// Generated by scripts/schema.ts from `Crawl` in data/types.ts: don't edit it, edit the type and run `pnpm run schema`.
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Crawl",
  "definitions": {
    "Crawl": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "The JSON Schema of this file, generated from this interface: for editors."
        },
        "asOf": {
          "type": "string",
          "description": "When crawl.ts last ran (YYYY-MM-DD).\n\nSource: scripts/crawl.ts, which .github/workflows/crawl.yml runs daily, sets it to the day it runs."
        },
        "qualified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Crawled"
          },
          "description": "At the minimums (`MINIMUMS` in ./params.ts) or above, or by a whitelisted author (`WHITELISTED_AUTHORS` there), most installed first: waiting for an agent to approve or disqualify them, with the add-skill skill.\n\nSource: scripts/crawl.ts sorts every skill it saw that day, in the top 600, down the sitemap or by a whitelisted author, into `qualified` or `unqualified`, with `passes()` of scripts/data.ts; a skill it didn't see keeps its state."
        },
        "unqualified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Crawled"
          },
          "description": "Below the minimums, most installed first.\n\nSource: scripts/crawl.ts, as for `qualified`."
        },
        "disqualified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Disqualified"
          },
          "description": "Not to be shown, each with why, and with no agent data: no tags, no TLDR, no copy of its SKILL.md.\n\nSource: scripts/crawl.ts adds the skills of the top 600 that aren't on GitHub, scripts/sync.ts the approved skills whose SKILL.md is gone from their repo, and an agent, with the add-skill skill, the qualified skills it turns down."
        }
      },
      "required": ["$schema", "asOf", "qualified", "unqualified", "disqualified"],
      "additionalProperties": false,
      "description": "The shape of data/crawl.jsonc: every skill the crawl has seen that isn't approved (the approved ones are in skills.jsonc), keyed by its skills.sh page: those of the skills.sh all-time top 600, those further down skills.sh's sitemap that reach `MINIMUMS.installs`, and all those of the `WHITELISTED_AUTHORS` of ./params.ts, on skills.sh or beside those in their GitHub repos. The two files are cumulative: a skill that lands in either never leaves them, only its state changes. Unlike skills.jsonc, crawl.jsonc takes any skill, such as one a website publishes."
    },
    "Crawled": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Its name on skills.sh: the end of its skills.sh page.\n\nSource: scraped by scripts/crawl.ts when it records the skill: `topSkills()` takes `name` from the leaderboard JSON in the HTML of https://www.skills.sh/; for a skill found down the sitemap or by a whitelisted author, it's the end of the skill's page there, which for one found beside their skills in their repos, `besideListed()`, is the `name` of its SKILL.md's frontmatter."
        },
        "repo": {
          "type": "string",
          "description": "Its GitHub repo, `owner/name`, as skills.sh names it: possibly an old name the repo redirects from.\n\nSource: scraped by scripts/crawl.ts when it records the skill: the `source` of its leaderboard entry, or for a skill found down the sitemap or by a whitelisted author, the owner and repo in its page's URL."
        },
        "official": {
          "type": "boolean",
          "description": "Whether skills.sh shows its publisher as verified: false while skills.sh doesn't list it.\n\nSource: scraped by scripts/crawl.ts, daily while it sees the skill: the `isOfficial` of its leaderboard entry, or for any other skill, whether the HTML of its skills.sh page has `title=\"Verified organization on GitHub\"`."
        },
        "stars": {
          "type": ["number", "null"],
          "description": "Its repo's GitHub stars, or null when unknown.\n\nSource: the GitHub API, by scripts/crawl.ts, daily while it sees the skill: the `stargazers_count` of https://api.github.com/repos/<repo>, when GITHUB_TOKEN is set. A request that fails keeps the last number."
        },
        "seen": {
          "type": "string",
          "description": "The last day the crawl saw it, in the top 600, down the sitemap or by a whitelisted author, which its numbers are from (YYYY-MM-DD).\n\nSource: scripts/crawl.ts sets it to the day it runs, for every skill it sees."
        },
        "skills.sh": {
          "$ref": "#/definitions/SkillsSh",
          "description": "Its `skills.sh` field once it's approved."
        }
      },
      "required": ["name", "repo", "official", "stars", "seen", "skills.sh"],
      "additionalProperties": false,
      "description": "A skill the crawl found, in the top 600, down the sitemap or by a whitelisted author, that's qualified or unqualified."
    },
    "SkillsSh": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The skill's page on skills.sh, or for one it doesn't list yet (`unlisted`), the page it will have once someone installs the skill: https://skills.sh/<repo>/<name>.\n\nSource: scripts/crawl.ts, when it records the skill: `pageOf()` builds it from the `source` and `skillId` of its leaderboard entry, `sitemapSkills()` takes it from skills.sh's sitemap, `authorSkills()` from a whitelisted author's repo pages there, such as https://www.skills.sh/mattpocock/skills, or `besideListed()` builds it from a SKILL.md beside one of those skills in its GitHub repo: the repo and the `name` of its frontmatter."
        },
        "unlisted": {
          "type": "boolean",
          "const": true,
          "description": "Set while skills.sh doesn't list the skill: its `url` is a page skills.sh doesn't have, and its numbers are null. skills.sh lists a skill once someone installs it with the skills CLI, so a whitelisted author's new skill starts unlisted. Left out once skills.sh lists it.\n\nSource: scripts/crawl.ts, daily while it sees the skill: when skills.sh answers the skill's page with its \"isn't available\" page, which it keeps out of search engines (`noindex`)."
        },
        "installs": {
          "type": ["number", "null"],
          "description": "All-time installs, or null when unknown: exact for a skill in the skills.sh all-time top 600, rounded to three digits (such as 26.5K) for a skill outside it. A skill of crawl.jsonc the crawl no longer sees keeps its last number.\n\nSource: scraped from skills.sh's HTML, with no skills.sh API, by scripts/crawl.ts, which .github/workflows/crawl.yml runs daily. For a skill in the top 600, `topSkills()` fetches the HTML of https://www.skills.sh/ and parses the leaderboard JSON that the page's Next.js payload embeds (its `self.__next_f.push(…)` scripts, the `initialSkills` object of the all-time view). For a skill outside it, an approved one, one of the skills of https://www.skills.sh/sitemap.xml it reads or one of a whitelisted author, `skillPage()` fetches the HTML of the skill's skills.sh page and matches the \"Installs\" stat in its markup with a regex, such as \"26.5K\"; null when skills.sh doesn't have the page, no longer or not yet (`unlisted`)."
        },
        "weeklyInstalls": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Installs per week for the 8 weeks up to the installs snapshot, oldest first, or null when unknown.\n\nSource: scraped from skills.sh's HTML by scripts/crawl.ts, daily, together with `installs`. For a skill in the top 600, `topSkills()` takes `weeklyInstalls` from the same leaderboard JSON in the HTML of https://www.skills.sh/. For a skill outside it, `skillPage()` matches the `aria-label=\"Weekly installs: …\"` of the chart in the HTML of the skill's skills.sh page."
        },
        "firstSeen": {
          "type": ["string", "null"],
          "description": "When skills.sh first saw the skill (YYYY-MM-DD), or null when unknown. It never changes.\n\nSource: scraped from skills.sh's HTML by scripts/crawl.ts. `skillPage()` fetches the HTML of the skill's skills.sh page and matches its \"First Seen\" stat with a regex, such as \"Jan 22, 2026\", or for a recent skill \"10 days ago\", counted back from the day of the crawl. The leaderboard doesn't give it. It does so once: when the crawl records the skill in crawl.jsonc, or for a skill that has none, such as one skills.sh didn't list then."
        }
      },
      "required": ["url", "installs", "weeklyInstalls", "firstSeen"],
      "additionalProperties": false
    },
    "Disqualified": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Its skills.sh page."
        },
        "reason": {
          "$ref": "#/definitions/DisqualifiedReason",
          "description": "Why it's disqualified: an agent's verdict, or a fact a script found."
        }
      },
      "required": ["url", "reason"],
      "additionalProperties": false
    },
    "DisqualifiedReason": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agentReview": {
              "$ref": "#/definitions/DisqualifyReview",
              "description": "Why an agent turned it down, and which agent.\n\nSource: the agent that reviews the qualified skill, with the add-skill skill."
            }
          },
          "required": ["agentReview"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "goneFromRepo": {
              "type": "string",
              "description": "The day its SKILL.md was found gone from its repo's HEAD, YYYY-MM-DD.\n\nSource: scripts/sync.ts, for an approved skill; and the agent working through the qualified skills, with the add-skill skill, for a qualified one."
            }
          },
          "required": ["goneFromRepo"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "notOnGitHub": {
              "type": "string",
              "description": "The site skills.sh lists it from instead of a GitHub repo, such as \"open.feishu.cn\".\n\nSource: scripts/crawl.ts, for a skill of the skills.sh top 600 that isn't on GitHub."
            }
          },
          "required": ["notOnGitHub"],
          "additionalProperties": false
        }
      ],
      "description": "One of: an agent turned it down, its SKILL.md is gone from its repo, or it isn't on GitHub."
    },
    "DisqualifyReview": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "The model of the agent that last wrote or changed the review, such as \"Claude Opus 5.5\". When that agent switched models partway, the one that served most of its turns.\n\nSource: the agent that writes or changes any part of the review sets it to its own model. For a review last written before 2026-11-07, it's the model the repo's commits name in their Co-Authored-By trailer."
        },
        "effort": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", "max", null],
          "description": "That agent's reasoning effort, or null when it wasn't recorded, as for a review last written before 2026-11-07.\n\nSource: as for `model`."
        },
        "note": {
          "type": "string",
          "description": "Why, in one sentence, such as \"Tool docs: an agent's manual for aws.\"."
        }
      },
      "required": ["effort", "model", "note"],
      "additionalProperties": false,
      "description": "An agent's verdict on a skill it turned down."
    }
  }
}
