// Generated by scripts/schema.ts from `Data` in data/types.ts: don't edit it, edit the type and run `pnpm run schema`.
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Data",
  "definitions": {
    "Data": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "The JSON Schema of this file, generated from this interface: for editors."
        },
        "asOf": {
          "type": "object",
          "properties": {
            "installs": {
              "type": "string",
              "description": "When the installs were collected.\n\nSource: scripts/crawl.ts, which .github/workflows/crawl.yml runs daily, sets it to the day it runs."
            },
            "stars": {
              "type": "string",
              "description": "When the GitHub stars were collected.\n\nSource: scripts/crawl.ts sets it to the day it runs, when it got stars from GitHub."
            },
            "tags": {
              "type": "string",
              "description": "When the tags were last assigned, which the tags page shows.\n\nSource: the agent that tags or retags a skill, with the add-skill skill, sets it to that day."
            }
          },
          "required": ["installs", "stars", "tags"],
          "additionalProperties": false,
          "description": "When each kind of data is from (YYYY-MM-DD)."
        },
        "facets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Facet"
          },
          "description": "The tag dimensions, with the values their tags can take."
        },
        "repos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Repo"
          },
          "description": "The GitHub repos of the skills and bundles, one entry each."
        },
        "bundles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Bundle"
          },
          "description": "Skills meant to be installed together."
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Skill"
          },
          "description": "The approved skills: the ones the site lists."
        }
      },
      "required": ["$schema", "asOf", "facets", "repos", "bundles", "skills"],
      "additionalProperties": false,
      "description": "The shape of skills.jsonc, the single data file behind the site: the approved skills, the ones it shows. The skills the crawl found but that aren't approved are in crawl.jsonc."
    },
    "Facet": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Its id: the prefix of its tags, `id:value`."
        },
        "name": {
          "type": "string",
          "description": "Its name, as the site shows it."
        },
        "question": {
          "type": "string",
          "description": "The question its values answer."
        },
        "count": {
          "type": "string",
          "enum": ["one", "one or more", "at most one", "one to five", "any"],
          "description": "How many values of this facet a skill carries."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Its id: the tag is `facet:id`, or just `id` for a topic."
              },
              "label": {
                "type": "string",
                "description": "A name for chips, when the id alone isn't one."
              },
              "description": {
                "type": "string",
                "description": "What it means: for people browsing, and for agents tagging skills."
              },
              "includes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Makes the value a parent of these values of the same facet: skills don't carry it, they have it through any of them, and filtering on it lists them all."
              }
            },
            "required": ["id"],
            "additionalProperties": false
          },
          "description": "The values its tags can take, when they're a closed list. Left out for a facet that takes any value, as stack does, a technology or a service: its tags are the ones the skills carry."
        },
        "prefix": {
          "type": "boolean",
          "const": false,
          "description": "`false` for topics, which are written without a `topic:` prefix."
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The group's heading."
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The ids of its values."
              }
            },
            "required": ["name", "values"],
            "additionalProperties": false
          },
          "description": "Display groups (topics only)."
        }
      },
      "required": ["id", "name", "question", "count"],
      "additionalProperties": false,
      "description": "A tag dimension. Tags are written `facet:value`, except topics, which have no prefix."
    },
    "Repo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "GitHub `owner/name`: its page is https://github.com/<id>.\n\nSource: the agent that approves the repo's first skill, with the add-skill skill."
        },
        "stars": {
          "type": ["number", "null"],
          "description": "GitHub stars, or null when unknown.\n\nSource: the GitHub API, by scripts/crawl.ts, which .github/workflows/crawl.yml runs daily: the `stargazers_count` of https://api.github.com/repos/<id>, when GITHUB_TOKEN is set. A request that fails keeps the last number."
        },
        "agentReview": {
          "$ref": "#/definitions/RepoReview",
          "description": "What an agent wrote about the repo: everything else is collected by scripts.\n\nSource: the agent that approves the repo's first skill, with the add-skill skill."
        }
      },
      "required": ["id", "stars", "agentReview"],
      "additionalProperties": false
    },
    "RepoReview": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "The model of the agent that last wrote or changed the review, such as \"Claude Opus 5.5\". When that agent switched models partway, the one that served most of its turns.\n\nSource: the agent that writes or changes any part of the review sets it to its own model. For a review last written before 2026-11-07, it's the model the repo's commits name in their Co-Authored-By trailer."
        },
        "effort": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", "max", null],
          "description": "That agent's reasoning effort, or null when it wasn't recorded, as for a review last written before 2026-11-07.\n\nSource: as for `model`."
        },
        "kind": {
          "type": "string",
          "enum": ["skills", "project", "index"],
          "description": "`skills`: exists to ship skills. `project`: a product that also ships a skill. `index`: a curated list or catalog."
        },
        "description": {
          "type": ["string", "null"],
          "description": "The repo in one line, such as its GitHub description, or null when it has none."
        },
        "note": {
          "type": "string",
          "description": "Something to know about the repo, such as where its star count comes from."
        }
      },
      "required": ["description", "effort", "kind", "model"],
      "additionalProperties": false
    },
    "Bundle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The GitHub repo, `owner/name`, or `owner/name@part` for one of several bundles in a repo.\n\nSource: the agent that records the bundle, with the add-skill skill."
        },
        "skew": {
          "type": "number",
          "description": "Words added plus words removed across its skills' SKILL.md since the commit the TLDR summarizes, or all their words when there's no TLDR.\n\nSource: scripts/sync.ts, daily, when one of its skills' SKILL.md changed: it compares each skill's copy with its SKILL.md at the commit of the bundle's TLDR permalink, fetched from https://raw.githubusercontent.com/, with `skew()` of website/skill-md.ts. `pnpm run tldr` resets it to 0 when it sets the TLDR."
        },
        "agentReview": {
          "$ref": "#/definitions/BundleReview",
          "description": "What an agent wrote about the bundle: all of it but its id and skew.\n\nSource: the agent that records the bundle, with the add-skill skill; and an agent with the write-tldr skill, which sets its TLDR with `pnpm run tldr`."
        }
      },
      "required": ["id", "skew", "agentReview"],
      "additionalProperties": false,
      "description": "Skills of one repo meant to be installed together, such as the steps of a workflow. Its skills are listed inside its entry; those worth installing alone also get an entry of their own."
    },
    "BundleReview": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "The model of the agent that last wrote or changed the review, such as \"Claude Opus 5.5\". When that agent switched models partway, the one that served most of its turns.\n\nSource: the agent that writes or changes any part of the review sets it to its own model. For a review last written before 2026-11-07, it's the model the repo's commits name in their Co-Authored-By trailer."
        },
        "effort": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", "max", null],
          "description": "That agent's reasoning effort, or null when it wasn't recorded, as for a review last written before 2026-11-07.\n\nSource: as for `model`."
        },
        "name": {
          "type": "string",
          "description": "Its name, as the site shows it."
        },
        "description": {
          "type": "string",
          "description": "One sentence, shown until it has a TLDR."
        },
        "tldr": {
          "$ref": "#/definitions/Tldr",
          "description": "What the bundle is and how its skills work together, written from the repo at its permalink's commit."
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BundleSkill"
          },
          "description": "Its skills, in the order they're used."
        },
        "install": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Where the command works, such as \"Claude Code plugin\"."
              },
              "command": {
                "type": "string",
                "description": "The command to run."
              }
            },
            "required": ["label", "command"],
            "additionalProperties": false
          },
          "description": "How to install all of its skills, one command per way, as its README gives them."
        }
      },
      "required": ["description", "effort", "install", "model", "name", "skills"],
      "additionalProperties": false
    },
    "Tldr": {
      "type": "object",
      "properties": {
        "glance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "A few words, such as \"Use it when\"."
              },
              "text": {
                "type": "string",
                "description": "What the label introduces."
              }
            },
            "required": ["label", "text"],
            "additionalProperties": false
          },
          "description": "Short labelled facts to place the skill quickly, most telling first, such as \"Use it when\"."
        },
        "text": {
          "type": "string",
          "description": "Prose that explains what the skill does."
        },
        "permalink": {
          "type": "string",
          "description": "GitHub permalink to what the TLDR summarizes: the skill's directory at a commit. For a bundle, its repo at a commit.\n\nSource: scripts/tldr.ts, when it sets the TLDR: for a skill, its directory at the commit of its copy (`skillMd.version`); for a bundle, its repo at the commit of the repo's HEAD, once its skills' copies match it."
        }
      },
      "required": ["glance", "text", "permalink"],
      "additionalProperties": false
    },
    "BundleSkill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Where its SKILL.md lives, as for a skill's `id`."
        },
        "standalone": {
          "type": "boolean",
          "description": "Whether it's worth installing alone, with no other skill of the bundle. A skill that loads another one of the bundle, or only works on another's output, isn't."
        },
        "listedOutsideBundle": {
          "type": "boolean",
          "description": "For a standalone skill: whether the skills list also shows it on a row of its own, besides its bundle's row. True when people would want it without the rest of the bundle, such as `tdd` in an engineering-workflow bundle. False when whoever would want it would want the bundle too: a skill for the bundle's niche, such as `save-systems` in a game-dev bundle, or one of a family of siblings that only differ in what they cover, such as game genres. False too for the skill the bundle is named after, such as `caveman` in Caveman: the bundle's row already is its row. A bundle's skills get installed together and rise together, so such rows would flood the list."
        },
        "note": {
          "type": "string",
          "description": "For a skill that isn't standalone: what it needs from the rest of the bundle."
        }
      },
      "required": ["id", "standalone"],
      "additionalProperties": false
    },
    "Skill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique: where the skill's SKILL.md lives, as the GitHub repo and the directory inside it, `owner/name/path/to/dir` (just `owner/name` for a SKILL.md at the root). The repo has an entry in `repos`.\n\nSource: the agent that approves the skill, with the add-skill skill, from where its SKILL.md is on GitHub."
        },
        "name": {
          "type": "string",
          "description": "Its name: the `name` in the frontmatter of its SKILL.md, which skills.sh also ends its page with.\n\nSource: the `name` of its crawl.jsonc entry, which the agent that approves the skill copies. `pnpm run check` fails when it isn't the `name` of its SKILL.md copy."
        },
        "skills.sh": {
          "$ref": "#/definitions/SkillsSh",
          "description": "Its listing on skills.sh, or for a whitelisted author's skill skills.sh doesn't list yet, the listing it will have, `unlisted`.\n\nSource: its crawl.jsonc entry, which the agent that approves the skill copies; scripts/crawl.ts then keeps its numbers current."
        },
        "skillMd": {
          "$ref": "#/definitions/SkillMd",
          "description": "The copy of the skill's SKILL.md at `data/skill-snapshots/<id>.md`, which `sync.ts` keeps current.\n\nSource: scripts/sync.ts, which .github/workflows/sync.yml runs daily: it fetches the SKILL.md from https://raw.githubusercontent.com/<repo>/<commit>/<dir>/SKILL.md, at the commit of the repo's HEAD, and updates the copy and this field when the text changed."
        },
        "agentReview": {
          "$ref": "#/definitions/SkillReview",
          "description": "What an agent wrote about the skill: everything else is collected by scripts.\n\nSource: the agent that approves the skill, with the add-skill skill, which writes its description, tags and note; and an agent with the write-tldr skill, which sets its TLDR with `pnpm run tldr`."
        }
      },
      "required": ["id", "name", "skills.sh", "agentReview"],
      "additionalProperties": false,
      "description": "A skill on GitHub that skills.sh lists, or a whitelisted author's (`WHITELISTED_AUTHORS` of ./params.ts), which skills.sh may not list yet. SkillHub lists no other skills."
    },
    "SkillsSh": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The skill's page on skills.sh, or for one it doesn't list yet (`unlisted`), the page it will have once someone installs the skill: https://skills.sh/<repo>/<name>.\n\nSource: scripts/crawl.ts, when it records the skill: `pageOf()` builds it from the `source` and `skillId` of its leaderboard entry, `sitemapSkills()` takes it from skills.sh's sitemap, `authorSkills()` from a whitelisted author's repo pages there, such as https://www.skills.sh/mattpocock/skills, or `besideListed()` builds it from a SKILL.md beside one of those skills in its GitHub repo: the repo and the `name` of its frontmatter."
        },
        "unlisted": {
          "type": "boolean",
          "const": true,
          "description": "Set while skills.sh doesn't list the skill: its `url` is a page skills.sh doesn't have, and its numbers are null. skills.sh lists a skill once someone installs it with the skills CLI, so a whitelisted author's new skill starts unlisted. Left out once skills.sh lists it.\n\nSource: scripts/crawl.ts, daily while it sees the skill: when skills.sh answers the skill's page with its \"isn't available\" page, which it keeps out of search engines (`noindex`)."
        },
        "installs": {
          "type": ["number", "null"],
          "description": "All-time installs, or null when unknown: exact for a skill in the skills.sh all-time top 600, rounded to three digits (such as 26.5K) for a skill outside it. A skill of crawl.jsonc the crawl no longer sees keeps its last number.\n\nSource: scraped from skills.sh's HTML, with no skills.sh API, by scripts/crawl.ts, which .github/workflows/crawl.yml runs daily. For a skill in the top 600, `topSkills()` fetches the HTML of https://www.skills.sh/ and parses the leaderboard JSON that the page's Next.js payload embeds (its `self.__next_f.push(…)` scripts, the `initialSkills` object of the all-time view). For a skill outside it, an approved one, one of the skills of https://www.skills.sh/sitemap.xml it reads or one of a whitelisted author, `skillPage()` fetches the HTML of the skill's skills.sh page and matches the \"Installs\" stat in its markup with a regex, such as \"26.5K\"; null when skills.sh doesn't have the page, no longer or not yet (`unlisted`)."
        },
        "weeklyInstalls": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Installs per week for the 8 weeks up to the installs snapshot, oldest first, or null when unknown.\n\nSource: scraped from skills.sh's HTML by scripts/crawl.ts, daily, together with `installs`. For a skill in the top 600, `topSkills()` takes `weeklyInstalls` from the same leaderboard JSON in the HTML of https://www.skills.sh/. For a skill outside it, `skillPage()` matches the `aria-label=\"Weekly installs: …\"` of the chart in the HTML of the skill's skills.sh page."
        },
        "firstSeen": {
          "type": ["string", "null"],
          "description": "When skills.sh first saw the skill (YYYY-MM-DD), or null when unknown. It never changes.\n\nSource: scraped from skills.sh's HTML by scripts/crawl.ts. `skillPage()` fetches the HTML of the skill's skills.sh page and matches its \"First Seen\" stat with a regex, such as \"Jan 22, 2026\", or for a recent skill \"10 days ago\", counted back from the day of the crawl. The leaderboard doesn't give it. It does so once: when the crawl records the skill in crawl.jsonc, or for a skill that has none, such as one skills.sh didn't list then."
        }
      },
      "required": ["url", "installs", "weeklyInstalls", "firstSeen"],
      "additionalProperties": false
    },
    "SkillMd": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "The GitHub commit the copy was taken from.\n\nSource: scripts/sync.ts: `git ls-remote https://github.com/<repo> HEAD`, when the copy changes."
        },
        "updated": {
          "type": "string",
          "description": "When the copy last changed (YYYY-MM-DD).\n\nSource: scripts/sync.ts sets it to the day it finds the SKILL.md changed."
        },
        "skew": {
          "type": "number",
          "description": "Words added plus words removed since the SKILL.md the TLDR summarizes, or all its words when there's no TLDR.\n\nSource: scripts/sync.ts, when the SKILL.md changed: it compares the new text with the SKILL.md at the TLDR's permalink, fetched from https://raw.githubusercontent.com/, with `skew()` of website/skill-md.ts. `pnpm run tldr` resets it to 0 when it sets the TLDR."
        }
      },
      "required": ["version", "updated", "skew"],
      "additionalProperties": false
    },
    "SkillReview": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "The model of the agent that last wrote or changed the review, such as \"Claude Opus 5.5\". When that agent switched models partway, the one that served most of its turns.\n\nSource: the agent that writes or changes any part of the review sets it to its own model. For a review last written before 2026-11-07, it's the model the repo's commits name in their Co-Authored-By trailer."
        },
        "effort": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "xhigh", "max", null],
          "description": "That agent's reasoning effort, or null when it wasn't recorded, as for a review last written before 2026-11-07.\n\nSource: as for `model`."
        },
        "description": {
          "type": "string",
          "description": "One sentence on what it does, shown until it has a TLDR."
        },
        "tldr": {
          "$ref": "#/definitions/Tldr",
          "description": "What the skill is and does, written from the SKILL.md its permalink points to."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Its tags, `facet:value` or just the value for a topic, from the values `facets` defines."
        },
        "note": {
          "type": "string",
          "description": "Something to know before installing."
        }
      },
      "required": ["description", "effort", "model", "tags"],
      "additionalProperties": false
    }
  }
}
