        "skew": 235
      },
      "agentReview": {
        "description": "Analyzes a site's backlinks, anchor text, toxic links and competitor gaps from free and paid link data, without scoring what it didn't measure.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to know who links to a site, whether any links look toxic, and where competitors get links you don't"
            },
            {
              "label": "It does",
              "text": "Detects which link sources you have set up, then covers profile, anchors, referring domains, toxic links, top pages, gaps and new or lost links"
            },
            {
              "label": "You get",
              "text": "A backlink health score out of 100 with a source and confidence on every figure, or INSUFFICIENT DATA, plus link-building opportunities"
            },
            {
              "label": "Free data",
              "text": "Common Crawl domain metrics and a crawler that checks known links still exist; free Moz, Bing Webmaster and Keywords Everywhere keys add more"
            },
            {
              "label": "Premium",
              "text": "DataForSEO, its only source for new and lost links over time"
            }
          ],
          "text": "Each source carries a confidence weight (DataForSEO 1.0, Moz 0.85, Bing 0.70, Common Crawl 0.50), and a numeric score needs data for at least four of its seven factors. With only Common Crawl it gives no number at all and writes Not Assessed instead; the plugin's validator fails any report that breaks this rule, and the agent must fix and rerun it before showing results. Anchor text is compared with healthy ranges, such as 30-50% branded and 3-10% exact-match keywords, and toxic patterns such as private blog networks, link farms and sitewide paid links are flagged, with disavow recommendations. A mandatory pre-delivery checklist catches false findings, such as a JavaScript-rendered page reported as \"link removed\". /seo backlinks setup explains how to add the free API keys, and it offers a PDF report at the end.",
          "permalink": "https://github.com/AgriciDaniel/claude-seo/tree/6be93f45064ffbadced572b5d5c95f55fd263af0/skills/seo-backlinks"
        },
