      "agentReview": {
        "description": "Interviews you about a load-bearing technical decision, recommends an answer for each choice, and writes it up as a build spec in docs/specs/.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A stack, data model, provider, feature or page design is still undecided, or its sibling develop skill says a decision is owed"
            },
