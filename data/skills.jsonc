    {
      "id": "julianoczkowski/designer-skills/design-tokens",
      "name": "design-tokens",
      "skills.sh": {
        "url": "https://skills.sh/julianoczkowski/designer-skills/design-tokens",
        "installs": 6100,
        "weeklyInstalls": [142, 148, 101, 82, 108, 86, 79, 79],
        "firstSeen": "2026-03-28"
      },
      "skillMd": {
        "version": "c259656c76d9758d7ead46b0d2f125cbe84f8665",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Generates design tokens with light and dark palettes and spacing, type, layout and motion scales, in your stack's format, from an aesthetic philosophy.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're setting up a project's visual system, or your tokens lack dark mode, a full spacing scale or motion values"
            },
            {
              "label": "It does",
              "text": "Extends any tokens you already have, reads the brief's aesthetic philosophy and derives values from frontend-design's parameters for it"
            },
            {
              "label": "You get",
              "text": "Semantic color, spacing, type, layout, shadow, motion and breakpoint tokens, in your Tailwind config and globals.css, a tokens.css or a theme file"
            },
            {
              "label": "Dark mode",
              "text": "Always generated and tuned to the philosophy rather than inverted, with both a system-preference query and a data-theme toggle"
            }
          ],
          "text": "The design-tokens step of Julian Oczkowski's designer workflow: every component built afterwards is meant to use these tokens instead of hard-coded values. It first scans for :root variables, Tailwind config, Material UI, Chakra or shadcn themes, Style Dictionary or Figma token files and UI dependencies, and fills gaps rather than replacing what exists. It reads the design brief if there is one; without one it asks what direction you want. Colors are named by role (backgrounds, text, borders, accents with hover and active states, status, overlay). The spacing scale's base unit follows the philosophy: 4px for tight styles like Brutalist or Swiss, 8px with bigger steps for spacious ones like Japanese minimalism or Editorial. Typography covers display, body and mono families, sizes, weights, line heights and letter spacing, and motion durations, easings and five breakpoints from 375px come with set values. Tailwind projects get their config extended, plain CSS gets tokens.css, CSS-in-JS gets theme.ts, and anything unclear gets CSS custom properties. It ends by saying which philosophy the values come from and where it deviated.",
          "permalink": "https://github.com/julianoczkowski/designer-skills/tree/c259656c76d9758d7ead46b0d2f125cbe84f8665/design-tokens"
        },
        "tags": [
          "category:design",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "design-system",
          "design"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "julianoczkowski/designer-skills/information-architecture",
      "name": "information-architecture",
      "skills.sh": {
        "url": "https://skills.sh/julianoczkowski/designer-skills/information-architecture",
        "installs": 6200,
        "weeklyInstalls": [171, 137, 82, 58, 110, 88, 94, 100],
        "firstSeen": "2026-03-28"
      },
      "skillMd": {
