      "agentReview": {
        "description": "Automates a browser: navigate, fill forms, click and take accessibility snapshots.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A task needs a website: testing your app, filling a form, scraping a page"
