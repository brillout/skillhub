          "stack:asc"
        ],
        "note": "Uploads through the asc CLI, so it needs asc signed in to App Store Connect with an API key. It shows every locale's text and waits for your OK before uploading.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
