      "agentReview": {
        "description": "Builds a scroll-driven landing page where a camera flies through AI-generated scenes of your business with no cuts, rendered with Higgsfield and Seedance video.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a landing-page hero where scrolling flies a camera into each scene of a generated world, like Apple's scroll-through product pages"
            },
            {
              "label": "It does",
              "text": "Interviews you, generates one still per section, renders camera clips that share the exact same frame at every seam, and wires them to a scroll engine"
