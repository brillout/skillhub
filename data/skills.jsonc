      },
      "skillMd": {
        "version": "25eec57919aec2cfd87d4ef9ae5661832302585e",
        "updated": "2026-11-12",
        "skew": 1215
      },
      "agentReview": {
        "description": "Sets up a game's audio mix: buses with volume sliders in decibels, music ducking under dialogue, adaptive music, varied sound effects and beat sync.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're laying out a game's mixer and volume settings, or music should dip under dialogue, react to play or stay on the beat"
            },
            {
              "label": "It does",
              "text": "Routes every sound through a few buses, maps settings sliders to decibels, adds ducking, varies repeated sounds and schedules events on the music's beat"
            },
            {
              "label": "Ducking means",
              "text": "Lowering music or ambience automatically while a voice or important sound plays, then letting it recover"
            },
            {
              "label": "You get",
              "text": "Audio code and mixer settings, checked by listening on headphones and speakers rather than trusting the editor meters"
            },
            {
              "label": "Code examples",
              "text": "Godot 4.7, with Unity 6.3 equivalents and notes for FMOD and Wwise"
            }
          ],
          "text": "A discipline skill from a game-development collection that treats game audio as a mixing graph plus a music system. Buses such as Music, SFX, Ambience, UI and Voice feed Master, and the player's sliders set bus volumes, never hundreds of clip volumes. Levels work in decibels, with peaks at or below -1 dBTP and a loudness target from Sony's ASWG-R001: -24 LUFS for console and PC, -18 for handheld and mobile, not the -14 LUFS of music streaming. Ducking uses a sidechain compressor, or a separate duck bus so it never overwrites the player's music setting. Adaptive music fades stems in and out or swaps segments at musical boundaries. Small random pitch and volume changes over a pool of samples keep footsteps from sounding robotic. Beat sync reads the audio playback position, corrected for mix time and output latency, instead of counting frame time. Pitfalls include sliders treated as decibels, sources that bypass the mixer, pumping ducking and one-shot players that leak. Engine audio nodes and asset import are left to engine skills.",
          "permalink": "https://github.com/gamedev-skills/awesome-gamedev-agent-skills/tree/19d93f97c9c1ea0f8b306e77aa81e0d3e352d3e9/skills/disciplines/audio-design"
        },
        "tags": [
          "category:media",
          "category:games",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "audio"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
