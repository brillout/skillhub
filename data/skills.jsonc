          "type:workflow",
          "effect:local",
          "needs:cli",
          "by:official",
          "stack:dudect",
          "stack:valgrind",
          "security",
          "testing"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
