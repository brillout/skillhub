        "skew": 0
      },
      "agentReview": {
        "description": "Collects the shortcut: comments ponytail leaves in code into a ledger of deferred work, with each one's limit and upgrade trigger.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You've used ponytail for a while and want to see which shortcuts it deferred, before they become permanent"
            },
            {
              "label": "It does",
              "text": "Greps the repo for shortcut: comments, and older ponytail: ones, skipping .git and ignored files, or for a marker word you name, such as TODO"
            },
            {
              "label": "You get",
              "text": "One line per marker, grouped by file: what was simplified, its limit and its upgrade trigger, with no-trigger on those that name none"
            },
            {
              "label": "Writes",
              "text": "Nothing, unless you ask it to save the ledger to a file such as PONYTAIL-DEBT.md"
            }
          ],
          "text": "Ponytail, a skill set that makes coding agents write the least code that fully solves a task, marks each deliberate shortcut with a comment in the form shortcut: <the limit>, <when to upgrade>. This skill gathers those comments into one ledger, so a deferral can't quietly become permanent. It runs one git grep over comment markers, skipping .git and everything .gitignore excludes, and drops hits that aren't deferrals, such as a note about a keyboard shortcut. Each row gives the file and line, what was simplified, the limit and the upgrade trigger, pulled straight from the comment; markers that name no trigger are tagged no-trigger, since those are the ones that rot. It ends with a count of markers and of those with no trigger, and git blame can add an owner to each row. It's one-shot and changes nothing.",
          "permalink": "https://github.com/dietrichgebert/ponytail/tree/96608e078b2d5ea607c5c3b8b5a54d1c1fba6846/skills/ponytail-debt"
        },
        "tags": [
          "category:engineering",
          "type:command",
          "effect:none",
          "needs:none",
          "by:community",
          "code-quality"
        ],
        "note": "Lists the shortcut: comments that the ponytail skill leaves in code; for any other marker, you name the word.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
