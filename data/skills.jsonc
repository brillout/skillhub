          "notes",
          "issue-tracking"
        ],
        "note": "It commits and pushes conversation history and workspace maps to a Git knowledge-base repo, and updates GitHub and Linear. The graph layer needs an MCP memory server.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
