          "effect:local",
          "needs:none",
          "by:community",
          "animation",
          "design"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "gamedev-skills/awesome-gamedev-agent-skills/skills/disciplines/game-ui-ux",
      "name": "game-ui-ux",
