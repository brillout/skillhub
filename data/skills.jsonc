      "agentReview": {
        "description": "Creates Mermaid diagrams and design documents from descriptions or source code, validating each diagram before adding it to your docs.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need a flowchart, sequence, class, ER, state, C4 or architecture diagram, or a design document, from a description or your code"
            },
            {
              "label": "It does",
              "text": "Loads only the guide for that diagram type, writes the Mermaid code, saves it as a .mmd file and renders it to validate it before adding it to Markdown"
            },
            {
              "label": "You get",
              "text": ".mmd and PNG or SVG files in ./diagrams with image links in your Markdown; full design documents go in docs/design/"
            },
            {
