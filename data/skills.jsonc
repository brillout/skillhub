      "skillMd": {
        "version": "463fd7b4d8168aadffc1b1613df96a342a47953e",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Launches and drives an app on an iOS Simulator with agent-device to verify a change, inspect its live UI or collect failure evidence.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need a native, React Native, Expo or Flutter app checked on an iPhone or iPad Simulator"
            },
            {
              "label": "It does",
              "text": "Opens the app on iOS with agent-device straight away, follows its interactive snapshot and error hints, and shuts down any simulator it booted when done"
            },
            {
              "label": "Needs",
              "text": "The agent-device CLI, which you install yourself; it won't install or upgrade it"
            },
            {
              "label": "Unlike agent-device",
              "text": "That one is the repo's general skill for phones, TVs and Macs; this one only targets the iOS Simulator and leaves details to agent-device's own help"
            },
            {
              "label": "For more",
              "text": "Version-matched agent-device help on validation, debugging, React Native, React DevTools and scripting, read only when a task is specialized"
            }
          ],
          "text": "A short entry point to Callstack's agent-device CLI for iOS. The agent skips probing first with --help, devices or a screenshot, opens the app or bundle id with --platform ios in the foreground, then works from the snapshot agent-device returns and its corrective hints. If agent-device isn't on your PATH, it stops and asks you to install it rather than running npx with a moving version. When a task is specialized or a command's shape is unclear, it reads one of agent-device's own help topics: validate for engineering checks and build freshness, debugging for screenshots, logs, traces and video, react-native, react-devtools for components, props, state and render profiling, or scripting for replays and CI. At the end it runs agent-device close --shutdown if it booted the simulator, unless you want it kept running.",
          "permalink": "https://github.com/callstack/agent-device/tree/463fd7b4d8168aadffc1b1613df96a342a47953e/skills/ios-simulator"
        },
