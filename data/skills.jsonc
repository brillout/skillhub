          "effect:none",
          "needs:none",
          "by:official",
          "code-quality",
          "refactoring",
          "planning"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "anthropics/knowledge-work-plugins/enterprise-search/skills/knowledge-synthesis",
      "name": "knowledge-synthesis",
      "skills.sh": {
        "url": "https://skills.sh/anthropics/knowledge-work-plugins/knowledge-synthesis",
        "installs": 6500,
        "weeklyInstalls": [81, 49, 57, 66, 60, 55, 57, 50],
        "firstSeen": "2026-01-31"
      },
      "skillMd": {
        "version": "ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Merges search results from chat, email, documents and trackers into one answer with sources cited, duplicates combined, conflicts flagged and confidence stated.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "The agent has results from several of your company's tools and you want one answer, not a list per source"
            },
            {
              "label": "It does",
              "text": "Merges the same fact found in several places, groups results by topic, ranks them, and rates confidence by freshness, source authority and agreement"
            },
            {
              "label": "You get",
              "text": "An answer that leads with the conclusion, cites each claim's source, place and date, and flags conflicting or possibly outdated information"
            },
            {
              "label": "Scales",
              "text": "Shows every detail for up to 5 results, groups 5 to 15 by theme, and summarizes 15 or more with an offer to dig deeper"
            },
            {
              "label": "Runs",
              "text": "On its own when there are results to combine; user-invocable: false hides it from the slash menu"
            }
          ],
          "text": "The last step of enterprise search: what the agent does with raw results from several sources once they're gathered. It spots results about the same thing from signs such as similar text, the same author, dates a day or so apart, the same project or decision, or one citing another, and merges them into one point that cites every source, keeping the fullest version and adding each source's unique details. It keeps them apart when people disagree, a decision changed between versions, or they cover different periods. Every claim names its source type, location, date and, where relevant, author, channel or subject line. Confidence depends on freshness, with anything older than a month flagged as possibly outdated, and on authority, from official wiki pages down to mid-thread chat and drafts. The answer is stated plainly when fresh, authoritative sources agree and hedged when it rests on one source or old data, and conflicts are always laid out rather than silently resolved. It avoids listing results source by source, burying the answer under method, or cutting useful detail.",
          "permalink": "https://github.com/anthropics/knowledge-work-plugins/tree/ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d/enterprise-search/skills/knowledge-synthesis"
        },
        "tags": [
          "category:documents",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:official",
          "research",
          "documents"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "anthropics/knowledge-work-plugins/pdf-viewer/skills/view-pdf",
      "name": "view-pdf",
      "skills.sh": {
        "url": "https://skills.sh/anthropics/knowledge-work-plugins/view-pdf",
        "installs": 6400,
        "weeklyInstalls": [77, 52, 42, 50, 56, 49, 45, 51],
        "firstSeen": "2026-03-28"
      },
      "skillMd": {
        "version": "ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Opens a PDF in a live local viewer where the agent highlights, annotates, stamps, fills form fields and places signature images with you.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to look at a PDF together: mark up a contract, fill in a form, stamp it or place your signature"
            },
            {
              "label": "It does",
              "text": "Opens the PDF in an interactive viewer, proposes annotations, applies them once you agree and checks each change with a screenshot"
            },
            {
              "label": "You get",
              "text": "A marked-up or filled-in PDF that you download from the viewer's toolbar"
            },
            {
              "label": "Not for",
              "text": "Summarizing or extracting text, which it leaves to the agent's own Read tool"
            },
            {
              "label": "Signatures",
              "text": "Places an image of your signature or initials, not a certified or cryptographic digital signature"
            },
            {
              "label": "Opens",
              "text": "Local files, arXiv links and any direct HTTPS link to a PDF"
            },
            {
              "label": "Needs",
              "text": "The pdf-viewer plugin's local PDF MCP server, started with npx"
            }
          ],
          "text": "The skill of the pdf-viewer plugin from Anthropic's knowledge-work plugins. It drives a local PDF server through three tools: one lists available PDFs, one opens a document in a live viewer, and one does everything after that: annotating, navigating, searching, zooming, reading page text, taking screenshots and filling forms. Annotations include highlights, underlines, strikethroughs, sticky notes, visible text, boxes, circles, lines, stamps such as APPROVED or CONFIDENTIAL, and images for signatures, initials or logos. To annotate, it reads the relevant pages, tells you what it plans to mark, adds the batch once you approve and shows a screenshot to iterate on. To fill a form, it matches cryptic field names such as Text1 to the labels printed on the page, asks you for values by those labels and shows the result; simple, well-labelled forms can instead prompt you for every field up front. To sign, it asks for your signature image and places it on a signature field or where you say. It only works on existing PDFs and doesn't create new ones.",
          "permalink": "https://github.com/anthropics/knowledge-work-plugins/tree/ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d/pdf-viewer/skills/view-pdf"
        },
        "tags": [
          "category:documents",
