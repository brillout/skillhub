      "agentReview": {
        "description": "Turns query results, pasted data or a file into a chart in Python, picking the chart type, applying design rules and saving a PNG.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a chart from query results, pasted data, a CSV or Excel file, or an analysis earlier in the conversation"
            },
            {
