    {
      "id": "lllllllama/rigorpilot-skills",
      "skew": 0,
      "agentReview": {
        "name": "RigorPilot",
        "description": "Reproduces a deep learning research repo from its README in small audited steps, with a separate lane for trying new ideas.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want an agent to run a deep learning research repo from its README and record honestly what worked"
            },
            {
              "label": "It does",
              "text": "Finds the smallest documented run, such as one evaluation command, sets it up, runs it and audits the result, instead of a full training run"
            },
            {
              "label": "You get",
              "text": "A repro_outputs/ folder: a verdict (verified, partial or blocked), the exact commands, logs, patches, any change to data, evaluation or metrics, and the README annotated section by section"
            },
            {
              "label": "Main skill",
              "text": "ai-research-reproduction runs a reproduction end to end and works alone; six of the others are steps it uses as needed, and each can be called by name"
            },
            {
              "label": "Exploration lane",
              "text": "ai-research-explore, explore-code and explore-run try new ideas on a saved baseline, only when you ask, and never report them as reproduced"
            },
            {
              "label": "Also has",
              "text": "safe-debug, which diagnoses a failed run and patches only with your approval"
            },
            {
              "label": "Needs",
              "text": "Python 3.11+ and Git for the main skill's scripts; five of the other skills load a runtime, writer or reference from it, so install it with them"
            }
          ],
          "text": "ai-research-reproduction is the entry point, and the README offers it as a self-contained install. It picks the smallest documented target (inference, then evaluation, then a training startup check; full training only after you confirm) and runs it through its script in three calls: plan, run, verify. Six skills are steps it uses as needed, and each can also be called by name. repo-intake-and-plan sorts the README's commands and recommends the first run. env-and-assets-bootstrap plans a conda environment and where checkpoints and datasets go. paper-context-resolver answers one gap the README leaves, such as a dataset split, from the paper, and notes any conflict. analyze-project maps a repo's entry points and configs, read-only, when its structure is unclear. minimal-run-and-audit records an inference or evaluation run in repro_outputs/, and run-train starts, checks or resumes training, recording it in train_outputs/. When a run fails, safe-debug diagnoses it and patches only with your approval. Exploration is a separate lane, only when you ask and from a saved baseline: ai-research-explore ranks ideas and hands code changes to explore-code, which works on an isolated branch, and short trials to explore-run. Their results go to explore_outputs/ as candidates, never as reproduced results.",
          "permalink": "https://github.com/lllllllama/rigorpilot-skills/tree/fb3ccdf5aa64b1fa5b1d0463e666a8bc8bc26e01"
        },
        "skills": [
          {
            "id": "lllllllama/rigorpilot-skills/skills/ai-research-reproduction",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/repo-intake-and-plan",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/paper-context-resolver",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/env-and-assets-bootstrap",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/analyze-project",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/minimal-run-and-audit",
            "standalone": false,
            "note": "Its run and report scripts load a shared runtime that ships inside ai-research-reproduction, the repo's main skill, and stop with an error without it."
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/run-train",
            "standalone": false,
            "note": "Its run and report scripts load a shared runtime that ships inside ai-research-reproduction, the repo's main skill, and stop with an error without it."
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/safe-debug",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/ai-research-explore",
            "standalone": false,
            "note": "Loads its required research loop and shared runtime from ai-research-reproduction, the repo's main skill, and hands code changes and trial runs to the repo's explore-code and explore-run skills."
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/explore-code",
            "standalone": false,
            "note": "Its report script loads a shared writer that ships inside ai-research-reproduction, the repo's main skill, and stops with an error without it."
          },
          {
            "id": "lllllllama/rigorpilot-skills/skills/explore-run",
            "standalone": false,
            "note": "Its report script loads a shared writer that ships inside ai-research-reproduction, the repo's main skill, and stops with an error without it."
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add https://github.com/lllllllama/rigorpilot-skills --skill '*'"
          }
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
