      "agentReview": {
        "description": "Summarizes a WeChat group chat into a dated digest, with an opt-in roast version, keeping per-member profiles and group history across runs.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to catch up on a busy WeChat group: what was discussed, by whom, since your last digest or over a date range"
            },
            {
              "label": "It does",
              "text": "Pulls the messages with wx-cli, lists every topic with verbatim quotes, writes the digest, then checks each quote against the raw messages"
            },
            {
              "label": "You get",
              "text": "A dated Markdown digest per group: an overview, topic sections, message stats with a top-10 leaderboard, and portraits of active members"
