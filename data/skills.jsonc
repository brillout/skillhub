          "by:community",
          "stack:x402",
          "stack:solana",
          "stack:okx",
          "payments",
          "web3",
          "agent-development",
          "guardrails"
        ],
        "note": "The code it writes signs real crypto payments with private keys you supply; it advises testing on Base Sepolia or Solana devnet first.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "affaan-m/ecc/skills/security-bounty-hunter",
      "name": "security-bounty-hunter",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/security-bounty-hunter",
        "installs": 5800,
        "weeklyInstalls": [259, 166, 157, 244, 414, 408, 476, 455],
        "firstSeen": "2026-05-19"
