    {
      "id": "trailofbits/skills/plugins/testing-handbook-skills/skills/fuzzing-obstacles",
      "name": "fuzzing-obstacles",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/fuzzing-obstacles",
        "installs": 5800,
        "weeklyInstalls": [108, 108, 97, 120, 124, 155, 166, 185],
        "firstSeen": "2026-01-19"
      },
      "skillMd": {
        "version": "e4dd0bb5b15535f7c5a0834187dffba6ac37e4ff",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Patches checksums, validation and non-deterministic state out of fuzzing builds behind a compile flag, leaving production behavior unchanged.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A fuzzer is stuck at checksum, hash or format validation, or the same input behaves differently between runs"
            },
            {
              "label": "It does",
              "text": "Finds the blocking check through coverage and code reading, wraps it in a fuzzing-only build flag, measures coverage again, then weighs the false-positive risk"
            },
            {
              "label": "You get",
              "text": "Small, commented patches to the code under test that apply only in fuzzing builds"
            },
            {
              "label": "Uses",
              "text": "FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION in C and C++, cfg!(fuzzing) in Rust"
            }
          ],
          "text": "From Trail of Bits' Testing Handbook skills. Many programs weren't written to be fuzzed: a fuzzer will never guess a valid checksum, a time-seeded random generator makes the same input behave differently, and strict validation spends the fuzzer's effort on rejections. The fix is conditional compilation, so the fuzzing build skips or neuters the obstacle while production keeps it. Patterns cover bypassing checksum checks, seeding a random generator deterministically, skipping validation carefully and getting past complex format checks. Skipping a check can create states that can't happen in production, so before keeping a patch it asks whether later code relies on what was validated, and prefers a narrower patch when crashes would be false positives. It warns against skipping all validation, patching without measuring, and letting the fuzzing build drift far from production. It isn't needed when a seed corpus or dictionary would get past the check, and it has notes for libFuzzer, AFL++, honggfuzz, cargo-fuzz and LibAFL.",
          "permalink": "https://github.com/trailofbits/skills/tree/e4dd0bb5b15535f7c5a0834187dffba6ac37e4ff/plugins/testing-handbook-skills/skills/fuzzing-obstacles"
        },
