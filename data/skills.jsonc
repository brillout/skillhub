    {
      "id": "coreyhaines31/marketingskills/skills/co-marketing",
      "name": "co-marketing",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/co-marketing",
        "installs": 89292,
        "weeklyInstalls": [2676, 2734, 3291, 3444, 3025, 3180, 3571, 3338],
        "firstSeen": "2026-05-06"
      },
      "skillMd": {
        "version": "8a3bde8083bd121971f61cba4bdbe5fd8c0eee7d",
        "updated": "2026-11-10",
        "skew": 67
      },
      "agentReview": {
        "description": "Helps choose co-marketing partners that share your audience, brainstorms joint campaigns, and outlines the outreach email and agreement.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're looking for companies to partner with, or planning a joint webinar, report or launch with one"
            },
            {
              "label": "It does",
              "text": "Scores possible partners 1-5 on audience fit, size, brand alignment, engagement, reciprocity and ease of execution"
            },
            {
              "label": "You get",
              "text": "Scored partner candidates, campaign ideas by format, an outreach email template and an agreement outline"
            },
            {
              "label": "Ideal partner",
              "text": "Same buyer, different problem, adjacent in the workflow, and not competing for the same budget"
            },
            {
              "label": "Unlike referrals",
              "text": "That one, from the same repo, covers customers referring customers and affiliate mechanics"
            }
          ],
          "text": "Partnerships between companies that share an audience. It reads your product marketing context if you have it (a shared file on your product, audience and positioning that the repo's product-marketing skill writes). Partners are found among your integration partners, tools used just before or after yours, sponsors of the same podcasts and conferences, and account overlap data from Crossbeam or Reveal. Co-marketing is placed among five partnership types (integrations, resellers, affiliates, co-marketing and app marketplaces) so a request goes to the right play, with HubSpot's partner program as the flagship example. Campaign formats run from co-authored posts and newsletter swaps to joint research reports, webinars, integration launches, bundles and giveaways, each rated by effort. For brainstorming with a specific partner, it looks for moments that matter to both audiences, what the two products enable together, and what each side brings. It then covers preparing for the first call, agreeing on lead ownership, promotion and approvals, and measuring leads, revenue and the relationship afterward, with a checklist from finding partners to the debrief.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/co-marketing"
        },
        "tags": [
          "category:marketing",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "marketing"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "coreyhaines31/marketingskills/skills/schema",
