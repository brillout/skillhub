      "agentReview": {
        "description": "Converts Markdown into styled HTML with inline CSS, ready for a WeChat Official Account article.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have a Markdown article and need it as styled HTML for a WeChat Official Account post"
