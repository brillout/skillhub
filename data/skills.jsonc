          "by:official",
          "security",
          "code-review",
          "architecture"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "trailofbits/skills/plugins/fp-check/skills/fp-check",
      "name": "fp-check",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/fp-check",
        "installs": 7700,
        "weeklyInstalls": [142, 134, 163, 169, 195, 221, 269, 262],
