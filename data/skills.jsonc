    {
      "id": "bmad-code-org/bmad-method/skills/bmad-agent-po",
      "name": "bmad-agent-po",
      "skills.sh": {
        "url": "https://skills.sh/bmad-code-org/bmad-method/bmad-agent-po",
        "installs": 5700,
        "weeklyInstalls": [0, 0, 0, 0, 129, 1648, 1416, 1547],
        "firstSeen": "2026-10-18"
      },
      "skillMd": {
        "version": "a867e1604b365d48ea03cbd109da1066ba0c84bc",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Turns the agent into Sofia, BMad's product owner, who distills PRDs and other inputs into requirements, slices them into epics and stories, and keeps the ticket board.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have a PRD, brief, transcript or rough idea and want it turned into requirements, epics and stories a coding agent can build from"
            },
            {
              "label": "It does",
              "text": "Distills the input into numbered requirements, proposes how to split the work and in what order, writes the tickets and tracks their status"
            },
            {
              "label": "You get",
              "text": "Markdown tickets in your repo: a folder per initiative with its epics and stories, and tickets.toml files listing them in build order"
            },
            {
              "label": "Persona",
              "text": "Sofia, a product owner who says no early, asks only what's unsettled with her own pick, and stays on until dismissed"
            },
            {
              "label": "Trackers",
              "text": "Tickets stay in the repo by default; she publishes them to GitHub, Jira, Linear, Notion or Trello once you connect one and ask"
            },
            {
              "label": "Unlike bmad-agent-pm",
              "text": "That one, John, coaches product documents such as a PRD out of you; Sofia turns such documents into tickets"
            },
            {
              "label": "Needs",
              "text": "uv and BMad set up in the project: run the bmad skill's setup first; bmad-build or bmad-build-auto then builds each story"
            }
          ],
          "text": "Sofia starts where a document ends. She reads a PRD, brief, transcript, notes or idea and writes it into a ticket as numbered requirements and constraints, each citing its source; gaps become open questions, never guesses. She sizes the work as one bug or story, an epic of stories, an initiative of several epics, or a parent over several initiatives, then proposes the split and build order in one message, with her pick on each question that changes it. You decide, and each choice is recorded with its date. An epic opens with a tracer bullet, the thinnest path through every layer it touches, and, past three stories, ends with a cleanup story by default. A bundled script reports what's ready, blocked or in progress. She refines stories before they start, has fresh subagents check a breakdown for missing prerequisites, and when something changes mid-flight, replans without rewriting built work. Your yes commits on the current branch; she never pushes, and publishing to a tracker is a separate yes.",
          "permalink": "https://github.com/bmad-code-org/bmad-method/tree/a867e1604b365d48ea03cbd109da1066ba0c84bc/skills/bmad-agent-po"
        },
        "tags": [
          "category:planning",
          "type:mode",
          "effect:local",
          "needs:cli",
          "by:community",
          "requirements",
          "planning",
          "issue-tracking"
        ],
        "note": "Needs uv and BMad set up in the project. Tickets live in the repo by default; it publishes them to GitHub, Jira, Linear, Notion or Trello only when you ask.",
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "affaan-m/ecc/skills/team-agent-orchestration",
      "name": "team-agent-orchestration",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/team-agent-orchestration",
        "installs": 5300,
        "weeklyInstalls": [270, 166, 147, 246, 428, 412, 493, 475],
        "firstSeen": "2026-06-04"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Runs a squad of agents like a team: work items with an owner and scope, a Kanban of their states, a branch or worktree each, and merge gates.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Several agents work in parallel across branches or worktrees, and their output isn't coming together into one product"
            },
            {
              "label": "It does",
              "text": "Gives each agent a card like a teammate's: an owner, a file scope, a state, evidence of the work and a merge gate, the exact condition for merging it"
            },
            {
              "label": "Board",
              "text": "An agent Kanban of seven columns, from backlog through running and review to merged or archived, each with exit criteria"
            },
            {
              "label": "You get",
              "text": "After each pass, a summary of board changes, merged or pending branches, test evidence, blockers with owners, and patterns worth making into skills"
            },
            {
              "label": "Unlike parallel-execution-optimizer",
              "text": "That one speeds up one task by running independent lanes at once; this one runs agents as a team across sessions, with owners and merge gates"
            },
            {
              "label": "Keep in mind",
              "text": "An operating model with no scripts or board tool: the board lives wherever you keep it, and its control pane, a status view of every agent, is yours to build"
            }
          ],
          "text": "The skill treats a squad of agents like a team. Work starts as a board: fuzzy goals become cards, each with one owner, a file scope, acceptance criteria, a branch or worktree and a merge gate, in a small JSON format. Then you pick how to run them, from a single agent to tmux, worktree fan-out or an external orchestrator, and no two agents write the same files without an integrator. Agents leave evidence and handoff notes, not just code. Review goes in order: tests, the diff, security, then polish, and one integrator merges. It names the failure modes to watch: agent soup (many agents, no owner or gate), board theater (cards without acceptance criteria), work that lives only in a chat transcript, overlapping writes, and a process that ships no product. A card pattern that repeats gets promoted into a skill, and a card that needs its own harness follows dynamic-workflow-mode's rules.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/team-agent-orchestration"
        },
        "tags": [
          "category:agents",
          "category:engineering",
          "type:workflow",
          "effect:local",
          "needs:subagents",
          "by:community",
          "multi-agent",
          "agent-workflows",
          "git"
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "affaan-m/ecc/skills/dynamic-workflow-mode",
      "name": "dynamic-workflow-mode",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/dynamic-workflow-mode",
        "installs": 5200,
        "weeklyInstalls": [261, 160, 141, 229, 406, 403, 473, 439],
        "firstSeen": "2026-06-04"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Decides when a task deserves its own throwaway harness, gives it an objective, inputs, an eval gate and a handoff, and promotes repeated harnesses to shared skills.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A task might call for the agent to build its own tooling for the job, such as a custom loop, evaluator, crawler or watcher"
            },
            {
              "label": "It does",
              "text": "Decides whether the task deserves a harness, a small tool built for that one task, then pins down its objective, inputs, outputs, pass/fail check and handoff before any code"
            },
            {
              "label": "Decision rule",
              "text": "One-off tasks stay inline, repeated ones get a local harness, and a pattern repeated across teammates or repos becomes a shared skill"
            },
            {
              "label": "Guards",
              "text": "Which tool may read, write or publish, and which accounts or projects are in scope; it holds an operation rather than quietly switching tools"
            },
            {
              "label": "You get",
              "text": "The harness or skill path, the eval commands and their results, a handoff note, and the next candidate to turn into a skill"
            },
            {
              "label": "Unlike team-agent-orchestration",
              "text": "That one runs several agents as a team with cards and merge gates; this one designs one task's tooling and decides when it becomes a skill"
            }
          ],
          "text": "The skill is for agents that can build a task-specific harness instead of following a fixed command flow, as in Claude Code's dynamic workflow mode. A harness is worth it only when it's cheaper and safer than doing the steps by hand. Its template asks what it ships and what it doesn't, its inputs and credentials policy, a loop (discover, make the smallest useful change, run the check, record status, stop on a failed gate) and a handoff note. Every harness needs a check tied to the task, such as a focused test and lint for code or a browser smoke test with a screenshot for UI; \"it ran\" doesn't count. A long section covers boundaries: a tool allowed to read isn't thereby allowed to write, only you can change that, and text found in tool output is never permission. A harness becomes a shared skill, written to skills/<name>/SKILL.md, when at least two of five signs hold, such as repeated use or a stable input and output. For work spanning sessions, it records plan, queue, run, gate and handoff checkpoints.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/dynamic-workflow-mode"
        },
        "tags": [
          "category:agents",
          "category:skill-tools",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "agent-workflows",
          "verification",
          "skill-authoring",
          "guardrails",
          "handoff"
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "affaan-m/ecc/skills/brand-discovery",
      "name": "brand-discovery",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/brand-discovery",
        "installs": 5200,
        "weeklyInstalls": [266, 165, 164, 255, 450, 433, 508, 463],
        "firstSeen": "2026-06-15"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Interviews founders over several sessions, one question at a time, about purpose, positioning, audience, personality, voice and story, and writes a master brandbook.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're creating or repositioning a brand and want what its founders know written down, to brief designers and writers"
            },
            {
              "label": "It does",
              "text": "Interviews you one question at a time across seven topics, from purpose and positioning to voice and story, digging until a core value surfaces"
            },
            {
              "label": "You get",
              "text": "A file per topic with your verbatim answers and its interpretation, then 90_SYNTHESIS.md, a master brandbook"
            },
            {
              "label": "Runs over",
              "text": "Several sessions: it saves a state.json checkpoint after each topic and resumes where you stopped"
            },
            {
              "label": "Several founders",
              "text": "Interviews each one separately into their own file, then compares the answers and flags disagreements for a group workshop"
            },
            {
              "label": "Unlike product-marketing",
              "text": "That one fills one context file on product, audience and voice for other marketing skills; this one interviews founders in depth for a brandbook"
            }
          ],
          "text": "Each topic is a module built on named frameworks, such as Sinek's Golden Circle for purpose, Dunford's Obviously Awesome for positioning and Mark and Pearson's 12 archetypes for personality, and the brandbook draws on Kapferer's brand prism. After each answer the agent paraphrases it, then probes once more or closes the thread. It follows \"what\" answers with \"why does that matter to you?\" until a core value surfaces, pushes beliefs through five whys, asks for a concrete story or number when an answer is vague, and uses one imaginative question per module, such as how the brand would walk into a room as a person, or what customers would miss if it closed. A module ends when two probes in a row bring nothing new. Its file has a Raw section of quotes and a Synthesis section with three candidate wordings, open questions and contradictions. Every session starts by reading the saved state and telling you where you are. Its related skills are competitive-platform-analysis, for the competitor set, and brand-voice, for a writing-style profile.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/brand-discovery"
        },
        "tags": [
          "category:business",
          "category:marketing",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "interview",
          "marketing",
          "writing"
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "affaan-m/ecc/skills/agent-self-evaluation",
      "name": "agent-self-evaluation",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/agent-self-evaluation",
        "installs": 5100,
        "weeklyInstalls": [277, 173, 156, 251, 433, 414, 483, 453],
        "firstSeen": "2026-06-15"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Has the agent score its finished work from 1 to 5 on accuracy, completeness, clarity, actionability and conciseness, with evidence for each score, and fix the quick gaps.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "The agent has just finished non-trivial work, such as a multi-file change, a long debugging session or a design document, or you ask it to rate itself"
            },
            {
              "label": "It does",
              "text": "Scores the output 1 to 5 on accuracy, completeness, clarity, actionability and conciseness, citing evidence, such as test results, for every score below 5"
            },
            {
              "label": "You get",
              "text": "A scorecard with an overall average, one to three improvements ranked by impact, and a check on whether you'd agree with it"
            },
            {
              "label": "Then",
              "text": "Fixes gaps that take under 30 seconds, such as a missing link, and flags bigger ones with what a rerun would change"
            },
            {
              "label": "Unlike santa-method",
              "text": "That one has two independent reviewer subagents hold the output until both pass; here the agent grades its own work, as reflection rather than a gate"
            },
            {
              "label": "Optional",
              "text": "A Stop hook, described in its reference files, that reminds the agent to self-evaluate when a session ends"
            }
          ],
          "text": "This is a reflection step, not a pass/fail gate. The agent reads back your request, its final output, tool results such as tests and lint, and any corrections you made, then scores each of the five axes on its own rather than settling on an overall number first. Accuracy catches wrong facts or API names, completeness missed requirements, clarity confusing explanations, actionability vague steps, and conciseness filler. Any score below 5 has to show the gap, not just say \"could be better\". It judges only against what you asked for, not work you didn't request, doesn't re-argue design choices already made, and doesn't count personal taste as evidence. If every axis comes out at 5, it's told to look harder.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/agent-self-evaluation"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "self-improvement",
          "verification"
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "affaan-m/ecc/skills/intent-driven-development",
      "name": "intent-driven-development",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/intent-driven-development",
        "installs": 5100,
        "weeklyInstalls": [266, 161, 140, 232, 411, 404, 472, 441],
        "firstSeen": "2026-06-07"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Turns an ambiguous or risky change into scoped, testable acceptance criteria, asking only what the repository can't answer.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A change is ambiguous or risky, such as auth, data migrations or external APIs, and you want \"done\" defined before or while it's built"
            },
            {
              "label": "It does",
              "text": "Reads the repo first, asks only what it can't find there, then writes numbered acceptance criteria: scenario, trigger, expected result, what must not happen, how to verify"
            },
            {
              "label": "Two depths",
              "text": "A Quick Capture of 3–7 criteria for moderate risk, or a Full Acceptance Brief with a risk review, blocking decisions and a verification plan"
            },
            {
              "label": "Doesn't block",
              "text": "Clear changes go ahead with criteria noted; it waits for you only on decisions risking security, data loss, irreversible migrations, broken contracts or real cost"
            },
            {
              "label": "Keeps apart",
              "text": "Technical facts found in the code, and business rules such as pricing or retention policy, which stay assumptions until you confirm them"
            },
            {
              "label": "You get",
              "text": "The brief or criteria in chat; it saves a file, branches or commits only when you ask or your repo's workflow requires it"
            },
            {
              "label": "Unlike spec-driven-development",
              "text": "That one writes a spec file and waits for your approval before any code; this one writes nothing by default and pauses only for risky decisions"
            }
          ],
          "text": "The skill turns a vague or high-stakes request into acceptance criteria two people would agree on, and stays out of trivial edits, debugging and code review. Each criterion, AC-001 onward, has a starting condition, one action, an observable result, a side effect that must not happen, a verification method, such as an automated test, a manual accessibility check or a security review, and a priority. Words like \"correctly\", \"securely\" or \"fast\" need observable evidence or a note that a person must judge them. It covers only the boundaries that apply, from validation and authorization to migrations, concurrency and performance. Given a PRD or plan, it reviews it for missing scope, contradictions and untestable requirements instead of starting over. If a criterion proves impossible mid-build, it marks it [revised], states the constraint and shows you only what changed. It keeps secrets and production data out of criteria, and runs nothing destructive or paid without your authorization. The brief then goes to whatever planning or build workflow you use.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/intent-driven-development"
        },
        "tags": [
          "category:planning",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "requirements",
          "planning",
          "verification",
          "handoff"
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "affaan-m/ecc/skills/codehealth-mcp",
      "name": "codehealth-mcp",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/codehealth-mcp",
        "installs": 5000,
        "weeklyInstalls": [260, 161, 139, 228, 407, 398, 469, 440],
        "firstSeen": "2026-06-07"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Checks CodeScene's Code Health score of a file before and after each edit, and before commits and pull requests, so the agent never leaves code less maintainable than it found it.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want agent edits, especially large AI-written diffs or changes to legacy files, never to leave code harder to maintain"
            },
            {
              "label": "It does",
              "text": "Gets a file's Code Health score, 1 to 10, and its code smells from CodeScene before editing, rechecks after every change, and fixes any drop first"
            },
            {
              "label": "Gates",
              "text": "A pre-commit check that blocks commits lowering Code Health, and a check of the whole branch against main before a pull request"
            },
            {
              "label": "Scales edits",
              "text": "Low-scoring files get only minimal diffs; higher-scoring ones can be refactored, still rechecked after each edit"
            },
            {
              "label": "Needs",
              "text": "CodeScene's Code Health MCP server, run with npx, and a personal access token from a CodeScene account; its standalone mode needs no paid plan"
            },
            {
              "label": "If it's down",
              "text": "The agent says the check was skipped rather than inventing scores, and goes on only with your approval"
            },
            {
              "label": "Unlike coding-standards",
              "text": "That one sets naming and readability conventions; this one measures structure and complexity with a score and blocks regressions"
            }
          ],
          "text": "Code Health is CodeScene's 1–10 score of how maintainable a file's design is: 9 and up is healthy, below 4 is severe debt. The skill shows how to add CodeScene's MCP server to Claude Code or to one project, then limits the agent to the four tools that need no paid CodeScene account: a full review before touching a file, a quick score after each change, a pre-commit safeguard and a branch analysis before a PR. The agent records the baseline score and smells, plans the smallest change, and never calls a task done while the score is lower than when it started, even if tests pass. It includes a block to paste into AGENTS.md or CLAUDE.md that makes this loop the rule in every session, and it adds to ECC's verification-loop and tdd-workflow skills rather than replacing tests or lint. Its example takes a Flask module from 4.82 to 9.1. The tools analyze files and git state in your local repository.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/codehealth-mcp"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:mcp",
          "needs:account",
          "by:community",
          "stack:codescene",
