    {
      "id": "rebelytics/one-skill-to-rule-them-all",
      "name": "task-observer",
      "skills.sh": {
        "url": "https://skills.sh/rebelytics/one-skill-to-rule-them-all/task-observer",
        "installs": 18500,
        "weeklyInstalls": [636, 917, 1190, 1425, 1877, 1657, 1605, 1550],
        "firstSeen": "2026-02-18"
      },
      "skillMd": {
        "version": "046b8f2aa6bdae369a93ae563889b7cc449d17ad",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Logs corrections and repeated work as observation files in every session, then turns them into skill updates or new skills in a weekly review.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want your skills to improve from how you actually use them, and to spot work that repeats enough to become a skill"
            },
            {
              "label": "It does",
              "text": "Watches the whole session for your corrections, broken skill rules, better methods and repeating tasks, and writes each as its own Markdown file"
            },
            {
              "label": "You get",
              "text": "An observation log of Issue, Improvement and Principle entries, and in a weekly review, staged skill updates for you to install"
            },
            {
              "label": "Runs",
              "text": "From before the first tool call of every session to its end; a CLAUDE.md line or session-start hook makes sure it loads"
            },
            {
              "label": "Keeps",
              "text": "One file per observation in skill-observations/ under a stable workspace folder, with resolved ones moved to an archive"
            },
            {
              "label": "Also called",
              "text": "One Skill to Rule Them All"
            }
          ],
          "text": "Task Observer treats friction in real work as the raw material for better skills. Each session opens with a seven-item checklist, including finding the persistent workspace folder, scanning the log's headers, checking whether a review is due and, on a first run, offering to backfill observations from the project's history. During the work it logs whenever you correct the agent, the agent breaks a documented rule, a better method appears, or a task repeats enough to deserve a skill; one-off fixes are skipped. Each observation is one file whose YAML header names its status and target skill. It writes them at once, checks in after every third finished to-do, and flushes whenever work is handed over. A rule broken twice gets a proposed structural barrier, such as a hook or lint rule, never a rewording. At the end of a session it summarises what it logged. Changes wait for the review, offered weekly or started by a scheduled run, unless you name a skill to update; every edit goes to a staged copy you install yourself. It runs bundled bash scripts, so it needs its whole folder, not only SKILL.md. A subagent of an observed session writes nothing.",
          "permalink": "https://github.com/rebelytics/one-skill-to-rule-them-all/tree/046b8f2aa6bdae369a93ae563889b7cc449d17ad"
        },
        "tags": [
