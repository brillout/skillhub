    {
      "id": "anthropics/knowledge-work-plugins/engineering/skills/tech-debt",
      "name": "tech-debt",
      "skills.sh": {
        "url": "https://skills.sh/anthropics/knowledge-work-plugins/tech-debt",
        "installs": 6700,
        "weeklyInstalls": [115, 96, 79, 106, 109, 103, 84, 89],
        "firstSeen": "2026-02-24"
      },
      "skillMd": {
        "version": "ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Sorts technical debt into six kinds and ranks each item by impact, risk and effort into a phased plan to fix alongside feature work.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a tech debt audit, or to decide what to refactor first"
            },
            {
              "label": "It does",
              "text": "Sorts debt into code, architecture, test, dependency, documentation and infrastructure debt, and scores each item 1 to 5 on impact, risk and effort"
            },
            {
              "label": "Ranks by",
              "text": "(impact + risk) × (6 − effort), so cheap fixes of costly problems rise to the top"
            },
            {
              "label": "You get",
              "text": "A prioritized list with effort estimates and a business case per item, and a phased plan to do alongside feature work"
            },
            {
              "label": "Part of",
              "text": "The engineering plugin of Anthropic's knowledge-work plugins"
            }
          ],
          "text": "A short framework from the engineering plugin of Anthropic's knowledge-work plugins. It names six kinds of technical debt, each with examples and the risk it carries: code debt such as duplicated logic and magic numbers causes bugs and slows development; architecture debt such as a monolith that should be split limits scaling; test debt such as flaky tests lets regressions ship; dependency debt such as unmaintained libraries brings security holes; documentation debt such as missing runbooks makes onboarding painful; infrastructure debt such as manual deploys and no monitoring leads to incidents and slow recovery. Each item is scored from 1 to 5 on how much it slows the team, what happens if it isn't fixed, and how hard the fix is, then ranked by (impact + risk) × (6 − effort). The output is a prioritized list with estimated effort and a business justification for each item, plus a phased remediation plan meant to run alongside feature work. It gives no steps for finding debt in a codebase.",
          "permalink": "https://github.com/anthropics/knowledge-work-plugins/tree/ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d/engineering/skills/tech-debt"
        },
