      },
      "agentReview": {
        "description": "Holds UI code to an opinionated baseline of stack, animation, typography and design rules against AI slop, or reviews a file against it.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "An agent's UI code looks generic and you want firm rules for it, or a file checked against them"
            },
            {
              "label": "It does",
              "text": "Applies MUST, SHOULD and NEVER rules on stack, components, interaction, animation, typography, layout, performance and visual design"
            },
            {
              "label": "You get",
              "text": "UI work that follows the rules for the rest of the conversation, or a review quoting each violation with a suggested code-level fix"
            },
            {
              "label": "Assumes",
              "text": "Tailwind CSS defaults, motion/react, the cn helper and accessible primitives such as Base UI, React Aria or Radix"
            }
          ],
          "text": "Ibelick's baseline against AI slop, the generic look of model-written interfaces. A sample of its rules: no animation unless asked, only transform and opacity animated, and no more than 200ms for interaction feedback; h-dvh instead of h-screen, and safe-area insets for fixed elements; text-balance for headings, text-pretty for body text and tabular-nums for data; a fixed z-index scale; no gradients unless asked and never purple or multicolor ones, no glow as the main affordance, one accent color per view; an AlertDialog for destructive actions, errors shown next to the action, and paste never blocked; aria-label on icon-only buttons and no hand-built keyboard or focus behavior; no useEffect for what render logic can do. It uses the project's existing components and color tokens first. Called alone, it applies the rules to all UI work in the conversation; called with a file, it lists each violation with the exact line, one sentence on why it matters and a suggested code-level fix.",
          "permalink": "https://github.com/ibelick/ui-skills/tree/00db7d656719c399c091f3ea138c6f42a7fa4d98/skills/baseline-ui"
