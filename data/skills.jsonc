          "verification",
          "multi-agent",
          "agent-workflows"
        ],
        "note": "Built for Russian speakers: its stage names, dashboard labels and report template are in Russian, though its rules are in English.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
