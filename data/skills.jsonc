          "type:tool",
          "effect:local",
          "needs:cli",
          "by:official",
          "stack:semgrep",
          "security",
          "code-review"
        ],
        "note": "Needs the Semgrep CLI and uv; Semgrep Pro, if you have it, adds cross-file taint analysis. Results go to ./static_analysis_semgrep_N unless you name a folder.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "trailofbits/skills/plugins/differential-review/skills/differential-review",
      "name": "differential-review",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/differential-review",
        "installs": 10300,
        "weeklyInstalls": [246, 266, 295, 357, 488, 709, 594, 535],
        "firstSeen": "2026-01-19"
      },
      "skillMd": {
