    {
      "id": "paramchoudhary/resumeskills/skills/resume-section-builder",
      "name": "resume-section-builder",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/resume-section-builder",
        "installs": 9100,
        "weeklyInstalls": [364, 293, 306, 394, 412, 393, 370, 448],
        "firstSeen": "2026-05-20"
      },
      "skillMd": {
        "version": "74ae19e7c62b0516d1c298328e5544976c12da5d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Recommends which resume sections to include, in what order and format, for your career stage and role, and drafts a summary when one fits.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're unsure what goes in a resume section, or which sections a graduate, career changer or executive needs"
            },
            {
              "label": "It does",
              "text": "Picks a section order for your situation and sets what goes in the summary, skills, experience, education and extras such as projects or volunteering"
            },
            {
              "label": "You get",
              "text": "Section-by-section recommendations: the order with reasons, include or skip for each, a drafted summary and an organized skills list"
            },
            {
              "label": "Unlike resume-formatter",
              "text": "That one handles layout and fonts; this one decides what each section holds"
            }
          ],
          "text": "Section-by-section guidance for building a resume. A professional summary is recommended for career changers, senior people, those returning to work and specialists, skipped for entry-level or straightforward careers, and written as title, years, key skills and value, with sample summaries for each career stage. Skills can be a simple list, grouped by category or by proficiency, leaving out Microsoft Office, basic skills and soft skills. Experience gets three to six bullets for recent roles, depending on career stage, and two or three for older ones, with formats for several roles at one company, short tenures and freelance work. Education shrinks as a career grows: GPA and coursework for graduates, just degree and school for senior people, who may drop the year to avoid age discrimination. Projects, volunteering, languages, publications and awards each have a rule for when they belong. Section order differs for standard, technical, recent-graduate, executive and career-changer resumes.",
          "permalink": "https://github.com/paramchoudhary/resumeskills/tree/74ae19e7c62b0516d1c298328e5544976c12da5d/skills/resume-section-builder"
        },
