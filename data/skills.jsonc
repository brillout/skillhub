    {
      "id": "medusajs/medusa-agent-skills/plugins/ecommerce-storefront/skills/storefront-best-practices",
      "name": "storefront-best-practices",
      "skills.sh": {
        "url": "https://skills.sh/medusajs/medusa-agent-skills/storefront-best-practices",
        "installs": 5100,
        "weeklyInstalls": [110, 123, 120, 121, 144, 141, 160, 179],
        "firstSeen": "2026-01-30"
      },
      "skillMd": {
        "version": "42b9afd28b22ee6077d3c0ea8b5444a8c9bee1bc",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Guides building ecommerce storefronts, from product pages and cart to checkout, SEO and mobile, with framework-agnostic patterns and Medusa backend integration.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're building or changing an online store's frontend: product pages, listings, cart, checkout, navigation, search or account pages"
            },
            {
              "label": "It does",
              "text": "Loads the matching guides among 28 reference files, one per component, page or topic, with decision guides such as single-page versus multi-step checkout"
            },
            {
              "label": "Rules",
              "text": "Cart count announced to screen readers, 44px touch targets, Product JSON-LD, at most three checkout steps, and categories, prices and shipping options fetched, never hardcoded"
            },
            {
              "label": "Agent-friendly",
              "text": "Product name, price and stock in the server HTML, add to cart as a real form, and search at a /search?q= URL, so AI shopping agents can buy"
            },
            {
              "label": "Backend code",
              "text": "Before each SDK or API call, it looks up the exact method in the docs or an MCP server and tells you what it found"
            },
            {
              "label": "With Medusa",
              "text": "SDK setup, regions and pricing, such as showing Medusa prices as stored instead of dividing by 100, and Medusa's docs MCP server"
            },
            {
              "label": "Runs",
              "text": "On any storefront task: its description tells the agent to always load it"
            }
          ],
          "text": "Medusa's guide to building store frontends, for any backend and framework, with extra detail for Medusa's own. The SKILL.md routes to its reference files and lists the mistakes to avoid, and any plan the agent writes should name the file to load for each step. Before any UI it reads your existing colors, fonts, spacing and Tailwind version, and won't add new colors or fonts without asking. It separates what a store needs at launch (navbar with cart, listing with filters, product details with variants, cart, checkout, order confirmation) from nice-to-haves and from choices to ask you about, such as guest checkout or multiple currencies. Other rules: dynamic routes like /products/[handle] instead of a file per product, lazy-loaded images below the fold, no emojis in the UI, staying on the product page after add to cart, a real 404 for unknown products, and clearing the cart after an order. Agent-friendly means AI agents shopping for people, most of which don't run JavaScript, can read the store and act on it. Examples are React and TypeScript, with route patterns for Next.js, SvelteKit, TanStack Start and Remix.",
          "permalink": "https://github.com/medusajs/medusa-agent-skills/tree/42b9afd28b22ee6077d3c0ea8b5444a8c9bee1bc/plugins/ecommerce-storefront/skills/storefront-best-practices"
        },
