      "id": "paramchoudhary/resumeskills/skills/executive-resume-writer",
      "name": "executive-resume-writer",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/executive-resume-writer",
        "installs": 8900,
        "weeklyInstalls": [356, 282, 307, 376, 396, 376, 354, 439],
