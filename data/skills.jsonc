      "agentReview": {
        "description": "Explores a web app like a QA tester, catching console errors and screenshotting issues, then writes a bug report ranked by severity.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a web app explored for bugs, from one feature to the full site, starting from a URL"
            },
            {
              "label": "It does",
              "text": "Plans pages and flows, then clicks, fills forms, tabs and scrolls through each, logging console errors and screenshotting every issue"
            },
            {
              "label": "You get",
              "text": "A Markdown report in ./dogfood-output: summary by severity, each issue's steps to reproduce, expected and actual behavior and screenshot, and a table"
            },
            {
              "label": "Needs",
              "text": "Hermes Agent's browser_exec tool, which runs Python with browser helpers and raw DevTools Protocol calls"
