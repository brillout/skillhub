      },
      "skillMd": {
        "version": "e734d3ac3c0f4ea31cc2c2bbbe79e86e54f2cae6",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Implements a story, feature or bug fix end to end: plans it, codes it, has subagents review the diff, then commits locally.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You hand the agent a ticket, story, feature or bug fix and leave the edits to it"
            },
            {
              "label": "It does",
              "text": "Investigates the code, writes a plan file, implements it, has a reviewer subagent check the diff, fixes what's real and commits"
            },
            {
              "label": "Two routes",
              "text": "About 100 changed lines or fewer: built in the session; larger: you approve the plan, then a fresh subagent implements it"
            },
            {
              "label": "You get",
              "text": "A local commit, not pushed on its own, and a plan file with the intent and every review verdict; larger changes add a code map, tasks and acceptance criteria"
            },
            {
              "label": "Unlike bmad-build-auto",
              "text": "This one stops to ask you about gaps in the intent, a dirty working tree or a request with several goals"
            },
            {
              "label": "Needs",
              "text": "uv and BMad set up in the project: run the bmad skill's setup first; subagents for implementation and review"
            }
          ],
          "text": "BMad's build workflow takes a change from intent to a local commit. It starts from what you hand it: a ticket from BMad's ticket tree of initiative, epic and story files, a plan file to resume, or a plain description; given nothing, it picks the next ready ticket. It checks that the working tree is clean and the branch fits, and offers to split off extra independently shippable goals into deferred-work.md. It investigates the code, then writes a plan file. A change of about 100 lines or fewer gets a short plan and is built in the session. A larger one gets the intent, a code map of what to touch, reuse and leave alone, tasks, Given/When/Then acceptance criteria and verification commands; once you approve, a fresh subagent implements it from the plan alone. Then a reviewer subagent reads the diff; a thorough review runs four lenses instead. The agent checks each finding against the code, fixes simple ones this change caused, defers older problems and logs every verdict in the plan; on the larger route, a finding traced to the plan or the intent reverts the code and re-plans. It then commits and offers a pull request or bmad-walkthrough.",
          "permalink": "https://github.com/bmad-code-org/bmad-method/tree/e734d3ac3c0f4ea31cc2c2bbbe79e86e54f2cae6/skills/bmad-build"
        },
        "tags": [
          "category:engineering",
          "category:planning",
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:cli",
          "needs:subagents",
          "by:community",
          "implementation",
          "planning",
          "code-review",
          "scope-control",
          "agent-workflows"
        ],
        "note": "Needs uv and BMad set up in the project: it runs scripts from the _bmad/ folder that the bmad skill's setup creates.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "bmad-code-org/bmad-method/skills/bmad-code-review",
      "name": "bmad-code-review",
      "skills.sh": {
        "url": "https://skills.sh/bmad-code-org/bmad-method/bmad-code-review",
        "installs": 16100,
        "weeklyInstalls": [987, 1254, 2417, 2699, 1536, 1706, 1452, 1514],
        "firstSeen": "2026-03-14"
      },
      "skillMd": {
        "version": "e734d3ac3c0f4ea31cc2c2bbbe79e86e54f2cae6",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Reviews a code change with several independent reviewer subagents, verifies and triages their findings, then applies the fixes you choose.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a change reviewed: a PR, branch, commit range, or staged or uncommitted work"
            },
            {
              "label": "It does",
              "text": "Sends the diff to up to four reviewer subagents with different lenses, then checks every finding against the code before keeping it"
            },
            {
              "label": "You get",
              "text": "Findings sorted into decisions for you, patches and deferred items, with each rejected finding listed and why"
            },
            {
              "label": "Then",
              "text": "You apply every patch, walk through them one by one, or keep them as action items in the plan file"
            },
            {
              "label": "Modes",
              "text": "Thorough by default or quick with one reviewer; a no-code review edits nothing and writes a fix handoff for a coding agent"
            },
            {
              "label": "Needs",
              "text": "uv and BMad set up in the project: run the bmad skill's setup first; subagents for the reviewers"
            }
          ],
          "text": "BMad's code review finds what to review from your request, a ticket in review in BMad's ticket tree, or the current branch, writes the diff to a temp file, and collects the commit messages as the change's own claims. A thorough review launches its reviewers at once, each without the others' findings: a blind hunter that sees only the diff, an edge-case hunter, a verification-gap reviewer that looks for behavior no test checks, and, when an intent is available, an intent-alignment auditor that compares the diff with it. The agent then checks every finding at its file and line, grades the real ones high, medium or low, rejects false ones with the evidence, and merges findings with the same root cause. Each survivor becomes a decision for you, a patch, or a deferral for problems this change didn't cause, which also go to deferred-work.md. With a plan file, the findings are written into it. A non-interactive run, such as from CI or another workflow, applies the patches without asking.",
          "permalink": "https://github.com/bmad-code-org/bmad-method/tree/e734d3ac3c0f4ea31cc2c2bbbe79e86e54f2cae6/skills/bmad-code-review"
        },
        "tags": [
