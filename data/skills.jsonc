    {
      "id": "warpdotdev/common-skills/.agents/skills/pr-walkthrough",
      "name": "pr-walkthrough",
      "skills.sh": {
        "url": "https://skills.sh/warpdotdev/common-skills/pr-walkthrough",
        "installs": 28400,
        "weeklyInstalls": [643, 588, 930, 493, 370, 374, 116, 86],
        "firstSeen": "2026-05-14"
