    {
      "id": "samber/cc-skills/skills/technical-article-writer",
      "name": "technical-article-writer",
      "skills.sh": {
        "url": "https://skills.sh/samber/cc-skills/technical-article-writer",
        "installs": 5500,
        "weeklyInstalls": [47, 179, 399, 572, 727, 775, 637, 262],
        "firstSeen": "2026-03-24"
      },
      "skillMd": {
        "version": "50a33836b20f690c668af557bd9ef9d07a8c7ef2",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Turns a technical topic into a developer blog post: interview, ten titles, a hook and CTA from sibling skills, then the draft.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to write a tutorial, explainer, benchmark, bug hunt, postmortem or \"we rewrote it in X\" post for developers"
            },
            {
              "label": "It does",
              "text": "Interviews you, proposes 10 titles, gets the hook from copywriting-hooks, drafts the body, gets the CTA from copywriting-cta, then humanizes the draft"
            },
            {
              "label": "You get",
              "text": "A Markdown article with title, subtitle, body, end CTA, 1 to 3 image ideas with optional Midjourney prompts, and runner-up titles"
            },
            {
              "label": "Won't draft",
              "text": "Before you've confirmed the topic, one objective, the audience, content type, length and a one-sentence thesis"
            },
            {
              "label": "Unlike substack-ghostwriting",
              "text": "That one, from the same repo, writes Substack newsletter issues and posts; this one writes standalone blog, dev.to or Medium posts"
            }
          ],
          "text": "The interview asks the objective from ten options, from newsletter growth and authority to signups, leads, demos or none, and pushes back on picking several, since the objective is passed to the CTA step. Ideas are tested against Julia Evans's advice to write what you struggled with and Julian Shapiro's novelty filters: counter-intuitive, counter-narrative, shock and awe, elegant articulation, makes you feel seen. Titles are 7 to 12 words, specific rather than clever, without superlatives, ranked with a note on each. Around the chosen hook it writes the stakes and a promise, answering why trust you, why care and will it deliver. Body rules: one idea per section, show then tell, start simple, snippets under 20 lines with a before and after, steelman the other side, quantify claims. The conclusion gives an implication, an open question or a next step rather than a recap. A humanizer pass leaves the title and hook untouched, and titles are revisited once the draft exists. Templates for each content type live in a reference file.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2/skills/technical-article-writer"
        },
        "tags": [
          "category:writing",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "writing",
          "copywriting"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "samber/cc-skills/skills/copywriting-cta",
      "name": "copywriting-cta",
      "skills.sh": {
        "url": "https://skills.sh/samber/cc-skills/copywriting-cta",
        "installs": 5500,
        "weeklyInstalls": [56, 180, 389, 547, 692, 766, 616, 280],
        "firstSeen": "2026-05-20"
      },
      "skillMd": {
        "version": "50a33836b20f690c668af557bd9ef9d07a8c7ef2",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Interviews you on context, goal, audience and funnel stage, then prescribes an end-of-article CTA: copy, layout, mechanism, an A/B test plan and accessibility checks.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're deciding what goes at the bottom of a blog post, newsletter or essay to win subscribers, leads, customers or supporters"
            },
            {
              "label": "It does",
              "text": "Asks up to five tappable questions one at a time, maps the answers to one of 11 CTA archetypes, then writes the recommendation in a fixed format"
            },
            {
              "label": "You get",
              "text": "Exact headline, body and button copy, placement and visual weight, any persuasion lever such as urgency or social proof, A/B tests, accessibility checks and 2 to 3 traps"
            },
            {
              "label": "Pushes back",
              "text": "On several competing goals, and on asks that will fail, such as \"Book a Demo\" under a beginner tutorial"
            },
            {
              "label": "Not for",
              "text": "Hooks or titles, which go to copywriting-hooks, nor landing pages, ads or email copy"
            }
          ],
          "text": "Its premise is that a CTA follows from three inputs: the objective, the audience and their relationship with the author, and the context (an independent blog, a newsletter publication or a brand's content blog). The interview asks those plus the funnel stage, and a mechanism preference (urgency, scarcity, reciprocity, social proof) only when one could help; skeptical or repeat readers get a plain value statement by default. A decision tree maps the answers to archetypes such as an author-signature subscribe line, a specific reply prompt, a value-gap tease for paid newsletters, or a lead magnet for early-stage brand readers. The recommendation covers the copy, the form (placement, visual weight, layout, proof to put beside it), the mechanism, an A/B plan with a rough sample size or advice to skip testing at low traffic, and accessibility: contrast, touch target, markup, keyboard focus and color independence. Copy comes in the article's language. It then offers to show the hard-sell version it advises against, adapt the CTA per platform, or audit the rest of the article. One primary CTA per post is its main rule.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2/skills/copywriting-cta"
        },
        "tags": [
          "category:marketing",
