    {
      "id": "wshobson/agents/plugins/documentation-standards/skills/hads",
      "name": "hads",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/hads",
        "installs": 7000,
        "weeklyInstalls": [179, 211, 264, 205, 177, 174, 160, 150],
        "firstSeen": "2026-04-08"
      },
      "skillMd": {
        "version": "4bde3168b43c0655c4d00ea2726e631719908a6d",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Writes, converts and checks docs in HADS, a Markdown convention tagging each block as fact, context, bug or unverified for AI readers.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're writing technical docs that both people and AI models will read, or converting a README to that form"
            },
            {
              "label": "It does",
              "text": "Writes or converts docs in HADS (Human-AI Document Standard), checks a document against its rules, or reads one by its tags"
            },
            {
              "label": "You get",
              "text": "Plain Markdown with a version line, an \"AI reading instruction\" section, numbered sections and tagged blocks"
            },
            {
              "label": "Tags",
              "text": "[SPEC] terse facts, [NOTE] human context an AI may skip, [BUG] symptom, cause and fix, [?] unverified claims"
            },
            {
              "label": "No validator",
              "text": "The agent checks documents itself; a validator is planned but not included"
            }
          ],
          "text": "HADS 1.0.0 is a convention for Markdown documentation that needs no tooling. Every document starts with an H1 title, a bold version number in its first 20 lines, and a short manifest telling an AI model to read SPEC and BUG blocks, read NOTE only if needed and treat [?] with lower confidence. Tags are bold, on their own line, with the content right after and no nesting. SPEC blocks prefer bullets, tables and code, with at most two sentences of prose; anything longer moves to a NOTE. BUG blocks carry a symptom, cause and fix, optionally affected versions or a workaround. Reading a HADS document, the agent reads the manifest, then every SPEC and BUG block, and NOTE only when SPEC isn't enough; for large documents it scans the headings first. Converting existing docs moves facts to SPEC, history to NOTE and known issues to BUG without duplicating anything. Generated documents end with a changelog. Its design note says the manifest is the key idea: it lets even small models know what to skip.",
          "permalink": "https://github.com/wshobson/agents/tree/4bde3168b43c0655c4d00ea2726e631719908a6d/plugins/documentation-standards/skills/hads"
        },
        "tags": [
          "category:writing",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "docs-writing",
          "token-saving"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wshobson/agents/plugins/block-no-verify/skills/block-no-verify-hook",
      "name": "block-no-verify-hook",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/block-no-verify-hook",
        "installs": 7000,
        "weeklyInstalls": [178, 213, 268, 214, 175, 177, 163, 147],
        "firstSeen": "2026-04-08"
      },
      "skillMd": {
        "version": "4bde3168b43c0655c4d00ea2726e631719908a6d",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Adds a Claude Code hook that blocks git commands using --no-verify, --no-gpg-sign or -n, so agents can't skip pre-commit hooks or commit signing.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your project relies on pre-commit hooks or signed commits and you don't want an agent bypassing them"
            },
            {
              "label": "It does",
              "text": "Adds a PreToolUse hook on Bash that searches the command and rejects it with exit code 2 when it finds a bypass flag"
            },
            {
              "label": "You get",
              "text": "A hook entry in .claude/settings.json for the project, or ~/.claude/settings.json for all projects"
            },
            {
              "label": "Watch out",
              "text": "Its setup commands overwrite settings.json, so anything already in it is lost; if you have one, add the hook to it by hand instead"
            },
            {
              "label": "Catches",
              "text": "--no-verify, --no-gpg-sign and the shorter prefixes git accepts, plus -n after commit, even behind sudo or if"
            },
            {
              "label": "Unlike git-guardrails-claude-code",
              "text": "That one, Matt Pocock's, stops push, reset --hard and other destructive commands; this one blocks only flags that skip hooks or signing"
            }
          ],
          "text": "Agents sometimes reach for --no-verify when a pre-commit hook fails, letting unformatted, unlinted or untested code through. The hook is one shell command in settings: it reads the tool call's JSON from stdin, searches only its command field, and needs neither jq nor node. A false match, such as a commit message that mentions a flag, blocks the call, which it calls the safe way to fail. It says plainly what it can't stop: an agent set on evading it, by building the flag from pieces or pointing core.hooksPath at /dev/null. It shows how to extend the pattern, for example to block git --force, and how to run it alongside other PreToolUse hooks, such as one blocking rm -rf /. Its best practices: commit the settings file so the whole team gets the hook, mention it in onboarding, pair it with pre-commit hooks worth running, and test it with a deliberate --no-verify commit.",
          "permalink": "https://github.com/wshobson/agents/tree/4bde3168b43c0655c4d00ea2726e631719908a6d/plugins/block-no-verify/skills/block-no-verify-hook"
        },
        "tags": [
          "category:engineering",
          "category:security",
          "type:setup",
          "effect:local",
          "needs:claude-code",
          "by:community",
          "stack:git",
          "guardrails",
          "git"
        ],
        "note": "Its install commands write .claude/settings.json, or ~/.claude/settings.json for every project, with cat >, replacing any settings already in the file; merge the hook into an existing file by hand instead.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
