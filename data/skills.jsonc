      "agentReview": {
        "description": "Builds multi-component claude.ai HTML artifacts with React, Tailwind and shadcn/ui.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A claude.ai artifact, the interactive page Claude shows beside the chat, needs state, routing or shadcn/ui components"
