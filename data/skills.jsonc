          },
          {
            "id": "cursor/plugins/pstack/skills/principle-boundary-discipline",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "cursor/plugins/pstack/skills/principle-type-system-discipline",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "cursor/plugins/pstack/skills/principle-fix-root-causes",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "cursor/plugins/pstack/skills/principle-prove-it-works",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "cursor/plugins/pstack/skills/principle-guard-the-context-window",
            "standalone": true,
            "listedOutsideBundle": false
