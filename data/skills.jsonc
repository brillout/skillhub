      "name": "salary-negotiation-prep",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/salary-negotiation-prep",
        "installs": 9000,
        "weeklyInstalls": [366, 283, 305, 387, 407, 387, 365, 442],
