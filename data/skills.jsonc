    {
      "id": "AgriciDaniel/claude-seo/skills/seo-technical",
      "name": "seo-technical",
      "skills.sh": {
        "url": "https://skills.sh/agricidaniel/claude-seo/seo-technical",
        "installs": 8100,
        "weeklyInstalls": [271, 260, 250, 258, 278, 292, 375, 369],
        "firstSeen": "2026-02-19"
      },
      "skillMd": {
        "version": "734998e5fdbb16cd96dbaafe2da24eee6fb0d291",
        "updated": "2026-11-11",
        "skew": 189
      },
      "agentReview": {
        "description": "Audits a site's technical SEO across nine areas, from crawlability and indexing to Core Web Vitals and JavaScript rendering.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You suspect Google can't crawl, index or render your pages, or the site is slow"
            },
            {
              "label": "It does",
              "text": "Checks crawlability, indexability, security, URLs, mobile, Core Web Vitals, structured data, JavaScript rendering and IndexNow support"
            },
            {
              "label": "You get",
              "text": "A technical score out of 100 with pass, warn or fail per area, scoring only what it measured, and fixes by priority"
            },
            {
              "label": "Covers",
              "text": "Which AI crawlers to allow or block in robots.txt, and which bot governs training versus search citations"
            },
            {
              "label": "Unlike seo-audit",
              "text": "This one leaves content strategy and backlinks out"
            }
          ],
          "text": "Core Web Vitals are judged by LCP, INP and CLS, with INP replacing FID everywhere. To find content hidden from crawlers, it compares the words in the raw HTML with the rendered page, using the plugin's scripts, when Chromium is available. Among the rules it applies: Googlebot reads only the first 2 MB of HTML, rel=next/prev no longer counts, dynamic rendering is technical debt, and canonical and noindex tags must match between raw and rendered HTML. It flags back-button hijacking as a spam-policy violation and, from the normal response only, detects a server stack with a known critical CVE; it asks whether you own the site before requesting other paths and never sends exploit payloads. Agent readiness gets two signals here and is left to seo-agentic. With Google API keys it adds real PageSpeed and Chrome field data and per-URL indexing status; with DataForSEO, Lighthouse and on-page checks. Local or staging hosts are refused unless you list them in an environment variable.",
          "permalink": "https://github.com/AgriciDaniel/claude-seo/tree/6be93f45064ffbadced572b5d5c95f55fd263af0/skills/seo-technical"
        },
