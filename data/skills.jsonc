    {
      "id": "affaan-m/ecc/skills/strategic-compact",
      "name": "strategic-compact",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/strategic-compact",
        "installs": 6300,
        "weeklyInstalls": [298, 203, 176, 264, 462, 451, 519, 504],
