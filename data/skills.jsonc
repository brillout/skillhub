        "firstSeen": "2026-03-14"
      },
      "skillMd": {
        "version": "7de1ef7cc831f62d205dfa589063f3831f66391b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits your App Store listing's metadata for wasted, missing and unlocalized keywords, and finds keyword gaps against competitors with Astro MCP.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to check an App Store listing's name, subtitle, keywords and description for wasted or missing search terms"
            },
            {
              "label": "It does",
              "text": "Runs offline checks on your local metadata files, then, with Astro MCP, compares your keywords with competitors' and Astro's suggestions"
            },
            {
              "label": "You get",
              "text": "One report: field usage against character limits, findings by severity per locale, keyword gaps ranked by popularity, and prioritized recommendations"
            },
            {
              "label": "Changes",
              "text": "None of your metadata: Astro keyword tracking is added only if you separately allow it, and edits are left to asc's keyword commands"
            },
            {
              "label": "Needs",
              "text": "Metadata pulled with asc into ./metadata; Astro MCP with your app tracked is optional, for the gap analysis"
            }
          ],
          "text": "ASO, App Store Optimization, is search optimization for an app's store listing. The audit reads the latest version's metadata for each locale, with en-US as the primary unless you say otherwise. Its offline checks flag words from the subtitle or name repeated in the keyword field, which Apple already indexes; keyword fields under 90 of 100 characters and subtitles under 20 of 30; empty fields; spaces, semicolons or pipes between keywords; locales whose keywords match en-US exactly, a sign they weren't localized; and keywords missing from the description, which isn't indexed but affects downloads. It splits Chinese, Japanese and Korean text by punctuation or character rather than spaces, and matches Arabic words with and without the ال prefix. It can add Apple's generated app tags as context and, with Apple Ads credentials, asc's experimental read-only Apple search plan, which saves CSV and JSON files for review. With Astro, it pulls tracked keywords, rankings, competitor keywords and suggestions per store, diffs them against your metadata, and flags combinations across title, subtitle and keywords, such as one added word that completes a popular two-word search.",
          "permalink": "https://github.com/rorkai/app-store-connect-cli-skills/tree/7de1ef7cc831f62d205dfa589063f3831f66391b/skills/asc-aso-audit"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:none",
          "needs:cli",
          "needs:mcp",
          "by:official",
          "stack:app-store",
          "stack:astro",
          "seo",
          "mobile",
          "marketing",
          "stack:asc"
        ],
        "note": "Reads metadata in the layout that asc metadata pull writes to ./metadata, so it needs the asc CLI or files in that layout. The keyword gap analysis needs the Astro MCP server with your app tracked; the offline checks run without it.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
