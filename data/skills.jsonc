      "agentReview": {
        "description": "Works out how a competitor grew, as a dated log of its moves against its traffic from public evidence, compares it with your numbers and ends with plays to run.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to know how a competitor or another company grew, and which of its moves are worth copying"
            },
            {
              "label": "It does",
              "text": "Logs the company's dated moves, such as ad launches, pricing changes, new sections of its site and hires, against its monthly traffic, then measures which came before growth"
            },
            {
              "label": "You get",
              "text": "playbook.md in teardowns/<company>/: a timeline, funnel findings, a gap table against your numbers, its weak spots, and ranked plays with paste-ready prompts"
            },
            {
              "label": "Unlike competitor-profiling",
              "text": "That one describes what a company is today; this one reconstructs how it got there, in date order"
            },
            {
              "label": "Needs",
              "text": "Node for its bundled script, which covers the free sources; traffic, keyword and social-post data come from paid tools you connect, within a spending cap per teardown, $5 by default"
            },
            {
              "label": "Goes inside",
              "text": "Signs up, books a demo or buys from the company only with your approval for each step, under your real name"
            },
            {
              "label": "Modes",
              "text": "Full teardown, content only, a quick look, a funnel hack that buys through to map upsells, several competitors at once, or a monthly watch for new moves"
            }
          ],
          "text": "A teardown here is a history, not a profile. The agent asks for the company's domain, a window (24 months by default), your company, stage and channels, and which of your own data and paid tools are connected. It builds a monthly traffic curve from one source and a log of every dated move it finds. Its Node script supplies the free evidence: when ad pixels and price changes first appear in the Wayback Machine, sitemap growth, DNS records, subdomains, job posts and App Store reviews. One of 31 industry packs adds that industry's signals. The agent also reads the company's funnel, mines founders' interviews, and works out what the best posts on each social channel share. Moves within six weeks form a cluster; the script measures each cluster's lift in growth, and the skill treats timing as a lead, not proof. Every finding is labelled Observed, Inferred or Not found. Then it compares the company with your numbers, mines bad reviews for weak spots, and ranks plays, each routed to another skill of the repo, plus plays to skip and one to start this week. It pauses after every stage to report and quote costs.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/1f837447b20bb6f0e72d87b80ece1c221c362c7d/skills/reverse-engineer-marketing"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:remote",
          "needs:cli",
          "needs:account",
          "needs:browser",
          "by:community",
          "stack:dataforseo",
          "stack:scrapecreators",
          "research",
          "marketing",
          "seo",
          "social-media"
        ],
        "note": "Traffic, keyword and social-post data come from paid tools you connect, such as DataForSEO or ScrapeCreators, within a spending cap per teardown, $5 by default. It signs up, books demos or buys from the competitor only with your approval for each step, under your real name.",
        "model": "Claude Opus 5.5",
        "effort": null
      }
