      "id": "wshobson/agents/plugins/conductor/skills/track-management",
      "name": "track-management",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/track-management",
        "installs": 10700,
        "weeklyInstalls": [178, 207, 260, 204, 174, 173, 164, 147],
