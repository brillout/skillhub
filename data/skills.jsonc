          "effect:local",
          "needs:mcp",
          "needs:account",
          "by:community",
          "stack:firecrawl",
          "stack:dataforseo",
          "research",
          "scraping",
          "seo",
          "marketing"
        ],
        "note": "Built around the Firecrawl and DataForSEO MCP servers; with no SEO data source connected it leaves traffic, keyword and backlink metrics out.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
