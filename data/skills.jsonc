        "version": "7f8ae3435e5bc68a54efdca9f67797e905845562",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Hands a coding task to the OpenCode CLI on a model you approve, then reviews its diff, re-runs your checks and commits it.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want OpenCode to write the code for a task, or a queue of tasks, while your main agent stays the reviewer"
            },
            {
              "label": "It does",
              "text": "Writes a self-contained brief, runs OpenCode headless through a bundled relay script, then re-runs your project's checks and reads the diff against the brief"
            },
            {
              "label": "Picks the model",
              "text": "From the models you allow, ideally listed in AGENTS.md or CLAUDE.md; with no list it asks, so a per-token model can't surprise you with a bill"
            },
            {
              "label": "You get",
              "text": "Verified changes committed by your main agent, plus a result.json with OpenCode's report and the files it touched"
            },
            {
              "label": "Read-only runs",
              "text": "Use OpenCode's plan agent, which never gets auto-approval, for reviews and diagnosis"
            },
            {
              "label": "Needs",
              "text": "The opencode CLI with a model provider signed in, Node 18+ and git"
            }
          ],
          "text": "Your main agent is the orchestrator and OpenCode is the implementer. OpenCode has no default model, so each fresh run needs one: you decide which models are allowed, and the agent picks per task, a cheap fast one for a mechanical rename or removal, a strong one for a subtle bug or a payment path. The brief carries everything OpenCode needs, since it sees no chat history: the goal, what to change and leave alone, the project's real check commands and a report format, and it says not to commit. The bundled relay.mjs wraps opencode run with the write-capable build agent, passes --auto, which approves every permission request so a headless run never stalls (--no-auto keeps OpenCode's own rules), keeps its artifacts in a temp folder and blocks until done. The agent then re-runs the checks, reads the diff for scope creep or gaps, and commits only what holds; rework resumes the last OpenCode session with a delta brief. A fleet lane from the repo's delegate-setup skill can set the model and other options.",
          "permalink": "https://github.com/amelnagdy/delegate-skills/tree/7f8ae3435e5bc68a54efdca9f67797e905845562/skills/opencode-delegate"
        },
        "tags": [
          "category:agents",
          "category:engineering",
          "type:workflow",
          "effect:local",
          "needs:cli",
          "needs:account",
          "by:community",
          "stack:opencode",
          "stack:git",
          "multi-agent",
          "agent-workflows",
          "implementation",
          "code-review"
        ],
        "note": "Needs the OpenCode CLI with a signed-in model provider, Node 18+ and git. Write runs auto-approve every OpenCode permission by default; pass --no-auto to keep its own rules.",
        "model": "Claude Opus 5.5",
