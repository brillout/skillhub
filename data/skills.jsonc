    {
      "id": "addyosmani/web-quality-skills/skills/core-web-vitals",
      "name": "core-web-vitals",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/web-quality-skills/core-web-vitals",
        "installs": 35000,
        "weeklyInstalls": [1074, 1024, 1030, 1061, 1058, 1118, 1057, 1245],
        "firstSeen": "2026-01-20"
      },
      "skillMd": {
        "version": "afa8da942115f2961fdbfa80807ea0b232ff6c00",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Diagnoses and fixes slow loading, sluggish responses and layout shifts (LCP, INP, CLS) from real-user data and browser traces.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A page's Core Web Vitals fail: the main content appears late (LCP), clicks respond slowly (INP), or the layout jumps (CLS)"
            },
            {
              "label": "It does",
              "text": "Checks real-user Chrome data at the 75th percentile, records a browser trace, reads only the insights for the failing metric, fixes the code behind it and re-measures"
            },
            {
              "label": "You get",
              "text": "Fixes with lab before-and-after numbers; it won't claim a real-user improvement until new visits show one"
            },
            {
              "label": "Unlike performance",
              "text": "That one, its sibling, covers loading and runtime speed in general; this one targets these three metrics and their good, needs-work and poor thresholds"
            },
            {
              "label": "Install with",
              "text": "The repo's performance skill: it reads that skill's measurement workflow and real-user monitoring files"
            }
          ],
          "text": "LCP (Largest Contentful Paint) is when the biggest visible element renders, good at 2.5 seconds or less; INP (Interaction to Next Paint) is how fast the page responds to clicks, taps and key presses, good at 200 ms; CLS (Cumulative Layout Shift) measures unexpected jumps, good at 0.1. Each must be met by 75% of visits. With only source code, it names likely causes but won't call a metric failing without runtime evidence. For LCP it covers slow server response, render-blocking CSS, hero images discovered late, client-side rendering, and Speculation Rules prerendering of the likely next page, with its costs: each prerender is roughly a full page load and fires analytics early. LCP, INP and CLS each have a detailed reference file, read only when a trace or field data points to that metric. It adds quick fixes for Next.js, React and Vue/Nuxt, and recommends Google's web-vitals library over hand-written observers for production data.",
          "permalink": "https://github.com/addyosmani/web-quality-skills/tree/afa8da942115f2961fdbfa80807ea0b232ff6c00/skills/core-web-vitals"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "performance"
        ],
        "note": "Reads the measurement and real-user monitoring files in the performance skill's folder, so install the repo's performance skill with it.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
