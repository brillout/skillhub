    {
      "id": "affaan-m/ecc/skills/agent-architecture-audit",
      "name": "agent-architecture-audit",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/agent-architecture-audit",
        "installs": 6000,
        "weeklyInstalls": [277, 171, 172, 257, 426, 422, 496, 457],
