    {
      "id": "rohitg00/ai-engineering-from-scratch/skills/find-your-level",
      "name": "find-your-level",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/ai-engineering-from-scratch/find-your-level",
        "installs": 5300,
        "weeklyInstalls": [195, 275, 451, 385, 310, 326, 354, 316],
