      "agentReview": {
        "description": "Turns a project or website URL into a short launch video with its own soundtrack and share copy, using tools already installed.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a launch video for a project or a live site, made entirely by the agent"
