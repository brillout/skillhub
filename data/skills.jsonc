        "skew": 0
      },
      "agentReview": {
        "description": "Writes a news-first press release in inverted-pyramid form, after finding the angle and offering 5 to 10 headlines, with regional conventions and quality checks.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need to announce a launch, funding round, partnership, crisis, hire, event, acquisition or open-source milestone to the press"
            },
