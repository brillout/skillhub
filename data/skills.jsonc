          "agent-workflows"
        ],
        "note": "Uses Claude Code's Agent Teams tools TaskCreate, TaskUpdate, TaskList and SendMessage; the agent-teams plugin's README turns that experimental feature on with CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wshobson/agents/plugins/agent-teams/skills/multi-reviewer-patterns",
      "name": "multi-reviewer-patterns",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/multi-reviewer-patterns",
        "installs": 10200,
        "weeklyInstalls": [187, 211, 269, 212, 181, 187, 168, 155],
        "firstSeen": "2026-02-05"
      },
      "skillMd": {
        "version": "4bde3168b43c0655c4d00ea2726e631719908a6d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Splits a code review across reviewers by dimension, such as security or performance, then merges duplicate findings, calibrates severity and writes one report.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're organizing a review by several reviewer agents, or merging and ranking what they found"
            },
            {
              "label": "It does",
              "text": "Picks dimensions from security, performance, architecture, testing and accessibility to suit the change, then merges findings at the same file and line"
            },
            {
              "label": "You get",
              "text": "One Markdown report with findings grouped from Critical to Low, each with location, dimension, impact and fix, and a count per dimension"
            },
            {
              "label": "Unlike code-review-excellence",
              "text": "That one, from the same repo, guides a single reviewer through a PR; this one coordinates several and reconciles their findings"
            }
          ],
          "text": "Coordination rules for a review split among parallel reviewers. A table says when each dimension applies, such as security for anything touching user input or auth and accessibility for UI changes, and suggests combinations: security, performance and architecture for API changes, performance and architecture for a database migration. When findings meet, the same issue at the same file:line is merged with every reviewer credited, different issues at one spot stay separate but tagged co-located, the same issue elsewhere is cross-referenced, conflicting severities take the higher one, and conflicting recommendations are both kept with attribution. Severity runs from Critical (data loss, breach, near certain) to Low (cosmetic), with floors: security issues external users can exploit are at least High; hot-path performance issues, missing tests on critical paths and accessibility failures in core features at least Medium. The report template lists the target, reviewers, date and files, then each finding by severity with an ID such as CR-001, a summary table by dimension and an overall recommendation.",
          "permalink": "https://github.com/wshobson/agents/tree/4bde3168b43c0655c4d00ea2726e631719908a6d/plugins/agent-teams/skills/multi-reviewer-patterns"
        },
        "tags": [
