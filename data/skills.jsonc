      "skillMd": {
        "version": "797337f33f73e35d08d82f840e21c4b8c4932d88",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Scans your codebase for security vulnerabilities, tracing user input across files, and reports them by severity with proposed patches, applying none.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You ask \"is my code secure?\", or want a project or one folder audited for vulnerabilities, leaked secrets and risky dependencies"
            },
            {
              "label": "It does",
              "text": "Audits dependencies, scans every file for secrets, reasons through the code for injection, access control, data handling, crypto and logic flaws, then traces input across files"
            },
            {
              "label": "You get",
              "text": "A report led by counts per severity, findings grouped by category with file, line, confidence and plain-English risk, and patches for critical and high ones"
            },
            {
              "label": "Won't",
              "text": "Apply any patch: it says nothing has been changed yet"
            },
            {
              "label": "Covers",
              "text": "JavaScript, TypeScript, Python, Java, PHP, Go, Ruby and Rust, with bundled pattern guides and a watchlist of vulnerable packages"
            },
            {
              "label": "Unlike Sentry's security-review",
              "text": "That one reports only high-confidence exploitable findings; this one reports every severity down to info, each with a confidence rating"
            }
          ],
          "text": "Run as /security-review, optionally with a path, it scans that scope or the whole project in eight steps. It identifies the languages and frameworks from manifests such as package.json or go.mod and loads matching vulnerability patterns. It audits dependencies first against a curated CVE watchlist, then scans all files, including config, CI, Dockerfiles and infrastructure code, for hardcoded keys, committed .env files and credentials in connection strings, using regex and entropy patterns. The deep scan reasons about the code rather than matching patterns: SQL, command and other injection, XSS, missing authentication, IDOR, JWT and CSRF weaknesses, sensitive data in logs, path traversal, SSRF, weak cryptography and randomness, race conditions and missing rate limits. A cross-file pass follows user input from HTTP parameters and uploads to queries, exec calls and HTML output. It then re-reads each finding to drop false positives and sets a final severity, from critical to info. The report follows a bundled template, and every critical and high finding gets a before-and-after patch in your code's style, with a comment explaining the fix. If the code is clean, it says so and what it scanned.",
          "permalink": "https://github.com/github/awesome-copilot/tree/797337f33f73e35d08d82f840e21c4b8c4932d88/skills/security-review"
        },
        "tags": [
          "category:security",
          "category:debugging",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:official",
          "security",
          "code-review"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
