          "by:community",
          "verification",
          "scope-control",
          "agent-workflows",
          "multi-agent"
        ],
        "note": "Needs Node 16+. It runs a gate's command only after you approve it, and offers a Claude Code Stop hook, installed only with your consent, that blocks stopping while gates are unmet.",
        "model": "Claude Opus 5.5",
