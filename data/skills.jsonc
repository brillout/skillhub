      "agentReview": {
        "description": "Polishes, tightens or translates academic prose into Nature-style English while preserving facts, terminology and evidence boundaries.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have drafted manuscript prose that needs Nature-style English, translation from Chinese or tightening, not new content"
            },
            {
              "label": "It does",
              "text": "Detects paper type, section, language and journal, then edits structure, claims and sentences in that order"
