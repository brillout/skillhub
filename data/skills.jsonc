      "skillMd": {
        "version": "8a3bde8083bd121971f61cba4bdbe5fd8c0eee7d",
        "updated": "2026-11-10",
        "skew": 119
      },
      "agentReview": {
        "description": "Plans compliant SMS, MMS and WhatsApp marketing programs, from consent and carrier registration to flows like abandoned cart and win-back.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're starting or fixing text-message marketing, deciding between SMS and email, or need to get compliant in the US, EU or Canada"
            },
            {
              "label": "It does",
              "text": "Checks compliance first, then ranks which flows to build by return, such as abandoned cart, welcome, post-purchase and win-back"
            },
            {
              "label": "You get",
              "text": "An SMS plan: compliance blockers, flow designs with timing and copy with character counts, a platform pick, a measurement plan and STOP/HELP templates"
            },
            {
              "label": "Also covers",
              "text": "WhatsApp for audiences outside the US, with its 24-hour reply window and approved message templates"
            }
          ],
          "text": "Text-message marketing built on compliance. It explains US rules (written consent under the TCPA, honoring STOP within seconds, quiet hours, and registering business numbers with carriers through A2P 10DLC, without which messages are silently filtered) plus EU, UK and Canadian consent rules. It says when SMS beats email, such as cart recovery, shipping updates and flash sales, and when it doesn't, such as newsletters. It compares short codes, toll-free and regular numbers by list size, and sets principles: every send costs money, one link per message, the brand name in every text, and staying within 160 characters, since emojis cut a segment to 70. Flow templates give timing, such as a cart reminder 30 minutes after abandonment, with any discount saved for the second or third message. It compares platforms such as Klaviyo, Postscript, Attentive and Twilio, lists healthy benchmark ranges, and covers WhatsApp's reply window, templates, per-message pricing and its lack of US marketing delivery. It reads your product marketing context if you have it (a shared file on your product, audience and positioning that the repo's product-marketing skill writes).",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/sms"
        },
