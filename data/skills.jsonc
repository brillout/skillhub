      "id": "imbad0202/academic-research-skills/academic-paper",
      "name": "academic-paper",
      "skills.sh": {
        "url": "https://skills.sh/imbad0202/academic-research-skills/academic-paper",
        "installs": 11500,
        "weeklyInstalls": [280, 267, 248, 250, 314, 301, 250, 242],
