    {
      "id": "affaan-m/ecc/skills/recursive-decision-ledger",
      "name": "recursive-decision-ledger",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/recursive-decision-ledger",
        "installs": 5500,
        "weeklyInstalls": [260, 160, 146, 230, 408, 398, 467, 437],
        "firstSeen": "2026-05-25"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Reruns a search or decision many times, logging every trial, verdict and gate to an append-only ledger, so repetition never approves a live action.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You ask for repeated rollouts, recursive reasoning, stochastic or high-dimensional search, or ensemble comparisons and want a visible evidence trail"
            },
            {
              "label": "It does",
              "text": "Loads the prior ledger, adds fresh information, runs a bounded search, and marks each candidate accept, watch, reject, decay watch or needs replay"
            },
            {
              "label": "You get",
              "text": "An append-only JSONL ledger, a Markdown summary that leads with the decision, and a coherence mark comparing this run's winner with earlier ones"
            },
            {
              "label": "Won't",
              "text": "Treat recursive confidence as approval for trading, deploys, migrations or destructive actions; it defaults to paper, dry-run or read-only mode"
            }
          ],
          "text": "Some users try to force deeper computation by having the agent repeat the same search over and over, which the skill calls \"Prime Gauss\" style recursive prompting. It keeps the useful parts, repeated trials, memory of earlier runs, fresh information and explicit marks, and drops the pretence that the loop proves certainty. Each rollout, one pass of the search, records its id and time, the prior accepted winner and watchlist, new information, search-space size, methods used, trial counts, top candidates, decision marks, coherence against the prior ledger and the promotion gate result. Candidates are downgraded when drift, tail risk, stale data or a failed replay undoes an earlier mark, and artifacts are appended before anything is summarized. A candidate is promoted only when it beats the prior winner on the chosen metric, passes correctness and replay checks, has explicit risk limits and durable evidence, and, for a live step, has your approval.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/recursive-decision-ledger"
        },
        "tags": [
