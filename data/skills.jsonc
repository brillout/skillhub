          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "personal",
          "marketing"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wondelai/skills/lean-startup",
      "name": "lean-startup",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/lean-startup",
        "installs": 6200,
        "weeklyInstalls": [150, 160, 151, 162, 265, 223, 141, 148],
        "firstSeen": "2026-02-10"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Plans MVPs, experiments and pivot-or-persevere calls with Eric Ries's Lean Startup, testing the riskiest assumption first and measuring with actionable metrics.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Deciding what goes into a first version, testing a business idea cheaply, or weighing whether to pivot"
            },
            {
              "label": "It does",
              "text": "Ranks the assumptions that would sink the business, picks the smallest MVP that tests the riskiest, and swaps vanity metrics for conversion rates and cohorts"
            },
            {
              "label": "You get",
              "text": "A score out of 10 from five checks, with double credit when sign-ups, deposits or use back it, and the weakest check to fix next"
            },
            {
              "label": "Unlike mom-test",
              "text": "That one, from the same repo, covers customer conversations; this one tests ideas by what customers actually do"
            }
          ],
          "text": "Based on Eric Ries's The Lean Startup. It treats a plan as hypotheses to disprove and plans the Build-Measure-Learn loop backward: what to learn, how you'll know, then the least you can build to find out. A validation ladder ranks evidence from opinion through stated wants, sign-ups and deposits to active use, aiming for deposits or use before building at scale. MVP types include concierge (a manual service), Wizard of Oz (manual work behind a product that looks automated), smoke test (a landing page with no product), single feature and piecemeal (existing tools stitched together). Leap-of-faith assumptions about value, growth, retention and payment are tested riskiest first. Innovation accounting sets a baseline, tunes it with experiments, then decides whether to pivot or persevere, with ten kinds of pivot such as zoom-in and customer segment. It replaces vanity metrics like total sign-ups with conversion rates and cohorts, picks one of three engines of growth (sticky, viral or paid), and uses the Five Whys for root causes and small batches for faster feedback.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/lean-startup"
        },
