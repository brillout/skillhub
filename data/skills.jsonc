      "agentReview": {
        "description": "Critiques a design from a Figma link, screenshot or description on first impression, usability, hierarchy, consistency and accessibility, with prioritized fixes.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want feedback on a mockup, screen or flow, at any stage from early exploration to final polish"
            },
            {
              "label": "It checks",
              "text": "The two-second first impression, usability, visual hierarchy, consistency with your design system, and accessibility such as contrast and touch targets"
            },
            {
              "label": "You get",
