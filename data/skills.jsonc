      "agentReview": {
        "description": "Writes blameless postmortems — timeline, root-cause analysis, impact, lessons and tracked action items — and facilitates the review meeting.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're writing a postmortem after an incident, or running the review meeting"
            },
            {
              "label": "It does",
              "text": "Frames the review as blameless — what conditions allowed the failure, not who caused it — and gives templates and a 5 Whys structure"
            },
