          "marketing",
          "type:workflow"
        ],
        "note": "With Common Crawl alone it gives no score; free Moz, Bing Webmaster or Keywords Everywhere keys, or DataForSEO, make the profile scoreable.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
