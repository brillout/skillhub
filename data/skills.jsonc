    {
      "id": "bmad-code-org/bmad-method/skills/bmad-ux",
      "name": "bmad-ux",
      "skills.sh": {
        "url": "https://skills.sh/bmad-code-org/bmad-method/bmad-ux",
        "installs": 15300,
        "weeklyInstalls": [959, 1224, 2346, 2585, 1447, 1642, 1399, 1470],
        "firstSeen": "2026-05-23"
      },
      "skillMd": {
        "version": "a867e1604b365d48ea03cbd109da1066ba0c84bc",
        "updated": "2026-11-08",
        "skew": 6
      },
      "agentReview": {
        "description": "Captures your UX vision in two specs: DESIGN.md for how the product looks and EXPERIENCE.md for how it behaves.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're planning a product's look and behavior before building it"
            },
            {
              "label": "It does",
              "text": "Draws your vision out with questions instead of proposing its own, and can render color themes, design directions, wireframes and HTML mocks to pick from"
            },
            {
              "label": "You get",
              "text": "DESIGN.md, tokens and visual rules after Google Labs' DESIGN.md spec, and EXPERIENCE.md: screens, states, interactions, accessibility and key user journeys"
            },
            {
              "label": "Modes",
              "text": "Coaching, a fast draft with [ASSUMPTION] tags, or a prompt you run in an outside design tool"
            },
            {
              "label": "Also",
              "text": "Updates or validates existing specs; reviewer subagents run only if you opt in"
            },
            {
              "label": "Needs",
              "text": "uv and BMad set up in the project: run the bmad skill's setup first; subagents to distill the specs"
            }
          ],
          "text": "BMad's UX facilitator records your vision and never volunteers colors, patterns or directions unless you confirm a theme already in place. It reads the ticket for the work first, or lists the brief, PRD and other planning documents for you to confirm, then takes a brain dump and asks about stakes and form factor. Decisions go into a memlog, an append-only log the specs are distilled from at the end, and your Figma files, sketches or brand decks into an imports folder. You narrate journeys with a named protagonist rather than \"the user\", and the information architecture closes only when every stated need has a screen and every screen a journey. DESIGN.md holds tokens for colors, typography, spacing and components plus brand and style sections; EXPERIENCE.md holds information architecture, voice and tone, component behavior, states, interactions, an accessibility floor and key flows, citing DESIGN.md tokens by name. When the product uses a UI system such as shadcn or MUI, both inherit from it. At the end it renders key-screen mocks, asks which screens still need one, and keeps the chosen ones in mockups/ and wireframes/ folders.",
          "permalink": "https://github.com/bmad-code-org/bmad-method/tree/e734d3ac3c0f4ea31cc2c2bbbe79e86e54f2cae6/skills/bmad-ux"
        },
        "tags": [
          "category:design",
          "category:planning",
          "type:workflow",
          "effect:local",
          "needs:cli",
          "needs:subagents",
          "by:community",
