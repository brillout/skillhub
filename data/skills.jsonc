    {
      "id": "wshobson/agents/plugins/agent-teams/skills/team-communication-protocols",
      "name": "team-communication-protocols",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/team-communication-protocols",
        "installs": 10100,
        "weeklyInstalls": [186, 210, 265, 211, 179, 182, 164, 153],
        "firstSeen": "2026-02-05"
      },
      "skillMd": {
        "version": "4bde3168b43c0655c4d00ea2726e631719908a6d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Sets messaging rules for Claude Code agent teams: direct messages over broadcasts, plan approval by the lead, and graceful shutdown.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You've spawned a team of Claude Code agents and need them to coordinate, approve plans or shut down cleanly"
            },
            {
              "label": "It does",
              "text": "Picks the message type: a direct message by default, a broadcast only for critical changes to shared resources, a shutdown_request to end a teammate"
            },
            {
              "label": "You get",
              "text": "JSON examples of each message, plan approval and rejection replies, a shutdown sequence ending in TeamDelete, and where to find teammates' names"
            },
            {
              "label": "Avoid",
              "text": "Broadcasting routine updates, status reports as JSON messages, micromanaging, addressing teammates by ID and leaving idle ones without work"
            }
          ],
          "text": "The protocol side of Claude Code's Agent Teams. Direct messages carry task updates, questions and notices that an interface is ready; a broadcast costs one message per teammate, so it's kept for blockers and changes to shared files. A teammate spawned with plan_mode_required explores read-only, then ExitPlanMode sends the lead a plan_approval_request, which the lead approves or rejects with feedback. To end the team, the lead sends each teammate a shutdown_request; a teammate approves and exits, or rejects with a reason, in which case the lead waits and retries, and TeamDelete runs once all are gone. Teammates are listed in ~/.claude/teams/{team-name}/config.json and always addressed by name, never by agent ID. Troubleshooting covers silent teammates (idle or mid-task), a missing SendMessage tool (agents with a restricted tool list must name the team tools), leads that broadcast every update, rejected shutdowns, plan requests without a request_id and two teammates deadlocked waiting on each other. It points to team-composition-patterns and parallel-feature-development.",
          "permalink": "https://github.com/wshobson/agents/tree/4bde3168b43c0655c4d00ea2726e631719908a6d/plugins/agent-teams/skills/team-communication-protocols"
        },
        "tags": [
