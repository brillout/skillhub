    {
      "id": "coreyhaines31/marketingskills/skills/offers",
      "name": "offers",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/offers",
        "installs": 67900,
        "weeklyInstalls": [2637, 2519, 2910, 3203, 3421, 3686, 4287, 3943],
        "firstSeen": "2026-06-17"
      },
      "skillMd": {
        "version": "8a3bde8083bd121971f61cba4bdbe5fd8c0eee7d",
        "updated": "2026-11-10",
        "skew": 128
      },
      "agentReview": {
        "description": "Designs or improves the offer behind a sale (deliverable, bonuses, guarantee, urgency, name and payment terms) using Hormozi's value equation.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your offer isn't converting, or you're packaging a service, course, coaching or high-ticket product"
            },
            {
              "label": "It does",
              "text": "Scores your offer on the four levers of the value equation, finds the weakest of six parts, and redrafts one part per round"
            },
            {
              "label": "You get",
              "text": "A reworked bonus, guarantee, deadline, name or payment plan, with an honest estimate of the lift to confirm by test"
            },
            {
              "label": "Unlike pricing",
              "text": "That one, from the same repo, sets tiers and price levels; this one improves what's included and how it's framed; self-serve SaaS should start with pricing"
            },
            {
              "label": "Won't",
              "text": "Use fake scarcity, inflated \"worth $X\" bonuses or over-promising guarantees"
            }
          ],
          "text": "Offer design for services, courses, coaching, info products, high-ticket B2B and direct response. Its premise is that a stronger offer with average copy beats better copy on a weak offer. The value equation, from Alex Hormozi's $100M Offers, rates value as the dream outcome times the buyer's belief they'll get it, divided by the wait and the effort it takes; most requests to lower a price are really requests to raise the top or shrink the bottom. A complete offer has six parts: the core deliverable, a bonus stack, a guarantee, scarcity or urgency, a name, and price with payment terms. Its diagnostic loop states the current offer plainly, scores each lever from 1 to 10, audits the six parts, changes only the weakest, and projects a 10 to 40% lift per change, multiplied rather than added. It bans words such as \"game-changing\" and unconditional \"100% guaranteed\", and advises against discounting to win new customers. References cover each part, formats by business type, SaaS offers and worked examples. It reads your product marketing context if you have it (a shared file on your product, audience and positioning that the repo's product-marketing skill writes).",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/offers"
        },
        "tags": [
          "category:marketing",
