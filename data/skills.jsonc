    {
      "id": "samber/cc-skills/skills/skill-progressive-disclosure-design",
      "name": "skill-progressive-disclosure-design",
      "skills.sh": {
        "url": "https://skills.sh/samber/cc-skills/skill-progressive-disclosure-design",
        "installs": 5100,
        "weeklyInstalls": [56, 156, 353, 528, 678, 726, 583, 241],
        "firstSeen": "2026-05-02"
      },
      "skillMd": {
        "version": "50a33836b20f690c668af557bd9ef9d07a8c7ef2",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Decides whether and how to split a skill between SKILL.md and reference files, weighing each option and measuring the split with evals.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're writing or refactoring a skill and unsure what belongs in SKILL.md, references/ or scripts/, or a SKILL.md passes 300 to 400 lines"
            },
            {
              "label": "It does",
              "text": "Separates triggering (the description) from disclosure (what loads later), defaults to not splitting, and weighs the pros and cons of each split"
            },
            {
              "label": "You get",
              "text": "Advice on your skill: a diagnosis, the content quoted, the smallest split and the exact pointer sentence for each new reference file"
            },
            {
              "label": "Measures",
              "text": "With architecture evals that record which reference files load, how often, and whether the output uses them"
            }
          ],
          "text": "Triggering depends only on the frontmatter description, it says, so splitting files never fixes a skill that doesn't fire; that needs a better description, with skill-creator's run_loop.py. One SKILL.md wins until it passes about 400 lines with natural branches, transcripts show wasted context, or large content is needed only in narrow cases. Three splits work: one reference per variant, such as a cloud or framework; the procedure in SKILL.md with lookup data in references; and the common path in SKILL.md with edge cases behind a sharp trigger. Four don't: topic splits that real tasks cross, splits made to hit a line count, critical content moved where it may be skipped, and cosmetic Examples or Tips files. A pointer names the signal that loads its file, in one sentence, with the condition in the filename. Deterministic work belongs in scripts. A five-question checklist ends on load rate: under 20% inline it, 20 to 80% keep it split, over 80% move it into SKILL.md. For evals, subagents run queries covering every path and record loads, tokens and time, and a decision table turns the rates into actions.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2/skills/skill-progressive-disclosure-design"
        },
