      "agentReview": {
        "description": "Applies prompts from the FLOW SEO framework to your URL or topic, one stage at a time: find, leverage, optimize, win or local.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want ready-written, structured AI prompts for the SEO task in front of you instead of improvising one"
            },
            {
              "label": "It does",
              "text": "Loads the FLOW overview, then only the prompts for the stage you name, and applies them to your URL or topic"
            },
            {
              "label": "FLOW means",
              "text": "The loop Find, Leverage, Optimize, Win: keyword research and gaps, backlinks and off-site authority, on-page, technical and content fixes, then bottom-of-funnel conversion"
            },
            {
              "label": "Stages",
              "text": "Find: 5 prompts for keywords and gaps; leverage: 1 for backlinks; optimize: 21, of which it picks 2-3; win: 3 for conversion; local: 11"
