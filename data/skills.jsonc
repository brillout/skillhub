    {
      "id": "github/awesome-copilot/skills/terraform-azurerm-set-diff-analyzer",
      "name": "terraform-azurerm-set-diff-analyzer",
      "skills.sh": {
        "url": "https://skills.sh/github/awesome-copilot/terraform-azurerm-set-diff-analyzer",
        "installs": 8900,
        "weeklyInstalls": [10, 12, 15, 7, 8, 2, 4, 2],
        "firstSeen": "2026-02-02"
      },
      "skillMd": {
