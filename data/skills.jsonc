    {
      "id": "anthropics/knowledge-work-plugins/product-management/skills/product-brainstorming",
      "name": "product-brainstorming",
      "skills.sh": {
        "url": "https://skills.sh/anthropics/knowledge-work-plugins/product-brainstorming",
        "installs": 6000,
        "weeklyInstalls": [143, 115, 83, 103, 116, 145, 127, 121],
        "firstSeen": "2026-03-18"
      },
      "skillMd": {
        "version": "ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Acts as a sharp product sparring partner that explores problems, generates solutions, stress-tests assumptions and pushes back before you commit to a direction.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're exploring a product problem or idea and want someone to think it through with you before writing a spec"
            },
            {
              "label": "It does",
              "text": "Asks hard questions, generates five to seven options before judging any, names the riskiest assumption and the cheapest test for it, and argues back"
            },
            {
              "label": "Modes",
              "text": "Problem exploration, solution ideation, assumption testing and strategy exploration, switching as the conversation moves"
            },
            {
              "label": "You get",
              "text": "A conversation rather than a deliverable, ending with the top ideas, assumptions to test, questions to research, next steps and what was set aside"
            },
            {
              "label": "Frameworks",
              "text": "How Might We, jobs to be done, opportunity solution trees, first principles, SCAMPER, OODA and reverse brainstorming, pulled in only when they help"
            },
            {
              "label": "Part of",
              "text": "The product-management plugin of Anthropic's knowledge-work plugins"
            }
          ],
          "text": "A thinking partner for product managers, written as an experienced PM or design lead who is opinionated, pushes back and brings unexpected angles. It picks one of four modes and shifts between them. Problem exploration asks who has the problem and what they do about it today, and digs from symptoms to root causes. Solution ideation produces at least five to seven distinct approaches before judging any, including one that does the opposite and one that removes something. Assumption testing lists every assumption, finds the one that would kill the idea, and suggests the cheapest way to test it. Strategy exploration weighs bets, second-order effects, competitor responses and timeframes. A session moves through framing, diverging, provoking, converging on the top two or three ideas, and capturing what came out. It names common traps, such as solutioning before framing, copying a competitor's feature, or brainstorming a question that needs research, and avoids dumping frameworks, handing over a list or agreeing with everything.",
          "permalink": "https://github.com/anthropics/knowledge-work-plugins/tree/ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d/product-management/skills/product-brainstorming"
        },
        "tags": [
          "category:planning",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:official",
          "planning",
          "interview"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
