      "id": "cloudflare/security-audit-skill/skills/security-audit",
      "name": "security-audit",
      "skills.sh": {
        "url": "https://skills.sh/cloudflare/security-audit-skill/security-audit",
        "installs": 104395,
        "weeklyInstalls": [7354, 4990, 3766, 7657, 7535, 16762, 19665, 19134],
