      "agentReview": {
        "description": "Scores a CLI printed by the Printing Press against its Steinberger quality bar, or compares two CLIs side by side.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a printed CLI's score again after changes, or to compare two versions of a CLI"
            },
            {
              "label": "It does",
              "text": "Runs the press's scorecard on a CLI found by name, by path or from your current run, with its OpenAPI spec when it finds one"
            },
            {
              "label": "You get",
              "text": "Tables of 18 dimension scores in two tiers, a total out of 100 with a letter grade and the gaps; compare mode adds a delta column"
