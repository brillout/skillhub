      "agentReview": {
        "description": "Guides marketing video production: picks programmatic, AI-generated, avatar or editing tools and lays out workflows for demos, explainers and batches of social clips.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a product demo, explainer, social clip or ad video and aren't sure which tools to use"
            },
