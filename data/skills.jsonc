      "skillMd": {
        "version": "50a33836b20f690c668af557bd9ef9d07a8c7ef2",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Walks a website through a pre-launch audit with dig and curl checks, from DNS, backups and security headers to SEO, Lighthouse and directory submissions.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're about to put a site or web app live, or migrate one, and want a full checklist run against it"
            },
            {
              "label": "It does",
              "text": "Asks six setup questions, runs a launch-readiness gate, then walks each phase, running a check per item and asking whether to fix failures now or later"
            },
            {
              "label": "You get",
              "text": "A pass/fail report by phase, then lists of blockers, recommended fixes and optional improvements"
            },
            {
              "label": "Opinionated for",
              "text": "Cloudflare DNS, Vercel hosting, PostHog analytics, Google Workspace mail and French CNIL rules"
            },
            {
              "label": "Pulls in",
              "text": "A subset of six outside skill packs, such as claude-seo and web-quality-skills, installed only after you confirm"
            },
            {
              "label": "Needs",
              "text": "Dig, curl, jq and npx; for browser checks, the Claude Chrome extension or Playwright, or you skip them"
            }
          ],
          "text": "It first asks whether the product is simple, lovable and complete, and whether it's ready for directories: public, priced, with legal pages, assets and comparison pages. The phases then cover domain and hosting (proxy, TLS, SPF, DKIM and DMARC, CAA, DNSSEC, redirects, error pages) and backups with a restore drill; analytics, from GA4 behind consent to Search Console, Bing, Ahrefs, Google Alerts and F5bot, plus competitor analysis; French legal pages and a cookie banner that really blocks trackers; security headers at a CSP strictness you choose; SEO and GEO (getting cited in AI answers), with robots.txt and an AI-crawler policy, sitemaps, llms.txt, schema, hreflang, keyword research and alternative pages; Open Graph, favicons and the manifest; Lighthouse at 90 or more on mobile, Core Web Vitals and WCAG 2.2 AA; links from your other sites; an optional weekly SEO agent; directory submissions across 13 tiers; Product Hunt; G2 and Capterra reviews; and post-launch announcements. Marketing copy gets a TONE.md and a humanizer pass in the site's language. It asks at every decision point.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2/skills/site-launch-checklist"
        },
        "tags": [
          "category:cloud",
          "category:marketing",
          "type:workflow",
          "effect:remote",
          "needs:cli",
          "needs:browser",
          "needs:account",
          "by:community",
          "stack:cloudflare",
          "stack:vercel",
          "stack:posthog",
          "deployment",
          "seo",
          "security",
