    {
      "id": "cursor/plugins/pstack/skills/principle-subtract-before-you-add",
      "name": "principle-subtract-before-you-add",
      "skills.sh": {
        "url": "https://skills.sh/cursor/plugins/principle-subtract-before-you-add",
        "installs": 5100,
        "weeklyInstalls": [292, 318, 396, 326, 406, 474, 363, 307],
        "firstSeen": "2026-05-24"
      },
      "skillMd": {
        "version": "a5539b15a3d56e04992565aafee2b37051329ce3",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Has the agent remove dead code, speculative guards and redundant instructions before building anything new.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Planning the order of an addition, refactor or rewrite"
            },
            {
              "label": "It does",
              "text": "Removes dead code, redundant validators and stub references first, then builds on the simpler base"
            },
            {
              "label": "Aims for",
              "text": "A design left slightly simpler and more capable, behind the same or a smaller surface than before"
            },
            {
              "label": "Runs",
              "text": "Only when you call it"
            }
          ],
          "text": "One of pstack's principle skills, in Cursor's plugin repo. Subtraction is the default and a continual investment. It cuts to the minimum before polishing, designs for observed usage rather than imagined edge cases, adds no validators, parsers or guards beyond what the spec demands, trims prompts of redundant instructions and heavy templates, and deletes a reference with nothing new in it rather than leaving a stub.",
          "permalink": "https://github.com/cursor/plugins/tree/a5539b15a3d56e04992565aafee2b37051329ce3/pstack/skills/principle-subtract-before-you-add"
        },
        "tags": [
          "category:engineering",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "refactoring",
          "code-quality",
          "scope-control"
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "iart-ai/motion-design-skills/skills/motion-art-direction",
      "name": "motion-art-direction",
      "skills.sh": {
        "url": "https://skills.sh/iart-ai/motion-design-skills/motion-art-direction",
        "installs": 5300,
        "weeklyInstalls": [142, 196, 378, 433, 581, 712, 715, 726],
        "firstSeen": "2026-06-23"
      },
      "skillMd": {
        "version": "b85e50c4cef5ff17aa2187a10d49d2dae9226c74",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Sets the motion language of a motion graphics piece before anything is animated: tone and energy, one easing and timing scale, what moves and what stays still, checked shot by shot.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Starting a motion graphics piece, such as an explainer, launch film, UI demo or data story, or when its motion feels busy or inconsistent"
            },
            {
              "label": "It does",
              "text": "Turns a brief into one motion language before anything is animated, ranks what moves, decides what stays still, and checks every shot against it"
            },
            {
              "label": "You get",
              "text": "A written direction: a one-line intent, a filled motion-language spec, a ranked list of what moves, what stays still, notes per shot and a pass or fail per shot"
            },
            {
              "label": "Motion language",
              "text": "A short spec of single choices every shot obeys: one easing family, timing unit, transition family, stagger rhythm, motion intensity and minimum rest"
            },
            {
              "label": "Unlike motion-design",
              "text": "LottieFiles' skill applies the same four motion personalities to UI animation code; this one directs a whole piece before anyone animates, with intent per shot, not keyframes"
            },
            {
              "label": "Works with",
              "text": "Technique skills for GSAP, Lottie, shaders or three.js, which carry out the rules it sets"
            }
          ],
          "text": "From iart.ai's motion design collection. It places the piece on a tone matrix, calm or kinetic against soft or sharp, and commits to one cell, since mixing cells is the most common cause of inconsistent motion. Each cell maps to a named personality with durations, an easing curve and an overshoot budget: Playful, Premium, Corporate or Energetic. Two easing curves at most: one for entrances, one for exits. Every element is ranked hero, support or texture, and each frame gets exactly one hero. A restraint pass holds still anything whose motion carries no meaning: no animating the whole frame at once, no looping text the viewer is still reading, no overshoot on financial content, and one \"wow\" moment per piece. Pacing is mapped across the timeline before single moves are timed, usually a calm open, a build, a peak and a settled end card, with key moments on the audio. The final check audits every shot against the spec; any miss is a direction defect to fix before polishing. A reference file holds filled specs for five tone cells, brief and shot-note templates, brand-to-motion tables and a pre-render checklist.",
          "permalink": "https://github.com/iart-ai/motion-design-skills/tree/b85e50c4cef5ff17aa2187a10d49d2dae9226c74/skills/motion-art-direction"
        },
