          "by:official",
          "skill-authoring"
        ],
        "note": "Built for OpenClaw: live skills are drafted with OpenClaw's skill_workshop tool, and its validator rejects frontmatter keys OpenClaw doesn't support.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
