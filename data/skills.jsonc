          "computer-use"
        ],
        "note": "Needs Orca, Stably's desktop app for running coding agents in parallel, on a Mac with the Xcode Command Line Tools.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "stablyai/orca/skills/orca-emulator-android",
      "name": "orca-emulator-android",
