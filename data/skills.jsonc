      }
    },
    {
      "id": "julianoczkowski/designer-skills/design-review",
      "name": "design-review",
      "skills.sh": {
        "url": "https://skills.sh/julianoczkowski/designer-skills/design-review",
        "installs": 6000,
        "weeklyInstalls": [134, 116, 75, 62, 80, 59, 79, 67],
        "firstSeen": "2026-03-28"
      },
      "skillMd": {
        "version": "c259656c76d9758d7ead46b0d2f125cbe84f8665",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Critiques a built interface against its design brief, from screenshots at three widths and the code, and saves a prioritized fix list.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You've built a page or component and want it checked against the brief before shipping"
            },
            {
              "label": "It does",
              "text": "Reads the brief, inspects the new code for hardcoded values and duplicate components, and screenshots the running app at 375, 768 and 1280px"
            },
            {
              "label": "You get",
              "text": "DESIGN_REVIEW.md with must fix, should fix and could improve items, each tied to files and screenshots, plus what works well"
            },
            {
              "label": "Needs",
              "text": "Playwright MCP or Cursor's built-in browser for screenshots; without either it asks you for them and waits"
            },
            {
              "label": "Checks",
              "text": "Hierarchy, consistency, fidelity to the named aesthetic, component reuse, states, responsiveness, accessibility, typography, dark mode and mobile-first rules"
            }
          ],
          "text": "The review step of Julian Oczkowski's designer workflow, which runs only once something is built. It looks for the feature's brief in .design/, falls back to a DESIGN_BRIEF.md at the project root, and asks for the intended direction if there's none. It examines every new or changed component for token use, duplicates and file conventions. Screenshots are mandatory: it asks for the app's URL if it can't tell, captures full pages at mobile, tablet and desktop widths, hover, focus, open, error, loading and empty states, dark mode and single components, and saves them under .design/<feature>/screenshots/ with descriptive names. It compares each screenshot with the brief and notes what reading code misses, such as fonts failing to load, overflow or z-index problems. Accessibility checks include WCAG AA contrast (4.5:1 for body text), keyboard reach, visible focus, semantic HTML, alt text and a reduced-motion query. Findings name exact components, files, line numbers and screenshot files, and the review is saved next to the brief.",
          "permalink": "https://github.com/julianoczkowski/designer-skills/tree/c259656c76d9758d7ead46b0d2f125cbe84f8665/design-review"
        },
        "tags": [
          "category:design",
