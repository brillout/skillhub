    {
      "id": "affaan-m/ecc/skills/ai-first-engineering",
      "name": "ai-first-engineering",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/ai-first-engineering",
        "installs": 5800,
        "weeklyInstalls": [262, 160, 138, 237, 411, 403, 473, 446],
