    {
      "id": "wondelai/skills/design-everyday-things",
      "name": "design-everyday-things",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/design-everyday-things",
        "installs": 6100,
        "weeklyInstalls": [163, 162, 145, 158, 283, 236, 158, 160],
        "firstSeen": "2026-02-10"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Finds why a product confuses people with Don Norman's The Design of Everyday Things: affordances, signifiers, mappings, constraints, feedback and mental models.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Users keep making mistakes, can't find a feature, or say the product is unintuitive"
            },
            {
              "label": "It does",
              "text": "Checks whether users can see what to do, tell what happened and recover from errors, walking an interaction through Norman's seven stages of action"
            },
            {
              "label": "You get",
              "text": "Design fixes and a score out of 10 from five checks"
            },
            {
              "label": "Unlike ux-heuristics",
              "text": "That one, from the same repo, audits usability against Nielsen's heuristics; this one teaches the underlying principles, for physical products as well as software"
            }
          ],
          "text": "Based on Don Norman's The Design of Everyday Things. Its premise is that when people struggle, the design is at fault, not the user. Every interaction crosses two gulfs: execution (how do I do what I want?) and evaluation (what happened?). Seven principles narrow them: discoverability; affordances, what an object can be used for, which only help when people perceive them; signifiers that show where to act; natural mappings between controls and their effects; constraints that make wrong actions impossible; feedback within 0.1 seconds; and conceptual models, so the user's idea of how it works matches the designer's. It splits errors into slips, the right goal with the wrong action, and mistakes, the wrong goal, each with design fixes, plus a checklist for error messages that say what went wrong and how to fix it without blaming the user. Norman's seven stages of action, from forming a goal to comparing the result, locate where users get stuck. A human-centered loop of observing, generating ideas, prototyping and testing with about five real users closes it.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/design-everyday-things"
        },
        "tags": [
          "category:design",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "design"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wondelai/skills/made-to-stick",
      "name": "made-to-stick",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/made-to-stick",
        "installs": 6000,
        "weeklyInstalls": [148, 163, 143, 165, 303, 261, 182, 178],
        "firstSeen": "2026-02-10"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Makes pitches, taglines and messages memorable with Chip and Dan Heath's SUCCESs traits: simple, unexpected, concrete, credible, emotional, stories.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Nobody remembers your pitch, a tagline or value proposition falls flat, or a product explanation is too complex"
            },
            {
              "label": "It does",
              "text": "Rates a message on six traits, simple, unexpected, concrete, credible, emotional and told as a story, then fixes the weakest first"
            },
            {
              "label": "You get",
              "text": "A score out of 10 and fixes for the lowest-rated traits, with examples for landing pages, demos and onboarding"
            },
            {
              "label": "Unlike storybrand-messaging",
              "text": "That one, from the same repo, gives brand copy one story structure; this one works on any message, from pitches to presentations"
            }
          ],
          "text": "Based on Chip and Dan Heath's Made to Stick. Its premise is that the curse of knowledge, being unable to imagine not knowing what you know, is the biggest barrier to being understood. Six traits make ideas stick, though not every message needs all of them. Simple means finding the one core idea, the commander's intent, and leading with it. Unexpected means breaking a pattern and opening a curiosity gap tied to that core. Concrete means specific numbers and sensory detail, so \"saves 16 hours a month\" rather than \"saves 40%\". Credible favors proof from within the message, such as vivid detail, human-scale statistics and the Sinatra Test: one example so strong it settles every doubt. Emotional means one person's story over statistics, and appeals to who people want to be. Stories follow challenge, connection or creativity plots. Each trait is rated 1 to 10 and the total of 6 to 60 maps to the score. It shows how the six apply to landing pages, product demos and onboarding, and suggests testing messages on outsiders.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/made-to-stick"
        },
