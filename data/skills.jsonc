      "agentReview": {
        "description": "Plans and runs product submissions to startup, SaaS, AI and MCP directories for backlinks and discovery, with positioning varied per directory.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're launching and want listings on Product Hunt, G2, AI directories or MCP registries, or are running a backlink campaign"
