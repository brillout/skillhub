    {
      "id": "wondelai/skills/release-it",
      "name": "release-it",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/release-it",
        "installs": 5600,
        "weeklyInstalls": [136, 146, 132, 137, 259, 188, 134, 130],
        "firstSeen": "2026-02-23"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Designs production systems that survive failure with Michael Nygard's Release It!: timeouts, circuit breakers, bulkheads, load testing, safe deploys and observability.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A service keeps crashing, one slow dependency takes others down, or deploys cause outages"
            },
            {
              "label": "It does",
              "text": "Guards every integration point with timeouts, circuit breakers and isolated pools, and separates deploying code from releasing it"
            },
            {
              "label": "You get",
              "text": "A score out of 8 from eight checks, the failing ones and the fix for each"
            },
            {
              "label": "Unlike ddia-systems",
              "text": "That one, from the same repo, covers databases and consistency; this one keeps services running through failures"
            }
          ],
          "text": "Based on Michael Nygard's Release It!, which argues that software that passes QA is not software that survives production. It names stability anti-patterns, such as integration points (every remote call can fail or hang), slow responses, unbounded result sets and blocked threads, and counters them with patterns: circuit breakers that stop calling a failing dependency, bulkheads that give each dependency its own pool, connect and read timeouts on every call, retries with backoff, jitter and a budget, failing fast, and automatic cleanup. Capacity limits are found with load, stress, soak and spike tests, and pools are sized from measured concurrency. Deploying and releasing are separate: blue-green or canary deploys, feature flags, backward-compatible schema changes and fast rollback. Observability means deep health checks, correlated logs, metrics and traces, and alerts on what users feel, such as errors and latency, rather than CPU. Chaos engineering is treated as planning: it says failure injection is for authorized engineers with approvals and rollback plans, not for the agent to run. Eight diagnostic questions set the score. Reference files go deeper on each pattern.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/release-it"
        },
        "tags": [
          "category:engineering",
          "category:cloud",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "architecture",
          "deployment",
          "observability"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
