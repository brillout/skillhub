      "id": "paramchoudhary/resumeskills/skills/resume-ats-optimizer",
      "name": "resume-ats-optimizer",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/resume-ats-optimizer",
        "installs": 12900,
        "weeklyInstalls": [505, 452, 482, 565, 555, 575, 542, 630],
