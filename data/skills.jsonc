      "agentReview": {
        "description": "Writes software diagrams as Mermaid code, picking the type that fits: class, sequence, flowchart, ER, C4, state or cloud architecture.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a domain model, API flow, user journey, database schema or system architecture drawn as a diagram that lives as text beside your code"
