          "category:documents",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:official",
          "memory",
          "notes",
          "issue-tracking"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
