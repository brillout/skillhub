      "agentReview": {
        "description": "Builds animated, single-file HTML slide decks from notes or PowerPoint files, after letting you pick a style from three generated preview slides.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a talk, pitch or workshop deck as a web page, or to turn a .ppt or .pptx file into one"
            },
            {
              "label": "It does",
              "text": "Asks the deck's purpose, length and the feeling it should create, generates three one-slide style previews, then builds the deck in the style you pick"
            },
            {
              "label": "You get",
              "text": "One self-contained HTML file with keyboard, touch and wheel navigation, reveal animations and reduced-motion support"
