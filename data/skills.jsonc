    {
      "id": "getsentry/skills/skills/security-review",
      "name": "security-review",
      "skills.sh": {
        "url": "https://skills.sh/getsentry/skills/security-review",
        "installs": 23400,
        "weeklyInstalls": [452, 451, 1892, 920, 785, 847, 853, 822],
