      },
      "skillMd": {
        "version": "ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Tracks which work tools are connected for search, orders sources by kind of question, guides you to connect more, and handles rate limits.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "The agent searches your company's tools through MCP and you want it to know which sources it can reach"
            },
            {
              "label": "It does",
              "text": "Detects connected chat, email, cloud storage, project tracker, CRM and knowledge base sources, and tells you how to connect missing ones"
            },
            {
              "label": "Priorities",
              "text": "Orders sources by question type, such as chat first for decisions, the project tracker for status and the wiki for policy"
            },
            {
              "label": "Rate limits",
              "text": "Doesn't retry a throttled source right away, carries on with the others and tells you which results are missing"
            },
            {
              "label": "Runs",
              "text": "On its own when needed; user-invocable: false hides it from the slash menu"
            }
          ],
          "text": "A support skill of the enterprise-search plugin that keeps track of the sources a search can use. A source counts as connected when its MCP tools are available. When few or none are, or you ask about one that isn't, it lists what's connected and explains how to add a server in your MCP settings. It sets an order of sources for each kind of question, used to weight results rather than to skip sources: chat, then email and documents, for decisions; the project tracker first for status; cloud storage first for documents; chat and task assignees for people; the wiki first for policy. On a rate limit, such as an HTTP 429, it doesn't retry immediately, continues with the other sources and says which one to retry later; it also avoids needless and repeated calls. It reports which sources were searched, and which are available, not connected or rate limited, so you know how complete an answer is. Sources added to the plugin's .mcp.json are picked up by its search and digest commands automatically.",
          "permalink": "https://github.com/anthropics/knowledge-work-plugins/tree/ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d/enterprise-search/skills/source-management"
        },
        "tags": [
          "category:documents",
          "type:guidelines",
          "effect:none",
          "needs:mcp",
          "by:official",
          "research"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
