    {
      "id": "mitsuhiko/gh-issue-sync/skill",
      "name": "gh-issue-sync",
      "skills.sh": {
        "url": "https://skills.sh/mitsuhiko/gh-issue-sync/gh-issue-sync",
        "installs": 27700,
