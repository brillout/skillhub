    {
      "id": "tw93/waza/skills/check",
      "name": "check",
      "skills.sh": {
        "url": "https://skills.sh/tw93/waza/check",
        "installs": 16400,
        "weeklyInstalls": [341, 265, 175, 414, 365, 221, 377, 196],
        "firstSeen": "2026-04-04"
      },
      "skillMd": {
        "version": "6095341ad46b063619f4d0a5afc1c6fa8f1b4696",
        "updated": "2026-11-10",
        "skew": 44
      },
      "agentReview": {
        "description": "Reviews a diff or PR for drift, over-design and hard stops, then handles approved commits, pushes, releases and issue follow-up.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A diff or PR is ready for review, or you want to commit, push, release, or triage issues and PRs"
            },
            {
              "label": "It does",
              "text": "Checks the diff against your stated goal, flags removable parts and must-fix risks at a depth set by size and risk, then runs the project's own checks"
            },
            {
              "label": "You get",
              "text": "Findings grouped by bug class with file:line, then a sign-off block saying exactly what was committed, pushed, released or blocked"
            },
            {
              "label": "Keeps",
              "text": "Reviews read-only: it edits, commits, pushes, publishes or comments only with your go-ahead, and asks before stashing or switching branches"
            },
            {
              "label": "Unlike a plain review",
              "text": "This one carries release and issue follow-through to the end and closes ship runs with a ledger of what is done, not applicable or remaining"
            }
          ],
          "text": "Check first reads git status, treats every uncommitted file as your work, and takes the baseline from your words: local changes, a branch, everything since the last release. It sizes the review as quick, standard or deep by lines and files, and any diff touching CI, release or signing, auth, billing, installers or deletion paths needs a human maintainer's review. Every review asks whether each changed file traces to the stated goal, lists layers that could be removed, and, when a fix covers one instance of a bug, greps for its siblings. A finding needs a file:line, a trigger and a severity a senior reviewer would raise; a clean review is a valid result. Standard and deep reviews add specialist reviewers, and deep ones an adversarial pass. Other modes load their own reference files: triaging issues and PRs, whether a release is worth it, ship and release follow-through, and a whole-project audit scorecard. Handed a plan from think, it skips the review, implements it and runs the project's checks; a \"ship if green\" rule in AGENTS.md lets it ship after a clean review unasked. Any claim that tests pass must come from a command run this session.",
          "permalink": "https://github.com/tw93/waza/tree/58217546cd94fcf5ddcde4265c00a9377ed3192c/skills/check"
        },
        "tags": [
