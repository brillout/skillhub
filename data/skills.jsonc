    {
      "id": "usestrix/strix/skills/fix-security-vulnerabilities-with-strix",
      "name": "fix-security-vulnerabilities-with-strix",
      "skills.sh": {
        "url": "https://skills.sh/usestrix/strix/fix-security-vulnerabilities-with-strix",
        "installs": 19600,
        "weeklyInstalls": [1077, 1057, 1118, 1181, 1598, 1638, 1669, 1473],
