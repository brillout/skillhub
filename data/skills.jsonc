      "agentReview": {
        "description": "Turns the agent into Amelia, BMad's test-first senior engineer, who stays on until dismissed and runs BMad's build, test and review skills.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a dedicated developer persona, Amelia, for building and checking stories"
