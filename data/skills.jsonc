    {
      "id": "bmad-code-org/bmad-method/skills/bmad-build",
      "name": "bmad-build",
      "skills.sh": {
        "url": "https://skills.sh/bmad-code-org/bmad-method/bmad-build",
        "installs": 16500,
        "weeklyInstalls": [982, 1335, 2672, 2938, 1628, 1753, 1494, 1556],
