          "type:mode",
          "effect:local",
          "needs:none",
          "by:community",
          "self-improvement",
          "skill-authoring",
          "memory"
        ],
        "note": "Asks to run before the first tool call of every session and stays on throughout, writing observation files to a workspace folder; it relies on an activation line in CLAUDE.md or a session-start hook.",
        "model": "Claude Opus 5.5",
