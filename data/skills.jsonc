      "agentReview": {
        "description": "Creates or updates a Codex skill, from concrete examples to a lean SKILL.md with scripts, references and assets, scaffolded and checked by bundled scripts.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to write a new skill for Codex or update one you have"
            },
            {
              "label": "It does",
              "text": "Asks for concrete examples of use, plans the scripts, references and assets they call for, scaffolds the folder with init_skill.py and checks it with quick_validate.py"
            },
            {
              "label": "You get",
              "text": "A skill folder with SKILL.md, optional scripts/, references/ and assets/, and agents/openai.yaml, the metadata Codex shows in its skill list"
            },
            {
              "label": "Its rules",
              "text": "Assume the agent is already smart, keep SKILL.md under 500 lines, put all trigger text in the description, keep references one level deep, add no README"
            },
            {
              "label": "Unlike Anthropic's skill-creator",
              "text": "It has no evals or benchmarks: improvement comes from using the skill on real tasks"
