          "effect:local",
          "needs:none",
          "by:community",
          "docs-writing",
          "domain-modeling",
          "code-review"
        ],
        "note": "Setting it up writes a LOGIC.md for every source file and directory of the codebase, in one go.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
