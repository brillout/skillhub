          "needs:subagents",
          "by:community",
          "stack:mermaid",
          "architecture",
          "refactoring",
          "diagrams",
          "multi-agent"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "thedotmack/claude-mem/plugin/skills/babysit",
