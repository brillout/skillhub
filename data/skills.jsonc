        "skew": 419
      },
      "agentReview": {
        "description": "Validates a site's XML sitemaps against Google's limits and rules, or generates new ones from an industry template.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to check that a sitemap works, or need one for a new or restructured site"
            },
            {
              "label": "It does",
              "text": "Finds sitemaps through robots.txt and common paths, then checks size limits, status codes, lastmod accuracy and stray noindexed, redirected or non-canonical URLs"
            },
            {
              "label": "You get",
              "text": "VALIDATION-REPORT.md with issues by severity, or sitemap.xml files split under an index, with STRUCTURE.md"
            },
            {
              "label": "Also checks",
              "text": "Image, video and news sitemaps, which have their own caps, such as 1,000 news items per file"
            }
          ],
          "text": "Analysis starts with the plugin's discovery script, which reads every Sitemap: line in robots.txt and still probes common paths, so a sitemap is reported missing only when nothing is found. The checks follow Google's rules: at most 50,000 URLs or 50 MB per file, a lastmod date only when it reflects a real content change, priority and changefreq flagged as ignored, and only canonical, indexable HTTPS URLs that return 200. Generation asks for the business type, loads that industry's template from seo-plan, plans the structure with you and applies its quality gates: a warning at 30 location pages and a hard stop at 50 without justification. It lists which programmatic pages are safe at scale, such as integration, glossary and product pages with real content, and which risk penalties, such as location pages that only swap the city name.",
          "permalink": "https://github.com/AgriciDaniel/claude-seo/tree/6be93f45064ffbadced572b5d5c95f55fd263af0/skills/seo-sitemap"
        },
