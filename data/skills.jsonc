    {
      "id": "jakubkrehel/make-interfaces-feel-better/skills/make-interfaces-feel-better",
      "name": "make-interfaces-feel-better",
      "skills.sh": {
        "url": "https://skills.sh/jakubkrehel/make-interfaces-feel-better/make-interfaces-feel-better",
        "installs": 76563,
        "weeklyInstalls": [1386, 1686, 1827, 5002, 6371, 1330, 1408, 1082],
