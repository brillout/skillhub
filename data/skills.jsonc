    {
      "id": "paramchoudhary/resumeskills/skills/interview-prep-generator",
      "name": "interview-prep-generator",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/interview-prep-generator",
        "installs": 9500,
        "weeklyInstalls": [378, 311, 323, 418, 438, 410, 399, 472],
        "firstSeen": "2026-05-20"
      },
      "skillMd": {
        "version": "74ae19e7c62b0516d1c298328e5544976c12da5d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Predicts interview questions from a job description, turns your resume bullets into STAR stories, and drafts your pitch and questions to ask.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have a job interview coming up and want your stories and answers ready"
            },
            {
              "label": "It does",
              "text": "Picks the competencies the role will test, then expands each resume bullet into a STAR story: situation, task, action, and a result with metrics"
            },
            {
              "label": "You get",
              "text": "A prep sheet: predicted questions linked to stories, a story bank, a two-minute \"tell me about yourself\" script, questions to ask and company notes"
            },
            {
              "label": "Story lengths",
              "text": "Two minutes in full, 60 seconds for follow-ups, and a 15-second one-liner"
            }
          ],
          "text": "Interview preparation in three phases: analyze the role, build a bank of stories, then prepare for practice with likely questions, questions to ask and company research. From the job description it picks the competencies likely to be tested and predicts questions by probability. Stories follow STAR (situation, task, action, result), with a quantified result and about two minutes for the full version. The bank should hold eight to ten stories covering leadership, problem-solving, collaboration, achievement and failure, each mapped to the questions it answers. It lists common behavioral, role-specific (product, engineering, marketing, sales) and standard questions, questions to ask hiring managers, team members and executives, and ones to avoid. Hard questions get formulas: a real weakness with the steps you're taking, a forward-looking reason for leaving, a genuine failure and what you learned, and a line that deflects salary questions until you're pressed. Its checklist ends with practicing out loud, logistics, a review the day before and thank-you notes.",
          "permalink": "https://github.com/paramchoudhary/resumeskills/tree/74ae19e7c62b0516d1c298328e5544976c12da5d/skills/interview-prep-generator"
        },
