      "id": "github/awesome-copilot/skills/security-review",
      "name": "security-review",
      "skills.sh": {
        "url": "https://skills.sh/github/awesome-copilot/security-review",
        "installs": 5800,
        "weeklyInstalls": [99, 83, 102, 96, 74, 95, 112, 99],
