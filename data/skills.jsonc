      "agentReview": {
        "description": "Sets up a Next.js editor for designing App Store and Google Play screenshots as ads, with copy coaching and export at every required size.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're preparing store screenshots for an iOS, Mac or Android app and want them to sell the app, not just show its UI"
            },
            {
              "label": "It does",
              "text": "Asks for your screenshots, icon, features and style, copies a ready-made editor into your project, installs it and starts the dev server"
