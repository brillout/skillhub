    {
      "id": "wondelai/skills/software-design-philosophy",
      "name": "software-design-philosophy",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/software-design-philosophy",
        "installs": 6500,
        "weeklyInstalls": [157, 168, 143, 155, 295, 221, 170, 162],
        "firstSeen": "2026-02-23"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Reduces software complexity with John Ousterhout's A Philosophy of Software Design: deep modules, information hiding and comments that record design intent.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "An API feels too complex, classes only pass calls along, or one change forces edits in many places"
            },
            {
              "label": "It does",
              "text": "Judges each module by how much it hides behind how simple its interface is, and hunts for design decisions leaking between modules"
            },
            {
              "label": "You get",
              "text": "Design advice and a score out of 10 from eight checks, with the change each failed check needs"
            },
            {
              "label": "Unlike clean-code",
              "text": "That one, from the same repo, favors very short functions; this one says depth matters more than size"
            }
          ],
          "text": "Based on John Ousterhout's A Philosophy of Software Design. It treats complexity as the enemy: it shows up as change amplification (one change, many edits), cognitive load and unknown unknowns, and comes from dependencies and obscurity. A deep module hides a lot of functionality behind a simple interface, like Unix file I/O; a shallow one adds an interface without hiding much, and many small shallow classes, which it calls classitis, add load instead of removing it. Information leakage, one design decision reflected in several modules, is a key red flag, often caused by splitting code by when things happen instead of by what each part knows. Interfaces should be somewhat general-purpose: the simplest one that covers all current needs, with complexity pushed down into lower modules and few configuration parameters. Comments record what code can't, such as intent, invariants and why one approach was chosen, and can be written before the code. Strategic programming spends 10–20% extra on design with every change, unlike the tactical tornado who ships fast and leaves wreckage. Eight diagnostic questions set the score.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/software-design-philosophy"
        },
        "tags": [
          "category:engineering",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "architecture",
          "code-quality"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wondelai/skills/cro-methodology",
      "name": "cro-methodology",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/cro-methodology",
        "installs": 6500,
        "weeklyInstalls": [146, 163, 134, 151, 268, 221, 153, 159],
        "firstSeen": "2026-01-29"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits landing pages and funnels for why visitors don't convert, and plans research-backed A/B tests, following the method of Making Websites Win.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A landing page, signup or checkout isn't converting, or you're deciding what to A/B test"
            },
            {
              "label": "It does",
              "text": "Grounds every change in research into why visitors leave, answers each objection with proof placed where it arises, and ranks test ideas by impact, confidence and ease"
            },
            {
              "label": "You get",
              "text": "A score out of 10 from seven checks, naming the ones that fail"
            },
            {
              "label": "Insists on",
              "text": "Bold tests over button-color tweaks, a sample size set in advance, and no peeking or stopping early"
            }
          ],
          "text": "Based on Making Websites Win by Karl Blanks and Ben Jesson of Conversion Rate Experts. Its rule is to discover, not guess, why visitors don't convert. A nine-step process runs from success metrics and a funnel map, which looks for busy but underperforming paths and missing stages, through visitor research, to experiments and scaling what wins. Exit surveys, chat logs, support tickets, sales calls and reviews reveal objections, usually about trust, price, fit, timing or effort. The core tool is the objection/counter-objection table: each objection gets evidence placed where the visitor feels it, such as a guarantee next to the payment form, and objections visitors won't admit are answered without being stated. It inventories persuasion assets such as testimonials, awards and guarantees, and has you acquire missing ones. Each test gets a written hypothesis and an ICE score (impact, confidence, ease), and changes that couldn't multiply results tenfold are deprioritized. Tests need a sample size set in advance, at least one full business cycle and honest reporting of whatever they return. Fake testimonials and inflated statistics are ruled out.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/cro-methodology"
        },
        "tags": [
