      }
    },
    {
      "id": "trailofbits/skills/plugins/supply-chain-risk-auditor/skills/supply-chain-risk-auditor",
      "name": "supply-chain-risk-auditor",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/supply-chain-risk-auditor",
        "installs": 9200,
