    {
      "id": "anthropics/knowledge-work-plugins@enterprise-search",
      "skew": 0,
      "agentReview": {
        "name": "Enterprise Search",
        "description": "Searches your company's chat, email, cloud storage, wikis, project trackers and CRM with one question and answers with every claim's source.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your company's knowledge is spread across chat, email, documents, wikis and trackers and you want one question to search them all"
            },
            {
              "label": "It does",
              "text": "search runs the query; search-strategy plans a search per source, source-management tracks which tools are reachable, knowledge-synthesis merges the results"
            },
            {
              "label": "You get",
              "text": "One answer with the source, place and date of each claim, conflicts flagged and confidence stated"
            },
            {
              "label": "Runs",
              "text": "search as /enterprise-search:search; the other three on their own when relevant, hidden from the slash menu"
            },
            {
              "label": "Works with",
              "text": "Any work tool connected through MCP; the plugin pre-configures Slack, Notion, Guru, Atlassian and Asana"
            },
            {
              "label": "Built for",
              "text": "Claude Cowork, installed from claude.com/plugins; also works in Claude Code"
            }
          ],
          "text": "The enterprise-search plugin of Anthropic's knowledge-work plugins, built to answer questions such as \"what did we decide about the API redesign?\" from every work tool you connect. search is the command you call: it checks the connected sources, splits the question into a query per source in that tool's own syntax, runs them in parallel and returns one answer with its sources. The other three skills, which the plugin's README says power the search experience, go deeper on each step and load on their own. search-strategy classifies the question, such as a decision, status or policy query, writes keyword and semantic variants, translates filters such as from: and after:, scores results and broadens empty searches. source-management detects which sources are connected, says how to add missing ones, orders sources by question type and handles rate limits. knowledge-synthesis merges the same fact found in several places, cites every claim, rates confidence by freshness and authority, and flags conflicts rather than picking one version. Installing the plugin also adds digest, a daily or weekly roundup of action items, decisions and mentions across the same sources, which isn't listed here.",
          "permalink": "https://github.com/anthropics/knowledge-work-plugins/tree/ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d"
        },
        "skills": [
          {
            "id": "anthropics/knowledge-work-plugins/enterprise-search/skills/search",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "anthropics/knowledge-work-plugins/enterprise-search/skills/source-management",
            "standalone": true,
