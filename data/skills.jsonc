    {
      "id": "OthmanAdi/planning-with-files/skills/planning-with-files",
      "name": "planning-with-files",
      "skills.sh": {
        "url": "https://skills.sh/othmanadi/planning-with-files/planning-with-files",
        "installs": 48800,
        "weeklyInstalls": [748, 624, 620, 586, 729, 829, 876, 580],
        "firstSeen": "2026-01-20"
      },
      "skillMd": {
        "version": "73606e0e2c457057ef3445d3217e08495069973d",
        "updated": "2026-11-11",
        "skew": 67
      },
      "agentReview": {
        "description": "Keeps a plan, findings and a progress log in Markdown files so long agent tasks survive lost context.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A task will take many steps or tool calls, such as research or a build, and the agent keeps losing track of it"
            },
            {
              "label": "It does",
              "text": "Has the agent create task_plan.md, findings.md and progress.md before it starts, then re-read and update them as it works"
            },
            {
              "label": "You get",
              "text": "Three Markdown files in your project, or under .planning/<id>/ for a named plan: phases with statuses, findings, errors tried and the next step"
            },
            {
              "label": "Runs",
              "text": "Hooks that put the plan back into context on each prompt, and on file, search and shell tool calls when its view has changed"
            },
            {
              "label": "Optional modes",
              "text": "Autonomous, which re-injects less, and gated, which can keep the agent from stopping while a phase is in progress, on hosts that allow it"
            }
          ],
          "text": "It follows the context-engineering principles of Manus, the AI agent company: the context window is RAM, the filesystem is disk, so anything important goes to a file. For a new task a bundled script creates task_plan.md, with phases each marked pending, in_progress or complete, decisions and a single next step, plus findings.md for research and progress.md as a session log, and validates the format. The agent saves findings after every two searches or page views, re-reads the plan before big decisions, logs every error, never repeats a failed action, and asks you after three failed attempts. When work resumes, it reads the files back and checks git diff for changes not yet recorded. Named plans under .planning/ let parallel agents each pin their own plan with PLAN_ID. Hooks wrap the injected plan as data, and optional hash attestation refuses to inject a plan changed since you approved it. It reads local session history only when you ask. In Claude Code, the plugin install adds /plan-goal and /plan-loop, which tie the plan to /goal and /loop.",
          "permalink": "https://github.com/OthmanAdi/planning-with-files/tree/8eef6dc6540dde5eef3fdc0ac487ad9c48ef3ba5/skills/planning-with-files"
        },
        "tags": [
          "category:planning",
          "category:agents",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "planning",
          "memory",
          "agent-workflows"
        ],
        "note": "Its hooks inject the current plan into context on each prompt and on many tool calls: from session start in a plugin install, or once you invoke it in a skill-only install.",
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "multica-ai/andrej-karpathy-skills/skills/karpathy-guidelines",
      "name": "karpathy-guidelines",
      "skills.sh": {
        "url": "https://skills.sh/multica-ai/andrej-karpathy-skills/karpathy-guidelines",
        "installs": 46200,
        "weeklyInstalls": [1035, 1045, 1075, 945, 1259, 1676, 1307, 1443],
        "firstSeen": "2026-01-28"
      },
      "skillMd": {
        "version": "2c606141936f1eeef17fa3043a72095b4765b9c2",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Makes the agent state assumptions, keep code minimal, change only what was asked and define checks before coding.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "The agent overcomplicates code, guesses silently, or edits lines you didn't ask it to touch"
            },
            {
              "label": "It does",
              "text": "Applies four rules while it writes, reviews or refactors: think before coding, simplicity first, surgical changes, goal-driven execution"
            },
            {
              "label": "You get",
              "text": "Questions instead of silent guesses, smaller diffs, and multi-step work stated as a short plan with a check for each step"
            },
            {
              "label": "Tradeoff",
              "text": "It favors caution over speed; for trivial tasks it tells the agent to use judgment"
            }
          ],
          "text": "Four short rules drawn from Andrej Karpathy's observations on the mistakes LLMs make when coding. Think before coding: state assumptions, lay out competing interpretations instead of picking one silently, say when a simpler approach exists, and stop to ask when something is unclear. Simplicity first: no features, abstractions, configurability or error handling nobody asked for; if 200 lines could be 50, rewrite them. Surgical changes: don't improve adjacent code, comments or formatting, match the existing style, mention unrelated dead code instead of deleting it, and remove only what your own change left unused, so every changed line traces to the request. Goal-driven execution: turn a task into something checkable, such as a test that reproduces a bug before the fix, and for multi-step work state a brief plan with a verification for each step, so the agent can loop until the checks pass.",
          "permalink": "https://github.com/multica-ai/andrej-karpathy-skills/tree/2c606141936f1eeef17fa3043a72095b4765b9c2/skills/karpathy-guidelines"
        },
        "tags": [
          "category:engineering",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "scope-control",
          "code-quality",
          "verification"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
