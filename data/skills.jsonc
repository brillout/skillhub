      "agentReview": {
        "description": "Drafts or audits manuscript Data and Code Availability statements, repository plans, dataset citations and FAIR metadata.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need a journal-ready Data/Code Availability statement or data-sharing plan, or want an existing statement audited"
            },
            {
              "label": "It does",
              "text": "Inventories each dataset, classifies its access route, chooses repositories and identifiers, drafts the statement and runs a FAIR metadata audit"
