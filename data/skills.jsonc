      "skillMd": {
        "version": "6d9388674de1ad0437ad95db3d52f92b92204d84",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Takes a paper from research to finished manuscript in ten stages, calling sibling skills, with integrity checks and your approval between stages.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want one guided run from a research question to a finished paper, or to enter midway with a draft or reviewer comments"
            },
            {
              "label": "It does",
              "text": "Research, write, integrity check, review, revise, re-review, revise again if needed, final integrity check, format, then a record of how the paper was made"
            },
            {
              "label": "You get",
              "text": "The final paper in Markdown, plus DOCX, a PDF compiled from LaTeX or the .tex source as you choose, and, unless you decline it, a process record scoring the collaboration"
            },
            {
              "label": "Stops for you",
              "text": "After every stage; integrity checks and review decisions can't be skipped, and going past a failed check needs your recorded decision"
            },
            {
              "label": "Midway entry",
              "text": "A draft you bring goes through the integrity check before any review"
            },
            {
              "label": "Needs",
              "text": "The other three ARS skills and the repo's shared/ and scripts/ folders, as the plugin installs them; Python for its checkers, Pandoc and tectonic for DOCX and PDF"
            }
          ],
          "text": "The orchestrator of Academic Research Skills (ARS): it does no research, writing or reviewing. It works out which stage your materials put you at, recommends modes (socratic, plan and guided when you want guidance, full for direct output, quick when time is short), loads each stage's skill and waits for your confirmation before moving on. Its own integrity agent runs before review and again from scratch before formatting: it checks references, citation context, statistics, originality and claims, plus a seven-mode checklist of AI research failures such as hallucinated results and fabricated methods. A failed check is fixed and rechecked up to three times, and a suspected failure mode blocks until you confirm, override with a reason or revise. Revision gets one round after the review and one after the re-review; what's left becomes acknowledged limitations. At the start it estimates token cost and the revision round-trips. Stage 6 writes a process record with a collaboration evaluation scored 1-100 on six dimensions and an AI self-reflection, and an advisory observer scores your collaboration pattern at checkpoints without ever blocking. Opt-in flags add a claim-to-source audit, external-model audits, and resuming in a fresh session from the Material Passport, its saved run state.",
          "permalink": "https://github.com/imbad0202/academic-research-skills/tree/6d9388674de1ad0437ad95db3d52f92b92204d84/academic-pipeline"
        },
        "tags": [
          "category:science",
          "category:writing",
          "type:workflow",
          "effect:local",
          "needs:cli",
          "by:community",
          "research",
          "writing",
          "verification"
        ],
        "note": "Needs the repo's deep-research, academic-paper and academic-paper-reviewer skills, and its shared/ folder, which the plugin install brings.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "backnotprop/plannotator/apps/skills/extra/plannotator-setup-goal",
