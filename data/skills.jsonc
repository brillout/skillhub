    {
      "id": "gamedev-skills/awesome-gamedev-agent-skills/skills/workflows/game-jam",
      "name": "game-jam",
      "skills.sh": {
        "url": "https://skills.sh/gamedev-skills/awesome-gamedev-agent-skills/game-jam",
