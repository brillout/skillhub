      },
      "skillMd": {
        "version": "8a3bde8083bd121971f61cba4bdbe5fd8c0eee7d",
        "updated": "2026-11-10",
        "skew": 138
      },
      "agentReview": {
        "description": "Builds verified, scored prospect lists for B2B, SaaS or local-business outreach, or finds first customers from public signs of demand.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need a list of companies or local businesses to contact, or your first customers and design partners"
            },
            {
              "label": "It does",
              "text": "Turns your ideal customer into pass/fail criteria, sources two to three times more candidates than needed, and qualifies each with sources and a confidence level"
            },
            {
              "label": "You get",
              "text": "A lead sheet scored hot, warm, cold or skip, as a chat table or a CSV above 25 rows, with the top 3 to 5 targets explained"
            },
            {
              "label": "Won't",
              "text": "Bulk-scrape LinkedIn or Google Maps, get past logins or CAPTCHAs, or use leaked data or sensitive traits"
            },
            {
              "label": "Works with",
              "text": "Apollo, Clay, ZoomInfo, Hunter and similar if you have them; otherwise public sources and browser research"
            },
            {
              "label": "Unlike cold-email",
              "text": "That one, from the same repo, handles the outreach itself (copy, sending setup, cadences and replies); this one builds the list you reach out to"
            }
          ],
          "text": "Prospect research in four branches: SaaS companies, other B2B businesses, local small businesses such as gyms or clinics, and an early-stage branch that looks for public evidence of the pain you solve in forums, reviews, GitHub issues and job posts. Every branch runs the same five phases. It defines the ideal customer profile as a paragraph plus pass/fail checks, including a \"why now\" buying signal; builds a candidate list from two or three sources; qualifies each candidate with evidence, rating confidence high only with two independent sources or the official business page; scores and tiers accounts, with a researched brief before any outreach to the top tier; and outputs the lead sheet, or an evidence report for the early-stage branch. Emails are verified before they go on the list and again before sending if the list has sat. Compliance rules apply on every run: no bulk scraping, public business contacts only, a source URL and date kept for every contact for GDPR and CAN-SPAM, and no reselling extracted data. It reads your product marketing context if you have it (a shared file on your product, audience and positioning that the repo's product-marketing skill writes).",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/prospecting"
        },
