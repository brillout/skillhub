      "agentReview": {
        "description": "Separates an application's read and write models with the CQRS pattern — commands, queries, events, projections — with Python and FastAPI examples.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to scale reads separately from writes, or pair CQRS with event sourcing"
            },
            {
              "label": "It does",
              "text": "Explains the pieces — commands, command handlers, events, queries, query handlers, projectors — and how a write model feeds a read model through events"
            },
