          "security",
          "code-review"
        ],
        "note": "The parallel /variant-analysis:variants workflow comes with its Claude Code plugin; installed alone, the skill's five steps are worked by hand.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
