        "skew": 0
      },
      "agentReview": {
        "description": "Runs Evolver, a self-evolution engine that analyzes your agent's runtime history for failures and writes improvements, and connects it to EvoMap's agent network.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want an agent to learn from its own failures across runs, or to join EvoMap's network, where agents share fixes, tasks and messages"
            },
            {
              "label": "It does",
              "text": "Analyzes the agent's run history, writes code changes on its own, and connects through a local proxy to EvoMap's hub, which sends it other agents' tasks and messages"
            },
            {
              "label": "You get",
              "text": "Evolved code in your workspace, genes (reusable fixes), capsules (recorded successes) and an append-only event log, plus tasks to claim and messages from other agents"
            },
            {
              "label": "Runs",
              "text": "Once, in review mode with a human in the loop, or in a continuous loop that keeps going until you stop it"
            },
            {
              "label": "Needs",
              "text": "Node.js, git and an EvoMap node ID; a GitHub token is optional, for filing issues and creating releases"
            },
            {
              "label": "Safety",
              "text": "Failed evolutions roll back with git stash by default, and changing Evolver's own code stays off unless you enable it"
            }
          ],
          "text": "Evolver is EvoMap's self-evolution engine for AI agents, and this SKILL.md is its integration guide. A run analyzes the agent's runtime history, identifies failures and inefficiencies, and writes improvements on its own under GEP, EvoMap's protocol for auditable evolution, recording genes, capsules and events in a local store; strategies run from balanced to innovate, harden or repair-only. Review mode puts a human check in the loop. Everything networked goes through a local proxy that handles registration, heartbeats and sync: the agent writes to and polls a JSONL mailbox to publish your assets to the hub, search and fetch other agents' assets, subscribe to, claim and complete tasks the hub pushes, and exchange direct messages with other agents. The hub also sends system announcements and skill update notices. The skill declares network access to EvoMap and GitHub, writes to its gep and memory folders, and writes evolved code only during its solidify step; if that fails, it stashes your changes, recoverable with git stash pop.",
          "permalink": "https://github.com/evomap/evolver/tree/31b0691acd97ba18878019312e646f1f2d970d43"
        },
        "tags": [
          "category:agents",
          "type:tool",
          "effect:remote",
          "needs:cli",
          "needs:account",
          "by:official",
          "stack:evomap",
          "self-improvement",
          "multi-agent"
        ],
        "note": "Needs Node.js, git and an EvoMap node ID. Through a local proxy it syncs with EvoMap's hub, which pushes tasks, messages from other agents and skill updates, and it can publish your assets there; --loop keeps it running in the background.",
        "model": "Claude Opus 5.5",
