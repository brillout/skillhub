      "agentReview": {
        "description": "Writes cold emails to hiring managers and founders that open with something specific about the company, not a pitch, ready to copy.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to reach a hiring manager, founder or recruiter about a role you weren't referred to"
