    {
      "id": "addyosmani/agent-skills/skills/security-and-hardening",
      "name": "security-and-hardening",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/agent-skills/security-and-hardening",
        "installs": 83945,
        "weeklyInstalls": [4463, 4543, 4846, 6068, 6709, 6347, 5802, 4957],
        "firstSeen": "2026-02-16"
      },
      "skillMd": {
        "version": "301b02b12bff98e4688e6984af6556802322bbde",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Threat-models a feature, then hardens it against injection, broken access control, leaked secrets, risky dependencies, privacy gaps and LLM prompt injection.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You build or audit anything that takes user input, handles logins, sessions or personal data, calls outside services, or adds a dependency"
            },
            {
              "label": "It does",
              "text": "Maps where untrusted data enters and what's worth stealing, asks the six STRIDE questions of each entry point, then applies hardening rules"
            },
            {
              "label": "Rules",
              "text": "Always validate input, parameterize queries and hash passwords; ask you before changing auth, CORS or uploads; never commit secrets or log tokens"
            },
            {
              "label": "Also covers",
              "text": "Dependency audits and supply-chain risk, server-side URL fetches, unsafe deletes, rate limiting, privacy rules such as GDPR, and features that call an LLM"
            }
          ],
          "text": "Before any control, the agent spends five minutes thinking like an attacker: it maps the trust boundaries where outside data enters, including LLM output and values handed over by other processes, names the assets worth stealing, and asks the six STRIDE questions of each boundary: can someone impersonate a user, tamper with data, deny an action, read what they shouldn't, overwhelm the system or gain rights? Abuse cases become the first tests. Rules come in three tiers: always do (validate at the boundary, parameterize queries, encode output, hash passwords, set security headers and safe cookies), ask first (new auth flows, new kinds of sensitive data, CORS, uploads, permissions), and never do (secrets in git, sensitive data in logs, eval or innerHTML on user input). Each control, from SSRF and rate limiting to secrets and dependency audits, links to worked code in a file that ships with the skill. Personal data is treated as a liability, with a purpose, a retention limit and a working deletion path. LLM features map to OWASP's LLM Top 10: model output is untrusted input, and the system prompt isn't a security boundary. Sign-off walks a security checklist kept in the repo's shared folder.",
          "permalink": "https://github.com/addyosmani/agent-skills/tree/301b02b12bff98e4688e6984af6556802322bbde/skills/security-and-hardening"
        },
        "tags": [
          "category:security",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "security",
          "privacy"
        ],
        "note": "Installed alone, it lacks the repo-wide security checklist its sign-off step walks; install the whole repo to get it.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
