    {
      "id": "samber/cc-skills/skills/deep-research",
      "name": "deep-research",
      "skills.sh": {
        "url": "https://skills.sh/samber/cc-skills/deep-research",
        "installs": 5600,
        "weeklyInstalls": [55, 195, 400, 588, 750, 817, 647, 279],
        "firstSeen": "2026-04-13"
      },
      "skillMd": {
        "version": "50a33836b20f690c668af557bd9ef9d07a8c7ef2",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Researches a topic with 3 to 20 parallel subagents and writes a cited Markdown report with confidence levels, source tiers and ranked recommendations.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need a sourced report, not a quick answer: a market, competitor, technology, literature, legal, funding or trend landscape"
            },
            {
              "label": "It does",
              "text": "Scopes the question, fans out 3 to 20 search subagents per step, appends findings as they land, synthesises, then has a subagent write the report"
            },
            {
              "label": "You get",
              "text": "./research/{date}-{type}-{topic}.md with a folder of per-axis notes, and a PDF through pandoc or md-to-pdf if you ask"
            },
            {
              "label": "Rules",
              "text": "Every claim cites a URL, critical claims need two independent sources or get low confidence, conflicts are reported and gaps stated"
            },
            {
              "label": "Depths",
              "text": "Quick, standard (the default) and deep, which adds an outline revision and a red-team critique"
            },
            {
              "label": "Needs",
              "text": "Web search and subagents; with no web access it stops and tells you"
            }
          ],
          "text": "It covers eleven research types, each with its own reference file of axes: market, domain, technical, competitive, product, academic, person or organisation, financial, legal, trend and community. A well-scoped prompt gets its assumptions stated in the report header and no interview; a vague one (\"research blockchain\") gets asked the type, the questions to answer and any constraints. It first checks ./research/ for earlier reports and asks whether to extend, update or start fresh. Subagents get a fixed prompt: research one axis, fetch the sources, write prose rather than bullets, tag each source as primary, established or low tier, and give each claim a high, medium or low confidence. Findings go into the report after each step, not at the end. Synthesis gives five key findings, three to five recommendations ranked by impact, risks and uncertainties, and next steps, with inference labelled as such. MCP connectors you have, such as arXiv, Reddit, Notion or Gmail, can feed the subagents too.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2/skills/deep-research"
        },
        "tags": [
