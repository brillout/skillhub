    {
      "id": "openclaw/openclaw/skills/gh-issues",
      "name": "gh-issues",
      "skills.sh": {
        "url": "https://skills.sh/openclaw/openclaw/gh-issues",
        "installs": 5000,
        "weeklyInstalls": [124, 116, 118, 17, 10, 5, 6, 2],
        "firstSeen": "2026-02-17"
      },
      "skillMd": {
        "version": "f99d785d2ac6269b37a1c88eb8d5ef2283b76b99",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Turns GitHub issues into pull requests with up to eight background agents, one per issue, and can then work through the PRs' review comments.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A repo has a backlog of issues you'd like agents to fix and turn into pull requests"
            },
            {
              "label": "It does",
              "text": "Lists matching issues, skips those with an open PR, branch or recent claim, asks which to take, then starts up to eight background workers"
            },
            {
              "label": "You get",
              "text": "One PR per issue from a fix/issue-<n> branch, with tests run and a body covering problem, reason, user impact and evidence"
            },
            {
              "label": "Reviews",
              "text": "With --reviews-only or --watch, workers patch its PRs for actionable review comments, push and reply"
            },
            {
              "label": "Options",
              "text": "Filter by label, milestone, assignee or state; --fork pushes to your fork, --dry-run only lists, --cron spawns workers and exits"
            },
            {
              "label": "Needs",
              "text": "gh and git with GitHub auth, a clean working tree, and an agent that runs background workers"
            }
          ],
          "text": "An issue-to-PR loop from OpenClaw, run with gh and git. The agent resolves the repo from the origin remote or your argument, checks GitHub auth, and stops on a dirty working tree unless you say otherwise. It fetches issues with your filters, ten open ones by default, and drops any that already have an open PR, a fix/issue-<n> branch, or a claim under two hours old in a local claim file. Once you choose all issues or some, it launches up to eight background workers, each told to branch from the base, make a minimal fix, run the relevant tests, commit with a conventional message, push and open a PR. It then reports each issue as PR opened, skipped, failed or timed out. A reviews mode finds the workflow's own fix/issue-* PRs, ignores praise and already-addressed comments, and sends one worker per PR to patch, push without force and reply to each comment it fixed. Watch mode repeats both on an interval until you stop it. In fork mode, branches go to your fork and PRs to the source repo.",
          "permalink": "https://github.com/openclaw/openclaw/tree/f99d785d2ac6269b37a1c88eb8d5ef2283b76b99/skills/gh-issues"
        },
        "tags": [
          "category:engineering",
          "category:agents",
          "type:workflow",
          "effect:remote",
          "needs:cli",
          "needs:subagents",
          "needs:issue-tracker",
          "by:community",
          "stack:github",
          "stack:git",
          "issue-tracking",
          "multi-agent",
          "agent-workflows",
          "implementation"
        ],
        "note": "Its workers push branches, open pull requests and reply to review comments on GitHub; --yes or --cron skip asking which issues to take, and --watch keeps polling until you say stop. It keeps claim files in ~/.openclaw and notifies through OpenClaw when you name a channel.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wondelai/skills/clean-code",
