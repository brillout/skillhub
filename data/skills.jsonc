          "effect:none",
          "needs:none",
          "by:community",
          "conversion",
          "research",
          "marketing"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wondelai/skills/negotiation",
      "name": "negotiation",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/negotiation",
        "installs": 6300,
        "weeklyInstalls": [158, 161, 139, 140, 263, 206, 139, 164],
        "firstSeen": "2026-02-05"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Prepares negotiations with Chris Voss's Never Split the Difference: tactical empathy, mirroring, labeling emotions, calibrated questions and Ackerman bargaining.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're negotiating a salary, contract or price, or facing a hard conversation where the other side won't budge"
            },
            {
              "label": "It does",
              "text": "Prepares an accusation audit, calibrated \"how\" and \"what\" questions and your walk-away point, aiming to get the other side to say \"that's right\""
            },
            {
              "label": "You get",
              "text": "A score out of 10 for preparation and execution, with the gaps to close"
            },
            {
              "label": "Unlike influence-psychology",
              "text": "That one, from the same repo, covers persuasion in products and copy; this one is for negotiating with a counterpart, in person, by phone or in writing"
            }
          ],
          "text": "Based on former FBI hostage negotiator Chris Voss's Never Split the Difference. Its premise is that people want to feel understood and safe, so empathy and listening move a deal more than argument or compromise, and no deal beats a bad deal. Its techniques: tactical empathy, voicing the other side's situation; mirroring, repeating their last few words as a question, then waiting; labeling emotions with \"It seems like...\"; calibrated questions that start with how or what, never why, such as \"How am I supposed to do that?\"; an accusation audit that names every negative thing they might think before they say it; and summarizing their view until they answer \"That's right\" rather than \"You're right\". Ackerman bargaining sets a target, opens at 65% of it and moves to 85%, 95% and 100%, ending on a precise number with a non-monetary extra. It hunts for Black Swans, hidden facts that change the deal, and adapts to analyst, accommodator and assertive counterparts. A reference file holds all 21 techniques. Six preparation checks and four execution points set the score.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/negotiation"
        },
        "tags": [
          "category:personal",
