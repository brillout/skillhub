      "skillMd": {
        "version": "0217868a5820d791730e5c1e172d094c134ff86e",
        "updated": "2026-11-11",
        "skew": 420
      },
      "agentReview": {
        "description": "Operates desktop apps on macOS, Windows and Linux through their accessibility trees with the agent-desktop CLI: clicks, typing, menus, windows and screenshots.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "The agent has to see or act on a desktop app's interface rather than a web page or a file"
            },
            {
              "label": "It does",
              "text": "Takes a snapshot of an app's accessibility tree, acts on an element by its ref, then reads the same region again to check the result"
            },
            {
              "label": "Unlike screenshot-based computer use",
              "text": "This one reads the OS accessibility tree, and its default actions don't take focus, move your cursor or press keys"
            },
            {
              "label": "Physical input",
              "text": "Hover, drag, double-click and focus need the --headed flag, used only when you've explicitly allowed physical input, never to recover from a failed action"
            },
            {
              "label": "Needs",
              "text": "The agent-desktop CLI; on first run it loads the macOS, Windows or Linux skill that the CLI itself ships"
            }
          ],
          "text": "agent-desktop is Vercel Labs' command-line tool for reading and operating desktop apps through the operating system's accessibility tree. It has no model of its own, so the agent runs the observe, act and verify loop. On first run the agent checks the platform and permissions with agent-desktop status and loads the platform skill the CLI serves. It maps a large app with a shallow skeleton snapshot, drills into one region, acts on a ref such as @s8f3k2p9:e12, and re-reads that region to verify. Refs last for one snapshot: STALE_REF or an expired snapshot means taking a new one, while AMBIGUOUS_TARGET means identical twins that a new snapshot won't separate, and on Windows and Linux identical buttons can't be targeted by ref at all. Every action reports whether it was delivered, and the agent retries only when it certainly wasn't, to avoid clicking or submitting twice. Actions are headless by default, through accessibility calls only; physical input needs --headed, used only when you allow it and never to recover from a failure. Reference files cover observation, interaction and system commands, and worked patterns.",
          "permalink": "https://github.com/vercel-labs/agent-desktop/tree/b43ac4f6e892ef608f8851428613c4009f0e84c7/skills/agent-desktop"
        },
        "tags": [
          "category:computer-use",
          "type:tool",
          "effect:local",
          "needs:cli",
          "by:official",
          "stack:agent-desktop",
          "computer-use",
          "agent-workflows"
        ],
        "note": "Its snapshots, screenshots and clipboard reads can contain private content from your desktop, as its README warns.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
