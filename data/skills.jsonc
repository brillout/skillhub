    {
      "id": "paramchoudhary/resumeskills/skills/offer-comparison-analyzer",
      "name": "offer-comparison-analyzer",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/offer-comparison-analyzer",
        "installs": 8800,
        "weeklyInstalls": [353, 275, 298, 379, 395, 373, 355, 429],
        "firstSeen": "2026-05-20"
      },
      "skillMd": {
        "version": "74ae19e7c62b0516d1c298328e5544976c12da5d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Compares job offers side by side: total compensation for year one and after, scored non-money factors, and a weighted decision matrix with a recommendation.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have two or more job offers and can't decide between them"
            },
            {
              "label": "It does",
              "text": "Totals cash, equity, benefits and perks for year one and after, then scores growth, work-life, culture and risk out of 10 against weights you set"
            },
            {
              "label": "You get",
              "text": "A comparison: compensation and non-monetary tables, weighted scores, key differences, a recommendation, questions to clarify and negotiation openings"
            },
            {
              "label": "Also flags",
              "text": "Vague bonus language, a vesting cliff over a year, non-competes, recent layoffs and promises that aren't in writing"
            }
          ],
          "text": "A systematic way to choose between offers whose pay is structured differently. Total compensation adds base pay, signing and target bonuses, equity (options valued at current price minus strike, RSUs at current price times shares, spread over the vesting period), benefits such as the 401(k) match and the employer's share of health insurance, and perks given a dollar value, such as extra vacation days or commute savings. Year-one and ongoing totals are kept apart, since a signing bonus comes once. The non-monetary factors are career growth, work-life balance, team and culture, and risk, including that startup equity could be worth nothing. The weighted matrix has you set weights that add up to 100%, score each offer from 1 to 10 on each factor, and multiply. It lists red flags in the offer, the company and the role, and gut checks such as which job you'd want to wake up for on Monday and which choice you'd regret. For negotiating the offer you pick, salary-negotiation-prep in the same repo has scripts.",
          "permalink": "https://github.com/paramchoudhary/resumeskills/tree/74ae19e7c62b0516d1c298328e5544976c12da5d/skills/offer-comparison-analyzer"
        },
        "tags": [
          "category:careers",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "personal",
          "finance"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "paramchoudhary/resumeskills/skills/reference-list-builder",
      "name": "reference-list-builder",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/reference-list-builder",
        "installs": 8700,
        "weeklyInstalls": [352, 275, 295, 376, 391, 370, 347, 426],
        "firstSeen": "2026-05-20"
      },
      "skillMd": {
        "version": "74ae19e7c62b0516d1c298328e5544976c12da5d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Helps you choose three to five job references, format their details for a separate page, and draft the permission request, briefing email and thank-you.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "An employer asks for references, or you're preparing them ahead of final-round interviews"
            },
            {
              "label": "It does",
              "text": "Ranks who to ask, recent direct managers first, and plans three steps: ask permission, brief each reference, follow up afterwards"
            },
            {
              "label": "You get",
              "text": "A reference list with backups and what each person can speak to, a permission script, a briefing email and a thank-you template"
            },
            {
              "label": "Key question",
              "text": "Brief your references for \"would you rehire them?\", which it calls the most important one"
            }
          ],
          "text": "This skill treats references as something to prepare, not just list. It ranks who makes a good reference, from a recent direct supervisor down to clients and professors, and who to avoid: your current employer without permission, friends, people who barely know you, and anyone who might be lukewarm. The list goes on a separate page in your resume's style, with name, title, company, phone, email and your working relationship for each of three to five people. Preparation has three steps: ask permission with a short script, brief each reference with your resume, the job description and the points and projects to mention, and thank them afterwards whatever the outcome. It covers an employer who doesn't know you're looking, a manager who has left, a bad relationship with a past manager and little work experience, lists what reference checkers usually ask, and says to share the list only when asked, usually in the final rounds, confirming permission each time.",
          "permalink": "https://github.com/paramchoudhary/resumeskills/tree/74ae19e7c62b0516d1c298328e5544976c12da5d/skills/reference-list-builder"
        },
