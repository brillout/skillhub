      "agentReview": {
        "description": "Writes and plans social media posts for LinkedIn, X, Instagram, TikTok and Facebook, from hooks and carousels to repurposing, calendars and short-form video scripts.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need posts, a content calendar or ideas for what to post, or want to turn a blog post or podcast into social content"
            },
            {
              "label": "It does",
              "text": "Builds 3-5 content pillars, writes hooks and posts per platform, and cuts long content into standalone pieces"
            },
            {
              "label": "You get",
              "text": "Post drafts, carousel slide plans, a weekly calendar, and short video scripts timed second by second"
