      "agentReview": {
        "description": "Applies a web-app security checklist with code patterns for secrets, input validation, SQL injection, auth, XSS, CSRF, rate limiting and data exposure.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're adding authentication, user input, secrets, API endpoints or payment features to a web app"
