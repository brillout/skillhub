        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want an executive overview, a monitoring snapshot or a shareable report with several charts and filters in one file"
            },
            {
              "label": "You get",
              "text": "One HTML file with KPI cards, Chart.js charts, filters and a sortable table, its data embedded as JSON, opened in your browser"
            },
