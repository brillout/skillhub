      "agentReview": {
        "description": "Rewrites your LinkedIn headline, About section and experience entries around the keywords recruiters search for, with a checklist for photo, skills and recommendations.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're job hunting and want recruiters to find you on LinkedIn, or your profile doesn't match your resume"
            },
            {
              "label": "It does",
              "text": "Rewrites your headline (role, expertise, value), About section and experience entries around the terms recruiters search for"
