    {
      "id": "conorbronsdon/avoid-ai-writing/skills/avoid-ai-writing",
      "name": "avoid-ai-writing",
      "skills.sh": {
        "url": "https://skills.sh/conorbronsdon/avoid-ai-writing/avoid-ai-writing",
        "installs": 5200,
        "weeklyInstalls": [246, 295, 249, 245, 245, 234, 236, 241],
