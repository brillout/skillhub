        "installs": 8100,
        "weeklyInstalls": [277, 263, 278, 253, 273, 278, 354, 354],
        "firstSeen": "2026-02-10"
      },
      "skillMd": {
        "version": "734998e5fdbb16cd96dbaafe2da24eee6fb0d291",
        "updated": "2026-11-11",
        "skew": 193
      },
      "agentReview": {
        "description": "Audits how likely AI Overviews, ChatGPT, Perplexity and other answer engines are to cite your pages, and what to change.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want your pages quoted in Google's AI Overviews and AI Mode, ChatGPT, Perplexity or Gemini"
            },
            {
              "label": "It does",
              "text": "Scores citability, structure, multimedia, authority and brand signals, and technical access, and checks each AI crawler in robots.txt"
            },
            {
              "label": "You get",
              "text": "GEO-ANALYSIS.md: a readiness score, access per crawler, brand presence on Wikipedia, Reddit, YouTube and LinkedIn, and passages to rewrite"
            },
            {
              "label": "GEO means",
              "text": "Generative engine optimization, getting cited in AI answers; it follows Google's line that this is still SEO"
            },
            {
              "label": "Unlike seo-technical",
              "text": "That one covers AI crawlers briefly and points here for the full table; this one scores how quotable the content is and the brand's presence elsewhere"
            }
          ],
          "text": "Its five weighted criteria are citability (25%: self-contained, quotable answer blocks near the top of the page), structural readability (20%), multimedia (15%), authority and brand signals (20%), and technical accessibility (20%: server-side rendering and crawler access). Each claim about access is tied to the right bot: GPTBot is OpenAI's training crawler, while OAI-SearchBot decides ChatGPT Search citations, and the same split holds for ClaudeBot and Claude-SearchBot, Google-Extended and Googlebot, Applebot-Extended and Applebot. llms.txt is reported but carries no weight, since Google says it doesn't help. Platform scores are given only when measured with a tool such as DataForSEO; otherwise readiness is described, not scored. It treats AI Overviews and AI Mode as separate citation engines, notes that brand mentions correlate with AI visibility more than backlinks, and quotes third-party figures only with their source and date. It lists quick wins, such as a definition in the first 60 words, and longer plays like original research or a Wikipedia presence. With DataForSEO it can check what ChatGPT's search actually returns.",
          "permalink": "https://github.com/AgriciDaniel/claude-seo/tree/6be93f45064ffbadced572b5d5c95f55fd263af0/skills/seo-geo"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:local",
          "by:community",
          "seo",
          "marketing",
          "needs:claude-code"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
