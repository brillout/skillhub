    {
      "id": "miqdadbadjuber/anti-slop/skills/antislop-copywriting",
      "name": "antislop-copywriting",
      "skills.sh": {
        "url": "https://skills.sh/miqdadbadjuber/anti-slop/antislop-copywriting",
        "installs": 8900,
        "weeklyInstalls": [826, 886, 613, 810, 781, 862, 958, 1026],
        "firstSeen": "2026-08-15"
      },
      "skillMd": {
        "version": "9504989f162a92b1996853eccbb3d8a86e73df68",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Keeps AI tells out of headlines, CTAs and prose, from buzzwords and rule-of-three padding to em dashes, without inventing facts or erasing your voice.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "The agent writes or edits marketing copy, product copy or any prose people will read"
            },
            {
              "label": "It does",
              "text": "Lists 30 AI writing patterns, each with why it reads as AI and a before-and-after rewrite, under the core's rule numbers"
            },
            {
              "label": "You get",
              "text": "Copy run through a draft, audit and final pass, then checked against a copywriting checklist alongside the core's Delivery Gate"
            },
            {
              "label": "Won't",
              "text": "Add a fact, name, number, date or quote that isn't in your source, or treat polish, formal words or one em dash as proof of AI"
            },
            {
              "label": "Needs",
              "text": "The core antislop skill, which holds the hard bans it relies on"
            }
          ],
          "text": "antislop's copy skill. Its patterns run from tone (empty words such as unlock, elevate and seamless, significance inflation, weasel attributions, chatbot closers, fake-candid openers) through rhythm (forced rule of three, \"it's not just X, it's Y\", staccato fragments, theatrical takeaways such as \"Let that sink in.\") and honesty (fabricated specifics, speculative gap-filling) to hygiene (em dashes, boldface and quotation-mark overuse, title case in bullets, emoji in headings, filler and hedging). It warns against over-sterilizing: copy with no voice reads as machine-made too, so a voice you supply is kept. Given a sample of your writing, it matches its sentence lengths, vocabulary and quirks first, and raises any em dashes in it for you to keep or drop rather than cutting them silently. It lists what not to flag, such as perfect grammar or formal vocabulary on its own, and signs of human writing to preserve, such as odd specific detail and mixed feelings. Before delivering, it drafts, asks what still reads as AI and whether any fact isn't in the source, then revises and checks for dashes once more.",
          "permalink": "https://github.com/miqdadbadjuber/anti-slop/tree/9504989f162a92b1996853eccbb3d8a86e73df68/skills/antislop-copywriting"
        },
