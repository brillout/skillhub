      },
      "agentReview": {
        "description": "Tests a staging or preview site through a browser MCP, from console errors to forms, breakpoints and accessibility, and gives a ship verdict.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A feature just reached staging or preview, or a frontend PR needs checking before it ships"
            },
            {
              "label": "It does",
              "text": "Drives the pages through Claude in Chrome, Playwright or Puppeteer in four phases: smoke test, interactions, visual regression and accessibility"
            },
            {
              "label": "You get",
              "text": "A QA report ending in SHIP, SHIP WITH FIXES or DO NOT SHIP, or INCONCLUSIVE when there are no baseline screenshots"
            },
            {
              "label": "Stays",
              "text": "Read-only by default: no checkout, payment or delete journeys on production, test credentials only, and secrets redacted from screenshots"
            },
            {
              "label": "Needs",
              "text": "A browser automation MCP, and committed baseline screenshots for the visual comparison"
            }
          ],
          "text": "ECC's browser QA has the agent use a live site the way a user would. The smoke test loads the page, filters analytics noise out of the console, checks for 4xx and 5xx responses, takes desktop and mobile screenshots and measures LCP, CLS and INP against web.dev thresholds. Interaction tests click every nav link, submit forms with valid and invalid data, log in, open a protected page and log out with test credentials, and walk critical journeys. Visual regression screenshots key pages at 375, 768 and 1440 pixels, compares them with committed baselines, flags layout shifts over 5 pixels, missing elements and overflow, and checks dark mode. The accessibility phase runs axe-core or similar for WCAG 2.2 AA violations and checks keyboard navigation and landmarks, with a reminder that automated checks cover only 30 to 40 percent of WCAG, so a clean run doesn't make a page accessible. Journeys that change data, such as checkout or deletion, run only on staging and only when you opt in.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/browser-qa"
