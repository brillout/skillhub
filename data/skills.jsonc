      "agentReview": {
        "description": "Suggests GitHub Copilot custom agents from the awesome-copilot catalog that fit your repo, flags outdated local copies, and installs the ones you pick.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to know which awesome-copilot custom agents would help in this repo, or whether your copies of them are out of date"
