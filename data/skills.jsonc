            {
              "label": "You get",
              "text": "A .drawio file and a 300dpi PNG, with the spec and other sidecars kept in .drawio-tmp/ for later edits"
            },
            {
              "label": "Imports",
              "text": "Declared Terraform, Kubernetes, Compose, SQL DDL, OpenAPI and CI configs, and module relationships from Python, JavaScript/TypeScript, Go or Rust code"
            },
            {
              "label": "Needs",
              "text": "Node 20+; draw.io Desktop for PNG, PDF and JPG, otherwise a standalone SVG"
