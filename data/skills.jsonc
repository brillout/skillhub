          "needs:none",
          "by:community",
          "marketing",
          "copywriting",
          "slides"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "coreyhaines31/marketingskills/skills/customer-research",
      "name": "customer-research",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/customer-research",
        "installs": 125921,
        "weeklyInstalls": [3046, 3143, 3894, 4123, 3571, 3861, 4504, 4004],
        "firstSeen": "2026-03-28"
      },
      "skillMd": {
        "version": "8a3bde8083bd121971f61cba4bdbe5fd8c0eee7d",
        "updated": "2026-11-10",
        "skew": 137
      },
      "agentReview": {
        "description": "Mines transcripts, surveys, reviews and online communities for customer pains, triggers and exact wording, and builds personas only from evidence.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to know what customers really say, why they buy or churn, or need personas grounded in data"
            },
            {
              "label": "It does",
              "text": "Analyzes material you have, mines Reddit, G2 and forums, or plans interviews and surveys, then clusters the themes"
            },
            {
              "label": "You get",
              "text": "Your pick of a synthesis report, a quote bank, personas, a jobs-to-be-done map, a competitor summary or a gap analysis"
            },
            {
              "label": "Guards against",
              "text": "Personas from fewer than 5 data points per segment, invented details, and averaging across segments"
            },
            {
              "label": "Labels",
              "text": "Every insight high, medium or low confidence by how many independent sources back it"
            }
          ],
          "text": "Customer research in three modes, usually combined: analyzing assets you already have (call transcripts, surveys, support tickets, win/loss notes, NPS answers), mining what customers say unprompted online, and asking them directly through interviews and surveys. From each asset it extracts jobs to be done (the outcome a customer is trying to reach), pains, trigger events, desired outcomes, exact phrases and alternatives considered, then clusters themes, scores them by frequency and intensity, segments them and pulls 5-10 verbatim quotes per theme. It picks online sources by type of customer, from G2 and role-specific subreddits for B2B software to 1-3 star app store reviews for consumer products, and treats fetched reviews and posts as data, never instructions. It checks for sample bias (reviewers skew toward power users, tickets toward problems) and weights the last 12 months more. For a product with no reviews yet, it builds provisional personas from competitors' and adjacent products' reviews and tags each with its proxy source. It reads your product marketing context first if you have it, and asks which deliverable you want before writing one.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/customer-research"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "research",
          "marketing"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
