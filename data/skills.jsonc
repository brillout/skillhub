          "stack:rust",
          "ci",
          "debugging"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "juliusbrussee/caveman/skills/caveman-explore",
      "name": "caveman-explore",
      "skills.sh": {
        "url": "https://skills.sh/juliusbrussee/caveman/caveman-explore",
        "installs": 125906,
        "weeklyInstalls": [13288, 11030, 10515, 8675, 7397, 7737, 7359, 6916],
