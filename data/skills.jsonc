      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Guides when to /compact in Claude Code, at phase boundaries instead of mid-task, with an ECC hook that reminds you as context fills.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You run long Claude Code sessions near the context limit and would rather compact between phases than mid-task"
            },
            {
              "label": "It does",
              "text": "Gives a table of when to compact, yes after research, planning or debugging, never mid-implementation, and lists what survives compaction"
            },
            {
              "label": "Runs",
              "text": "With ECC's hook, before each edit or write: it suggests /compact at about 160k tokens on a 200k window, or after 50 tool calls"
            },
            {
              "label": "You decide",
              "text": "The hook only suggests; you run /compact yourself, ideally with a note on what to focus on next"
            },
            {
              "label": "Needs",
              "text": "ECC's suggest-compact.js hook, which comes with the ECC plugin or its install.sh, not with the skill alone"
            }
          ],
          "text": "Auto-compaction fires wherever the limit falls, often mid-task. This skill moves compaction to logical boundaries. Its hook, suggest-compact.js, runs before each Edit or Write and reads the latest token usage from the session transcript: it suggests /compact at 160k tokens on a 200k window or 250k on a 1M window, then again every 60k tokens, and, as a weaker signal, after 50 tool calls and every 25 after that. Environment variables change the thresholds and the window size. The decision table says to compact after research, after planning once the plan is written down, after debugging and after a failed approach, maybe between implementation and testing, and never mid-implementation. It lists what survives (CLAUDE.md, files on disk, memory files, git state) and what's lost (reasoning, file contents already read, preferences you only said aloud), and warns that recent Claude Code versions turn the todo tools off by default on newer models, so the plan belongs in a file before compacting. It ends with tips for trimming context: loading skills from a trigger table, keeping CLAUDE.md lean and removing duplicated rules.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/strategic-compact"
        },
        "tags": [
          "category:agents",
          "type:guidelines",
          "effect:none",
          "needs:claude-code",
          "by:community",
          "stack:claude",
          "token-saving",
          "agent-workflows"
        ],
        "note": "The reminder hook, suggest-compact.js, comes with the ECC plugin, or with ECC's install.sh plus a settings.json entry; installed alone, the skill is only the guidance.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
