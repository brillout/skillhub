    {
      "id": "samber/cc-skills/skills/influence-and-negotiation",
      "name": "influence-and-negotiation",
      "skills.sh": {
        "url": "https://skills.sh/samber/cc-skills/influence-and-negotiation",
        "installs": 5300,
        "weeklyInstalls": [51, 174, 389, 565, 723, 774, 612, 259],
        "firstSeen": "2026-04-30"
      },
      "skillMd": {
        "version": "50a33836b20f690c668af557bd9ef9d07a8c7ef2",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Coaches you through a negotiation, from your mandate and the people involved to live replies and a debrief, for deals, raises and hires.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're preparing a sales deal, raise, collective bargaining round, hard 1:1, hiring close or cross-cultural deal, or they just said something and you need a reply"
            },
            {
              "label": "It does",
              "text": "Maps the people, sets your walk-away and targets per issue, pre-writes anchors, concessions and questions, coaches live replies and runs a debrief"
            },
            {
              "label": "You get",
              "text": "A preparation plan, drafted replies and scripts built on calibrated questions, and a debrief naming what went wrong"
            },
            {
              "label": "Keeps",
              "text": "A negotiation-<slug>/ folder of Markdown notes on context, people, numbers, a log and strategy, so a later session resumes where you stopped"
            },
            {
              "label": "Researches",
              "text": "Each named counterpart across LinkedIn, your CRM, Slack and open sources, and your alternatives, with parallel subagents"
            },
            {
              "label": "Not for",
              "text": "Cold outreach, contract wording, crisis negotiation such as hostage cases, or personal and family conflicts"
            }
          ],
          "text": "Its premise: most of the outcome is set before the meeting, you negotiate the underlying stake rather than the stated position, and the more emotionally invested side loses. Preparation asks one question at a time: stage, stakes, who's at the table, their last words verbatim, your authority and your walk-away, treating a vague answer as a gap to fix first. The mandate, which it calls a Mandascan, sets five points per issue (opening, ideal, target, escalation point, walk-away), with the walk-away sized from your best alternative (BATNA). Moves are written in advance: a non-round anchor, 3 or 4 concessions each traded for something, 5 or 6 \"what\" and \"how\" questions, labels that defuse objections, and a pre-mortem of the likeliest objection and the surprise move. Live, it classifies each \"no\" before answering, treats a stalled deal as indecision rather than a loss, and names manipulation patterns. Before any agreement the other side restates the terms. A debrief starts with how you feel, then five questions, while a background subagent checks for five closing mistakes. Drafted messages go through a humanizer that keeps the questions verbatim, and figures stay out of anything the other side sees.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2/skills/influence-and-negotiation"
        },
        "tags": [
          "category:writing",
          "category:business",
          "type:workflow",
          "effect:local",
          "needs:subagents",
          "by:community",
          "research",
          "writing",
          "flag:dual-use"
        ],
        "note": "Its preparation sends subagents to profile each named counterpart across LinkedIn, the web and any CRM, Slack or email you've connected, ruling out pretexting and paid non-public data. It saves the deal's notes, including your walk-away numbers, to a negotiation-<slug>/ folder without asking.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "samber/cc-skills/skills/press-release-writer",
      "name": "press-release-writer",
      "skills.sh": {
        "url": "https://skills.sh/samber/cc-skills/press-release-writer",
