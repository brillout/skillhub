      "agentReview": {
        "description": "Sets a product-specific design direction before UI work, then checks content states and the rendered interface at each target viewport, with recorded evidence.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're building or polishing a web page, dashboard, app or component that works but looks generic or wrong for its audience"
            },
            {
              "label": "It does",
              "text": "Picks purpose, audience, tone and one memorable detail before coding, then records the evidence behind each choice and every content state"
