      },
      "agentReview": {
        "description": "Downloads a YouTube video's transcript as Markdown or SRT, with chapters, speaker labels and its cover image, without an API key.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want the words of a YouTube video, or its thumbnail, saved as a file"
            },
            {
              "label": "It does",
              "text": "Fetches captions with its bundled script through YouTube's InnerTube API, falling back to yt-dlp when YouTube blocks it"
            },
            {
              "label": "You get",
              "text": "transcript.md with timestamped paragraphs, or transcript.srt, plus meta.json and imgs/cover.jpg, under youtube-transcript/<channel>/<title>/"
            },
            {
              "label": "Speakers",
              "text": "By default a subagent labels who is speaking, from the title, channel, description and conversation cues, and splits the text into chapters"
            },
            {
              "label": "Languages",
              "text": "Lists the available transcripts when you name no language, takes a language order, and can translate"
            },
            {
              "label": "Caches",
              "text": "Raw data per video, so reformatting it or asking only for the cover doesn't fetch it again"
            },
            {
              "label": "Needs",
              "text": "Bun or npx, plus yt-dlp as a fallback, which the agent sets up itself if it's missing; no API key or browser"
            }
          ],
          "text": "It works with manual and auto-generated captions and takes watch, youtu.be, embed and shorts links or bare video IDs, several at once. Chapters come from the timestamps in the video's description; without them, the text is grouped into paragraphs. For speaker identification, which it uses by default, the script saves a raw file with the metadata and the transcript in SRT form, then a subagent, which can be a cheaper model, rewrites it with speaker labels, short paragraphs and timestamps. Sentences are split on punctuation, including Chinese, Japanese and Korean, with timestamps shared out by length. When YouTube flags it as a bot, the script retries other client identities, then yt-dlp; passing your browser's cookies to yt-dlp is the last resort. It can skip auto-generated or manual transcripts, and --refresh ignores the cache.",
          "permalink": "https://github.com/jimliu/baoyu-skills/tree/ca703c2d7c2c4399a1dc0cf82224f8551e05a96d/skills/baoyu-youtube-transcript"
        },
