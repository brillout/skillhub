        "skew": 0
      },
      "agentReview": {
        "description": "Checks whether suspected security bugs are real, tracing data flow, exploitability and impact before giving each a true- or false-positive verdict.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A scanner, reviewer or another agent flagged a bug and you need to know if it's real and exploitable, not hunt for new ones"
            },
            {
              "label": "It does",
              "text": "Restates each claim, traces source to sink, proves attacker control and impact, sketches a proof of concept, argues against itself, then applies six gates"
            },
            {
              "label": "You get",
              "text": "A TRUE POSITIVE or FALSE POSITIVE verdict per bug with documented evidence, then the counts and both lists"
            },
            {
              "label": "Two paths",
              "text": "A linear checklist for clear single-component bugs; deep, task-tracked verification with subagents for races, cross-component or ambiguous claims"
            }
          ],
          "text": "From Trail of Bits. It starts by restating each claim precisely, with the exact bug, root cause, trigger, impact, threat model and bug class, because many false positives fall apart there. The standard path then traces data from source to sink across trust boundaries and validation, checks API contracts and compiler, runtime or OS protections, proves the attacker controls the input (with algebraic proofs for bounds bugs), separates real security impact from robustness issues and sketches a pseudocode proof of concept. A devil's-advocate step asks whether the code only looks dangerous, and also whether a real bug is being dismissed. Unresolved doubt escalates to deep verification, which splits each phase into dependent tasks, hands data-flow, exploitability and proof-of-concept work to the plugin's agents, running each phase's independent sub-steps in parallel, and builds executable or unit-test proofs of concept when feasible. With several bugs it restates them all first, then checks whether rejected findings chain into a viable attack. It rejects shortcuts such as rushing the remaining bugs or calling a pattern a vulnerability without tracing it.",
          "permalink": "https://github.com/trailofbits/skills/tree/e4dd0bb5b15535f7c5a0834187dffba6ac37e4ff/plugins/fp-check/skills/fp-check"
        },
        "tags": [
          "category:security",
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:subagents",
          "by:official",
          "security",
          "verification",
          "debugging"
        ],
        "note": "Deep verification delegates to the fp-check plugin's data-flow-analyzer, exploitability-verifier and poc-builder agents, which come with the Claude Code plugin rather than the skill alone.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
