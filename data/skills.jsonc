    {
      "id": "boristane/agent-skills/skills/logging-best-practices",
      "name": "logging-best-practices",
      "skills.sh": {
        "url": "https://skills.sh/boristane/agent-skills/logging-best-practices",
        "installs": 5000,
        "weeklyInstalls": [52, 58, 70, 43, 41, 33, 49, 61],
        "firstSeen": "2026-01-21"
