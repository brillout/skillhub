          "type:workflow",
          "effect:local",
          "needs:claude-code",
          "needs:subagents",
          "by:official",
          "security",
          "verification",
          "requirements",
          "code-review"
        ],
        "note": "Runs through its Claude Code plugin's /spec-to-code-compliance:spec-compliance command and spec-compliance-checker agent, so install the plugin from the trailofbits/skills marketplace, not the skill alone.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "trailofbits/skills/plugins/semgrep-rule-creator/skills/semgrep-rule-creator",
