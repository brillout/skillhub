      "agentReview": {
        "description": "Builds three-statement financial projections, linking income statement, balance sheet and cash flow, from your historical figures and driver assumptions.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need a five-year projection of a company's income statement, balance sheet and cash flow for a valuation, budget or plan"
