          "type:tool",
          "effect:local",
          "needs:cli",
          "by:official",
          "stack:agentshield",
          "stack:claude",
          "security",
          "guardrails"
        ],
        "note": "Runs AgentShield through npx or a global npm install. The optional --opus deep analysis needs your Anthropic API key, so your configuration goes to Anthropic's API.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
