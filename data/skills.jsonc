    {
      "id": "wondelai/skills/pragmatic-programmer",
      "name": "pragmatic-programmer",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/pragmatic-programmer",
        "installs": 6200,
        "weeklyInstalls": [155, 152, 141, 152, 266, 208, 137, 145],
        "firstSeen": "2026-02-23"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Applies Hunt and Thomas's The Pragmatic Programmer: no duplicated knowledge, independent components, tracer bullets, design by contract, reversible decisions and ranged estimates.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Code is rotting, you're estimating work, starting a project with vague requirements, or deciding build-vs-buy and how to keep a vendor choice reversible"
            },
            {
              "label": "It does",
              "text": "Checks a codebase and team habits against seven principles, from no duplicated knowledge to learning something every week"
            },
            {
              "label": "You get",
              "text": "A score out of 10 from seven checks, naming each failure and its fix"
            },
            {
              "label": "Unlike clean-code",
              "text": "That one, from the same repo, covers code-level quality; this one works at the level of systems and habits"
            }
          ],
          "text": "Based on Andrew Hunt and David Thomas's The Pragmatic Programmer, 20th anniversary edition. DRY (don't repeat yourself) is about knowledge, not text: each business rule or setting lives in one place, while two identical blocks serving different rules aren't duplication. Orthogonal components change without affecting each other, helped by layers, dependency injection and no global state. Tracer bullets are thin end-to-end slices of real code you keep, unlike prototypes, which explore one risk and are thrown away. Design by contract states what must be true before a routine runs, after it and always, and a broken contract crashes the program at once. Broken windows, hacks left unrepaired, invite more; one that can't be fixed now gets boarded up with a tracked ticket. Decisions stay reversible by hiding vendors and databases behind your own interfaces. Estimates come as ranges, using PERT (optimistic plus four times most likely plus pessimistic, divided by six) and a log of estimates against actuals. A knowledge portfolio means learning regularly, including beyond your stack.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/pragmatic-programmer"
        },
        "tags": [
          "category:engineering",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "code-quality",
          "architecture",
          "prototyping"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wondelai/skills/obviously-awesome",
