    {
      "id": "wondelai/skills/design-sprint",
      "name": "design-sprint",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/design-sprint",
        "installs": 5800,
        "weeklyInstalls": [146, 145, 135, 142, 263, 194, 131, 132],
