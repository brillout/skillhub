          "agent-workflows",
          "code-review",
          "testing",
          "architecture"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "affaan-m/ecc/skills/regex-vs-llm-structured-text",
      "name": "regex-vs-llm-structured-text",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/regex-vs-llm-structured-text",
        "installs": 5700,
        "weeklyInstalls": [257, 158, 150, 237, 415, 407, 480, 447],
        "firstSeen": "2026-05-19"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Parses structured text such as quizzes, forms and invoices with regex first, sending only low-confidence items to a cheap LLM to check.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're extracting records from text that follows a pattern, such as exam questions, forms, invoices or tables, and LLM cost matters"
            },
            {
              "label": "It does",
              "text": "Parses with regex first, scores each item's confidence, and sends only the items below 0.95 to the cheapest LLM for correction"
            },
            {
              "label": "You get",
              "text": "A hybrid parser design with Python code for the regex parser, confidence scorer, LLM validator and pipeline"
            },
            {
              "label": "Reports",
              "text": "On a 410-item quiz, regex handled 98% and about five LLM calls fixed the rest, around 95% cheaper than sending everything to an LLM"
            },
            {
              "label": "Unlike LLM-only extraction",
              "text": "For free-form, highly variable text, this one still says to use an LLM directly"
            }
          ],
          "text": "A decision framework and pattern for structured text. If more than 90% of the text follows a repeating pattern, start with regex; if regex handles 95% or more, no LLM is needed, and otherwise an LLM takes only the edge cases. Free-form text goes straight to an LLM. The pipeline runs a regex parser, a cleaner that strips markers, page numbers and other noise, and a confidence scorer that deducts for signs of a bad extraction, such as too few choices, a missing answer or very short text. Items under the threshold go to an LLM validator, a Haiku-class model in its example, which returns a corrected item or confirms the extraction. Its practices: start with imperfect regex as a baseline, return new objects instead of mutating parsed ones, write tests for known patterns before edge cases, and log the regex success rate and LLM call count.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/regex-vs-llm-structured-text"
        },
