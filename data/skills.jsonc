        "skew": 0
      },
      "agentReview": {
        "description": "Writes an llms.txt file at your repo's root, following the llmstxt.org spec, that points language models to your key docs and files.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want language models and agents to find their way around your repository from one index file"
            },
            {
              "label": "It does",
              "text": "Reviews the llms.txt spec, analyzes the repo's structure, docs, specs, examples and config, plans what matters most, then writes and checks the file"
            },
            {
              "label": "You get",
              "text": "/llms.txt: the project name as an H1, a blockquote summary, and H2 sections of described links such as Documentation, Specifications, Examples, Configuration and Optional"
            },
            {
              "label": "llms.txt",
              "text": "A Markdown file at the repository root that points language models to the files worth reading; links under Optional can be skipped when context is short"
            },
            {
              "label": "Unlike create-agentsmd",
              "text": "That one, from the same repo, tells coding agents how to build and test the project; this one indexes its documentation for any LLM"
            }
          ],
          "text": "The file is meant as an entry point for language models: the project name as the only H1, an optional blockquote summary, optional context paragraphs without headings, then H2 sections listing links in the form [name](relative-url): description. Before writing, the agent reviews the specification at llmstxt.org, examines the whole repository, reads the main README, and catalogs the documentation in folders such as /docs/ and /spec/ along with specification, example and configuration files, then plans which files matter most and how to group them. It includes files that explain the project's purpose, document it, show usage, define interfaces or cover setup, and leaves out implementation details, redundant content and build artifacts. Afterwards it checks the format against the spec, that every link is a valid relative path, and that the file reads well for people and machines alike. It writes the file from scratch; update-llms, from the same repo, refreshes an existing one.",
          "permalink": "https://github.com/github/awesome-copilot/tree/797337f33f73e35d08d82f840e21c4b8c4932d88/skills/create-llms"
        },
