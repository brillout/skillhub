    {
      "id": "wondelai/skills/hooked-ux",
      "name": "hooked-ux",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/hooked-ux",
        "installs": 6700,
        "weeklyInstalls": [161, 167, 144, 157, 301, 246, 166, 156],
        "firstSeen": "2026-01-30"
