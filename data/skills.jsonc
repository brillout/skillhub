    {
      "id": "thedotmack/claude-mem/plugin/skills/smart-explore",
      "name": "smart-explore",
      "skills.sh": {
        "url": "https://skills.sh/thedotmack/claude-mem/smart-explore",
        "installs": 7700,
        "weeklyInstalls": [113, 99, 102, 98, 135, 130, 147, 162],
        "firstSeen": "2026-02-26"
      },
      "skillMd": {
        "version": "3ab6e1a215c7bbcf716b9d8d763aa78bacba52a0",
        "updated": "2026-11-08",
        "skew": 11
      },
      "agentReview": {
        "description": "Explores code with claude-mem's tree-sitter search, outline and unfold tools instead of reading whole files, to spend fewer tokens.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want the agent to find its way around a codebase without reading whole files"
            },
            {
              "label": "It does",
              "text": "Replaces Read, Grep and Glob for code discovery with claude-mem's smart_search, smart_outline and smart_unfold tools"
            },
            {
              "label": "You get",
              "text": "Ranked symbols and file outlines first, then the full source of only the functions you need"
            },
            {
              "label": "Claims",
              "text": "4 to 8 times fewer tokens than reading files, and 11 to 18 times fewer than an Explore agent, by its own figures"
            },
            {
              "label": "Stays on",
              "text": "It overrides the agent's usual exploration for as long as it's active"
            },
            {
              "label": "Needs",
              "text": "claude-mem's MCP server"
            },
            {
              "label": "Languages",
              "text": "JavaScript, TypeScript, Python, Go, Rust, Ruby, Java, C and C++, plus Markdown headings"
            }
          ],
          "text": "The rule is to get a map before reading code. The tools parse source files with tree-sitter, which reads code as a syntax tree of functions, classes and methods rather than lines of text. smart_search walks a directory and returns matching symbols with signatures, line numbers and folded views of their files; smart_outline gives one file's skeleton; smart_unfold returns the complete source of one named symbol. The skill makes these the agent's first move for code, and keeps the standard tools for what they do better: Grep for exact strings, Read for small or non-code files, Glob for path patterns, and an Explore agent for explanations that span many files. In Markdown, outline lists the headings and unfold returns one section. Files in other languages get no symbols, so for those it uses a text search such as rg.",
          "permalink": "https://github.com/thedotmack/claude-mem/tree/24802b13ef5e9bf61a84e650af446c4ff69ab399/plugin/skills/smart-explore"
        },
        "tags": [
          "category:engineering",
          "type:tool",
          "effect:none",
          "needs:mcp",
          "by:official",
          "stack:claude-mem",
          "stack:tree-sitter",
          "token-saving",
          "agent-workflows"
        ],
        "note": "While active, it tells the agent to use claude-mem's smart_search, smart_outline and smart_unfold MCP tools instead of Read, Grep and Glob, so it needs claude-mem's MCP server.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "thedotmack/claude-mem/plugin/skills/make-plan",
      "name": "make-plan",
      "skills.sh": {
        "url": "https://skills.sh/thedotmack/claude-mem/make-plan",
        "installs": 7600,
        "weeklyInstalls": [105, 97, 94, 92, 138, 125, 138, 155],
        "firstSeen": "2026-02-24"
      },
      "skillMd": {
        "version": "24802b13ef5e9bf61a84e650af446c4ff69ab399",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Writes a phased implementation plan grounded in documentation that subagents gather first, ready to execute with do.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a plan for a feature or multi-step change before any code is written"
            },
            {
              "label": "It does",
              "text": "Sends subagents to find the real docs, API signatures and examples, then writes phases that each cite them"
            },
            {
              "label": "You get",
              "text": "A plan file that opens with the user-visible goal, plus a five-part summary of it in chat"
            },
            {
              "label": "Each phase has",
              "text": "What to copy from which file, doc references, a verification checklist and anti-pattern guards"
            },
            {
              "label": "Written for",
              "text": "Running one phase at a time in fresh chat contexts"
            },
            {
              "label": "Next",
              "text": "do, which executes the plan with subagents"
            }
          ],
          "text": "The agent acts as an orchestrator: subagents gather facts, and it writes the plan itself. Phase 0 is always documentation discovery, in which subagents must report their sources, exact API names and file paths, example locations and known gaps, or be sent back. The result is a list of allowed APIs, citing their docs, and of anti-patterns such as methods that don't exist. The plan opens with its primary goal, the outcome a user would see, and every phase starts with a short paragraph on how it serves that goal; a phase that can't honestly say so is cut. Tasks are framed as copying documented patterns rather than transforming existing code, and the last phase checks everything against the docs, greps for anti-patterns and runs the tests. In chat it presents the plan in a fixed format: goal, current state, idea, one line per step, and what's deferred. For a plan rooted in an issue backlog, it suggests the repo's oh-my-issues skill first.",
          "permalink": "https://github.com/thedotmack/claude-mem/tree/24802b13ef5e9bf61a84e650af446c4ff69ab399/plugin/skills/make-plan"
        },
        "tags": [
          "category:planning",
