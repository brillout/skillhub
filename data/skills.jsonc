      "id": "addyosmani/agent-skills/skills/frontend-ui-engineering",
      "name": "frontend-ui-engineering",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/agent-skills/frontend-ui-engineering",
        "installs": 80252,
        "weeklyInstalls": [4281, 4248, 4230, 5448, 6141, 5840, 5315, 4711],
