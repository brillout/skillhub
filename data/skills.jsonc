          "type:workflow",
          "effect:local",
          "needs:subagents",
          "by:community",
          "code-review",
          "planning",
          "handoff",
          "multi-agent"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
