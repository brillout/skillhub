      "agentReview": {
        "description": "Searches the web and domain sources such as finance or academic, and extracts page content, through the AnySearch service.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "The agent needs current facts or news, a page's full text, or data looked up by identifier, such as a stock symbol, a DOI or a CVE"
