    {
      "id": "rohitg00/agentmemory/plugin/skills/commit-context",
      "name": "commit-context",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/agentmemory/commit-context",
        "installs": 14400,
        "weeklyInstalls": [396, 372, 342, 312, 331, 319, 294, 256],
        "firstSeen": "2026-05-18"
      },
      "skillMd": {
        "version": "f0f7378ac42849b863fcc5c8e753f120d5ec6f9d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Traces a file, function or line to its commit and the agent session that produced it, through git and agentmemory.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You ask why some code is here, who wrote it, or what the agent was doing when it changed"
            },
            {
              "label": "It does",
              "text": "Finds the commit with git blame or git log, then looks it up in agentmemory for the agent session linked to it"
            },
            {
              "label": "You get",
              "text": "The commit's sha, branch, author and message, the linked session's summary and observation count, and its important observations"
            },
            {
              "label": "Needs",
              "text": "agentmemory's memory server and MCP tools, and git"
            },
            {
              "label": "Older commits",
              "text": "Made before session linking show no session, and the agent says so rather than guessing intent from the diff"
            }
          ],
          "text": "Part of agentmemory, a memory server that records what coding agents do in each session as observations. commit-context works backwards from code to the session linked to its commit. For a line range the agent runs git blame, for a function git log -L, and for a bare file path the last commit that touched it. It looks the full sha up in agentmemory and presents the commit, the linked sessions with their project, start and end, observation count and summary, and the observations of importance 7 or more when memory recall is available. When the lookup finds no commit record, the commit predates session linking: the agent says so and describes only what git shows, claiming no intent beyond what the observations state. commit-history lists many linked commits at once.",
          "permalink": "https://github.com/rohitg00/agentmemory/tree/f0f7378ac42849b863fcc5c8e753f120d5ec6f9d/plugin/skills/commit-context"
        },
        "tags": [
