          "effect:local",
          "needs:none",
          "by:official",
          "personal"
        ],
        "note": "It moves, renames and archives files on your computer once you approve its plan, and asks before deleting anything.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
