          "effect:none",
          "needs:none",
          "by:community",
          "personal",
          "writing"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "paramchoudhary/resumeskills/skills/portfolio-case-study-writer",
      "name": "portfolio-case-study-writer",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/portfolio-case-study-writer",
        "installs": 9200,
        "weeklyInstalls": [369, 293, 311, 388, 416, 398, 376, 476],
        "firstSeen": "2026-05-20"
      },
      "skillMd": {
        "version": "74ae19e7c62b0516d1c298328e5544976c12da5d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Expands a resume bullet into a portfolio case study: overview, problem, process, solution, results and learnings, with a list of visuals to add.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need portfolio case studies, common for PM, UX and creative roles, or a project write-up for your site"
            },
            {
              "label": "It does",
              "text": "Tells the project in six parts, overview, problem, process, solution, results and learnings, to show how and why, not just what"
            },
            {
              "label": "You get",
              "text": "A Markdown case study with quick facts, a before-and-after results table and a list of the images or screenshots it needs"
            },
            {
              "label": "Reading time",
              "text": "3-5 minutes for a quick read, 10-15 for a deep dive"
            }
          ],
          "text": "Resumes show what you did; case studies show how and why. This skill turns a resume bullet into a write-up in six sections. The overview gives the project, company, your role, timeline, team and a one-line result. The problem sets out the business context, user pain points, goals and constraints. The process shows the research, the options considered and the decisions made, with reasons. The solution describes what you built, with places for mockups and screenshots. Results compare before and after with numbers and a timeframe, and learnings cover what worked, what you'd do differently and the skills you gained. Its worked example is a checkout redesign that cut cart abandonment by 35%. The emphasis shifts by role: strategy and stakeholders for product managers, research and design process for designers, architecture for engineers, targeting and ROI for marketers. A checklist covers making your own contribution clear, honesty about challenges, and being able to discuss it in detail in an interview.",
          "permalink": "https://github.com/paramchoudhary/resumeskills/tree/74ae19e7c62b0516d1c298328e5544976c12da5d/skills/portfolio-case-study-writer"
        },
