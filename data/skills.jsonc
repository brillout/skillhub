    {
      "id": "samber/cc-skills/skills/copywriting-prose-creator",
      "name": "copywriting-prose-creator",
      "skills.sh": {
        "url": "https://skills.sh/samber/cc-skills/copywriting-prose-creator",
        "installs": 5400,
        "weeklyInstalls": [59, 170, 382, 532, 703, 753, 600, 255],
        "firstSeen": "2026-05-23"
      },
      "skillMd": {
        "version": "50a33836b20f690c668af557bd9ef9d07a8c7ef2",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Codifies how a brand or person writes, from lexicon and sentence length to rhythm and signature moves, into a PROSE.md guide.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A content team, ghostwriter or bot needs a house style so everyone writes like the brand"
            },
            {
              "label": "It does",
              "text": "Interviews you, matches the brand to one of 11 category playbooks, then codifies lexicon, syntax, rhythm, structure and voice markers"
            },
            {
              "label": "You get",
              "text": "PROSE.md, a 20 to 60 page guide with punctuation and formatting policies, channel overrides, anti-LLM rules and before/after samples"
            },
            {
              "label": "Three modes",
              "text": "BUILD a new guide, ADAPT one to another channel group, or AUDIT a corpus into an AUDIT-MEMO.md of measured patterns"
            },
            {
              "label": "Unlike copywriting-tone-of-voice-creator",
              "text": "That one, from the same repo, sets emotional tone in TONE.md; this one covers the measurable craft, and reads TONE.md when present"
            }
          ],
          "text": "\"Tone is the music, prose is the score\", it says. BUILD looks for SOUL.md, TONE.md, an earlier PROSE.md and a content corpus; when tone is missing it offers to run the tone skill first or capture it inline, and when a corpus exists it offers an audit first. The interview covers mission, category posture, audience, author archetype, goals, channels and constraints. For categories outside its playbooks, such as healthcare or crypto, it calls the repo's deep-research skill. Every rule comes with a reason: a target mean sentence length and spread, a short sentence every 3 to 5, banned words checked against the corpus with grep, hook and closing types, rationed signature moves. Channels are four groups: long-form, social, email and marketing copy. Multilingual brands get one guide per language, with French-English false friends and length budgets. Anti-LLM rules list words such as delve and leverage, structures such as lists of three and \"In conclusion\", and formula phrases, with counts used as triage, not proof. An audit runs up to five subagents on corpora over 50 pieces and sorts patterns into signature, default, noise and liability.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2/skills/copywriting-prose-creator"
        },
