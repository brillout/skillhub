        "skew": 0
      },
      "agentReview": {
        "description": "Finds the animations an interface doesn't need, deletes or tones them down, and cleans up the code they leave behind.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "An app feels slow or over-animated and you want motion taken out, not added or tuned"
            },
            {
              "label": "It does",
              "text": "Puts every animation through a decision tree: keyboard-triggered, seen 100+ times a day or on data you read means delete; frequent or over 300ms means reduce"
            },
            {
              "label": "You get",
              "text": "The edits in your code, then a report of what it removed or reduced and why, 2–5 animations it kept and their purpose, and the cleanup"
            },
            {
              "label": "Checks first",
              "text": "What a deletion would break, such as elements left at opacity 0, code waiting for an animation to end, or a layout jump the animation hid"
            },
            {
              "label": "Won't",
              "text": "Add motion, change easing or retune springs, and it asks before uninstalling a motion library"
            },
            {
              "label": "Unlike find-animation-opportunities",
              "text": "That one looks for places that should animate; this one takes motion away, and leaves fixing the animations it keeps to improve-animations"
            }
          ],
          "text": "Built on Emil Kowalski's essay \"You Don't Need Animations\", this skill reverses the burden of proof: an animation stays only if it can defend itself. The agent maps where motion lives and how often each animated surface is seen, then sweeps for kinds that rarely survive, such as fade-in on scroll, hover scale on cards, animated command palettes, charts that redraw from zero and spinners on operations under 300ms. Each candidate goes through a decision tree. Keyboard-triggered, very frequent or data animations are deleted; frequent ones and any over 300ms are reduced to a smaller version of the same motion; rare first-time moments, the delight budget, stay. Marketing pages get more latitude than product UI. Before deleting, it checks what depends on the animation: hidden start states, listeners waiting for it to end, exit animations delaying unmount, focus moves and tests. It then removes orphaned keyframes, motion.div wrappers and imports, runs the type checker and tests, and greps to confirm nothing still refers to what it deleted. Badly built animations it keeps are listed for improve-animations.",
          "permalink": "https://github.com/emilkowalski/skills/tree/c8a79627b59d72d764d6ab6f2c87c09a48169833/skills/remove-animations"
        },
        "tags": [
          "category:design",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "animation",
          "design"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
