    {
      "id": "samber/cc-skills@technical-article",
      "skew": 0,
      "agentReview": {
        "name": "Technical article writing",
        "description": "Writes a developer blog post end to end: interview, titles, a hook you pick, the draft, and an end-of-article CTA designed for your goal.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to publish a tutorial, explainer, benchmark, bug hunt or postmortem for developers, from idea to finished post"
            },
            {
              "label": "It does",
              "text": "technical-article-writer runs the interview, titles and draft, and calls copywriting-hooks for the opening and copywriting-cta for the ending"
            },
            {
              "label": "You get",
              "text": "A Markdown article with your chosen title and hook, the body, a CTA with copy, layout, A/B plan and accessibility checks, and image ideas"
            },
            {
              "label": "Pauses",
              "text": "For your pick of title, hook and CTA inputs; nothing is drafted before the interview is answered"
            },
            {
              "label": "Also needs",
              "text": "A humanizer skill for the final pass, which isn't part of the bundle"
            }
          ],
          "text": "Three skills from samber/cc-skills that work as one pipeline. technical-article-writer starts by asking the topic, a single objective, the audience, content type, length and a one-sentence thesis, then tests the idea for novelty and offers ten titles. For the opening it hands over to copywriting-hooks, which proposes 3 or 4 hooks built on different levers, such as a curiosity gap, a contrarian claim or a scene, two candidates each, and waits for your choice; the writer then adds the stakes and a promise around it. After the body and conclusion, copywriting-cta takes the objective from the interview, asks what it still needs, such as the publication context, your relationship with readers and the funnel stage, and prescribes the end-of-article CTA: exact copy, placement, any persuasion mechanism such as urgency or social proof, an A/B test and accessibility checks. A humanizer pass follows that leaves the title and hook alone, then image suggestions and a final pick among the top three titles. Both copywriting skills also work alone, for any long-form article.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2"
        },
        "skills": [
          {
            "id": "samber/cc-skills/skills/technical-article-writer",
            "standalone": false,
            "note": "Hands the opening hook to copywriting-hooks and the end-of-article CTA to copywriting-cta, and tells the agent not to write either itself."
          },
          {
            "id": "samber/cc-skills/skills/copywriting-hooks",
            "standalone": true,
            "listedOutsideBundle": true
          },
          {
            "id": "samber/cc-skills/skills/copywriting-cta",
            "standalone": true,
            "listedOutsideBundle": true
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add https://github.com/samber/cc-skills --skill technical-article-writer --skill copywriting-hooks --skill copywriting-cta"
          },
          {
            "label": "Claude Code plugin, after /plugin marketplace add samber/cc; with the repo's 18 other skills",
            "command": "/plugin install cc-skills@samber"
          },
          {
            "label": "Gemini CLI extension, with the repo's 18 other skills",
            "command": "gemini extensions install https://github.com/samber/cc-skills"
          },
          {
            "label": "Codex plugin, with the repo's 18 other skills",
            "command": "codex plugin add github:samber/cc-skills"
          },
          {
            "label": "GitHub Copilot CLI plugin, with the repo's 18 other skills",
            "command": "/plugin install https://github.com/samber/cc-skills"
          }
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
