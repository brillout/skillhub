    {
      "id": "miqdadbadjuber/anti-slop/skills/antislop",
      "name": "antislop",
      "skills.sh": {
        "url": "https://skills.sh/miqdadbadjuber/anti-slop/antislop",
        "installs": 10400,
        "weeklyInstalls": [940, 1403, 722, 890, 875, 1031, 1129, 1124],
        "firstSeen": "2026-08-15"
      },
      "skillMd": {
        "version": "9504989f162a92b1996853eccbb3d8a86e73df68",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Filters the generic AI look out of interfaces with 40 rules and a PASS/FAIL gate, while building or as an audit of finished work.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "An agent builds UI for you and you don't want it to look generated, or you want existing UI audited for AI patterns"
            },
            {
              "label": "It does",
              "text": "Holds every visual choice to a purpose test: a gradient, badge or glow stays only with a written reason, while honesty, function and accessibility rules are absolute"
            },
            {
              "label": "Modes",
              "text": "Asks each session whether to apply the rules while building or to audit afterwards, unless you saved a default"
            },
            {
              "label": "You get",
              "text": "A PASS/FAIL Delivery Gate report with evidence, or a numbered findings file in anti-slop/ where only the numbers you approve get fixed"
            },
            {
              "label": "Needs",
              "text": "Your design direction in DESIGN.md or a brief; without it, output is labelled a draft without direction"
            },
            {
              "label": "Unlike a style guide",
              "text": "It prescribes no colors, fonts or layouts"
            }
          ],
          "text": "The core of antislop, a rulebook against AI slop: the generic, recognizable look of model-made interfaces. Its 40 rules come in three tiers. Hard Gate rules are absolute: no em dashes, no statistics or testimonials without a real source, no invented claims, ask before creating logos, avatars or numbers, no nav links or buttons that go nowhere, WCAG AA contrast, empty, loading and error states, keyboard access, and running the app and clicking every control before delivery. Purpose-Gate rules allow techniques such as gradients, glassmorphism and badges only with a written reason, and Quality Locks catch template layouts, generic CTAs and buzzwords. Because removing slop can leave a sterile page, it also requires liveliness: three dials, energy, rhythm and motion, each set from 1 to 3 from your direction or a one-line read of the brief, plus one focal point per screen, one deliberate accent and a repeated identity motif. The Delivery Gate checks all of this in four blocks, and any FAIL means fix and re-run before handing over. In audit mode, nothing changes until you approve findings by number, and a follow-up report closes the run.",
          "permalink": "https://github.com/miqdadbadjuber/anti-slop/tree/9504989f162a92b1996853eccbb3d8a86e73df68/skills/antislop"
        },
        "tags": [
          "category:design",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "design",
          "anti-slop",
          "accessibility"
        ],
        "note": "Asks at the start of every session whether to apply its rules while building or to audit afterwards, unless you save a default with npx antislop-ai --mode; for UI you mean to ship, it wants a DESIGN.md or brand direction.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
