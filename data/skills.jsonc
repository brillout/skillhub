      "name": "course-guide",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/ai-engineering-from-scratch/course-guide",
        "installs": 5000,
        "weeklyInstalls": [196, 273, 447, 389, 303, 330, 353, 318],
        "firstSeen": "2026-08-02"
