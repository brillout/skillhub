      },
      "skillMd": {
        "version": "25eec57919aec2cfd87d4ef9ae5661832302585e",
        "updated": "2026-11-12",
        "skew": 1677
      },
      "agentReview": {
        "description": "Detects your game's engine from its project files and your task from the request, then loads only the matching skills from this game-dev collection.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You start any game-development request, or aren't sure which of the collection's skills applies"
            },
            {
              "label": "It does",
              "text": "Fingerprints the project to pick one of twelve engines, sorts the request into concepts, usually one genre at most, and process or shipping workflows, then reads only those skills"
            },
            {
              "label": "You get",
              "text": "A short announcement of what it loaded and why, then work ordered engine basics, concept, genre glue, workflow"
            },
            {
              "label": "No engine yet",
              "text": "A pure concept question needs none; it asks once only if the choice blocks the answer, and picks Godot for a new project with no preference"
            },
            {
              "label": "Custom engine",
              "text": "Kept, with the concepts mapped onto the project's own APIs from its code and docs"
            },
            {
              "label": "Needs",
              "text": "The whole repo installed beside it, including the engine, Steam and itch skills it routes to, which SkillHub doesn't list"
            }
          ],
          "text": "The entry point of a game-development skill collection. It reads project files to pick one engine: a project.godot means Godot, a *.uproject Unreal, a go.mod requiring Ebitengine, a phaser dependency in package.json Phaser, and so on for twelve engines. Then it reads the engine version, so existing projects keep their pinned APIs. It classifies the request into three additive groups: cross-engine disciplines such as save-systems or camera-systems, usually at most one genre such as platformer or rpg, and workflows such as game-jam or steam-publish. Ownership is split: the engine skill owns API and syntax, the discipline owns the portable concept, and the genre owns the glue and links out. It reads only the chosen skills' bodies, and their reference files only on demand, and re-routes when the task pivots to a new engine or concern. When no skill covers a subtask, it loads the closest one for that engine and states the gap, never inventing a skill name. Its references hold the full fingerprints, every trigger word and the custom-engine mapping.",
          "permalink": "https://github.com/gamedev-skills/awesome-gamedev-agent-skills/tree/19d93f97c9c1ea0f8b306e77aa81e0d3e352d3e9/router"
        },
        "tags": [
          "category:skill-tools",
          "category:games",
          "type:router",
          "effect:none",
          "needs:none",
          "by:community",
          "skill-discovery"
        ],
        "note": "Routes to the repo's other skills, engine manuals included, so it needs the whole repo installed beside it.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
