      "agentReview": {
        "description": "Writes sales, project and partnership proposals and quick quotes from templates, with pricing options, a timeline and clear next steps.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need a sales or service proposal, a quick quote, a partnership proposal or an RFP response for a specific client"
