      "agentReview": {
        "description": "Creates PowerPoint decks from scratch with PptxGenJS, one JavaScript module per slide, and edits or reads existing decks through their XML and markitdown.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need a new PowerPoint deck built from a topic, or want to edit or read an existing .pptx"
            },
            {
              "label": "It does",
              "text": "Picks a palette, fonts and one of four styles, classifies every slide as one of five page types, writes one JavaScript file per slide, then compiles them"
            },
            {
              "label": "You get",
              "text": "slides/output/presentation.pptx, with one JavaScript file per slide and the images they use in slides/"
            },
            {
              "label": "Checks",
              "text": "Extracts the deck's text with markitdown to find missing content and leftover placeholders, then fixes and re-checks until a pass finds nothing new"
            },
            {
              "label": "Needs",
              "text": "Node with pptxgenjs and Python with markitdown; react-icons and sharp are optional, for icons"
