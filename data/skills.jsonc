      }
    },
    {
      "id": "trailofbits/skills/plugins/agentic-actions-auditor/skills/agentic-actions-auditor",
      "name": "agentic-actions-auditor",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/agentic-actions-auditor",
        "installs": 7300,
        "weeklyInstalls": [132, 122, 122, 149, 154, 187, 200, 217],
        "firstSeen": "2026-02-26"
      },
      "skillMd": {
        "version": "e4dd0bb5b15535f7c5a0834187dffba6ac37e4ff",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits GitHub Actions workflows that run AI coding agents for paths where attacker-controlled input reaches the agent, and reports each finding with a fix.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your CI runs Claude Code Action, Gemini CLI, OpenAI Codex or GitHub AI Inference and you want to know whether outsiders can steer it"
            },
            {
              "label": "It does",
              "text": "Finds the AI steps, follows composite actions and reusable workflows one level deep, captures triggers, env, permissions and sandbox settings, then checks nine attack vectors"
            },
            {
              "label": "You get",
              "text": "One report with findings grouped by workflow and ordered by severity, each with evidence, an attacker-to-agent data-flow trace and action-specific remediation"
            },
            {
              "label": "Works on",
              "text": "A local checkout, or a remote owner/repo whose workflow files it fetches with gh"
            }
          ],
          "text": "From Trail of Bits. The nine vectors are env-var intermediaries (event data reaching the prompt through an env: block, the most often missed), direct ${{ }} expression injection, prompts that fetch issue or PR text with gh, pull_request_target with a checkout of the PR head, CI logs or dispatch inputs fed to the prompt, allowed tools that permit $() subshell expansion, eval of the agent's output, dangerous sandbox settings such as danger-full-access, Bash(*) or --yolo, and wildcard user allowlists. Severity depends on context: external triggers, loose sandboxes, wildcard allowlists, broad permissions and secret access raise it, and a dangerous setting with no injection path is only Info or Low. It treats fetched YAML strictly as data, uses Bash only for gh api calls and doesn't modify workflow files. A clean repo still gets a report of what was scanned. It covers GitHub Actions only, not Jenkins, GitLab CI or CircleCI.",
          "permalink": "https://github.com/trailofbits/skills/tree/e4dd0bb5b15535f7c5a0834187dffba6ac37e4ff/plugins/agentic-actions-auditor/skills/agentic-actions-auditor"
        },
        "tags": [
