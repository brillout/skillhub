      "skillMd": {
        "version": "e706ea0c6401f92af2ff7098c941bd7f59039058",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Tunes existing motion against the transitions.dev token scale for duration, distance, scale, blur and easing, applying rules for open, close, hover and stagger.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your animations work but feel slow, janky or inconsistent, and you want their values on one scale"
            },
            {
              "label": "It does",
              "text": "Scans stylesheets, inline styles, CSS-in-JS and Tailwind for motion values, infers what each motion does and suggests the token whose usage matches"
            },
            {
              "label": "You get",
              "text": "A list by file and line, such as a 300ms modal close moved to the 150ms quick token, then the edits once you confirm"
            },
            {
              "label": "Rules",
              "text": "Closes faster than opens, hover-out springier than hover-in, total stagger under about 300ms, no delay on a close"
            },
            {
              "label": "Works with",
              "text": "transitions-dev, as its add-on, or alone, since it restates the token values"
            },
            {
              "label": "Unlike transitions-dev",
              "text": "It never swaps in a whole transition, only retunes values that exist"
            }
          ],
          "text": "An add-on to transitions-dev for tuning motion rather than adding it. Its rule is to match on usage, never the nearest number: a value is wrong when it doesn't fit what the motion does, and one whose usage matches no token is left alone. It covers five dimensions: durations from a 40ms stagger to 500ms emphasis moments, easings with a smooth ease-out as the default for surfaces, travel distances from 4px to 30px, starting scales from 0.96 to 0.99, and blurs from 2px to 8px. Beyond single values it checks pairs and sequences: a dropdown opens in 250ms and closes in 150ms, while tabs, accordions and page slides stay symmetric; overshoot is for entrances only; a tooltip waits 80ms so a passing cursor doesn't trigger it. transitions review only reports; transitions polish asks before editing, writes var(--…) references where _root.css is imported or the literal value otherwise, keeps each file's units and touches nothing else. transitions-dev also defines a transitions review command, which finds where a whole transition would fit instead. Installed in a project, it also feeds its rules to the Small refinement tab of transitions.dev's Refine panel, a separate live tuning tool.",
          "permalink": "https://github.com/jakubantalik/transitions.dev/tree/e706ea0c6401f92af2ff7098c941bd7f59039058/skills/transitions-polish"
        },
        "tags": [
          "category:design",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "animation",
          "design-system"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
