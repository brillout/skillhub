      "agentReview": {
        "description": "Sees and operates macOS app interfaces with the Peekaboo CLI: annotated screenshots, clicks, typing, shortcuts and drags, checking the screen after each action.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want the agent to look at a Mac app's window and work it: click, type, scroll, press shortcuts, drag or manage windows and menus"
