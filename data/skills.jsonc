      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/obviously-awesome",
        "installs": 6100,
        "weeklyInstalls": [165, 163, 162, 174, 291, 224, 143, 141],
        "firstSeen": "2026-02-10"
      },
      "skillMd": {
