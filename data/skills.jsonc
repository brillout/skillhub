        "skew": 0
      },
      "agentReview": {
        "description": "Builds focused knowledge bases from your claude-mem history and answers questions about past work from an AI session primed with them.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to ask questions of one slice of your claude-mem history, such as everything about a subsystem or last month's decisions"
            },
            {
              "label": "It does",
              "text": "Collects matching observations into a named corpus, loads it into an AI session, and answers your questions from it"
            },
            {
              "label": "You get",
              "text": "A reusable knowledge base: prime it once, ask many questions, with follow-ups keeping context"
            },
            {
              "label": "Filters by",
              "text": "Project, observation type such as decision or bugfix, concept tags, files, a semantic query and dates, up to 500 observations by default"
            },
            {
              "label": "Needs",
              "text": "claude-mem and its MCP tools"
            }
          ],
          "text": "claude-mem records observations, notes on what happened in your agent sessions. This skill turns a filtered set of them, a corpus, into what it calls a knowledge agent, or a \"brain\". build_corpus collects the observations, prime_corpus loads them into an AI session, and query_corpus asks that session a question; list_corpora shows each corpus with its stats and whether it's primed. Its tips: focused corpora such as \"hooks architecture\" work better than everything at once; prime once and query many times; reprime to clear a conversation that drifted while keeping the corpus; and when new observations arrive, rebuild the corpus, then reprime.",
          "permalink": "https://github.com/thedotmack/claude-mem/tree/31ebffbb112260183c91bbf901a4da22e241018f/plugin/skills/knowledge-agent"
        },
        "tags": [
          "category:agents",
          "type:tool",
          "effect:local",
          "needs:mcp",
          "by:official",
          "stack:claude-mem",
          "memory"
        ],
        "note": "Needs claude-mem installed with its MCP server. Per claude-mem's docs, priming loads the whole corpus into a separate Claude session through the Agent SDK, so a large corpus costs tokens up front.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
