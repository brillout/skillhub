    {
      "id": "earthtojake/text-to-cad",
      "skew": 5074,
      "agentReview": {
        "name": "text-to-cad",
        "description": "Design physical parts with an agent: text-to-cad's skills for 3D models, purchasable parts, DXF drawings, robot descriptions, fabrication and 3D-printing checks, slicing and printer handoff.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want an agent to design a physical part or a robot and carry it on toward cutting, printing or simulation"
            },
            {
              "label": "It does",
              "text": "cad models parts as Python build123d scripts; the other skills add catalog parts, DXF drawings, fabrication and 3D-printing checks, slicing, printer handoff and robot description files"
            },
            {
              "label": "You get",
              "text": "Python model scripts; STEP, STL, 3MF, GLB, DXF, URDF, SRDF and SDF files; a CAD Viewer that follows every rebuild; preflight and printability reports and printer-ready G-code"
            },
            {
              "label": "Needs",
              "text": "text-to-cad's cad command, which cad, dxf, urdf, srdf and sdf install by curl-to-shell script if missing; Python with trimesh for dfam-check; OrcaSlicer, and Bambu Connect or Studio, for printing"
            },
            {
              "label": "Telemetry",
              "text": "text-to-cad sends usage stats and crash reports by default, never files, paths or prompts, its README says"
            }
          ],
          "text": "Most of these skills run through text-to-cad's cad command and local server and show results in one CAD Viewer. cad is the core: it writes each part or assembly as a Python build123d function and exports STEP, STL, 3MF or GLB on request. step-parts adds real purchasable parts from the step.parts catalog, which a model reads once converted with cad export. dxf turns a modelled part, a vendor STEP or a fresh sketch into a cut-ready DXF, and sendcutsend checks that DXF or a STEP against SendCutSend's current specs before you order. For 3D printing, dfam-check first measures an exported mesh against the chosen process's limits for walls, overhangs and supports, then gcode slices it with OrcaSlicer, and bambu-labs opens the sliced file in Bambu Connect, where you start the print. For robots, urdf writes the robot's links and joints, each link's mesh exported from its cad model; srdf adds MoveIt planning groups on top of a validated URDF, and sdf writes Gazebo models and worlds, derived from the URDF when there is one. The cad command validates all three, and the viewer poses their joints. Each skill also works alone; one install command adds them all.",
          "permalink": "https://github.com/earthtojake/text-to-cad/tree/4099cac3ddc56a5e696138c53fd7bee685e8ad9d"
        },
        "skills": [
          {
            "id": "earthtojake/text-to-cad/skills/cad",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "earthtojake/text-to-cad/skills/sendcutsend",
            "standalone": true,
            "listedOutsideBundle": true
          }
        ],
        "install": [
          {
            "label": "macOS and Linux: installs uv if missing, the cad command and CAD's server, and in every agent app it finds the plugin, or the skills alone, with the repo's dfm and engineering-drawing skills too",
            "command": "curl -fsSL https://texttocad.dev/install.sh | sh"
          },
          {
            "label": "Windows, in PowerShell: the same; run it the first time in a terminal of its own, not in a Store app's shell such as the Claude desktop app's",
            "command": "irm https://www.texttocad.dev/install.ps1 | iex"
          },
          {
            "label": "Claude Code plugin, which needs uv; it brings CAD's server and the repo's 2 other skills, dfm and engineering-drawing, and Cursor and Grok Build load it too",
            "command": "claude plugin marketplace add earthtojake/text-to-cad#latest && claude plugin install text-to-cad@earthtojake"
          },
          {
            "label": "Codex plugin, which needs uv; it brings the CAD viewer and the repo's 2 other skills, dfm and engineering-drawing",
            "command": "codex plugin marketplace add earthtojake/text-to-cad --ref latest && codex plugin add text-to-cad@earthtojake"
          },
          {
            "label": "Gemini CLI extension, which needs uv; it brings CAD's server and the repo's 2 other skills, dfm and engineering-drawing",
            "command": "gemini extensions install https://github.com/earthtojake/text-to-cad --ref latest --consent"
          },
          {
            "label": "Any agent without a plugin, with the skills CLI, plus the repo's 2 other skills, dfm and engineering-drawing; cad, dxf, urdf, srdf and sdf need the cad command, which they install with the script above if missing",
            "command": "npx skills add earthtojake/text-to-cad#latest"
          }
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "miqdadbadjuber/anti-slop",
      "skew": 0,
      "agentReview": {
        "name": "antislop",
        "description": "A filter against AI slop: a core of 40 rules with a PASS/FAIL gate, plus companion skills for UI, copy, accessibility, mobile layout and code comments.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want agent-built UI, copy and code comments free of the generic AI look, without being handed a house style"
            },
            {
              "label": "It does",
              "text": "The core antislop skill sets 40 rules and a final gate; five companion skills each add a pattern catalog for one concern and cite the core's rules"
            },
            {
              "label": "You get",
              "text": "A PASS/FAIL report with evidence before delivery, or an audit file of numbered findings you pick from to fix"
            },
            {
              "label": "Needs",
              "text": "For UI you mean to ship, your own design direction, such as a DESIGN.md; without it, the result is labelled a draft without direction"
            },
            {
              "label": "Installer",
              "text": "npx antislop-ai asks which skills and agents, and writes a pointer that reloads antislop every session"
            }
          ],
          "text": "The core, antislop, does the work and is the one skill that works alone. Unless you've saved a default with npx antislop-ai --mode, it asks each session whether to apply its rules while building or to audit finished work. It holds every technique to a purpose test, so a gradient or badge stays only with a written reason; sets three liveliness dials, energy, rhythm and motion, so that removing slop doesn't leave a sterile page; and ends with the Delivery Gate, a four-block PASS/FAIL check. Each companion skill says to load the core with it for one kind of task, cites the core's rules by number, and adds a catalog of patterns, each with a tell, why it reads as AI and a fix, plus a checklist run alongside the gate. antislop-ui covers color, layout, decoration, dashboards, motion and performance. antislop-copywriting covers AI writing tells in headlines and prose, with before-and-after rewrites and a draft, audit and final loop. antislop-human covers contrast, keyboard, focus and affordances, with a contrast-ratio script. antislop-layoutmobile covers reflow from phone to desktop. antislop-code covers comments only, never the code.",
          "permalink": "https://github.com/miqdadbadjuber/anti-slop/tree/9504989f162a92b1996853eccbb3d8a86e73df68"
        },
        "skills": [
          {
            "id": "miqdadbadjuber/anti-slop/skills/antislop",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "miqdadbadjuber/anti-slop/skills/antislop-ui",
            "standalone": false,
            "note": "Says to load the core antislop skill with it: its fixes cite the core's rules by number and its RHYTHM and MOTION dials, and the core's Delivery Gate stays the final check."
          },
          {
            "id": "miqdadbadjuber/anti-slop/skills/antislop-copywriting",
            "standalone": false,
            "note": "Says to load the core antislop skill with it, which holds the hard bans it cites by number, such as no em dashes and no invented numbers, and the R-37 rule for asking about em dashes in your writing sample; its checklist runs alongside the core's Delivery Gate."
          },
          {
            "id": "miqdadbadjuber/anti-slop/skills/antislop-human",
            "standalone": false,
            "note": "Says to load the core antislop skill with it: it cites the core's contrast, keyboard, state and affordance rules by number and runs its checklist alongside the core's Delivery Gate; the contrast checker is its own."
          },
          {
            "id": "miqdadbadjuber/anti-slop/skills/antislop-layoutmobile",
            "standalone": false,
            "note": "Says to load the core antislop skill with it: it cites the core's mobile and verification rules by number and runs its checklist alongside the core's Delivery Gate."
          },
          {
            "id": "miqdadbadjuber/anti-slop/skills/antislop-code",
            "standalone": false,
            "note": "Says to load the core antislop skill with it and to run its comment checklist alongside the core's Delivery Gate; its own rules cite only one core rule, R-31."
          }
        ],
        "install": [
          {
            "label": "The 12 agents antislop's installer supports; it asks which skills, where and which agents, and writes a pointer that reloads antislop every session",
            "command": "npx antislop-ai"
          },
          {
            "label": "Any agent, with the skills CLI; the same folders without the installer's pointer, so antislop loads by its description alone",
            "command": "npx skills add miqdadbadjuber/anti-slop"
          },
          {
            "label": "Claude Code plugin, after /plugin marketplace add https://github.com/miqdadbadjuber/anti-slop; also adds a local contrast-checking MCP server",
            "command": "/plugin install antislop@anti-slop"
          },
          {
            "label": "Codex plugin",
            "command": "codex plugin marketplace add miqdadbadjuber/anti-slop && codex plugin add antislop@anti-slop"
          },
          {
            "label": "Cursor plugin; then open Customize, find antislop and select Install",
            "command": "agent plugin marketplace add https://github.com/miqdadbadjuber/anti-slop"
          },
          {
            "label": "Antigravity plugin",
            "command": "agy plugin install https://github.com/miqdadbadjuber/anti-slop"
          },
          {
            "label": "Kimi Code plugin",
            "command": "/plugins install https://github.com/miqdadbadjuber/anti-slop"
          },
          {
            "label": "Cline CLI plugin; for the VS Code or JetBrains extension, use the installer",
            "command": "cline plugin install https://github.com/miqdadbadjuber/anti-slop.git"
          },
          {
            "label": "Oh My Pi plugin",
            "command": "omp plugin marketplace add miqdadbadjuber/anti-slop && omp plugin install antislop@anti-slop"
          },
          {
            "label": "Pi package",
            "command": "pi install git:github.com/miqdadbadjuber/anti-slop"
          }
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "imbad0202/academic-research-skills",
      "skew": 286,
      "agentReview": {
        "name": "Academic Research Skills",
        "description": "Researches, writes, reviews and revises academic papers through role-separated agents, with integrity checks and your approval at every stage.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're working on an academic paper and want help researching, drafting, reviewing and checking it while every decision stays yours"
            },
            {
              "label": "It does",
              "text": "academic-pipeline runs ten stages through the other three: deep-research researches, academic-paper writes and revises, academic-paper-reviewer simulates a journal panel"
            },
            {
              "label": "You get",
              "text": "A research report, a paper draft with bilingual abstracts, review reports with a decision letter, integrity reports, the formatted paper and a record of how it was made"
            },
            {
              "label": "Stops for you",
              "text": "After every stage; the integrity checks before review and before formatting can't be skipped"
            },
            {
              "label": "Install together",
              "text": "Each skill reads protocol files from the repo's shared/ folder and from the others' folders, so a single copied skill folder doesn't run as written"
            },
            {
              "label": "Unlike a humanizer",
              "text": "This one doesn't help hide AI use: citations must be verified and papers carry an AI-use statement"
            },
            {
              "label": "Needs",
              "text": "Python for revision mode and the re-review's checker script; Pandoc and LaTeX only for DOCX and PDF output"
            }
          ],
          "text": "Academic Research Skills (ARS), by Cheng-I Wu, treats the AI as a copilot: it hunts down references, formats citations and checks consistency, while you define the question, choose the method and interpret the results. deep-research frames a research question with you, searches and grades sources and writes an APA 7.0 report, or guides you through Socratic questions when the idea is still vague. Its question brief, bibliography and synthesis hand over to academic-paper, which interviews you about the paper, then outlines, drafts, cites and formats it, and later revises it from reviewer comments. In academic-paper-reviewer, five role-separated seats, including a Devil's Advocate, review the draft and a synthesizer writes a decision letter and a revision roadmap that academic-paper's revision mode takes in. academic-pipeline chains them into ten stages, with integrity checks of references, data and claims before review and again before formatting, a re-review that verifies the revision, and a closing record of the human-AI collaboration. Each stage waits for your confirmation. The skills share contracts and protocols in the repo's shared/ folder and read each other's files, so they're installed together; the plugin also adds sr-screener, a study-screening skill, plus slash commands, agents and hooks.",
          "permalink": "https://github.com/imbad0202/academic-research-skills/tree/6d9388674de1ad0437ad95db3d52f92b92204d84"
        },
        "skills": [
          {
            "id": "imbad0202/academic-research-skills/academic-pipeline",
            "standalone": false,
            "note": "Dispatches deep-research, academic-paper and academic-paper-reviewer for its stages and does no research, writing or reviewing itself; it also runs checker scripts from the repo's scripts/ folder, so it needs them and the whole repo, as the plugin installs it."
          },
          {
            "id": "imbad0202/academic-research-skills/deep-research",
            "standalone": false,
            "note": "Its report compiler runs the writing-quality check in academic-paper's folder, its bibliography and three-way scan use academic-paper-reviewer's review-criteria table, and its ethics review reads registries in the repo's shared/ folder, so it needs the whole repo, as the plugin installs it."
          },
          {
            "id": "imbad0202/academic-research-skills/academic-paper",
            "standalone": false,
            "note": "Its full mode loads writer and evaluator contracts from the repo's shared/ folder, revision mode runs scripts from its scripts/ folder, and plan mode reads its questions from deep-research's Socratic mentor file, so it needs the whole repo, as the plugin installs it."
          },
          {
            "id": "imbad0202/academic-research-skills/academic-paper-reviewer",
            "standalone": false,
            "note": "Its full and methodology-focus reviews load their contracts from the repo's shared/ folder, and its revision coaching reads its questions from deep-research's Socratic mentor file, so it needs the whole repo, as the plugin installs it."
          }
        ],
        "install": [
          {
            "label": "Claude Code plugin, with the repo's shared files and scripts; also adds sr-screener, the /ars-* commands, plugin agents and hooks",
            "command": "claude plugin marketplace add Imbad0202/academic-research-skills && claude plugin install academic-research-skills@academic-research-skills"
          },
          {
            "label": "Pi, through the repo's community-maintained wrapper",
            "command": "pi install git:github.com/Imbad0202/academic-research-skills"
          }
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
