    {
      "id": "trailofbits/skills/plugins/spec-to-code-compliance/skills/spec-to-code-compliance",
      "name": "spec-to-code-compliance",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/spec-to-code-compliance",
        "installs": 6400,
        "weeklyInstalls": [144, 117, 122, 149, 151, 180, 198, 215],
