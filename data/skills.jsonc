    {
      "id": "web-infra-dev/midscene-skills/skills/android-automation",
      "name": "android-device-automation",
      "skills.sh": {
        "url": "https://skills.sh/web-infra-dev/midscene-skills/android-device-automation",
        "installs": 5600,
        "weeklyInstalls": [66, 44, 54, 51, 64, 47, 41, 70],
        "firstSeen": "2026-03-06"
      },
      "skillMd": {
        "version": "e6836973627a20edc34b844a2e20d4180602ae5d",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Controls an Android phone or emulator over ADB from plain-language commands, reading the screen from screenshots to tap, type, swipe and verify.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want the agent to operate or test an app on an Android phone or emulator, without its code or accessibility labels"
            },
            {
              "label": "It does",
              "text": "Runs one Midscene command at a time: connect, launch an app, act on a plain-language goal, take a screenshot, assert what the screen shows"
            },
            {
              "label": "You get",
              "text": "A summary of what it did and found, screenshots, and an HTML report with a replay video of each step"
            },
            {
              "label": "Works with",
              "text": "Any app on screen, whatever it's built with, because a vision model reads screenshots instead of the view hierarchy"
            },
            {
              "label": "Needs",
              "text": "adb, Node.js and an API key for a vision model that can locate elements on a screenshot, such as Gemini, Qwen or Doubao"
            }
          ],
          "text": "Midscene's skill for Android. The agent plans and Midscene's CLI, run through npx, does the work: `act` takes a whole goal in plain words, such as opening Settings and reporting the Wi-Fi network, and handles the taps, long presses, typing, swipes, pinches and Back or Home presses itself. `assert` checks the current screen against a sentence, optionally against reference images, and can fail with your own message for CI logs; for a toast or animation that vanishes, a recorder captures frames in its own terminal while the action runs, and `assert` checks the recording. `tap --locate` finds an element from a reference image, `runadbshell` passes raw adb shell commands, and `--deep-locate` or `--deep-think` trade speed for precision. Commands run one at a time, in the foreground, about a minute each, and the agent reads every screenshot before the next step. It recommends launching the app with adb first, batching related actions into one `act` and adding `--use-scrcpy` when screenshots are slow. At the end it must report the results, data found and file paths; the HTML report converts to Markdown or JSON for another tool. A troubleshooting table covers unauthorized or offline devices and API key errors.",
          "permalink": "https://github.com/web-infra-dev/midscene-skills/tree/e6836973627a20edc34b844a2e20d4180602ae5d/skills/android-automation"
        },
