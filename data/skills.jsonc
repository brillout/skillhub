          "type:workflow",
          "effect:local",
          "needs:subagents",
          "by:community",
          "planning",
          "multi-agent",
          "agent-workflows"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "thedotmack/claude-mem/plugin/skills/do",
      "name": "do",
      "skills.sh": {
        "url": "https://skills.sh/thedotmack/claude-mem/do",
        "installs": 7400,
        "weeklyInstalls": [103, 96, 92, 91, 128, 116, 133, 152],
        "firstSeen": "2026-02-24"
      },
      "skillMd": {
        "version": "24802b13ef5e9bf61a84e650af446c4ff69ab399",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Executes a phased implementation plan through subagents that implement, verify, review and commit each phase in turn.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have a phased plan, such as one from make-plan, and want it carried out"
            },
            {
              "label": "It does",
              "text": "Stays a coordinator and hands all the work to subagents: one implements each phase, others verify, check anti-patterns and review"
            },
            {
              "label": "You get",
              "text": "One commit per phase that passed its checks, pushed to your working branch"
            },
            {
              "label": "Needs",
              "text": "An agent that can start subagents"
            },
            {
              "label": "Won't",
              "text": "Move to the next phase, or commit, until a subagent's evidence shows the phase is done"
            }
          ],
          "text": "The main agent does no work itself except routing context and checking each subagent's report against the plan. Every subagent gets one objective and must report evidence: commands run, outputs and files changed. In each phase an implementation subagent copies patterns from the documentation, cites sources for unfamiliar APIs and stops to verify when an API seems missing rather than assuming it exists. After the phase, separate subagents run its verification checklist, grep for the plan's known bad patterns and review code quality, and a commit subagent commits only if verification passed. Between phases a branch subagent pushes to the working branch and prepares a handoff, so the next phase's subagents start fresh but know the plan.",
          "permalink": "https://github.com/thedotmack/claude-mem/tree/24802b13ef5e9bf61a84e650af446c4ff69ab399/plugin/skills/do"
        },
        "tags": [
          "category:engineering",
          "category:agents",
          "type:workflow",
          "effect:remote",
          "needs:subagents",
          "by:community",
          "implementation",
          "multi-agent",
          "verification",
          "agent-workflows"
        ],
        "note": "Commits each phase once it passes verification and pushes to your working branch between phases.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "thedotmack/claude-mem/plugin/skills/timeline-report",
      "name": "timeline-report",
      "skills.sh": {
        "url": "https://skills.sh/thedotmack/claude-mem/timeline-report",
        "installs": 7100,
        "weeklyInstalls": [104, 97, 93, 92, 129, 119, 136, 155],
        "firstSeen": "2026-03-18"
