      "agentReview": {
        "description": "Grades your agent skills by scoring recent local conversations, then drafts skill edits and a shareable HTML report.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to know which of your installed skills actually help, judged from your real conversation history"
            },
            {
              "label": "It does",
              "text": "Samples up to 12 conversations from the last 45 days by default, scores each for efficiency, code quality, procedure compliance and verbosity, and grades the setup"
