    {
      "id": "gamedev-skills/awesome-gamedev-agent-skills/skills/disciplines/ai-behavior-trees-utility-ai",
      "name": "ai-behavior-trees-utility-ai",
      "skills.sh": {
        "url": "https://skills.sh/gamedev-skills/awesome-gamedev-agent-skills/ai-behavior-trees-utility-ai",
        "installs": 9600,
        "weeklyInstalls": [337, 398, 400, 485, 668, 1507, 1874, 1709],
        "firstSeen": "2026-08-24"
      },
      "skillMd": {
        "version": "25eec57919aec2cfd87d4ef9ae5661832302585e",
        "updated": "2026-11-12",
        "skew": 1920
      },
      "agentReview": {
        "description": "Builds a reusable behavior-tree runtime and a utility AI scorer for NPC decisions, plus hybrids where the tree delegates graded choices.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "An enemy or NPC needs decisions beyond a simple state machine, and you want your own reusable decision code rather than an engine's built-in assets"
            },
            {
              "label": "Behavior tree means",
              "text": "A tree of conditions and actions checked each decision step, each node reporting success, failure or still running to its parent"
            },
            {
              "label": "Utility AI means",
              "text": "Scoring every possible action from 0 to 1 through response curves, then picking the best, so trade-offs such as distance against health are graded"
            },
            {
              "label": "You get",
              "text": "Plain C# runtime code: a blackboard (per-agent shared memory), composites, decorators, curves and an evaluator, plus guard, villager and hybrid agent templates"
            },
            {
              "label": "Unlike its siblings",
              "text": "The repo's game-ai helps choose between state machines, behavior trees, steering and pathfinding; unreal-behavior-trees is for Unreal's own tree assets"
            },
            {
              "label": "Code examples",
              "text": "C# using Unity's Vector2 member names, with the Godot C# equivalents named"
            }
          ],
          "text": "The implementation companion to the repo's game-ai skill: game-ai picks a decision model, this one builds it. Its workflow takes a behavior tree for structured, prioritized, interruptible behavior, utility scoring for continuous choices such as targeting, or both. It designs the blackboard first, so leaves share it and never reference each other; writes conditions that answer at once and actions that return Running across frames; and composes them with Selector (first child that doesn't fail wins), Sequence (stops at the first that doesn't succeed), Parallel and decorators such as Inverter, Cooldown and Repeat. For utility, each fact passes through a curve normalized to 0..1; the results combine as a weighted sum, or as a product with a compensation factor so each extra consideration doesn't drag the score toward zero; hysteresis keeps agents from flip-flopping on near-ties. It ticks once per decision step and has you draw the active path and scores on screen while tuning. Its pitfalls cover restarting a running action every frame, guard conditions that stop being checked once an action runs, cooldowns cleared when a branch is abandoned, and allocations every tick. Four reference files hold the full C# code, the templates and best practices.",
          "permalink": "https://github.com/gamedev-skills/awesome-gamedev-agent-skills/tree/19d93f97c9c1ea0f8b306e77aa81e0d3e352d3e9/skills/disciplines/ai-behavior-trees-utility-ai"
        },
        "tags": [
          "category:engineering",
          "category:games",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "stack:csharp",
          "architecture",
          "implementation"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
