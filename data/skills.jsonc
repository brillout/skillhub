      "agentReview": {
        "description": "Shows a quick-reference card for ponytail's levels, skills and commands.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You've installed ponytail and want a reminder of its levels, commands and settings"
            },
            {
              "label": "It does",
              "text": "Prints one reference card, without changing the mode or saving anything"
