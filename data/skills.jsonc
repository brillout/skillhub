    {
      "id": "wshobson/agents/plugins/reverse-engineering/skills/protocol-reverse-engineering",
      "name": "protocol-reverse-engineering",
      "skills.sh": {
        "url": "https://skills.sh/wshobson/agents/protocol-reverse-engineering",
        "installs": 13600,
        "weeklyInstalls": [255, 268, 315, 295, 329, 336, 345, 297],
        "firstSeen": "2026-01-20"
      },
      "skillMd": {
        "version": "4bde3168b43c0655c4d00ea2726e631719908a6d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Reverse-engineers network protocols: captures traffic, dissects messages, identifies fields and encryption, fuzzes and replays, then documents the format.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need to understand an undocumented or proprietary network protocol, for security research, interoperability or debugging network communication"
            },
            {
              "label": "It does",
              "text": "Captures traffic, maps message structure and fields by comparing samples, writes a specification, checks it with a parser, then probes edge cases by fuzzing"
            },
            {
              "label": "You get",
              "text": "A protocol specification from its template, a parser to check it, and optionally a Wireshark dissector written in Lua"
            },
            {
              "label": "Needs",
              "text": "Wireshark or tshark, tcpdump, mitmproxy, Scapy or boofuzz installed, depending on the step"
            },
            {
              "label": "Sends traffic",
              "text": "Its fuzzing and replay steps send crafted or modified packets to a live target, and mitmproxy intercepts TLS traffic"
            }
          ],
          "text": "Commands and a seven-step method for working out a protocol from its traffic: capture several sessions, find where messages start and end, map the fixed header and variable payload, identify fields by comparing samples, write a specification, validate it by implementing a parser or generator, then test edge cases with fuzzing. Capture uses Wireshark, tshark (with ring buffers), tcpdump, or mitmproxy and Burp Suite for HTTP and HTTPS. Analysis uses Wireshark display filters and stream following, tshark field extraction and statistics, and Scapy scripts. It lists byte signatures for common protocols, such as HTTP, TLS, SSH, SMB and Redis, and a typical header layout: magic number, version, flags, length, message type, sequence number. Before binary or encryption work, the agent reads a file on length-prefixed and type-length-value structures, a Python parser, hex dumps, entropy checks that hint at encryption, JA3 TLS fingerprints and decrypting TLS with key logs. Before documenting, it reads a specification template and a Lua dissector example. Active testing defines messages for the boofuzz fuzzer and replays or modifies captured packets with Scapy.",
          "permalink": "https://github.com/wshobson/agents/tree/4bde3168b43c0655c4d00ea2726e631719908a6d/plugins/reverse-engineering/skills/protocol-reverse-engineering"
        },
