    {
      "id": "gamedev-skills/awesome-gamedev-agent-skills/skills/workflows/prototype-fast",
      "name": "prototype-fast",
      "skills.sh": {
        "url": "https://skills.sh/gamedev-skills/awesome-gamedev-agent-skills/prototype-fast",
