    {
      "id": "trailofbits/skills/plugins/audit-context-building/skills/audit-context-building",
      "name": "audit-context-building",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/audit-context-building",
        "installs": 7500,
        "weeklyInstalls": [165, 156, 137, 195, 231, 262, 282, 280],
        "firstSeen": "2026-01-19"
