        "skew": 0
      },
      "agentReview": {
        "description": "Adapts your resume to one job posting: rewrites the summary, reorders skills, jobs and bullets, and adds its keywords without inventing experience.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're applying to a specific job and want your resume aimed at it"
            },
            {
              "label": "It does",
              "text": "Rewrites your summary for the role, puts the most relevant skills, jobs and bullets first, and works the posting's keywords into true statements"
            },
            {
              "label": "You get",
              "text": "A list of tailored changes, before and after, with keywords added, bullets moved or modified and an estimated new match score"
            },
            {
              "label": "Won't",
              "text": "Add skills you don't have, change numbers, invent experience, or claim titles or certifications you didn't earn"
            },
            {
              "label": "Works best after",
              "text": "job-description-analyzer, from the same repo, which it says to run first"
            }
          ],
          "text": "Tailoring here means choosing from your true experience, not adding to it: the skill treats your full history as a library and picks what each employer wants. After the posting is analyzed, it audits each section of the resume for relevance to this role. The summary is rewritten to mirror the job's main requirements; its examples show one person's summary aimed at an operations role and at a project management role. Skills are reordered so the posting's top requirements come first, a more relevant older job can move above a recent one, bullets are swapped so the most relevant lead, and vague wording such as \"worked with various teams\" takes the posting's terms when they're accurate. It has strategies for technical roles at non-tech companies, management roles, and moves between startups and big companies, plus a ten-point check before you submit. It also recommends keeping a master resume with every bullet, and naming each tailored file by name, role, company and date.",
          "permalink": "https://github.com/paramchoudhary/resumeskills/tree/74ae19e7c62b0516d1c298328e5544976c12da5d/skills/resume-tailor"
        },
