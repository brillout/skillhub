      "agentReview": {
        "description": "Creates, edits, imports and exports draw.io diagrams through a bundled offline CLI that renders a YAML spec into a .drawio file and PNG.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need an architecture, network, flowchart, UML, ER or org-chart diagram as an editable .drawio file"
