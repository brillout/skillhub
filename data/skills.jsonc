    {
      "id": "trailofbits/skills/plugins/zeroize-audit/skills/zeroize-audit",
      "name": "zeroize-audit",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/zeroize-audit",
        "installs": 5200,
        "weeklyInstalls": [106, 101, 98, 117, 127, 157, 167, 186],
