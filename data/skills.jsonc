      "id": "jeffallan/claude-skills/skills/code-reviewer",
      "name": "code-reviewer",
      "skills.sh": {
        "url": "https://skills.sh/jeffallan/claude-skills/code-reviewer",
        "installs": 7000,
        "weeklyInstalls": [136, 134, 129, 137, 180, 175, 200, 160],
