        "skew": 0
      },
      "agentReview": {
        "description": "Lists recent git commits linked to agent sessions in agentmemory, optionally by branch or repo, with each commit's session.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to see what the agent has shipped: commits alongside the sessions that produced them"
            },
            {
              "label": "It does",
              "text": "Lists the git commits linked to agent sessions in agentmemory, filtered by branch or repo if you ask, up to 100 by default and 500 at most"
            },
            {
              "label": "You get",
              "text": "Newest first: short sha, branch, date, first line of the message, linked session ids with observation counts, and file counts"
            },
            {
              "label": "Needs",
              "text": "agentmemory's memory server running, with its MCP tools connected to your agent"
            },
            {
              "label": "Unlike commit-context",
              "text": "That one traces one piece of code to its session; this one lists many commits"
            }
          ],
          "text": "Part of agentmemory, a memory server that records what coding agents do in each session as observations. commit-history lists the git commits linked to those sessions. You can filter by branch and by repository URL or a fragment of it, and set a limit; a bare number is the limit, and by default there's no filter and up to 100 commits, capped at 500. The list shows only what the tool returned, newest first, with the short sha, branch, authored time, first line of the message, the linked sessions' short ids with their observation counts, and the number of files when given. An empty result means the filter matched nothing, and the agent suggests dropping the branch or repo filter. When the MCP tools are missing and it calls agentmemory's REST API instead, it URL-encodes every filter value.",
          "permalink": "https://github.com/rohitg00/agentmemory/tree/f0f7378ac42849b863fcc5c8e753f120d5ec6f9d/plugin/skills/commit-history"
