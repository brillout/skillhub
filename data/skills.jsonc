    {
      "id": "mattpocock/skills/skills/engineering/wizard",
      "name": "wizard",
      "skills.sh": {
        "url": "https://skills.sh/mattpocock/skills/wizard",
        "installs": 630129,
        "weeklyInstalls": [34314, 30866, 30913, 44498, 37150, 32039, 28988, 26973],
        "firstSeen": "2026-06-29"
      },
      "skillMd": {
