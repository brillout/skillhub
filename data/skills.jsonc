      "agentReview": {
        "description": "Turns a description into an Excalidraw diagram file, such as a flowchart, mind map, architecture, sequence or ER diagram.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You ask for a flowchart, mind map, architecture, data-flow, swimlane, class, sequence or ER diagram"
            },
            {
              "label": "It does",
              "text": "Picks the diagram type, pulls out the steps, entities and relationships, and lays them out as Excalidraw JSON"
