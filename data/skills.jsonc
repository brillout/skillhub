      "skills.sh": {
        "url": "https://skills.sh/gamedev-skills/awesome-gamedev-agent-skills/puzzle",
        "installs": 10500,
        "weeklyInstalls": [314, 371, 386, 440, 633, 1405, 1778, 1623],
