    {
      "id": "affaan-m/ecc/skills/codebase-onboarding",
      "name": "codebase-onboarding",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/codebase-onboarding",
        "installs": 6700,
        "weeklyInstalls": [320, 214, 212, 296, 481, 493, 552, 517],
        "firstSeen": "2026-05-19"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Maps an unfamiliar codebase's stack, architecture, entry points and conventions into a short onboarding guide and a starter CLAUDE.md.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You join a new project, open a repo in Claude Code for the first time, or want a CLAUDE.md written for it"
            },
            {
              "label": "It does",
              "text": "Scans manifests, framework configs, entry points, the top two directory levels, tooling, tests and git history, without reading every file"
            },
            {
              "label": "You get",
              "text": "An onboarding guide in the chat and a CLAUDE.md of under 100 lines at the project root"
            },
            {
              "label": "Keeps",
              "text": "An existing CLAUDE.md: it enhances it and marks what was added or changed"
            },
            {
              "label": "Unlike a README",
              "text": "The guide traces one request from entry to response and says where to look for each common task"
            }
          ],
          "text": "A four-phase workflow from ECC. Reconnaissance runs parallel checks with Glob and Grep: package manifests from package.json to pubspec.yaml, framework configs, entry points, the top two levels of the directory tree, linters, Docker and CI files, and the test layout. Architecture mapping names the languages, frameworks, databases, build tools and CI, the architecture and API style, maps directories to their purpose and traces one request through routing, validation, business logic and the database. Convention detection reads naming, error handling, dependency injection and async style, and branch and commit habits from git history, skipped when the history is too shallow. It then writes the onboarding guide, meant to be scanned in two minutes: the stack and versions, entry points, a directory map, the request lifecycle, common commands and a where-to-look table. The CLAUDE.md holds the stack, code style, test, build and lint commands, structure and conventions; asked only for that file, it skips the guide. It says what it couldn't detect rather than guessing, and trusts the code over config when they disagree.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/codebase-onboarding"
        },
        "tags": [
          "category:agents",
          "category:writing",
