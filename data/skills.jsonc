    {
      "id": "amelnagdy/delegate-skills",
      "skew": 0,
      "agentReview": {
        "name": "Delegate skills",
        "description": "Hands coding tasks to implementer CLIs such as Codex, OpenCode, Claude Code or Antigravity, directly or by lane, while your agent reviews the diff and commits.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want other coding CLIs to write the code while your main agent stays the reviewer and keeps the commit"
            },
            {
              "label": "It does",
              "text": "Each delegate skill briefs one implementer CLI, runs it through a bundled relay script, re-runs your checks, reads the diff and commits what holds"
            },
            {
              "label": "Lanes",
              "text": "delegate-setup maps kinds of work, such as features, tests or UI, to the implementers you have; a delegate skill run with --lane uses one"
            },
            {
              "label": "Listed here",
              "text": "Codex, OpenCode, Claude Code and Antigravity; installing the whole repo adds 15 more implementer skills, from Aider to Cursor and Copilot"
            },
            {
              "label": "Tested with",
              "text": "Claude Code as the orchestrator; the README calls other orchestrators, such as Cursor, designed for but unproven"
            },
            {
              "label": "Needs",
              "text": "Node 18+, git, and each implementer's CLI signed in"
            }
          ],
          "text": "Every delegate skill runs the same loop. Your main agent, the orchestrator, writes a self-contained brief, since the implementer sees no chat history, and tells it not to commit. The skill's relay.mjs runs the implementer, never commits, and writes a result.json with the implementer's report, the files git shows as changed and a session id where the CLI has one. The orchestrator then re-runs the project's tests and other checks, reads the diff against the brief and commits what holds, or resumes the session with a short delta brief. Each skill states its implementer's autonomy in that CLI's own terms: Codex's write sandbox, OpenCode's auto-approval, Claude Code's acceptEdits with a shell sandbox, Antigravity's own permission rules. You can skip setup and name an implementer directly, or run delegate-setup once to discover what's installed and write a lane map, globally or for one repo. A delegate skill dispatched with --lane then takes that lane's model and other settings, explicit flags still win, and the wrong skill for a lane fails loudly. The README says the scripts use Node built-ins only, make no network calls of their own and send no telemetry.",
          "permalink": "https://github.com/amelnagdy/delegate-skills/tree/7f8ae3435e5bc68a54efdca9f67797e905845562"
        },
        "skills": [
          {
            "id": "amelnagdy/delegate-skills/skills/delegate-setup",
            "standalone": false,
            "note": "Only writes the lane map that the repo's delegate skills read when you dispatch with --lane; it never dispatches work itself."
          },
          {
            "id": "amelnagdy/delegate-skills/skills/codex-delegate",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "amelnagdy/delegate-skills/skills/opencode-delegate",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "amelnagdy/delegate-skills/skills/claude-delegate",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "amelnagdy/delegate-skills/skills/agy-delegate",
            "standalone": true,
            "listedOutsideBundle": false
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI",
            "command": "npx skills add amElnagdy/delegate-skills --skill delegate-setup --skill codex-delegate --skill opencode-delegate --skill claude-delegate --skill agy-delegate"
          },
          {
            "label": "Any agent, with the skills CLI, plus the repo's 15 other implementer skills",
            "command": "npx skills add amElnagdy/delegate-skills"
          }
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "rohitg00/ai-engineering-from-scratch@learning",
      "skew": 0,
      "agentReview": {
        "name": "AI Engineering from Scratch tutor",
        "description": "Takes you through the AI Engineering from Scratch course with your agent: a placement quiz and study plan, lessons taught one at a time, phase quizzes and a guide to where each topic is taught.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to work through the free AI Engineering from Scratch course with your coding agent as the tutor"
            },
            {
              "label": "It does",
              "text": "Places you with a quiz, saves a study plan, teaches the lessons one at a time, quizzes you per phase and finds where a topic is taught"
            },
            {
              "label": "You get",
              "text": "A LEARNING.md with your path, progress log and review queue, interactive lessons with their code, and per-phase grades naming lessons to re-read"
            },
            {
              "label": "Start with",
              "text": "start-learning for a plan, or just ask learn for the next lesson: without a plan it starts at Phase 1, Lesson 1"
            },
            {
              "label": "Works from",
              "text": "A clone of the repo, or lesson files fetched from GitHub with no setup"
            }
          ],
          "text": "The course is 542 lessons in 20 phases, from linear algebra to autonomous agents, and these five skills make your agent its tutor. start-learning is the front door: three questions about why you're learning, your weekly hours and what you want to build, then find-your-level's placement quiz, then a LEARNING.md with your mission, entry phase, a Skip, Review or Do path with hours, a progress log and a review queue. find-your-level also works alone and shows the same path in the conversation. learn teaches one lesson per call: a warm-up from the last lesson's quiz, the concept with questions before the math, the from-scratch code in small chunks, run when it can be, the production library's version, then the lesson's quiz, logged in LEARNING.md, with lessons under 70% queued for review. check-understanding quizzes you on a finished phase with eight questions and names the lessons to re-read. course-guide maps a topic, a question or a bug to the one to three lessons that teach it and the command to run next. The MCP, Agent Skills, reverse engineering, Claude certification and interview practice tracks have tutors of their own, which these skills hand you to and which aren't listed here.",
          "permalink": "https://github.com/rohitg00/ai-engineering-from-scratch/tree/a509402c0b5455d11ddc2b5fa83cc8c0d2e0692b"
        },
        "skills": [
          {
            "id": "rohitg00/ai-engineering-from-scratch/skills/start-learning",
            "standalone": false,
            "note": "Runs find-your-level's placement quiz, which it expects installed alongside it, and writes the LEARNING.md plan that learn teaches from."
          },
          {
            "id": "rohitg00/ai-engineering-from-scratch/skills/find-your-level",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "rohitg00/ai-engineering-from-scratch/skills/learn",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "rohitg00/ai-engineering-from-scratch/skills/check-understanding",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "rohitg00/ai-engineering-from-scratch/skills/course-guide",
            "standalone": true,
            "listedOutsideBundle": false
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI (needs Node.js); it asks which of the repo's skills to add and for which agent and scope",
            "command": "npx skills add rohitg00/ai-engineering-from-scratch"
          },
          {
            "label": "Any agent, with the skills CLI: just these five",
            "command": "npx skills add rohitg00/ai-engineering-from-scratch --skill start-learning --skill find-your-level --skill learn --skill check-understanding --skill course-guide"
          }
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
