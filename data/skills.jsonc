          "effect:none",
          "needs:none",
          "by:community",
          "personal"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "paramchoudhary/resumeskills/skills/resume-bullet-writer",
      "name": "resume-bullet-writer",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/resume-bullet-writer",
        "installs": 11400,
        "weeklyInstalls": [448, 374, 396, 505, 511, 498, 538, 662],
        "firstSeen": "2026-05-20"
      },
      "skillMd": {
        "version": "74ae19e7c62b0516d1c298328e5544976c12da5d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Rewrites resume bullets from duties into achievements, with a strong verb, at least one number and the result, using formulas like Google's X-Y-Z.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your resume bullets read like job duties (\"responsible for\", \"helped with\") and show no results"
            },
            {
              "label": "It does",
              "text": "Asks what you did, at what scale and with what outcome, then rebuilds each bullet with the X-Y-Z, STAR or CAR formula"
            },
            {
              "label": "You get",
              "text": "Each original bullet with its issues, an improved version and a note on what changed"
            },
            {
              "label": "Unlike resume-quantifier",
              "text": "That one, from the same repo, focuses on finding and estimating the numbers; this one rewrites the whole bullet: verb, scale, action and result"
            }
          ],
          "text": "Most resume bullets list duties instead of achievements; this skill turns them around. Its main formula is Google's X-Y-Z: accomplished X, as measured by Y, by doing Z. STAR (situation, task, action, result) and CAR (challenge, action, result) are the alternatives. For each weak bullet the agent asks clarifying questions, such as which platforms, how many followers, what growth and what business impact, then applies a formula and trims the result to one or two lines. Every bullet should start with a strong verb, carry at least one number (money, percentages, time, scale or before and after), state an outcome and fit the target role. When you lack exact figures it suggests approximations with ~, ranges, conservative estimates, or counting inputs such as interviews run. It includes lists of strong verbs by category, weak-versus-strong examples for software, product, sales, marketing, customer success, data and operations roles, and advice for graduates, career changers and employment gaps.",
          "permalink": "https://github.com/paramchoudhary/resumeskills/tree/74ae19e7c62b0516d1c298328e5544976c12da5d/skills/resume-bullet-writer"
        },
