          "effect:none",
          "needs:none",
          "by:community",
          "conversion",
          "copywriting"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "samber/cc-skills/skills/conventional-git",
      "name": "conventional-git",
      "skills.sh": {
        "url": "https://skills.sh/samber/cc-skills/conventional-git",
        "installs": 5400,
        "weeklyInstalls": [47, 176, 391, 563, 742, 787, 620, 269],
        "firstSeen": "2026-03-22"
      },
      "skillMd": {
        "version": "50a33836b20f690c668af557bd9ef9d07a8c7ef2",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Names branches, worktrees and commits by Conventional Commits, with type prefixes, issue numbers, 72-character subjects and issue-closing footers for GitHub and GitLab.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want the agent's branches and commits to follow Conventional Commits, so changelogs and version bumps can be generated from history"
            },
            {
              "label": "Branches",
              "text": "type/[issue-]description, lowercase with hyphens, under 50 characters, never containing \"worktree\""
            },
            {
              "label": "Worktrees",
              "text": "Under .claude/worktrees/, named after the branch with / turned into -, reused when one exists and removed once merged"
            },
            {
              "label": "Commits",
              "text": "type(scope): description in the imperative, at most 72 characters, with ! or a BREAKING CHANGE footer for breaking changes"
            },
            {
              "label": "No AI credit",
              "text": "It tells the agent never to add a Claude signature or a Co-authored-by trailer for an AI agent"
            }
          ],
          "text": "Branch types match commit types: feat, fix, docs, style, refactor, perf, test, build, ci, chore and revert, where feat bumps the minor version and fix the patch. The issue number goes in the branch name when there is one, so GitHub and GitLab link it. Before creating a worktree the agent runs git worktree list, and each worktree stays on one branch. Commit subjects take no capital letter or trailing period, a blank line separates the body, revert commits keep \"This reverts commit <hash>.\", and breaking changes are marked in the header or footer, since changelog tools miss body-only notes. Issue-closing keywords such as closes, fixes and resolves go in the footer and take effect once the commit reaches the default branch, with cross-repository forms for both hosts. A table of common mistakes and a few practices close it: align branch and commit types, keep one concern per branch, use one scope throughout a branch, and give the pull request a Conventional Commits title before a squash merge, since that title becomes the commit message.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2/skills/conventional-git"
        },
        "tags": [
          "category:engineering",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "stack:git",
          "git"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
