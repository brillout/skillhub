    {
      "id": "cursor/plugins/pstack/skills/principle-foundational-thinking",
      "name": "principle-foundational-thinking",
      "skills.sh": {
        "url": "https://skills.sh/cursor/plugins/principle-foundational-thinking",
        "installs": 5100,
        "weeklyInstalls": [303, 327, 397, 307, 351, 459, 353, 302],
        "firstSeen": "2026-05-24"
      },
      "skillMd": {
        "version": "a5539b15a3d56e04992565aafee2b37051329ce3",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Has the agent get the data structures and core types right before writing logic, and lay scaffold such as CI, linting and shared types before features.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Before writing logic: choosing core types and data structures, ordering scaffold against features, or sharing state between concurrent actors"
            },
            {
              "label": "It does",
              "text": "Gets the data shape right first, tracing every access pattern, and lays scaffold such as CI, linting, test setup and shared types before features"
            },
            {
              "label": "Key question",
              "text": "What happens if another actor changes this state at the same time? If the answer isn't \"nothing\", isolate it"
            },
            {
              "label": "Runs",
              "text": "Only when you call it"
            }
          ],
          "text": "One of pstack's principle skills, in Cursor's plugin repo. Structural decisions protect option value, the freedom to change course later; code-level ones protect simplicity. At code level it removes duplicated structure, not every repeated line: three similar statements beat a premature abstraction, explicit beats clever, and tests cover behavior and edge cases, not line counts. Scaffold is anything every later phase benefits from, so setup comes before features and tests before fixes, in small single-purpose commits. Each increment should land a coherent abstraction or deepen one, not spread a new capability across callers as special cases. Dead code goes first, before any foundation is laid.",
          "permalink": "https://github.com/cursor/plugins/tree/a5539b15a3d56e04992565aafee2b37051329ce3/pstack/skills/principle-foundational-thinking"
        },
        "tags": [
          "category:engineering",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "architecture",
          "domain-modeling",
          "planning"
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "cursor/plugins/pstack/skills/principle-laziness-protocol",
      "name": "principle-laziness-protocol",
      "skills.sh": {
        "url": "https://skills.sh/cursor/plugins/principle-laziness-protocol",
        "installs": 5200,
        "weeklyInstalls": [295, 331, 399, 311, 424, 477, 357, 306],
