          "multi-agent",
          "planning",
          "debugging"
        ],
        "note": "Needs Paseo running, from its desktop app or the @getpaseo/cli daemon, with its MCP tools. It reads the repo's paseo skill first, which isn't listed, so install it alongside.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
