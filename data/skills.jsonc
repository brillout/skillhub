            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-screenshot-diff",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-screen-recording",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-metro-debugger",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-react-native-optimization",
            "standalone": false,
            "note": "Loads argent-react-native-profiler as its profiling phase, and navigates every screen with argent-device-interact to check that the fixes broke nothing."
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-react-native-profiler",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-native-profiler",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-lens",
            "standalone": true,
            "listedOutsideBundle": false
          }
        ],
        "install": [
          {
            "label": "Editors the Argent installer supports, via npm; also sets up the MCP server and 6 more of the repo's skills",
            "command": "npx @swmansion/argent@latest init"
          },
          {
            "label": "Editors the Argent installer supports, via pnpm; also sets up the MCP server and 6 more of the repo's skills",
            "command": "pnpm dlx @swmansion/argent@latest init"
          }
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
