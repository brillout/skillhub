    {
      "id": "affaan-m/ecc/skills/orch-pipeline",
      "name": "orch-pipeline",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/orch-pipeline",
        "installs": 5000,
        "weeklyInstalls": [260, 160, 142, 236, 406, 398, 470, 439],
        "firstSeen": "2026-06-07"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Defines the gated pipeline the orch-* skills share: a size check, research, plan approval, test-first build, review and commit confirmation, each phase delegated to an ECC agent.",
        "tldr": {
          "glance": [
            {
              "label": "What it is",
              "text": "The shared engine orch-add-feature and orch-build-mvp load for their phases and gates; read it directly only to add an operation or tune the phases"
            },
            {
              "label": "It does",
              "text": "Sizes the request, then runs only the phases that size needs: research, plan, test-first build, review and commit, each handed to an ECC agent or command"
            },
            {
              "label": "Two gates",
              "text": "It stops for you to approve the plan before any code is written, and to confirm the diff and commit messages before committing"
            },
            {
              "label": "Sizes",
              "text": "Trivial, small, standard or large, judged by files touched, new dependencies or contracts, and open design questions; trivial work goes straight to build, review and commit"
            },
            {
              "label": "You get",
              "text": "Conventional commits, one per logical chunk, of code written test-first and reviewed, with critical and high findings fixed before you're asked to confirm"
            },
            {
              "label": "Needs",
              "text": "ECC installed, for agents such as planner, tdd-guide and code-reviewer, commands such as /code-review and /gan-build, and its rules files; research uses gh"
            }
          ],
          "text": "ECC's orch-* skills are thin wrappers: each picks which phases of this pipeline run and hands every phase to an existing ECC agent or command. Before anything else it scores the request on three signals, takes the highest tier any of them reaches and states it in one line so you can override it; a change touching security or a public API is at least standard. Research looks for something to adopt before writing new code: gh search, then Context7 or vendor docs, then package registries, then Exa search. The planner agent writes a task list of thin vertical slices, which you approve. orch-build-mvp alone adds a scaffold phase that stands up the first end-to-end slice. Each task then goes red, green, refactor through the tdd-guide agent. Review runs code-reviewer, plus security-reviewer whenever the diff touches authentication, user input, database queries, file paths, external APIs, cryptography or secrets. Nothing is kept in hidden state: the task list, and for larger work PRD and architecture docs under docs/, are the handoff between phases. Its final checks ask for tests on new behavior and coverage of at least 80%. It also names orch-fix-defect, orch-change-feature and orch-refine-code, which SkillHub doesn't list.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/orch-pipeline"
        },
        "tags": [
          "category:engineering",
          "category:agents",
          "category:planning",
          "type:workflow",
          "effect:local",
          "needs:subagents",
          "needs:cli",
          "by:community",
          "agent-workflows",
          "multi-agent",
          "planning",
          "tdd",
          "code-review"
        ],
        "note": "Not meant to be run alone: orch-add-feature and orch-build-mvp load it, and its phases call ECC's agents and commands.",
        "model": "Claude Opus 5.5",
        "effort": null
      }
