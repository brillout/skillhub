      },
      "skillMd": {
        "version": "00db7d656719c399c091f3ea138c6f42a7fa4d98",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Applies accessibility rules to UI work, from accessible names and keyboard access to focus traps and form errors, or reviews a file against them.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You add buttons, links, forms, dialogs, menus or keyboard shortcuts, or want a file checked for accessibility"
            },
            {
              "label": "It does",
              "text": "Applies rules in priority order: accessible names, keyboard access, focus and dialogs, semantics, forms and errors, announcements, contrast, media"
            },
            {
              "label": "You get",
              "text": "UI work that follows the rules, or a review quoting each violation with why it matters and a proposed small fix"
            },
            {
              "label": "Rule of thumb",
              "text": "Native HTML before ARIA, and targeted fixes rather than rewriting large parts of the UI"
            }
          ],
          "text": "The accessibility rules of ibelick's UI skills, in priority order. Every control needs an accessible name, icon-only buttons an aria-label and decorative icons aria-hidden; nothing clickable is a div without full keyboard support, focus stays visible and tabindex never goes above 0. Dialogs trap focus, set it inside on open, return it to the trigger on close and close on Escape. Native elements come before roles, headings don't skip levels, and lists and tables use their proper elements; complex widgets such as menus, dialogs and comboboxes use established accessible primitives. Form errors are tied to their fields with aria-describedby, invalid fields set aria-invalid and disabled submit buttons explain why. Critical errors use aria-live, toasts never carry critical information alone, hover-only interactions get keyboard equivalents, text and icons get sufficient contrast, disabled states don't rely on color alone, images get correct alt text, and non-essential motion respects reduced-motion settings. It won't migrate UI libraries or refactor unrelated code. Called alone, it applies the rules for the rest of the conversation; called with a file, it reviews that file and proposes small fixes.",
          "permalink": "https://github.com/ibelick/ui-skills/tree/00db7d656719c399c091f3ea138c6f42a7fa4d98/skills/fixing-accessibility"
        },
        "tags": [
          "category:design",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "accessibility",
          "code-review"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "ibelick/ui-skills/skills/fixing-metadata",
