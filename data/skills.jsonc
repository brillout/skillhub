      "agentReview": {
        "description": "Walks you through the whole designer workflow in order, from grilling and brief to tokens, tasks and build, confirming each phase before the next.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're starting a page or product from scratch and want the whole design process, not one step of it"
            },
            {
              "label": "It does",
              "text": "Lists the six phases, lets you skip any, then loads each phase's skill in turn and asks before moving on"
            },
            {
              "label": "You get",
              "text": "A brief, information architecture and a task list in .design/<feature>/, tokens in your project's styles, then the built pages, one task at a time"
