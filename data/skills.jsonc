    {
      "id": "gamedev-skills/awesome-gamedev-agent-skills/skills/genres/survival-crafting",
      "name": "survival-crafting",
      "skills.sh": {
        "url": "https://skills.sh/gamedev-skills/awesome-gamedev-agent-skills/survival-crafting",
        "installs": 10400,
        "weeklyInstalls": [313, 370, 371, 429, 622, 1407, 1765, 1605],
        "firstSeen": "2026-06-27"
      },
      "skillMd": {
        "version": "25eec57919aec2cfd87d4ef9ae5661832302585e",
        "updated": "2026-11-12",
        "skew": 1815
      },
      "agentReview": {
        "description": "Guides building survival-crafting games: resource gathering gated by tool tiers, crafting that consumes inputs atomically, decaying needs with graded consequences, and base building.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "The player gathers, crafts, manages hunger, thirst and temperature, and builds a base against escalating threats"
            },
            {
              "label": "It does",
              "text": "Sets out eight must-have systems, from resource nodes and inventory to threats and saving, with a knob table and engine-neutral pseudocode"
            },
            {
              "label": "Its rule",
              "text": "Each tier must open the next (better tool, new node, new resource, better craft), or the game turns into a grind"
            },
            {
              "label": "Leaves to others",
              "text": "Items as data, world generation, saving and creature AI, to the repo's engine data, procedural-gen, save-systems and game-ai skills"
            }
          ],
          "text": "A genre playbook from a game-development collection. Its loop is gather, craft, build, manage needs, explore farther and survive bigger threats, one tier higher each time. Patterns cover needs that decay over time and, once empty, drain health instead of killing at once, with healing while the player is fed and safe; recipes as data, crafted only after checking tech, station, inputs and room for the result, so inputs are never consumed by a failed craft; and gathering that yields only to a good enough tool, from nodes that respawn. Pitfalls include needs that kill instantly, inventories with no limit, which remove any reason for storage, a world players can strip bare, decay not scaled by frame time, and fragile saves of a large world. The knob table covers decay rates, scarcity, tool tiers, recipe depth, inventory limits, threat escalation and day length.",
          "permalink": "https://github.com/gamedev-skills/awesome-gamedev-agent-skills/tree/19d93f97c9c1ea0f8b306e77aa81e0d3e352d3e9/skills/genres/survival-crafting"
        },
