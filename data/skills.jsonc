    {
      "id": "emilkowalski/skills/skills/gestures",
      "name": "gestures",
      "skills.sh": {
        "url": "https://skills.sh/emilkowalski/skills/gestures",
        "installs": 12300,
        "weeklyInstalls": [0, 0, 0, 0, 0, 0, 0, 1358],
        "firstSeen": "2026-11-08"
      },
      "skillMd": {
        "version": "4061b67b8d976a186aca118594f54b638c5f718a",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Builds drag, swipe and sheet interactions that follow the finger exactly while held and finish with a spring carrying the release velocity.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're building or fixing something people drag, swipe, fling or hold, such as a drawer, bottom sheet, swipe-to-dismiss card or pull-to-refresh"
            },
            {
              "label": "It does",
              "text": "Splits every gesture in two: while the finger is down, the element follows it exactly; on release, a spring carries on at the finger's speed"
            },
            {
              "label": "Prefers",
              "text": "Vaul, a drawer library, for any bottom sheet or drawer; it builds a gesture by hand only when no library covers it"
            },
            {
              "label": "Covers",
              "text": "Dismissing on distance or a fast flick, resistance at edges, catching an element mid-animation, and overlays that fade with the drag"
            },
            {
              "label": "Unlike apple-design",
              "text": "That one brings Apple's fluid-interface talks to the web, plus glass, type and design principles; this one covers only gestures, with Motion code and lessons from Vaul and Sonner"
            },
            {
              "label": "Checklist",
              "text": "For every gesture: test on a real phone, keep hit targets at least 44px, set touch-action on the drag axis, and limit hover effects to mouse and trackpad"
            }
          ],
          "text": "Its rule: while the finger is down, the interface is the finger; once it lifts, physics takes over. While tracking, position comes straight from the pointer, written as a transform on the dragged element, with no easing, no spring and no React re-render per move. On release, a spring starts at the gesture's velocity, so a flick lands differently from a slow drag. An element dismisses past about 40–50% of its travel or on a fast flick, bounces slightly only after a drag, never after a button press, and snaps back fast when it doesn't pass. Nothing a gesture can touch uses CSS keyframes, which restart from zero and can't be caught mid-flight, and overlays or scaled backgrounds follow the drag's position instead of animating separately. It also covers Motion's drag props, Vaul's iOS-style sheet curve, dismissing along the axis an element entered on, as the toast library Sonner does, linear timing for hold-to-delete, and reduced motion. For stutter it points to the animation-performance skill, and to pick-ui-library when unsure whether to build at all.",
          "permalink": "https://github.com/emilkowalski/skills/tree/4061b67b8d976a186aca118594f54b638c5f718a/skills/gestures"
        },
        "tags": [
