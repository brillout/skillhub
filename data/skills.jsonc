    {
      "id": "gamedev-skills/awesome-gamedev-agent-skills/skills/genres/visual-novel",
      "name": "visual-novel",
      "skills.sh": {
        "url": "https://skills.sh/gamedev-skills/awesome-gamedev-agent-skills/visual-novel",
        "installs": 10300,
        "weeklyInstalls": [292, 362, 372, 427, 618, 1386, 1738, 1591],
