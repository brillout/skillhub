      "agentReview": {
        "description": "Drafts or restructures manuscript sections and initial-submission materials from your evidence, in Nature-style argument form.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need to draft or restructure a manuscript section, or first-submission materials, from your own results"
            },
            {
              "label": "It does",
              "text": "Surfaces the missing claim, evidence or boundary, then drafts in paper-type and section order, sentence rules last"
