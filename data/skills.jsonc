      "agentReview": {
        "description": "Lets you pick up to five of your agent personas, runs them in parallel on one task, and merges their findings into one report.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have a collection of agent persona files and want several specialists, such as security and SEO, to look at one task"
