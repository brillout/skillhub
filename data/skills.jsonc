      "agentReview": {
        "description": "Audits TON FunC contracts for three platform-specific bugs: positive integers used as booleans, fake Jetton notifications and TON forwarded without gas checks.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're auditing FunC contracts on TON, especially Jetton token handlers and code that forwards TON in outgoing messages"
