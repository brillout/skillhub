      "name": "refactor-method-complexity-reduce",
      "skills.sh": {
        "url": "https://skills.sh/github/awesome-copilot/refactor-method-complexity-reduce",
        "installs": 10000,
        "weeklyInstalls": [19, 28, 24, 18, 6, 6, 16, 9],
