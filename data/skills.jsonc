    {
      "id": "wondelai/skills/domain-driven-design",
      "name": "domain-driven-design",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/domain-driven-design",
        "installs": 7700,
        "weeklyInstalls": [189, 196, 160, 187, 320, 248, 182, 194],
        "firstSeen": "2026-02-23"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Models software around the business with Eric Evans's Domain-Driven Design: a shared language, bounded contexts, small aggregates and domain events.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Code doesn't match how the business talks, or you're splitting a big system or setting service boundaries"
            },
            {
              "label": "It does",
              "text": "Applies Eric Evans's patterns, from business vocabulary in class names to maps of how subsystems relate"
            },
            {
              "label": "You get",
              "text": "Modeling advice and a score out of 10 from seven diagnostic questions and three depth checks"
            },
            {
              "label": "Unlike clean-architecture",
              "text": "That one, from the same repo, arranges layers and dependencies; this one shapes the model of the business itself"
            }
          ],
          "text": "Based on Eric Evans's Domain-Driven Design. Its premise is that the code should be the model of the business, named in a ubiquitous language: the words domain experts use, so ClaimAdjudicator rather than DataProcessor, and a concept that's hard to name is a sign the model is wrong. A bounded context is a boundary inside which one model applies, so billing and shipping can each have their own Customer; a context map shows how contexts relate, and an anti-corruption layer translates any outside model before it reaches yours. It separates entities, which keep their identity as they change, from value objects, defined only by their values, and keeps aggregates small, with one root that guards their consistency. Domain events, named in the past tense like OrderPlaced, carry changes between aggregates. Repositories and factories hide storage and creation, and strategic design puts the deepest modeling into the core domain, buying or reusing generic parts such as payments. Seven diagnostic questions and three depth checks set the score.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/domain-driven-design"
        },
        "tags": [
          "category:engineering",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "domain-modeling",
          "architecture"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wondelai/skills/jobs-to-be-done",
      "name": "jobs-to-be-done",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/jobs-to-be-done",
        "installs": 7400,
        "weeklyInstalls": [168, 188, 173, 181, 327, 278, 193, 192],
        "firstSeen": "2026-01-30"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Finds the job customers hire your product to do, with Clayton Christensen's Jobs to Be Done theory, for discovery, positioning and churn.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need to know why customers buy, switch or churn, or want to rethink a product around what they need"
            },
            {
              "label": "It does",
              "text": "Frames a need as progress someone wants in a situation, with its functional, emotional and social sides and the forces for and against switching"
            },
            {
              "label": "You get",
              "text": "A job statement, competitors beyond your category, interview questions, and a score out of 10"
            },
            {
              "label": "Unlike mom-test",
              "text": "That one, from the same repo, is for non-leading interviews; this one is the wider theory of why customers choose products"
            }
          ],
          "text": "Based on Competing Against Luck by Clayton Christensen and coauthors. A job is the progress someone wants to make in a particular situation, written as \"When [situation], I want to [progress], so I can [outcome]\" without naming any product, and every job has functional, emotional and social sides. Customers switch only when frustration with what they have and the pull of the new option outweigh habit and anxiety, so it looks for ways to reduce anxiety and habit, not only to add appeal. It separates the big hire, buying once, from the little hire, choosing to use the product each time, where it says most retention problems lie. Competition is everything that could do the same job, including doing nothing. For customer interviews, it reconstructs a real purchase from the first thought to using it, asking only about past events. It also suggests job-based metrics and teams, and copy patterns for marketing. Seven diagnostic questions and three depth checks set the score.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/jobs-to-be-done"
        },
