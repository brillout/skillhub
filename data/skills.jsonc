      "agentReview": {
        "description": "Optimizes your content to be cited in AI answers from ChatGPT, Perplexity, Google AI Overviews and other assistants.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want your brand cited in AI answers from ChatGPT, Perplexity, Claude, Gemini, Copilot or Google AI Overviews"
            },
            {
              "label": "It does",
              "text": "Audits where you're cited today, then improves pages along three lines: structure AI can quote, authority worth citing, and presence where AI looks"
            },
            {
              "label": "You get",
              "text": "A citation audit by query and platform, page fixes, AI crawler rules for robots.txt, files such as llms.txt and pricing.md, and a monitoring routine"
