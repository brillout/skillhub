    {
      "id": "cursor/plugins/pstack/skills/principle-prove-it-works",
      "name": "principle-prove-it-works",
      "skills.sh": {
        "url": "https://skills.sh/cursor/plugins/principle-prove-it-works",
        "installs": 5800,
        "weeklyInstalls": [384, 441, 530, 426, 437, 476, 373, 324],
        "firstSeen": "2026-05-24"
      },
      "skillMd": {
        "version": "8ecfb19f844b67a4bc7af7f66c366d57bc7b6d2b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Makes the agent check the real thing before calling a task done, not a proxy, a self-report or \"it compiles\".",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A task is finished and the agent is about to say it's done"
            },
            {
              "label": "It does",
              "text": "Verifies against the real artifact: runs the feature, reads the actual value, inspects the diff, checks process liveness directly"
            },
            {
              "label": "Prefers",
              "text": "A script that reruns the same comparison, kept as output a reviewer can rerun"
            },
            {
              "label": "Runs",
              "text": "Only when you call it"
            }
          ],
          "text": "One of pstack's principle skills, in Cursor's plugin repo. Indirect checks, such as file times, output freshness, an agent's own report or a cached screenshot, feel cheaper than looking, and it rules them out because acting on a wrong inference costs far more than checking the source. When a check fails, it suspects the way it observed before it suspects the system. The strongest proof is a deterministic script, run and kept as an artifact so a reviewer can rerun it instead of trusting the agent's word. The artifact stays visible to you, and is committed only for large or complex work that needs an auditable trail, like a big port or migration, with pstack's show-me-your-work skill.",
          "permalink": "https://github.com/cursor/plugins/tree/8ecfb19f844b67a4bc7af7f66c366d57bc7b6d2b/pstack/skills/principle-prove-it-works"
        },
        "tags": [
