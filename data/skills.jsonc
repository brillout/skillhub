      },
      "skillMd": {
        "version": "456d9e0d3e2d84c748bb143c6ca3d90c45e16213",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Plans, writes and styles landing pages around one offer, audience and action, with conversion copy, SEO and a strict visual system for type, spacing, radius and motion.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're building or restyling a landing page or marketing site and want both its copy and its look held to fixed rules"
            },
            {
              "label": "It does",
              "text": "Asks what it's missing about the offer, audience, proof and constraints, plans the page around one primary action, then builds it section by section"
            },
            {
              "label": "You get",
              "text": "An outline, hero copy, benefits, three steps, an FAQ, an SEO recommendation and a layout pick before any code, then the page"
            },
            {
              "label": "Visual rules",
              "text": "Geist, Manrope or Poppins only, Tailwind's type scale, a fixed spacing scale, flat backgrounds, Phosphor, Solar or Iconamoon icons, and one easing curve"
            },
            {
              "label": "Always adds",
              "text": "A large tagline section further down the page whose words brighten one by one as you scroll"
            },
            {
              "label": "Applies to",
              "text": "Any web UI work by its own description, dashboards and components included; your explicit prompt overrides its rules"
            },
            {
              "label": "Unlike taste-skill",
              "text": "That one picks a different design direction for each brief; this one applies the same fixed visual system to every page"
            }
          ],
          "text": "Part A decides what the page says. The agent asks, in one batch, for the one action you want, the offer, the audience and their objections, the traffic source, proof and brand voice, and states an assumption for anything you can't answer. The page follows a fixed order: a hero with an outcome headline, one call to action and a proof signal, then problem and solution, benefits, three steps, testimonials, an FAQ, a risk reversal such as a free trial, and the same call to action again. Copy is specific and benefit-first, without filler such as \"supercharge\". Prices, statistics and testimonials it can't source become marked placeholders such as {{price}}. Part B is the visual system: named text styles on Tailwind's scale, spacing and radius tokens, a gradient only on the hero heading, no italics, no hyphens in copy, and motion only on transform and opacity. Every element gets hover, focus, loading, empty and error states, and a ship list covers a 404 page, legal links, meta tags, alt text and a check at 390px wide. For an existing site it points to the author's separate redesign skill.",
          "permalink": "https://github.com/elayadesign/ai-design-skills/tree/456d9e0d3e2d84c748bb143c6ca3d90c45e16213/skills/landing-page-design"
        },
