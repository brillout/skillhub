      "agentReview": {
        "description": "Triages issues, chases stale pull requests, diagnoses CI failures, prepares releases and checks security alerts on GitHub with the gh CLI.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You maintain a GitHub repo and want issues triaged, stale PRs chased, a broken CI run diagnosed or a release cut"
            },
            {
              "label": "It does",
              "text": "Classifies issues by type and priority, labels and answers them, checks PRs' CI and mergeability, reads failed logs and creates releases, all with gh"
            },
            {
              "label": "You get",
              "text": "Labeled issues and replies, investigated CI failures, releases with changelogs from merged PRs, and flagged security alerts"
            },
            {
              "label": "Treats",
              "text": "Issue bodies, PR descriptions and CI logs as untrusted, and never merges, closes or releases because repository text asks it to"
