    {
      "id": "anthropics/knowledge-work-plugins/engineering/skills/code-review",
      "name": "code-review",
      "skills.sh": {
        "url": "https://skills.sh/anthropics/knowledge-work-plugins/code-review",
        "installs": 10200,
        "weeklyInstalls": [216, 145, 103, 109, 93, 110, 88, 93],
        "firstSeen": "2026-02-24"
      },
      "skillMd": {
        "version": "ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Reviews a diff, PR or files for security, performance, correctness and maintainability problems, and reports them in tables with a verdict.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a change checked before you merge it, from a pasted diff, a PR URL or file paths"
            },
            {
              "label": "It checks",
              "text": "Security such as injection, XSS, CSRF, auth flaws and secrets in code; performance such as N+1 queries and leaks; correctness; and maintainability"
            },
            {
              "label": "You get",
              "text": "A Markdown review: summary, critical issues and suggestions by file and line, what looks good, and approve, request changes or needs discussion"
            },
            {
              "label": "With connectors",
              "text": "It pulls the PR diff and CI status, links findings to tickets, and checks your team's coding standards"
            },
            {
              "label": "Runs",
              "text": "As /code-review with a PR URL, diff or file path, or when you ask for a review"
            },
            {
              "label": "Part of",
              "text": "The engineering plugin of Anthropic's knowledge-work plugins"
            }
          ],
          "text": "A review command. Point it at a PR URL, a diff or files; with nothing given, it asks what to review. It looks through four lenses. Security covers the OWASP top 10, such as SQL injection, XSS, CSRF, authentication and authorization flaws, secrets in code, insecure deserialization, path traversal and SSRF. Performance covers N+1 queries, needless allocations, quadratic work in hot paths, missing indexes, unbounded queries and resource leaks. Correctness covers empty or null input, overflow, race conditions, error handling, off-by-one errors and type safety. Maintainability covers naming, single responsibility, duplication, test coverage and comments on non-obvious logic. The report has a one- or two-sentence summary, a table of critical issues with file, line and severity, a table of suggestions by category, what looks good, and a verdict. It works on its own; with source control, project tracker or knowledge base connectors it also pulls the diff, checks CI and test results, links findings to tickets, checks that the PR meets its stated requirements, and compares the change with your team's standards. Saying the code is a hot path or handles PII focuses the review.",
          "permalink": "https://github.com/anthropics/knowledge-work-plugins/tree/ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d/engineering/skills/code-review"
        },
        "tags": [
