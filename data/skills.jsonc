    {
      "id": "gamedev-skills/awesome-gamedev-agent-skills/skills/genres/card-game",
      "name": "card-game",
      "skills.sh": {
        "url": "https://skills.sh/gamedev-skills/awesome-gamedev-agent-skills/card-game",
        "installs": 10500,
        "weeklyInstalls": [325, 368, 380, 430, 635, 1417, 1750, 1597],
