        "skew": 0
      },
      "agentReview": {
        "description": "Migrates test files from `as` type assertions to shoehorn's fromPartial and fromAny.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your tests use `as` assertions to pass partial or deliberately wrong data to typed functions"
            },
            {
              "label": "It does",
              "text": "Installs shoehorn and replaces `as Type` with fromPartial() and `as unknown as Type` with fromAny() in your test files"
