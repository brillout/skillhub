    {
      "id": "wondelai/skills/mom-test",
      "name": "mom-test",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/mom-test",
        "installs": 6100,
        "weeklyInstalls": [156, 162, 157, 168, 320, 257, 196, 167],
        "firstSeen": "2026-02-23"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Plans and reviews customer interviews with Rob Fitzpatrick's Mom Test, asking about people's past behavior instead of their opinion of your idea.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're validating an idea, writing an interview script, or people say they want your product but don't buy it"
            },
            {
              "label": "It does",
              "text": "Steers questions toward specific past behavior, treats compliments and hypotheticals as bad data, and plans the commitment to ask for"
            },
            {
              "label": "You get",
              "text": "A score out of 7 for a conversation or interview plan, with a fix for each failed check"
            },
            {
              "label": "Unlike jobs-to-be-done",
              "text": "That one, from the same repo, is the wider theory of why customers buy; this one is about running the conversation itself"
            }
          ],
          "text": "Based on Rob Fitzpatrick's The Mom Test. Its premise is that people, even your mom, will be polite rather than truthful if you ask about your idea, so three rules apply: talk about their life, not your idea; ask about specifics in the past, not hypotheticals about the future; and talk less, letting them speak 80% of the time. Questions like \"Would you buy this?\" give way to \"Tell me about the last time you...\" or \"What are you currently paying to solve this?\". Compliments, fluff such as \"I usually\", and feature requests count as bad data to deflect or dig into. Every conversation should end in a commitment of time, reputation or money, such as an intro, a pilot or a pre-order, rather than a polite lead that goes nowhere. It prefers casual settings to formal interviews, rules out disguising a sales call as research, and has the team process notes together: separating facts from interpretations and updating beliefs about the problem, the customer segment and the solution after each batch.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/mom-test"
        },
        "tags": [
