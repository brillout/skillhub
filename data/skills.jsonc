        "url": "https://skills.sh/affaan-m/ecc/latency-critical-systems",
        "installs": 5600,
        "weeklyInstalls": [266, 163, 142, 232, 411, 402, 471, 449],
        "firstSeen": "2026-05-25"
      },
      "skillMd": {
