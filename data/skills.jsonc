          "requirements",
          "planning",
          "docs-writing",
          "prototyping"
        ],
        "note": "Needs uv, BMad set up in the project, and the repo's bmad-facilitate skill, which isn't listed on its own.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
