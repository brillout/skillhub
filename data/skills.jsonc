    {
      "id": "julianoczkowski/designer-skills",
      "skew": 0,
      "agentReview": {
        "name": "Designer Skills",
        "description": "A guided design process for building UI with an agent: a brief, information architecture, design tokens and a task list, then the build and a review.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You prototype or build interfaces with an agent and want it to follow a design process instead of jumping straight to code"
            },
            {
              "label": "It does",
              "text": "Settles decisions, writes a brief, plans structure, sets tokens, splits the work into tasks, builds in a named aesthetic and reviews the result"
            },
            {
              "label": "You get",
              "text": "A brief, information architecture, a task list and a screenshot-backed review in .design/<feature>/, tokens in your project's styles, and the built pages"
            },
            {
              "label": "Start with",
              "text": "design-flow, which runs the steps in order, lets you skip any and asks before each next one"
            },
            {
              "label": "Review needs",
              "text": "Playwright MCP or Cursor's built-in browser for screenshots, or screenshots you supply"
            }
          ],
          "text": "Julian Oczkowski's skills for designers who prototype and build with AI coding tools. Each step also runs alone, and design-flow strings them together with a confirmation between phases. grill-me, which comes with the install but isn't listed here, questions you about the plan; design-brief turns that into a brief after scanning the codebase's existing tokens and components; information-architecture adds a site map, navigation, content priority and user flows; design-tokens derives light and dark tokens from the brief's aesthetic philosophy and writes them into your Tailwind config, CSS or theme file; brief-to-tasks orders the work into vertical slices; frontend-design builds them, mobile-first with dark mode, in one of eight named philosophies such as Dieter Rams, Swiss or Neo-Memphis; design-review, run only when you ask, screenshots the running app at three widths and lists must-fix, should-fix and could-improve issues against the brief, each with a suggested fix. The brief, information architecture, task list and review share one .design/<feature>/ folder, so later steps pick up earlier decisions and features don't overwrite each other. The skills that plan or build first scan your project for existing tokens, themes and components, and extend them rather than replace them.",
          "permalink": "https://github.com/julianoczkowski/designer-skills/tree/c259656c76d9758d7ead46b0d2f125cbe84f8665"
        },
        "skills": [
          {
            "id": "julianoczkowski/designer-skills/design-flow",
            "standalone": false,
            "note": "Reads and follows the other skills' SKILL.md files one phase at a time, so alone it has no phases to run. Its first phase, grill-me, isn't listed here: the Claude Code plugin includes it, and the skills CLI offers it among the repo's skills."
          },
          {
            "id": "julianoczkowski/designer-skills/design-brief",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "julianoczkowski/designer-skills/information-architecture",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "julianoczkowski/designer-skills/design-tokens",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "julianoczkowski/designer-skills/brief-to-tasks",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "julianoczkowski/designer-skills/frontend-design",
            "standalone": true,
            "listedOutsideBundle": true
          },
          {
            "id": "julianoczkowski/designer-skills/design-review",
            "standalone": true,
            "listedOutsideBundle": false
          }
        ],
        "install": [
          {
            "label": "Any agent, with the skills CLI, which asks which of the repo's 8 skills to add and for which agents; pick grill-me too for design-flow's first phase",
            "command": "npx skills add julianoczkowski/designer-skills"
