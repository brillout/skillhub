      "agentReview": {
        "description": "Builds UI from a Figma file or design image with your project's existing tokens and components, then compares the result against the design.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have a Figma frame or a screenshot of a design and want it built in your app as drawn"
            },
            {
              "label": "It does",
              "text": "Reads exact values through the Figma MCP server, maps each to an existing token or component, builds only what the design shows, then compares element by element"
            },
            {
              "label": "You get",
              "text": "The built UI and a table of each element's design value, built value and status, plus lists of unwired data, missing states and rule conflicts"
