        "skew": 0
      },
      "agentReview": {
        "description": "Hands the current task to a fresh agent through Paseo, with a self-contained briefing of context, attempts, decisions and acceptance criteria.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want another agent, from any provider Paseo runs, to take over the task you're working on"
            },
            {
              "label": "It does",
              "text": "Picks an agent profile from Paseo's configured profiles, writes a briefing for an agent with zero context, and launches it in your workspace or a new worktree"
            },
            {
              "label": "You get",
              "text": "A new agent titled [Handoff] working from that briefing, which Paseo lists among your subagents until you detach it yourself"
            },
            {
              "label": "Keeps",
              "text": "The task's intent: an investigate-only task tells the new agent not to edit files, a refactor says refactor, not rewrite"
            },
            {
              "label": "Needs",
              "text": "Paseo running with its MCP tools, and the repo's paseo skill"
            }
          ],
          "text": "Paseo is an open-source app that runs coding agents such as Claude Code and Codex side by side, each in its own worktree. This skill passes your current job to one of them. It first reads Paseo's agent profiles and their notes, then takes the profile you name or the one whose notes best fit the work, falling back to Paseo's list of providers when none fits. The briefing follows a fixed outline: task, context, relevant files, current state, what was tried and why it failed, decisions with their reasons, acceptance criteria and constraints. Say \"in a worktree\" and it creates an isolated workspace on a short branch named after the task. It then creates the agent with the briefing as its first prompt and tells you which agent and workspace it used. It doesn't wait for the new agent or poll it, and it leaves detaching it from your subagents to you.",
          "permalink": "https://github.com/getpaseo/paseo/tree/9f68af0274ca06c5decd6269d870d442b8e04500/skills/paseo-handoff"
        },
        "tags": [
          "category:agents",
          "type:command",
          "effect:local",
          "needs:cli",
          "needs:mcp",
          "by:official",
          "stack:paseo",
          "handoff",
          "multi-agent"
        ],
        "note": "Needs Paseo running, from its desktop app or the @getpaseo/cli daemon, with its MCP tools. It reads the repo's paseo skill first, which isn't listed, so install it alongside.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
