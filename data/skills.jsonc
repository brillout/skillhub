      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Hunts a repository for remotely exploitable vulnerabilities worth a bug bounty, proves each with a minimal PoC, and drafts the report.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're preparing a Huntr or HackerOne submission and want findings that pay, not theoretical risks"
            },
            {
              "label": "It does",
              "text": "Checks the program's scope, finds real entry points, uses Semgrep only for triage, and follows user input end to end to a dangerous sink"
            },
            {
              "label": "You get",
              "text": "A report with description, vulnerable code, proof of concept, impact and affected version, once a quality gate passes"
            },
            {
              "label": "Unlike ECC's security-review",
              "text": "This one skips best-practice gaps and drops local-only findings, missing headers and self-XSS that programs reject"
            }
          ],
          "text": "A triage-first workflow for responsible disclosure. It keeps to issues bounty programs pay for: SSRF through user-controlled URLs, auth bypass in middleware, remote deserialization or upload-to-RCE paths, reachable SQL and command injection, path traversal in file serving, and auto-triggered XSS, each with its CWE. It drops what platforms usually reject: local-only pickle or torch.load, eval in CLI tools, shell=True on hardcoded commands, missing headers alone, rate-limit complaints without impact, self-XSS, out-of-scope CI injection and test or demo code. The steps: read the program's rules and SECURITY.md, find real entry points such as handlers, uploads, webhooks and parsers, run static tools like Semgrep only as triage input, read the code path end to end, prove user input reaches a meaningful sink, confirm with the smallest safe proof of concept, and check for duplicates. Before submitting, a gate checks reachability, user control, a working PoC, no existing advisory or CVE, and that the target is in scope.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/security-bounty-hunter"
        },
        "tags": [
          "category:security",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "security",
          "code-review"
        ],
        "note": "Test only targets you own or that a bounty program's scope authorizes you to test.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
