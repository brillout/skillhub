    {
      "id": "gamedev-skills/awesome-gamedev-agent-skills/skills/genres/tower-defense",
      "name": "tower-defense",
      "skills.sh": {
        "url": "https://skills.sh/gamedev-skills/awesome-gamedev-agent-skills/tower-defense",
        "installs": 10400,
        "weeklyInstalls": [309, 366, 372, 433, 622, 1398, 1749, 1600],
        "firstSeen": "2026-06-27"
      },
      "skillMd": {
        "version": "25eec57919aec2cfd87d4ef9ae5661832302585e",
        "updated": "2026-11-12",
        "skew": 1620
      },
      "agentReview": {
        "description": "Guides building tower defense games: data-driven waves, tower targeting priorities, and enemy health balanced against gold income and tower damage.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're building a game where placed towers fire on waves of enemies walking a path, or balancing its waves and economy"
            },
            {
              "label": "It does",
              "text": "Sets out the path, waves, towers, targeting, economy, lives and prep UI, with a knob table and engine-neutral pseudocode"
            },
            {
              "label": "Balance rule",
              "text": "The player should almost afford each wave; enemy health grows about 1.1–1.2× per wave, paced as spike, breather, spike"
            },
            {
              "label": "Leaves to others",
              "text": "Pathfinding, movement, maps and UI, to the repo's game-ai, engine, level-design and game-ui-ux skills"
            }
          ],
          "text": "A genre playbook from a game-development collection. The tension is a planning puzzle: is the current damage enough for what's coming, and can the player afford the answer? Patterns cover a wave as data (enemy type, count, spacing) spawned over time; a tower that keeps the enemies in range and picks one by priority, first along the path by default, or last, closest, strongest or weakest; and a quick sum of a lane's damage against an enemy's health. Pitfalls include enemy health that grows slower than income, one dominant tower with no enemy type to counter it, maze layouts where players can block the goal, fast enemies that slow down or skip waypoints at corners, waves with no preview, and leaks that cost lives but not gold, which sometimes makes leaking the best play.",
          "permalink": "https://github.com/gamedev-skills/awesome-gamedev-agent-skills/tree/19d93f97c9c1ea0f8b306e77aa81e0d3e352d3e9/skills/genres/tower-defense"
        },
