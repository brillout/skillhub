    {
      "id": "mvanhorn/cli-printing-press",
      "skew": 348,
      "agentReview": {
        "name": "CLI Printing Press",
        "description": "Prints agent-friendly Go CLIs with MCP servers for any API or website, then polishes, scores and publishes them, amends or reprints published ones, and files retros on the press itself.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want an agent-friendly command-line tool and MCP server for an API or website, built, tested and optionally shared in a public library"
            },
            {
              "label": "It does",
              "text": "printing-press researches and generates the CLI, output-review and polish check and fix it, score grades it, and publish opens a PR to the public library"
            },
            {
              "label": "You get",
              "text": "A Go CLI with its README, SKILL.md and MCP server in your local press library, plus research and test-proof manuscripts"
            },
            {
              "label": "After publishing",
              "text": "amend patches a published CLI from your session's friction, import copies one back locally, reprint rebuilds it under a newer press, and retro reports press defects"
            },
            {
              "label": "Needs",
              "text": "The cli-printing-press binary, Go 1.26.10 or newer and subagents; the GitHub CLI to publish, amend, import or file retros"
            },
            {
              "label": "Asks first",
              "text": "Before capturing a site in a browser, on the feature list, before amend's PR and before retro files anything; publishing needs a direct request from you"
            },
            {
              "label": "Goes public",
              "text": "publish and amend open PRs on mvanhorn/printing-press-library; retro files public issues on mvanhorn/cli-printing-press and uploads scrubbed zips to catbox.moe, a public file host"
            }
          ],
          "text": "CLI Printing Press turns an API, a website or a captured HAR file into a Go command-line tool built for agents, with an MCP server, and its nine skills drive the cli-printing-press binary. printing-press runs the main loop: research, a feature list you approve, generation, shipcheck and live tests against the real API. Inside that run it calls printing-press-output-review, where a subagent judges sampled command output, and printing-press-polish, which fixes what the checks flag without asking and returns the ship, ship-with-gaps or hold verdict that decides whether the CLI reaches your library. printing-press-score regrades a CLI or compares two. printing-press-publish, only on your direct request, revalidates and live-tests the CLI, scans it for secrets and personal data, and opens a pull request to the public library. Later, printing-press-amend turns friction from your session, or your own asks, into a library PR; printing-press-import copies a published CLI back into your library; and printing-press-reprint regenerates one under the current press, importing it first if needed. printing-press-retro mines a run for defects in the press itself and, on Submit, files public issues on mvanhorn/cli-printing-press and uploads scrubbed zips to catbox.moe, a public file host.",
          "permalink": "https://github.com/mvanhorn/cli-printing-press/tree/94ce80e35cbc516cbab1b80f54d96ca419958ca0"
        },
        "skills": [
          {
            "id": "mvanhorn/cli-printing-press/skills/printing-press",
            "standalone": false,
            "note": "Invokes printing-press-output-review and printing-press-polish on every run, so both must be installed alongside it."
          },
          {
            "id": "mvanhorn/cli-printing-press/skills/printing-press-output-review",
            "standalone": false,
            "note": "Runs only when printing-press or printing-press-polish calls it on a CLI they're checking; it can't be invoked directly."
          },
          {
            "id": "mvanhorn/cli-printing-press/skills/printing-press-polish",
            "standalone": false,
            "note": "Invokes printing-press-output-review during its checks, and works only on CLIs printing-press generated."
          },
          {
            "id": "mvanhorn/cli-printing-press/skills/printing-press-score",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "mvanhorn/cli-printing-press/skills/printing-press-publish",
            "standalone": false,
            "note": "Publishes only CLIs printing-press generated, and applies the PII-scanning step of the secret-protection reference that ships with printing-press."
          },
          {
            "id": "mvanhorn/cli-printing-press/skills/printing-press-amend",
            "standalone": false,
            "note": "Changes only CLIs already in the public Printing Press library, and scrubs credentials with the patterns in printing-press-retro's secret-scrubbing reference."
          },
          {
            "id": "mvanhorn/cli-printing-press/skills/printing-press-import",
            "standalone": false,
            "note": "Fetches only CLIs the press printed and published, into the local press library that printing-press-polish, printing-press-publish and printing-press-reprint work on."
          },
          {
            "id": "mvanhorn/cli-printing-press/skills/printing-press-reprint",
            "standalone": false,
            "note": "Hands every run to printing-press, and invokes printing-press-import first when the CLI isn't local."
          },
          {
            "id": "mvanhorn/cli-printing-press/skills/printing-press-retro",
            "standalone": false,
            "note": "Only reviews printing-press runs, reading their manuscripts. On Submit it files public issues on mvanhorn/cli-printing-press and uploads scrubbed zips to catbox.moe, a public file host."
          }
        ],
        "install": [
          {
            "label": "Claude Code: the installer runs go install for the binary, then adds all nine skills with the skills CLI; needs Go 1.26.10 or newer and Node",
            "command": "curl -fsSL https://raw.githubusercontent.com/mvanhorn/cli-printing-press/main/scripts/install.sh | bash"
          },
          {
            "label": "Codex: the same installer, adding the skills for Codex instead of Claude Code",
            "command": "curl -fsSL https://raw.githubusercontent.com/mvanhorn/cli-printing-press/main/scripts/install.sh | bash -s -- --agent codex"
          },
          {
            "label": "Claude Code, by hand: the binary with go install, then all nine skills with the skills CLI",
            "command": "go install github.com/mvanhorn/cli-printing-press/v4/cmd/cli-printing-press@latest && npx -y skills@latest add mvanhorn/cli-printing-press/skills --skill '*' -g -a claude-code -y"
          },
          {
            "label": "Codex, by hand: the binary with go install, then all nine skills with the skills CLI",
            "command": "go install github.com/mvanhorn/cli-printing-press/v4/cmd/cli-printing-press@latest && npx -y skills@latest add mvanhorn/cli-printing-press/skills --skill '*' -g -a codex -y"
          }
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
      "id": "cursor/plugins@pstack",
      "skew": 0,
      "agentReview": {
        "name": "pstack",
        "description": "Lauren Tan's agent workflows for rigorous engineering: explain code, trace why it's built that way, design and stress-test with several models, and write plainly.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want the agent to go deep before it ships: understand the code, settle the design, then prove the change works"
            },
            {
              "label": "It does",
              "text": "Runs multi-model workflows that explain, design, attack and check changes, plus writing rules and short engineering principles the workflows cite"
            },
            {
              "label": "Entry point",
              "text": "poteto-mode, not listed here, matches a task to one of its 23 playbooks and calls these skills as the steps need them"
            },
            {
              "label": "Works with",
              "text": "Cursor, where it's built; Claude Code gets a generated copy that skips Cursor-only steps and runs the Grok roles on the session model"
            },
            {
              "label": "Models",
              "text": "One per role, set with /setup-pstack; by default Claude Opus for judgment and prose, Grok for code and for the explorers of how and why"
            },
            {
              "label": "Runs",
              "text": "Each skill only when called, by you or by another pstack skill"
            }
          ],
          "text": "pstack is the plugin Lauren Tan (poteto) uses to ship code at Cursor, aimed at writing less code of higher quality. how explains what code does through read-only explorer subagents, and why digs through git, PRs and each connected evidence source for the reasons behind it. architect grounds a design with both, has arena sketch it, then writes the code against the chosen sketch. arena has several models attempt the same task, picks a base and grafts in the best of the rest. interrogate reuses arena's fan-out so adversaries try to break a change, keeping only findings a run proves, and blast-radius proves the one fact a risky-looking change is safe because of. create-verification-skill writes a project skill that drives your app the way a user does, and show-me-your-work keeps an audited log of the decisions in long unattended runs. technical-writing and unslop hold the prose rules for docs, PR descriptions and replies. The fifteen principle skills are one rule each, such as fix root causes or build the lever, which poteto-mode indexes and the other skills cite. The plugin's 33 other skills, among them poteto-mode, setup-pstack and swarm, and its two subagents aren't listed here.",
          "permalink": "https://github.com/cursor/plugins/tree/a5539b15a3d56e04992565aafee2b37051329ce3"
        },
        "skills": [
          {
            "id": "cursor/plugins/pstack/skills/how",
            "standalone": true,
            "listedOutsideBundle": true
          },
          {
            "id": "cursor/plugins/pstack/skills/why",
            "standalone": true,
            "listedOutsideBundle": true
          },
          {
            "id": "cursor/plugins/pstack/skills/architect",
            "standalone": false,
            "note": "Runs the how and why skills to ground the design, and the arena skill to sketch it."
          },
          {
            "id": "cursor/plugins/pstack/skills/arena",
            "standalone": true,
            "listedOutsideBundle": true
          },
          {
            "id": "cursor/plugins/pstack/skills/interrogate",
            "standalone": false,
            "note": "Runs the arena skill's runner setup, fan-out and verify steps; it also states the intent with in-your-own-words, which comes with the plugin but isn't listed here."
          },
          {
            "id": "cursor/plugins/pstack/skills/blast-radius",
            "standalone": true,
            "listedOutsideBundle": true
          },
          {
            "id": "cursor/plugins/pstack/skills/create-verification-skill",
            "standalone": true,
            "listedOutsideBundle": true
          },
          {
            "id": "cursor/plugins/pstack/skills/show-me-your-work",
            "standalone": true,
            "listedOutsideBundle": true
          },
          {
