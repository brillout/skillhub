    {
      "id": "danyuchn/asd-ste100-skill",
      "name": "asd-ste100",
      "skills.sh": {
        "url": "https://skills.sh/danyuchn/asd-ste100-skill/asd-ste100",
        "installs": 10100,
        "weeklyInstalls": [426, 438, 948, 1716, 1280, 1155, 1028, 1089],
        "firstSeen": "2026-08-13"
      },
      "skillMd": {
        "version": "fd86652be0d5d3485c69e1529dfd1fa3c9a7a640",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Rewrites ambiguous English, such as tool descriptions, error messages and agent instructions, into Simplified Technical English that a reader can't misparse.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Text will be read by an agent or system with no human to clear up ambiguity, such as a tool description, error message, prompt or status report"
            },
            {
              "label": "It does",
              "text": "Applies ASD-STE100, the aerospace standard for maintenance English: active voice, simple tenses, one instruction per sentence, short sentences, no phrasal verbs or semicolons"
            },
            {
              "label": "You get",
              "text": "The rewritten text alone, ready to paste, plus a \"Kept as-is:\" line when it kept a longer phrase on purpose; a rule table on request"
            },
            {
              "label": "Two modes",
              "text": "Strict for procedures, errors and tool descriptions; STE-flavored for READMEs, PR descriptions and prose, keeping the sentence rules but loosening word choice"
            },
            {
              "label": "Keeps",
              "text": "Every fact, condition and hedge: \"may have failed\" never becomes \"failed\""
            },
            {
              "label": "Not for",
              "text": "Creative or marketing copy, where voice is the point"
            }
          ],
          "text": "ASD-STE100 is a controlled language the aerospace and defense industry built so technicians can't misread instructions: one meaning per word, one structure per sentence. This skill applies it to text an AI agent or downstream system must parse alone. It splits the rules in two. Structural ones, such as active voice, simple tenses, caps of 20 words per instruction and 25 per description, noun stacks of at most three words and lists for three or more steps, are applied fully. Lexical ones depend on ASD's roughly 900-word dictionary, which the skill doesn't reproduce for copyright reasons, so it only prefers plain words and won't claim dictionary compliance. Before rewriting it scans for six habits: synonym rotation, hedge stacking, nominalization, marketing adjectives, run-on sentences and soft phrasal verbs like \"spin up\". A bundled Python linter can make a first pass over the structural rules. If the text already complies, it says so. Unlike a general plain-language rewrite, it never upgrades a hedge to a fact or adds a cause the source didn't state.",
          "permalink": "https://github.com/danyuchn/asd-ste100-skill/tree/fd86652be0d5d3485c69e1529dfd1fa3c9a7a640"
        },
        "tags": [
          "category:writing",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "writing",
          "docs-writing",
          "agent-development"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
