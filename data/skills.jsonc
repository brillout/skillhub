      "id": "affaan-m/ecc/skills/benchmark-optimization-loop",
      "name": "benchmark-optimization-loop",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/benchmark-optimization-loop",
        "installs": 5600,
        "weeklyInstalls": [264, 164, 148, 235, 413, 404, 475, 446],
