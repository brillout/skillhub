      "agentReview": {
        "description": "Splits a home network into trusted, IoT, server and guest VLANs, with switch ports, SSID mapping and firewall rules for UniFi, pfSense/OPNsense or MikroTik.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want IoT devices, guests and your own computers on separate networks at home, or inter-VLAN rules aren't working"
            },
            {
              "label": "It does",
              "text": "Lays out a five-VLAN design with subnets, then gives click paths for UniFi and pfSense/OPNsense and commands for MikroTik"
