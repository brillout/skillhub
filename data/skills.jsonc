    {
      "id": "yuan1z0825/nature-skills/skills/nature-statistics",
      "name": "nature-statistics",
      "skills.sh": {
        "url": "https://skills.sh/yuan1z0825/nature-skills/nature-statistics",
        "installs": 12900,
        "weeklyInstalls": [992, 778, 512, 661, 660, 592, 449, 420],
        "firstSeen": "2026-07-13"
