        "skew": 0
      },
      "agentReview": {
        "description": "Separates real changes from order-only false positives in Terraform plans for Azure, with a bundled Python script.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "terraform plan shows every element of an Application Gateway, Load Balancer, NSG or similar as changed after you edited one"
            },
            {
              "label": "It does",
              "text": "Exports the plan as JSON and runs a bundled script that tells reordered Set elements apart from added, removed or modified ones"
            },
            {
              "label": "You get",
              "text": "Each change sorted as order-only, an actual Set change or a resource replacement, as Markdown, JSON or a one-line summary"
            },
            {
              "label": "Needs",
              "text": "Terraform and Python 3.8 or later; the script uses only the standard library and covers only azurerm_* resources"
            },
            {
              "label": "Why",
              "text": "Terraform compares Set-type attributes by position, so adding or removing one element marks them all as changed"
            },
            {
              "label": "In CI",
              "text": "Exit codes can stop a pipeline on real changes or replacements, with GitHub Actions and Azure Pipelines examples"
            }
          ],
          "text": "Terraform's Set-type attributes are compared by position rather than by key, so adding or removing one backend pool or security rule makes every element look changed. AzureRM resources such as Application Gateway, Load Balancer, Firewall, Front Door and NSG use many of them, which makes their plans hard to review. The skill has the agent save the plan with terraform plan -out, export it with terraform show -json, and run scripts/analyze_plan.py on the JSON. The script uses only Python's standard library and sorts changes into order-only diffs that are safe to ignore, actual Set changes to review, and resource replacements to check for downtime. It writes Markdown for PR comments, JSON for programs or a one-line summary for CI logs, can include or exclude resource types, and with --exit-code returns 0 to 3 so a pipeline can gate on the result. Values known only after apply, or masked as sensitive, may compare incompletely.",
          "permalink": "https://github.com/github/awesome-copilot/tree/797337f33f73e35d08d82f840e21c4b8c4932d88/skills/terraform-azurerm-set-diff-analyzer"
        },
