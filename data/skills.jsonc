    {
      "id": "rohitg00/ai-engineering-from-scratch/skills/learn",
      "name": "learn",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/ai-engineering-from-scratch/learn",
        "installs": 5100,
        "weeklyInstalls": [197, 279, 452, 395, 305, 334, 354, 322],
        "firstSeen": "2026-08-02"
      },
      "skillMd": {
        "version": "a509402c0b5455d11ddc2b5fa83cc8c0d2e0692b",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Teaches the AI Engineering from Scratch course one lesson at a time, with questions at each step, the lesson's code, a closing quiz and progress saved to LEARNING.md.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're taking the AI Engineering from Scratch course and want your agent to teach you the next lesson"
            },
            {
              "label": "It does",
              "text": "Teaches one lesson per call: the problem, the concept with a question before any math, the code in chunks of 5 to 15 lines, then the lesson's quiz"
            },
            {
              "label": "You get",
              "text": "A warm-up on your last lesson, a quiz score, and a row in LEARNING.md's progress log; lessons scored under 70% join its review queue"
            },
            {
              "label": "Needs",
              "text": "Nothing to install: lessons come from a clone of the repo or from GitHub; start-learning's LEARNING.md picks the next lesson, or it starts at Phase 1, Lesson 1"
            },
            {
              "label": "Lesson screen",
              "text": "An optional browser page beside the terminal, from the repo's lesson-screen skill, with figures, code traces and clickable predictions; needs Node.js 20 or later"
            },
            {
              "label": "Hands off",
              "text": "The MCP, Agent Skills and reverse engineering routes, Claude certification and interview practice to their own tutors, which SkillHub doesn't list"
            },
            {
              "label": "Unlike course-guide",
              "text": "That one points you to the lessons on a topic or bug; this one teaches a lesson, has you answer and predict, and records the result"
            }
          ],
          "text": "learn is the course's teacher, and it expects you to type, answer and run things rather than scroll. With a LEARNING.md it takes the first unlogged lesson of the first phase you marked Do or Review; name a topic, such as \"teach me backprop\", and it teaches that instead, noting the detour. A warm-up asks two questions from your previous lesson's quiz, unscored, to help you remember. Each lesson follows the course's fixed shape: frame the problem, explain the core concept, build it from scratch, then show the production library and ask what it does for you. Code runs for real when the repo is cloned and the runtime is there; otherwise the agent traces a tiny input by hand. Quiz answers stay hidden until you reply. It closes in two lines: what you can now build or explain, and the next lesson's title. Finishing a phase marks it Done and suggests check-understanding; finishing your whole path offers the review queue, a phase quiz or extending the plan. It writes skill calls the way your agent expects: /learn in Claude Code, learn in Codex, plain words elsewhere.",
          "permalink": "https://github.com/rohitg00/ai-engineering-from-scratch/tree/a509402c0b5455d11ddc2b5fa83cc8c0d2e0692b/skills/learn"
        },
        "tags": [
          "category:personal",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:official",
          "learning"
        ],
        "model": "Claude Opus 5.5",
        "effort": null
      }
    },
    {
