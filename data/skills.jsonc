    {
      "id": "AgriciDaniel/claude-seo/skills/seo-hreflang",
      "name": "seo-hreflang",
      "skills.sh": {
        "url": "https://skills.sh/agricidaniel/claude-seo/seo-hreflang",
        "installs": 7600,
        "weeklyInstalls": [241, 223, 236, 235, 250, 278, 336, 321],
        "firstSeen": "2026-02-10"
      },
      "skillMd": {
        "version": "734998e5fdbb16cd96dbaafe2da24eee6fb0d291",
        "updated": "2026-11-11",
        "skew": 11
      },
      "agentReview": {
        "description": "Validates and generates hreflang tags for multilingual sites, and checks content parity and cultural fit across language versions.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A site serves several languages or countries and the wrong version shows up in search"
            },
            {
              "label": "It does",
              "text": "Checks self-references, return tags, x-default, language and region codes, canonical alignment and protocol consistency"
            },
            {
              "label": "You get",
              "text": "A validation table per language, corrected hreflang as HTML tags, HTTP headers or a sitemap, and recommendations"
            },
            {
              "label": "Hreflang is",
              "text": "The tag that tells Google which language or country version of a page to show: a hint, not a directive"
            },
            {
              "label": "Goes further",
              "text": "Scores each language version's cultural adaptation and content parity, and checks its number, date and currency formats"
            }
          ],
          "text": "Common mistakes are ranked by severity: a missing self-referencing or return tag is critical, since Google then ignores the set; codes such as eng, jp, en-uk or es-LA are invalid; hreflang on a non-canonical URL is ignored. It explains when to use HTML link tags, HTTP headers (for PDFs) or an XML sitemap (for large or cross-domain sites), and notes that Search Console's country-targeting setting is gone. Generation detects languages from paths, subdomains, domains and lang attributes, maps equivalent pages and writes the full set for each. Beyond tags, cultural profiles for German-, French- and Spanish-speaking and Japanese markets check calls to action and trust signals, a parity audit compares page existence, structure, metadata and word-count ratios across versions, and locale checks catch formats such as 1,000.00 on a German page. It also flags unreviewed machine translation, which Google treats as scaled content abuse, and notes search features found only in the EEA, Türkiye or South Africa.",
          "permalink": "https://github.com/AgriciDaniel/claude-seo/tree/6be93f45064ffbadced572b5d5c95f55fd263af0/skills/seo-hreflang"
