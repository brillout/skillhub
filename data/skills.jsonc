    {
      "id": "cursor/plugins/pstack/skills/principle-experience-first",
      "name": "principle-experience-first",
      "skills.sh": {
        "url": "https://skills.sh/cursor/plugins/principle-experience-first",
        "installs": 5000,
        "weeklyInstalls": [303, 338, 394, 309, 347, 463, 355, 301],
        "firstSeen": "2026-05-24"
      },
      "skillMd": {
        "version": "a5539b15a3d56e04992565aafee2b37051329ce3",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Has the agent choose user delight over implementation convenience: fewer, polished features, prototypes before production code and the details right.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Product, UX or feature-scope tradeoffs come up, and the convenient implementation would cost the experience"
            },
            {
              "label": "It does",
              "text": "Chooses user delight over implementation convenience: fewer features, polished, prototyped in throwaway HTML before production code, with the details right"
            },
            {
              "label": "The user",
              "text": "Whoever consumes the work: the end user of a UI, the colleague who imports a library or API, and the next engineer to maintain the code"
            },
            {
              "label": "Runs",
              "text": "Only when you call it"
            }
          ],
          "text": "One of pstack's principle skills, in Cursor's plugin repo. Every feature, control and option must justify itself, and a polished product with three features beats a rough one with ten. The details it names are transitions, alignment, spacing, feedback and error states, and every feature should serve the central workflow or get out of the way. The agent explains impact from the user's side. It pairs with the foundational-thinking principle: that one sets the order of the work, this one sets what the work aims at.",
          "permalink": "https://github.com/cursor/plugins/tree/a5539b15a3d56e04992565aafee2b37051329ce3/pstack/skills/principle-experience-first"
        },
