    {
      "id": "gamedev-skills/awesome-gamedev-agent-skills/skills/genres/platformer",
      "name": "platformer",
      "skills.sh": {
        "url": "https://skills.sh/gamedev-skills/awesome-gamedev-agent-skills/platformer",
