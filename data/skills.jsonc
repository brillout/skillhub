      "agentReview": {
        "description": "Watches a pull request until it can merge: waits on checks, fixes review comments, pushes and resolves threads until nothing actionable remains.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want the agent to stay on a pull request until it's ready to merge"
            },
            {
              "label": "It does",
              "text": "Watches pending checks, reads new comments and unresolved review threads, fixes real issues, pushes, then checks again"
            },
            {
              "label": "You get",
              "text": "A PR with passing checks and no open threads, plus a report: commit SHA, check results, open threads, tests run and uncommitted local files left alone"
            },
            {
              "label": "Won't",
              "text": "Resolve a review thread until it has verified the code addresses it, or stop while actionable comments remain"
            },
            {
              "label": "Needs",
              "text": "The GitHub CLI (gh) signed in, and jq"
            }
          ],
          "text": "The agent finds the PR, its branch and base, checks it isn't a draft, and reads its status with gh pr view: mergeability, checks, review decision and comments. It lists unresolved review threads through GitHub's GraphQL API, paging through all of them, and polls pending checks, usually every 30 to 60 seconds. Bot comments are leads, not facts: it checks each finding against the code, and whether a thread refers to stale code. Real issues get focused commits, the relevant tests or builds, and a push, then the loop starts again. When a generated file ships with the code, it makes sure the source and the generated file agree before resolving the comment. It stops only when checks pass or are intentionally skipped, the review decision is acceptable and no actionable comments or unresolved threads remain, and does one last sweep, including local git status, before reporting. claude-mem's build skill runs it last, after make-plan and do.",
          "permalink": "https://github.com/thedotmack/claude-mem/tree/31ebffbb112260183c91bbf901a4da22e241018f/plugin/skills/babysit"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:remote",
          "needs:cli",
          "by:community",
          "stack:github",
          "code-review",
          "ci",
          "git"
        ],
        "note": "Commits and pushes fixes to the PR's branch and resolves review threads on GitHub without stopping to ask, and keeps polling until the PR is clean. Needs gh signed in, and jq.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "langchain-ai/langchain-skills/config/skills/eval-engineering",
      "name": "eval-engineering",
      "skills.sh": {
        "url": "https://skills.sh/langchain-ai/langchain-skills/eval-engineering",
        "installs": 6200,
        "weeklyInstalls": [520, 487, 430, 389, 392, 358, 372, 324],
