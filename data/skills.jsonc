      "agentReview": {
        "description": "Writes a repository-grounded threat model: trust boundaries, assets, attacker capabilities, ranked abuse paths and mitigations, after checking its assumptions with you.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You explicitly ask to threat model a codebase or path, or to list its abuse paths"
