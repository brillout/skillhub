      "agentReview": {
        "description": "Builds static HTML slide decks from 36 themes, 36 layouts and 15 full-deck templates, with animations, keyboard navigation and a presenter window.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a talk, pitch deck, report or Xiaohongshu (RedNote) image post as a tasteful HTML deck rather than a PowerPoint file"
            },
            {
              "label": "It does",
              "text": "Asks or proposes the content and audience, a theme and a starting template first, then scaffolds the deck with a script and fills in copied layouts"
