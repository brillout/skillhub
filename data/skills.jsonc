    {
      "id": "addyosmani/agent-skills/skills/shipping-and-launch",
      "name": "shipping-and-launch",
      "skills.sh": {
        "url": "https://skills.sh/addyosmani/agent-skills/shipping-and-launch",
        "installs": 69600,
        "weeklyInstalls": [3916, 3601, 3885, 5084, 5671, 5253, 4598, 4102],
