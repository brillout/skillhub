      "agentReview": {
        "description": "Maps a codebase into a knowledge graph of files, functions, classes and dependencies, with architectural layers and a guided tour.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You face an unfamiliar codebase and want to see how its pieces fit before reading the code"
