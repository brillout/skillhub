    {
      "id": "affaan-m/ecc/skills/inherit-legacy-style",
      "name": "inherit-legacy-style",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/inherit-legacy-style",
        "installs": 5000,
        "weeklyInstalls": [259, 159, 138, 234, 414, 402, 471, 445],
