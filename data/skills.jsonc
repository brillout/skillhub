    {
      "id": "ayghri/i-have-adhd/skills/i-have-adhd",
      "name": "i-have-adhd",
      "skills.sh": {
        "url": "https://skills.sh/ayghri/i-have-adhd/i-have-adhd",
        "installs": 33500,
        "weeklyInstalls": [2540, 1736, 1508, 2431, 2099, 1925, 1706, 1582],
        "firstSeen": "2026-05-14"
      },
      "skillMd": {
        "version": "1ecea1993b7fce257ffbd686c070948b5e07eda6",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Shapes replies for a reader with ADHD: next action first, numbered steps, restated progress and concrete time estimates.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Long or scattered replies make it hard for you to act on them"
            },
            {
              "label": "It does",
              "text": "Puts the next action first, numbers multi-step work, restates where you are each turn, holds tangents for later and gives concrete time estimates"
            },
            {
              "label": "You get",
              "text": "Replies that start with something to do and end with one next step you can take in under two minutes"
            },
            {
              "label": "Runs",
              "text": "Only when you call /i-have-adhd, then for the rest of the session until you say \"stop adhd mode\" or \"normal mode\""
            },
            {
              "label": "Breaks the rules",
              "text": "For explanations you ask for, destructive actions, debugging loops and real ambiguity"
            }
          ],
          "text": "Its rules start from five facts about reading with ADHD: working memory is small, knowing isn't doing, starting is the hardest step, vague estimates all feel the same, and progress you can't see doesn't register. So the first line is an action, such as a file and line to edit, never context. Work with more than one step becomes a numbered list of single actions, as few as will do. Each turn restates the state, like \"Step 3 of 5 done\", or uses the agent's task list if it has one. A second issue waits until the first is done and comes back as a question. Estimates are concrete (\"about 15 minutes if tests already cover this\"), finished work is shown as what now works and how to try it, errors get a cause and a fix without \"uh oh\", and visible lists stay at five items per group without dropping relevant ones. Openers like \"Great question\", recaps and closing pleasantries are cut. After three \"still broken\" turns it stops patching and names the assumption that might be wrong.",
          "permalink": "https://github.com/ayghri/i-have-adhd/tree/1ecea1993b7fce257ffbd686c070948b5e07eda6/skills/i-have-adhd"
        },
        "tags": [
          "category:output-style",
          "type:mode",
          "effect:none",
          "needs:none",
          "by:community",
          "output-style"
        ],
        "note": "Stays on for the rest of the session until you say \"stop adhd mode\" or \"normal mode\".",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "wheresryan22/anatomy",
