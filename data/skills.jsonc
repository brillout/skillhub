          "architecture",
          "agent-workflows"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "warpdotdev/common-skills/.agents/skills/check-impl-against-spec",
      "name": "check-impl-against-spec",
      "skills.sh": {
        "url": "https://skills.sh/warpdotdev/common-skills/check-impl-against-spec",
        "installs": 27200,
        "weeklyInstalls": [639, 584, 929, 495, 363, 361, 107, 81],
        "firstSeen": "2026-05-20"
      },
      "skillMd": {
        "version": "8792394ff1b655e0af451b8fabb68ef0cfcbd208",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Checks a pull request's code against its spec context during an automated review and adds material mismatches to review.json.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "An automated review with review-pr finds spec_context.md, the PR's spec context: product behavior, tech details or both"
            },
            {
              "label": "It does",
              "text": "Lists the spec's commitments, compares them with the diff and checked-out code, and flags only material drift: missing behavior, contradictions, significant unplanned scope, skipped validation or migration steps"
            },
            {
              "label": "You get",
              "text": "Spec findings folded into review.json: broad drift in the summary, inline comments only on changed lines, each at least an important concern"
            },
            {
              "label": "Doesn't",
              "text": "Write its own report, post to GitHub, or flag harmless differences in naming, structure or technique"
            }
          ],
          "text": "A supplement to review-pr, not a separate review. It runs only when spec_context.md exists, alongside pr_diff.txt and, when present, the PR description. From the spec it extracts the required behaviors, the files or subsystems it said to change, its constraints, and any required validation, migration or follow-up steps, then checks the diff and the checked-out branch for each. Small implementation choices that keep the spec's intent are accepted: it doesn't demand a one-to-one match or speculate about details the spec doesn't state. Material drift goes into the same review.json that review-pr writes, in the summary or as inline comments tied to changed lines, and nothing is added just to say the code matches.",
          "permalink": "https://github.com/warpdotdev/common-skills/tree/8792394ff1b655e0af451b8fabb68ef0cfcbd208/.agents/skills/check-impl-against-spec"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:local",
