      "agentReview": {
        "description": "Creates and maintains product, tech-stack, workflow and track documents in a conductor/ folder that the agent reads before each piece of work.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want every AI coding session on a project to start from the same written product goals, tech choices and working rules"
            },
            {
              "label": "It does",
              "text": "Creates and keeps current a conductor/ folder of Markdown files: product vision, product guidelines, tech stack, workflow rules and a registry of work units"
            },
            {
              "label": "You get",
              "text": "product.md, product-guidelines.md, tech-stack.md, workflow.md, tracks.md and an index.md under conductor/, with starter templates for the first five"
