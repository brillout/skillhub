    {
      "id": "wondelai/skills/system-design",
      "name": "system-design",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/system-design",
        "installs": 6700,
        "weeklyInstalls": [191, 186, 164, 171, 301, 234, 183, 186],
        "firstSeen": "2026-02-23"
      },
      "skillMd": {
