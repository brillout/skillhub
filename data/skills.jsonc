      "skillMd": {
        "version": "a5539b15a3d56e04992565aafee2b37051329ce3",
        "updated": "2026-11-12",
        "skew": 0
      },
      "agentReview": {
        "description": "Biases the agent toward the smallest diff that solves the problem, with one source of truth per decision and no abstractions the change doesn't need.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Refactoring, judging a diff's size, or tempted to add abstractions, layers or signals threaded through the code"
            },
            {
              "label": "It does",
              "text": "Puts a decision repeated in several places behind one source of truth, passed on as a simple flag, and makes the smallest change that solves the problem"
            },
            {
              "label": "Runs",
              "text": "Only when you call it"
            }
          ],
          "text": "One of pstack's principle skills, in Cursor's plugin repo, and a very short one: two rules under a description that biases the agent toward deletion. Fewer lines beat \"elegant\" boilerplate. pstack's build-the-lever principle cites it to keep tools to the smallest script, never a framework.",
          "permalink": "https://github.com/cursor/plugins/tree/a5539b15a3d56e04992565aafee2b37051329ce3/pstack/skills/principle-laziness-protocol"
        },
