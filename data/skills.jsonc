      "skillMd": {
        "version": "e4dd0bb5b15535f7c5a0834187dffba6ac37e4ff",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits a project's npm, PyPI and Go dependencies for known advisories, abandoned upstreams, publisher concentration and install scripts, and writes a risk report.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need to judge the third-party package risk in a project, for example before a security engagement"
            },
            {
              "label": "It does",
              "text": "Runs a bundled collector over each direct dependency and the whole lockfile tree, renders its report, then adds upgrade paths and replacement candidates"
            },
            {
              "label": "You get",
              "text": "report.md and findings.json, written outside the audited repo, with every criterion marked clean, flagged or unassessable"
            },
            {
              "label": "Never",
              "text": "Installs, builds or executes anything; it reads manifests, lockfiles and registry, advisory and repository metadata"
            },
            {
              "label": "Needs",
              "text": "uv to run its scripts, and a logged-in gh; without it, GitHub rate limits leave repository checks unassessable"
            }
          ],
          "text": "Trail of Bits rebuilt this audit around scripts after hand-collected figures came out wrong, such as GitHub contributor counts that overstated how many people can publish a package. So a collector measures advisories matched to exact versions, abandoned or archived upstreams, how few npm publishers control a package, and install-time scripts, and the agent quotes its numbers verbatim instead of estimating them from gh, web search or memory. Missing data is never treated as risk, and a run that measured nothing fails rather than report a clean result. It covers npm, PyPI and Go only, and reads package-lock.json, npm-shrinkwrap.json, uv.lock and Go 1.17+ go.mod for exact versions; yarn, pnpm and poetry lockfiles are noted but not read. On top of the measured report the agent adds a short narrative of what to act on first, whether each advisory fix is a patch or a major version away, verified replacements for abandoned packages, and whether npm ci --ignore-scripts would work, all in an impersonal security-report style. License compliance and scanning your own source are out of scope.",
          "permalink": "https://github.com/trailofbits/skills/tree/e4dd0bb5b15535f7c5a0834187dffba6ac37e4ff/plugins/supply-chain-risk-auditor/skills/supply-chain-risk-auditor"
        },
        "tags": [
          "category:security",
          "type:tool",
          "effect:local",
          "needs:cli",
          "by:official",
          "stack:node",
          "stack:python",
          "stack:go",
          "security"
        ],
        "note": "Needs uv, and gh signed in: unauthenticated GitHub allows 60 requests an hour, so repository checks come back unassessable without it. It reads only manifests, lockfiles and registry metadata, and never installs or runs your code.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
