        "skew": 0
      },
      "agentReview": {
        "description": "Runs commands, debugs CI or build failures and makes narrow fixes, then reports exactly what was inspected, changed, verified, committed or pushed.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You ask the agent to run something, check a repo, fix a failing build or test, or push a fix"
            },
            {
              "label": "It does",
              "text": "Pins down repo, branch, diff and mode, reads the error before editing, fixes one failure at a time and reruns the proving command"
            },
            {
              "label": "You get",
              "text": "A report of surface, evidence, action and a status word, from inspected through verified locally to pushed, or blocked"
            },
            {
              "label": "Won't",
              "text": "Claim a fix before the proving command passes, claim a push the branch didn't make, or run destructive git commands"
            }
          ],
          "text": "An operator workflow from ECC for terminal work where proof matters. It first settles the exact repo path, branch, local diff and which mode you asked for: inspect, fix, verify or push, staying read-only if you only wanted a review. Before changing anything it reads the error, the failing file or test and the git state, using any logs you've already given. Fixes stay narrow: one dominant failure at a time, the smallest proving command first, a bigger build or test pass only after that, and a narrower scope instead of broad retries when a command keeps failing the same way. It prefers the repo's own scripts, leaves unrelated local work alone and avoids destructive git commands. The report names the repo, branch and mode, the failing command or diff, what changed, and a status of inspected, changed locally, verified locally, committed, pushed or blocked; any push claim names the target branch and result. It pulls in ECC's verification-loop, tdd-workflow, security-review, github-ops or knowledge-ops skills when relevant.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/terminal-ops"
        },
        "tags": [
          "category:engineering",
          "category:debugging",
          "type:workflow",
