      "id": "github/awesome-copilot/skills/agent-governance",
      "name": "agent-governance",
      "skills.sh": {
        "url": "https://skills.sh/github/awesome-copilot/agent-governance",
        "installs": 9700,
        "weeklyInstalls": [32, 26, 28, 17, 12, 9, 23, 29],
        "firstSeen": "2026-02-19"
      },
      "skillMd": {
        "version": "797337f33f73e35d08d82f840e21c4b8c4932d88",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Guides adding policy controls to AI agents you build: tool allowlists, content filters, rate limits, threat detection on prompts, trust scores and audit trails.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're building an agent that calls tools, such as APIs, databases or shell commands, and need limits on what it may do"
            },
            {
              "label": "It does",
              "text": "Gives six Python patterns: policies, intent checks, a governing decorator for tools, trust scores, audit trails and framework wiring"
            },
            {
              "label": "You get",
              "text": "Code to adapt: a policy object or YAML file, a @govern decorator, a decaying trust score and an append-only audit log"
            },
            {
              "label": "Works with",
              "text": "PydanticAI, CrewAI and the OpenAI Agents SDK, with an example for each"
            },
            {
              "label": "Unlike output guardrails",
              "text": "Those check after generation; this one's intent check runs on the request before any tool executes"
            }
          ],
          "text": "Reference patterns for putting a governance layer between an agent and its tools. A policy lists allowed and blocked tools, regex patterns to block, a cap on calls per request and tools that need human approval; policies can live in YAML and combine so the most restrictive rule wins. Intent classification scores a prompt against weighted regex signals for data exfiltration, privilege escalation, destructive commands and prompt injection before the agent acts. A decorator wraps each tool function to apply the policy and log every call. Trust scores rise with successes, fall faster with failures and decay over time, so delegated agents can be gated on them. The audit trail is append-only and exports to JSON Lines. A table matches four governance levels, from audit-only to locked-down allowlists, to risk, and a checklist covers setup, implementation and tests. It points to Microsoft's Agent Governance Toolkit and the OWASP Top 10 for LLM applications for more.",
          "permalink": "https://github.com/github/awesome-copilot/tree/797337f33f73e35d08d82f840e21c4b8c4932d88/skills/agent-governance"
        },
        "tags": [
          "category:agents",
          "category:security",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:official",
          "stack:python",
          "guardrails",
          "agent-development",
          "security"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
