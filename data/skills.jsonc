      "agentReview": {
        "description": "Runs a scenario step by step through Playwright MCP, then writes a Playwright TypeScript test from it and runs it until it passes.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have a scenario to test in a web app and want a Playwright test written for it"
