      "agentReview": {
        "description": "Runs a chosen training command conservatively and records its logs, checkpoints and metrics.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A training command is already chosen and you want it started, checked over a short run, kicked off in full, or resumed"
            },
            {
              "label": "It does",
              "text": "Runs the command through RigorPilot's shared runtime and records the command, config, seed, logs, checkpoints and metrics"
            },
            {
              "label": "You get",
              "text": "A train_outputs/ folder: summary, commands, log, status, scientific changelog and comparability report, with partial, blocked and resumed states kept apart"
