    {
      "id": "samber/cc-skills/skills/linkedin-ghostwriting",
      "name": "linkedin-ghostwriting",
      "skills.sh": {
        "url": "https://skills.sh/samber/cc-skills/linkedin-ghostwriting",
        "installs": 5800,
        "weeklyInstalls": [80, 180, 396, 580, 716, 793, 643, 298],
        "firstSeen": "2026-03-22"
      },
      "skillMd": {
        "version": "50a33836b20f690c668af557bd9ef9d07a8c7ef2",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Interviews you for numbers, a method and a counter-intuitive insight, then writes a results-first B2B LinkedIn post around the hook you pick.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a LinkedIn post for yourself, a founder or an executive from a story, a result or an insight"
            },
            {
              "label": "It does",
              "text": "Asks 8 to 14 questions at once, proposes 3 to 5 hooks with nothing else, waits for your pick, then writes the body"
            },
            {
              "label": "You get",
              "text": "A phone-friendly post with short paragraphs, bullets, a directive call to action and unicode bold that pastes into LinkedIn"
            },
            {
              "label": "Won't write",
              "text": "Until it has at least one metric, one counter-intuitive insight, a 2 to 3 step method and a call to action"
            },
            {
              "label": "Unlike substack-ghostwriting",
              "text": "That one, from the same repo, writes newsletter issues; this one writes feed posts"
            }
          ],
          "text": "Written as a B2B ghostwriter that puts results and authority before vanity metrics. The interview covers the audience and starting situation, the post's goal and offer, before-and-after numbers with a timeframe and what can be claimed publicly, the method in three steps, the market belief you contradict, and credibility: what it cost you, a specific moment, social proof. Hooks come from frameworks in a reference file, reveal the result but hold back the how, and avoid rhetorical questions and vague promises. The body opens with a re-hook, follows an and-but-therefore arc, adds new information at regular intervals, pulls one psychological lever and ends on a clear call to action rather than an open question. It cuts filler words, prefers active voice, keeps paragraphs to two lines on a phone, and avoids clichés, emoji overuse and lists of three. Mental models such as the costly signal (\"I spent 40 hours…\") and posts meant to start conversations, not just collect impressions, shape the writing. Afterwards it runs a humanizer skill over the post, telling it to leave the hook intact.",
          "permalink": "https://github.com/samber/cc-skills/tree/50a33836b20f690c668af557bd9ef9d07a8c7ef2/skills/linkedin-ghostwriting"
        },
