          "needs:none",
          "by:community",
          "design",
          "animation"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "earthtojake/text-to-cad/skills/sendcutsend",
      "name": "sendcutsend",
      "skills.sh": {
        "url": "https://skills.sh/earthtojake/text-to-cad/sendcutsend",
        "installs": 11300,
        "weeklyInstalls": [485, 291, 313, 441, 565, 488, 826, 159],
