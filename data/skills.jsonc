      "skillMd": {
        "version": "8d90fd121a263355a4fb44fd082af1416a5c1c2a",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Builds and audits accessibility in SwiftUI, UIKit and AppKit apps for VoiceOver, Voice Control, Switch Control, keyboard access and Dynamic Type.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're building or auditing an iOS, iPadOS or macOS app for VoiceOver, Voice Control, Switch Control, Full Keyboard Access or larger text"
            },
            {
              "label": "It does",
              "text": "Applies rules such as returning focus to the trigger when a sheet closes, speakable and unique labels, gesture alternatives as custom actions and 44×44-point targets"
            },
            {
              "label": "You get",
              "text": "Accessible SwiftUI, UIKit or AppKit code, or an audit against a checklist that asks for evidence on every common task"
            },
            {
              "label": "App Store labels",
              "text": "Before recommending an Accessibility Nutrition Label claim, it requires evidence that every common task works with that feature on each declared device type"
            },
            {
              "label": "Unlike better-accessibility",
              "text": "That one, Jakub Krehel's, covers web UI and WCAG 2.2; this one covers Apple's assistive technologies and its three UI frameworks"
            }
          ],
          "text": "A reference for accessibility on Apple platforms, from dpearson2699's swift-ios-skills collection. It starts from five principles: prefer system controls, never make a gesture, color or motion the only path to an action, keep focus and traversal deliberate, adapt to the user's settings, and treat App Store accessibility answers as claims that need evidence. It explains VoiceOver's fixed reading order (label, value, trait, hint), moves accessibility focus with @AccessibilityFocusState and back to the trigger after a dismissal, makes custom overlays modal with an escape action, and posts announcements in UIKit. It covers Dynamic Type with scaled metrics, custom rotors, Reduce Motion, Reduce Transparency, Increase Contrast and Bold Text, decorative versus meaningful images, Voice Control labels checked with both Show Names and Show Numbers, Switch Control grouping, Full Keyboard Access, Assistive Access and AppKit's NSAccessibility roles for custom views. Testing pairs manual runs with each assistive technology and the Accessibility Inspector with XCTest checks that complement them, never replace them. Longer examples, the nutrition-label criteria and media captions sit in reference files it loads when needed, and keyboard focus mechanics are left to the collection's focus-engine skill.",
          "permalink": "https://github.com/dpearson2699/swift-ios-skills/tree/8d90fd121a263355a4fb44fd082af1416a5c1c2a/skills/ios-accessibility"
        },
