    {
      "id": "wondelai/skills/contagious",
      "name": "contagious",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/contagious",
        "installs": 5700,
        "weeklyInstalls": [140, 148, 137, 153, 290, 220, 166, 152],
        "firstSeen": "2026-02-10"
      },
      "skillMd": {
        "version": "d8d5d75f83da9f16d8aad5bab5f5b341a4770a30",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Designs word of mouth into products, campaigns and content with Jonah Berger's six STEPPS drivers of why people share.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a product, campaign or piece of content to spread by word of mouth, or nothing you make gets shared"
            },
            {
              "label": "It does",
              "text": "Rates six drivers of sharing, STEPPS: social currency, triggers, emotion, public visibility, practical value and stories"
            },
            {
              "label": "You get",
              "text": "A score out of 10 and the drivers to strengthen next, plus copy patterns for each"
            },
            {
              "label": "Unlike made-to-stick",
              "text": "That one, from the same repo, makes messages sticky; this one is about why people pass things on"
            }
          ],
          "text": "Based on Jonah Berger's Contagious: Why Things Catch On. Its premise is that sharing can be engineered, and that most word of mouth happens offline, so it is about the psychology of sharing more than social media mechanics. STEPPS names six drivers. Social currency: people share what makes them look good, such as Spotify Wrapped or achievement cards. Triggers: everyday cues keep a product top of mind, and frequent cues beat strong rare ones, like Kit Kat and coffee breaks. Emotion: high-arousal feelings such as awe, amusement or anger drive sharing, while sadness and contentment don't. Public: usage others can see gets copied, like Hotmail's signature line. Practical value: useful tips and deals that are easy to forward, framed with the Rule of 100 (percent off under $100, dollars off above). Stories: a narrative people retell that can't be told without the brand, its Trojan Horse test. Each driver scores 0 to 2, and the total out of 12 maps to the score. Tables combine drivers for launches, content and features, and each driver has an ethical line, such as no false scarcity. Reference files cover each driver, with case studies.",
          "permalink": "https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/contagious"
        },
        "tags": [
          "category:marketing",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "marketing",
          "copywriting",
          "social-media"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
