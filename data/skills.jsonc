        "weeklyInstalls": [1268, 1191, 1182, 1224, 1121, 1100, 1101, 1063],
        "firstSeen": "2026-01-21"
      },
      "skillMd": {
        "version": "febd071a873968a7d4214dbff0dfc7908b5cd453",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits a website's SEO and plans changes for both classic search and AI answer engines such as ChatGPT and Perplexity.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a site found in Google and Bing and cited by AI answer engines such as ChatGPT, Perplexity and Claude"
            },
            {
              "label": "It does",
              "text": "Checks the site's meta tags, robots.txt, sitemap and load time, researches keywords by web search, then works through SEO and GEO checklists"
            },
            {
              "label": "You get",
              "text": "A report of what's in place and prioritized recommendations, with meta tag and JSON-LD schema templates to fill in"
            },
            {
              "label": "GEO means",
              "text": "Generative engine optimization: getting cited by AI search, which cites sources rather than ranking pages"
            }
          ],
          "text": "Covers classic search and AI search in one pass. A bundled Python script runs a free technical check of the title, meta description, H1, robots.txt, sitemap and load time, and curl checks confirm the meta tags and that AI crawlers such as GPTBot, PerplexityBot and ClaudeBot are allowed. Keyword research uses web searches for volume, difficulty and competitors. For AI engines it weighs nine methods from Princeton's GEO research by the visibility change it attributes to each: citing sources, adding statistics and quotations, an authoritative tone and plainer language help, while keyword stuffing hurts. It generates FAQPage schema and suggests an answer-first structure with short paragraphs, lists and tables. For classic search it gives title, description, Open Graph and Twitter card templates, JSON-LD types per kind of page and a content checklist, then opens Google's Rich Results Test and the Schema.org validator and checks indexing with site: searches. Platform notes cover ChatGPT, Perplexity, Google AI Overviews, Copilot and Bing, and Claude, which it says relies on Brave Search.",
          "permalink": "https://github.com/resciencelab/opc-skills/tree/febd071a873968a7d4214dbff0dfc7908b5cd453/skills/seo-geo"
        },
