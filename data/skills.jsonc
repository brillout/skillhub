    {
      "id": "software-mansion/argent",
      "skew": 369,
      "agentReview": {
        "name": "Argent",
        "description": "Software Mansion's skills for Argent, an MCP server that lets the agent use your app on simulators, emulators, phones, TVs and Chromium apps, to test its UI, record it, debug its JavaScript, profile it and try out design variants.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want the agent to use, test, record, debug or speed up your app, React Native above all, on a simulator, emulator, phone or TV"
            },
            {
              "label": "It does",
              "text": "Teaches the agent Argent's tools: drive the app by touch or TV remote, check UI flows, diff screenshots, record video, read logs, profile code and offer design variants"
            },
            {
              "label": "You get",
              "text": "UI flows checked with screenshot diffs, element trees and logs, answers from the live app, videos, profiling reports, measured fixes if you want them, and your chosen design applied"
            },
            {
              "label": "Start with",
              "text": "argent-device-interact, which the testing, recording, design and profiling skills use to drive the app (argent-tv-interact on a TV); for speed, argent-react-native-optimization, which runs the profilers for you"
            },
            {
              "label": "Needs",
              "text": "The Argent MCP server, set up by its installer; full Xcode for native profiling on iOS; the vega CLI for Fire TV; a feature flag for argent-lens"
            },
            {
              "label": "Physical iPhones",
              "text": "Support only the tools argent-ios-device-interact lists: no debugger, profiler or screen recording, which move to a simulator, and no permission tool"
            },
            {
              "label": "Unlike agent-browser",
              "text": "That one drives websites; this one drives apps on phones, TVs, simulators and emulators, and can see inside a React Native app"
            }
          ],
          "text": "Argent is Software Mansion's MCP server for controlling simulators, emulators, phones, TVs and Chromium apps; these twelve skills teach the agent to use it. argent-device-interact is the base: which tool fits each tap, swipe or keystroke, and how to find targets in the element tree. It sends the agent to argent-ios-device-interact for a physical iPhone, which has fewer tools, and to argent-settings-permissions only when the app's own dialog can't change a permission. argent-tv-interact swaps taps for focus moved by remote buttons. argent-test-ui-flow builds on argent-device-interact for manual QA, checking each step with the element tree, logs or a screenshot diff, taken as argent-screenshot-diff describes, then giving a verdict. argent-screen-recording captures a flow as video. argent-metro-debugger attaches to a React Native app's JavaScript runtime through Metro for logs, components, network traffic and running code. Performance work starts at argent-react-native-optimization: subagents fix what lint and a checklist turn up, then argent-react-native-profiler records React commits, with argent-native-profiler alongside by default for native hangs, CPU and leaks; both ask before fixing and re-profile after. argent-lens builds design variants in the running app, lets you pick in Argent's Lens window, then applies your picks. One installer sets up the server and all the repo's skills.",
          "permalink": "https://github.com/software-mansion/argent/tree/b965c94827d6167fd2912a7ca5ad5505040ae4e0"
        },
        "skills": [
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-device-interact",
            "standalone": true,
            "listedOutsideBundle": false
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-ios-device-interact",
            "standalone": false,
            "note": "Covers only what differs on a physical iPhone; argent-device-interact, which sends the agent here for one, still applies to everything else."
          },
          {
            "id": "software-mansion/argent/packages/skills/skills/argent-tv-interact",
            "standalone": true,
            "listedOutsideBundle": false
