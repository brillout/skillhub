          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "stack:framer-motion",
          "stack:react",
          "stack:vaul",
          "animation",
          "mobile",
          "design",
          "accessibility"
        ],
        "model": "Claude Opus 5.5",
