    {
      "id": "trailofbits/skills/plugins/property-based-testing/skills/property-based-testing",
      "name": "property-based-testing",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/property-based-testing",
        "installs": 7900,
        "weeklyInstalls": [188, 207, 211, 272, 278, 299, 344, 312],
