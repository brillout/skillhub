      "agentReview": {
        "description": "Controls and inspects Chrome from shell commands or scripts with the chrome-devtools CLI: clicks and forms, screenshots, network, performance traces and heap snapshots.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want browser automation or debugging from the terminal or a shell script, without connecting an MCP server to your agent"
            },
            {
              "label": "It does",
              "text": "Runs chrome-devtools commands against pages by ID: a snapshot for element uids, then click, fill, type, navigate or emulate"
            },
            {
              "label": "You get",
              "text": "Markdown-like text or JSON, plus screenshots, traces, heap snapshots, screencasts and Lighthouse reports saved to files"
            },
            {
              "label": "Needs",
              "text": "The chrome-devtools CLI, a one-time install, and Chrome"
            },
            {
              "label": "Unlike chrome-devtools",
              "text": "That one, from the same repo, uses the same tools through MCP"
            }
          ],
          "text": "A command reference for the chrome-devtools CLI that ships with chrome-devtools-mcp. A background server starts on the first command and state persists between commands, so the agent doesn't start or stop it each time. Required arguments are positional and options are flags. Commands cover input (click, drag, fill, hover, key presses, typing, file uploads, dialogs), navigation and tabs, emulation of network, CPU, geolocation, color scheme, viewport and user agent, performance traces and insights, heap snapshots with deeper analysis behind --memoryDebugging, network requests, console messages, CSS styles, JavaScript evaluation, Lighthouse audits, screenshots and mp4 screencasts, Chrome extensions, and installable web apps behind a flag. Experimental tools, such as clicking at coordinates, need their own flags at start, and --headless=false shows the browser window.",
          "permalink": "https://github.com/chromedevtools/chrome-devtools-mcp/tree/0b37364dc0a88a804c6d73d3335e776adc7f33c4/skills/chrome-devtools-cli"
