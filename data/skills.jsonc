      "agentReview": {
        "description": "Turns a range of git commits into a customer-friendly changelog grouped into features, improvements and fixes.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're writing release notes, an app store update or a weekly product update from recent commits"
