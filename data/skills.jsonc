      "agentReview": {
        "description": "Builds a scheduled Python scraper that scores what it finds with Gemini, saves new items to Notion and runs on GitHub Actions.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a bot that keeps checking a public site, API or feed, such as job boards, prices, news or GitHub repos, and files what it finds"
            },
            {
              "label": "It does",
              "text": "Asks what to collect and where to keep it, then writes a Python project that scrapes, scores items in batches with Gemini and pushes new ones to Notion"
