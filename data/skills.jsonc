        "skew": 286
      },
      "agentReview": {
        "description": "Drafts, revises and formats academic papers through an interview-first, phase-by-phase pipeline with citation checks and a simulated peer review.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want help with a paper, from planning its chapters and drafting it to answering reviewer comments, checking citations or converting it to LaTeX"
            },
            {
              "label": "It does",
              "text": "Interviews you on paper type, discipline, journal, citation style and length, then searches, outlines, argues, drafts, cites, writes abstracts and reviews the draft"
            },
            {
              "label": "You get",
              "text": "A paper draft, with abstracts in two languages if you want them (Traditional Chinese and English by default), as Markdown, LaTeX, DOCX via Pandoc or PDF"
            },
            {
              "label": "Waits for you",
              "text": "To confirm the configuration and approve the outline; critical review issues block formatting"
            },
            {
              "label": "Modes",
              "text": "11, among them plan (guided, chapter by chapter), revision, revision-coach (reviewer comments to a roadmap), citation-check, disclosure (a venue's AI-use statement) and rebuttal-audit (checks your response letter)"
            },
            {
              "label": "Needs",
              "text": "The whole repo, as the plugin installs it, for files in shared/ and the other ARS skills; Python for revision mode, Pandoc for DOCX, LaTeX for PDF"
            },
            {
              "label": "Unlike academic-paper-reviewer",
              "text": "That one has a five-seat journal panel; this one's own review is a self-check inside the writing run"
            }
          ],
          "text": "The writing skill of Academic Research Skills (ARS). Full mode runs eight phases, each handled by one of twelve role prompts, which run inline in your session unless dispatched as subagents: a configuration interview you confirm, a literature search strategy, an outline you approve, claim-evidence chains, a section-by-section draft, citation checks and bilingual abstracts in parallel, a simulated review on five criteria with at most two revision loops, then formatting. Points still open become an Acknowledged Limitations section. Every citation must be verified by DOI or web search, and every paper carries data availability, ethics, CRediT authorship, conflict-of-interest and funding statements. Revision mode changes only the blocks a revision targets, through patches a script applies, so the rest stays byte-identical. Optional style calibration learns your voice from three or more past papers. It picks up deep-research's question brief, bibliography and synthesis when you hand them over, and academic-pipeline runs it for its writing, revision and formatting stages.",
          "permalink": "https://github.com/imbad0202/academic-research-skills/tree/6d9388674de1ad0437ad95db3d52f92b92204d84/academic-paper"
        },
        "tags": [
          "category:writing",
          "category:science",
          "type:workflow",
          "effect:local",
          "needs:cli",
          "by:community",
          "writing",
          "research",
          "verification"
        ],
        "note": "Some steps read protocols from the repo's shared/ folder and the other ARS skills' folders, which a whole-repo install such as the plugin brings and a single-skill copy doesn't.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "imbad0202/academic-research-skills/academic-paper-reviewer",
      "name": "academic-paper-reviewer",
      "skills.sh": {
        "url": "https://skills.sh/imbad0202/academic-research-skills/academic-paper-reviewer",
        "installs": 10400,
        "weeklyInstalls": [259, 228, 221, 214, 276, 281, 243, 212],
        "firstSeen": "2026-03-10"
      },
      "skillMd": {
        "version": "6d9388674de1ad0437ad95db3d52f92b92204d84",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Simulates a journal peer review of your paper with five reviewer roles, then writes an editorial decision letter and a revision roadmap.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a manuscript critiqued the way a journal panel would before you submit it, or want to check that a revision answered earlier comments"
            },
            {
              "label": "It does",
              "text": "Works out the paper's field, sets up reviewer identities for you to confirm, then reviews it from five seats: journal fit, methodology, domain, cross-disciplinary and Devil's Advocate"
            },
            {
              "label": "You get",
              "text": "Five reports, an editorial decision letter (accept, minor or major revision, or reject) and a revision roadmap; it never edits the manuscript"
            },
            {
              "label": "Modes",
              "text": "Full, quick, methodology-focus, guided (Socratic, issue by issue), re-review of a revision, and calibration against papers you've already judged"
            },
            {
              "label": "Waits for you",
              "text": "After showing the reviewer configuration cards; no review starts until you accept them"
            },
            {
              "label": "Needs",
              "text": "The whole repo, as the plugin installs it, for contracts in shared/ and deep-research's coaching questions; Python for the attachments, which become one-line notes without it"
            },
            {
              "label": "Sends out",
              "text": "Suggested references' titles to bibliographic indexes for an existence check; the manuscript to a second model provider only with cross-model setup and your consent"
            }
          ],
          "text": "The review skill of Academic Research Skills (ARS). A field analyst reads the paper and writes configuration cards for a Journal-Fit Reviewer and three peer reviewers (methodology, domain, cross-disciplinary perspective); a fixed Devil's Advocate takes the fifth seat, looking for the strongest counter-argument, cherry-picking and confirmation bias. The seats write their reports without seeing each other's, and an editorial synthesizer combines them into a decision and roadmap built only from what the reports say. Every critical Devil's Advocate issue is adjudicated in the open, and one that is validated or unresolved blocks a silent accept. After a revision decision it can coach you through the comments with questions and record which items you'll address. The letter carries advisory attachments from Python scripts: an acronym check, whether the works the reviewers suggest exist in four bibliographic indexes, and whether the manuscript contradicts the panel's findings, judged by a subagent. None feeds the decision. With cross-model verification configured and your consent, a full review runs Reviewer 2 on another model family. Live reviews are labelled NOT_CALIBRATED, since no error profile measured in calibration mode is applied to them, and re-review checks each concern against the revised manuscript.",
          "permalink": "https://github.com/imbad0202/academic-research-skills/tree/6d9388674de1ad0437ad95db3d52f92b92204d84/academic-paper-reviewer"
        },
        "tags": [
          "category:writing",
          "category:science",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "research",
          "writing"
        ],
        "note": "Some steps read protocols from the repo's shared/ folder and the other ARS skills' folders, which a whole-repo install such as the plugin brings and a single-skill copy doesn't.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
