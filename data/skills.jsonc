      "name": "antislop-code",
      "skills.sh": {
        "url": "https://skills.sh/miqdadbadjuber/anti-slop/antislop-code",
        "installs": 8200,
        "weeklyInstalls": [793, 843, 594, 766, 735, 817, 922, 894],
