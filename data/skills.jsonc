      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Designs and refactors services as ports and adapters, so business logic stays free of frameworks, databases and transport code.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Domain logic is tangled with I/O, or one use case needs several entry points such as HTTP, CLI, queue workers and cron"
            },
            {
              "label": "It does",
              "text": "Has the agent put each use case behind ports, interfaces for what it offers and needs, with adapters at the edges and one place that wires them"
            },
            {
              "label": "You get",
              "text": "A feature-first folder layout, TypeScript examples of ports, use cases, adapters and wiring, and testing rules per boundary"
            },
            {
              "label": "For old code",
              "text": "Migrates one vertical slice at a time behind characterization tests, with a rollback switch per slice, never a big-bang rewrite"
            },
            {
              "label": "Also called",
              "text": "Ports and adapters"
            }
          ],
          "text": "Hexagonal architecture, also called ports and adapters, keeps business rules independent of frameworks and infrastructure. Ports are interfaces: inbound ones say what the application can do, outbound ones say what it needs, such as a repository, a payment gateway or a clock. Adapters implement them at the edges, such as HTTP controllers or a Postgres repository, and a single composition root wires them together, so dependencies only point inward. This ECC skill lays out six steps: model one use case with plain input and output types, define outbound ports first, orchestrate in the use case, build adapters, wire them, and test per boundary. It includes a feature-first folder layout, TypeScript examples of each piece, package and wiring conventions for Java, Kotlin and Go, and anti-patterns such as domain entities importing ORM models. For existing code, its playbook migrates one high-churn vertical slice at a time behind characterization tests, keeping a reversible route switch until each slice is verified. Testing rules cover pure domain tests, use cases with fake ports, shared contract tests for adapters, and end-to-end flows.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/hexagonal-architecture"
        },
        "tags": [
          "category:engineering",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "stack:typescript",
          "architecture",
          "refactoring",
          "backend"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
