      "agentReview": {
        "description": "Turns a structured-autonomy plan.md into an implementation.md with complete, copy-paste code for every step, checkboxes, verification checks and commit stops.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have a plan.md from structured-autonomy-plan and want every step written out as code before anyone implements it"
