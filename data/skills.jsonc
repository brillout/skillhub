    {
      "id": "paramchoudhary/resumeskills/skills/resume-quantifier",
      "name": "resume-quantifier",
      "skills.sh": {
        "url": "https://skills.sh/paramchoudhary/resumeskills/resume-quantifier",
        "installs": 9500,
        "weeklyInstalls": [376, 315, 329, 409, 433, 424, 397, 494],
        "firstSeen": "2026-05-20"
      },
      "skillMd": {
        "version": "74ae19e7c62b0516d1c298328e5544976c12da5d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Finds numbers for resume bullets that have none, asking about scale and impact and estimating conservatively when exact figures aren't available.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your resume bullets have no numbers, or you feel you \"don't have metrics\""
            },
            {
              "label": "It does",
              "text": "Asks scale, impact and before-and-after questions, then estimates low, as ranges, as minimums, or from known totals and frequencies"
            },
            {
              "label": "You get",
              "text": "Each bullet quantified, with the questions asked, the metrics added, how each estimate was made and the questions still open"
            },
            {
              "label": "Rule",
              "text": "Every number should be conservative and one you can defend in an interview"
            }
          ],
          "text": "Built on the claim that every bullet can be quantified. It sorts metrics into money, time, percentages, volume, quality and frequency, and lists what to measure by role, from quota attainment in sales to uptime in engineering and time to fill in HR. To find hidden numbers it asks scale questions (how many people, what budget), impact questions (what changed because of you) and comparison questions (before versus after). When exact data is missing it estimates: conservatively (if you think 100 hours, say 75+), as a range, as a minimum (\"100+\"), as a share of a known total, or by multiplying a frequency, such as 30 invoices a day over 250 days. It has templates for before-and-after, scale, volume and ranking bullets, and answers for \"I was just one person on a team\", confidential results and entry-level work. Its numbers to avoid include inflated ones, ones you can't explain and confidential ones. Unlike resume-bullet-writer, from the same repo, which rewrites the whole bullet, this one concentrates on the numbers.",
          "permalink": "https://github.com/paramchoudhary/resumeskills/tree/74ae19e7c62b0516d1c298328e5544976c12da5d/skills/resume-quantifier"
        },
