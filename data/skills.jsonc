      "agentReview": {
        "description": "Builds CI/CD pipelines, Dockerfiles, Kubernetes manifests and Terraform, and deploys to production only after your approval, with a rollback plan.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need a pipeline, a container, infrastructure as code or a deployment, or are handling a production incident"
