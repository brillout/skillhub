      "agentReview": {
        "description": "Rewrites French text that reads as AI-generated, removing 38 patterns from stock vocabulary to anglicisms, at the register you need.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A French draft sounds like ChatGPT or Claude: \"crucial\", \"notamment\", \"dans un monde où\", em dashes, sentences all the same length"
