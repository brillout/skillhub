      "skillMd": {
        "version": "d774add241c65e89ed17a4da573b472b0972fd42",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits or improves a manuscript's statistical reporting: experimental units, replication, uncertainty, tests and figure statistics.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You need to check or write up the statistics in a manuscript, not run a new analysis"
            },
            {
              "label": "It does",
              "text": "Extracts the design, defines the true n, maps each claim to its test, and checks failure modes and reporting completeness"
            },
            {
              "label": "You get",
              "text": "A severity-ranked issue list and ready-to-paste Statistical analysis, Results or figure-legend text, with author-input gaps flagged"
            },
            {
              "label": "Keeps",
              "text": "Cells or technical replicates from being counted as independent n"
            }
          ],
          "text": "A reporting-and-review skill, not a substitute for reanalysing raw data unless you supply it and ask. It separates what was measured, what unit was analysed and what was claimed, and treats the independent experimental unit as the default n rather than silently counting cells, fields of view or technical replicates. It maps each result claim to its comparison, test family, assumptions, correction, effect size and uncertainty, checks common failure modes (nesting, many comparisons, significance-only reasoning) and reporting completeness, and aligns figure-legend statistics. Output is a severity-ranked issue list plus conservative ready-to-paste text, with missing facts marked AUTHOR_INPUT_NEEDED rather than invented; a clean drafting request gets just the draft and reporting notes. It carries exact Nature and Nature Machine Intelligence reporting requirements, and checks that a statistic reported in several places agrees, both the NMI rules and that check coming from the repo's nature-shared package. It will not upgrade association into causation or hide weak results.",
          "permalink": "https://github.com/yuan1z0825/nature-skills/tree/d774add241c65e89ed17a4da573b472b0972fd42/skills/nature-statistics"
        },
        "tags": [
          "category:science",
          "type:workflow",
          "effect:none",
          "needs:none",
          "by:community",
          "research"
        ],
        "note": "For Nature Machine Intelligence targets, and to check a statistic reported in several places, it loads files from the repo's nature-shared support package; install that alongside for those.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
