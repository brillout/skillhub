    {
      "id": "juliusbrussee/caveman/skills/cavecrew",
      "name": "cavecrew",
      "skills.sh": {
        "url": "https://skills.sh/juliusbrussee/caveman/cavecrew",
        "installs": 377675,
        "weeklyInstalls": [13425, 11186, 10519, 9349, 7810, 7980, 7538, 7042],
