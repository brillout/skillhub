        "skew": 0
      },
      "agentReview": {
        "description": "Debugs a problem by reproducing, isolating and diagnosing it, then reports the root cause, a proposed fix and tests to keep it from recurring.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have an error or stack trace, something broke after a deploy, or it works in staging but not in production"
            },
            {
              "label": "It does",
              "text": "Reproduces the problem, narrows it to a component and recent changes, tests hypotheses down to the root cause, then proposes a fix"
            },
            {
              "label": "You get",
              "text": "A debug report: expected versus actual behavior, reproduction steps, root cause, the fix, and tests and guards to prevent a repeat"
            },
            {
              "label": "With connectors",
              "text": "It pulls logs, metrics and recent deploys, finds commits that touched the code, searches known bugs, and creates a ticket for the fix"
            },
            {
              "label": "Runs",
              "text": "As /debug with the error or problem, or when the cause of a bug isn't obvious"
            },
            {
              "label": "Part of",
              "text": "The engineering plugin of Anthropic's knowledge-work plugins"
            }
          ],
          "text": "A debugging command from the engineering plugin of Anthropic's knowledge-work plugins. It asks for whatever you have: the exact error or stack trace, steps to reproduce, what changed recently, logs or screenshots, and expected versus actual behavior. It then works in four steps. Reproduce pins down the behavior, the exact steps and the scope: when it started and who is affected. Isolate narrows it to a component, service or code path and checks recent deploys, config and dependency changes, and the logs. Diagnose forms and tests hypotheses and traces the code path to a root cause rather than a symptom. Fix proposes a change with an explanation, weighs side effects and edge cases, and suggests regression tests. The report covers reproduction, root cause, the fix and prevention. With monitoring connected it pulls logs, error rates, metrics and recent deploys around the time of the issue; with source control, the commits and PRs that touched the affected code; with a project tracker, related bug reports, and it creates a ticket for the fix.",
          "permalink": "https://github.com/anthropics/knowledge-work-plugins/tree/ab4cb1cd383b4eb87383be8cf4e70cb5b2a2348d/engineering/skills/debug"
        },
        "tags": [
          "category:debugging",
          "type:workflow",
          "effect:remote",
          "needs:none",
          "by:official",
          "debugging"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
