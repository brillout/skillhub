      "agentReview": {
        "description": "Implements ERC-721 and ERC-1155 NFT contracts in Solidity, with on- or off-chain metadata, EIP-2981 royalties, soulbound and dynamic tokens and ERC721A minting.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're launching an NFT collection, game items or non-transferable badges, or adding royalties for marketplaces"
            },
            {
              "label": "You get",
              "text": "Solidity contracts for a capped, paid ERC-721 mint and an ERC-1155 set of game items with per-item supply caps, batch minting and burning"
