        "skew": 190
      },
      "agentReview": {
        "description": "Pulls Search Console performance, indexing status, Core Web Vitals field data and GA4 organic traffic from Google's APIs for SEO analysis.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want Google's own numbers on your site, such as real users' page speed, index status and search clicks, rather than estimates from a crawl"
            },
            {
              "label": "It does",
              "text": "Runs the plugin's scripts against PageSpeed Insights, CrUX, Search Console, URL Inspection, the Indexing API and GA4, and reports the results"
            },
            {
              "label": "You get",
              "text": "GOOGLE-API-REPORT-{domain}.md with Core Web Vitals rated Good, Needs Improvement or Poor and data tables, and a PDF with charts on request"
            },
            {
              "label": "Unlocks in tiers",
              "text": "An API key covers PageSpeed, CrUX, YouTube and NLP; a service account or OAuth adds Search Console and indexing; a GA4 property ID adds traffic; Ads tokens add keywords"
            },
            {
              "label": "Also has",
              "text": "YouTube search, entity and sentiment analysis, Knowledge Graph and Web Risk checks, and Keyword Planner volumes with a Google Ads account"
            },
            {
              "label": "Unlike the crawl-based audits",
              "text": "The bundle's other audits crawl the site; this one reports what Google itself measured: Chrome users' speed, index status, clicks and organic sessions"
            }
          ],
          "text": "Before each command it checks your credentials and says which tier you're on. PageSpeed runs Lighthouse for mobile and desktop and adds 28 days of CrUX field data, metrics from real Chrome users, at URL level or else for the whole origin; crux-history shows 25 weeks of trend per metric. Search Console gives clicks, impressions, CTR and position for 28 days, flags quick wins at positions 4 to 10 with high impressions, inspects URLs one at a time or in batches of up to 2,000 a day, and lists sitemap status. Submitting URLs to the Indexing API is capped at 200 a day, and it tells you Google officially supports it only for job postings and livestream videos. GA4 reports organic sessions, users and top landing pages. It warns that a Search Console logging error made impressions, CTR and position unreliable from May 2025 to April 2026, that AI Mode traffic can't be split from normal totals, and that GA4's AI Assistants channel undercounts. After any analysis it offers a PDF or HTML report.",
          "permalink": "https://github.com/AgriciDaniel/claude-seo/tree/6be93f45064ffbadced572b5d5c95f55fd263af0/skills/seo-google"
