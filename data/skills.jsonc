    {
      "id": "coreyhaines31/marketingskills/skills/marketing-plan",
      "name": "marketing-plan",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/marketing-plan",
        "installs": 77900,
        "weeklyInstalls": [2636, 2666, 3090, 3393, 3270, 3499, 3952, 3734],
        "firstSeen": "2026-05-29"
      },
      "skillMd": {
        "version": "8a3bde8083bd121971f61cba4bdbe5fd8c0eee7d",
        "updated": "2026-11-10",
        "skew": 148
      },
      "agentReview": {
        "description": "Builds a 12-month marketing plan structured by funnel stage and fitted to a company's budget, team and funding, reviewed with you section by section.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're a fractional CMO or consultant starting with a client, or a founder who needs a 12-month marketing roadmap for the team or investors"
            },
            {
              "label": "It does",
              "text": "Researches the company and interviews you, then drafts 13 sections one at a time for you to approve, adjust or expand"
            },
            {
              "label": "You get",
              "text": "One Markdown file of roughly 8,000 to 12,000 words, ready to paste into Notion, with a 90-day roadmap that names owners"
            },
            {
              "label": "Keeps",
              "text": "Research, progress and each approved section in ~/marketing-plans/, so you can stop and resume where you left off"
            },
            {
              "label": "Unlike marketing-ideas",
              "text": "That one, from the same repo, suggests standalone tactics; this one commits to a sequenced plan and cross-references all 139 of those ideas"
            }
          ],
          "text": "A fractional CMO's strategy document, organized by AARRR, the funnel stages acquisition, activation, retention, referral and revenue, so every move names the stage it serves. You call it with a client name or domain. First it reads the materials you provide, pulls data from connected tools such as analytics or Stripe, and interviews you on funding, team, budget, channels, what's done and what's stuck, scoring the current state against its own 17-part rubric. In the second it presents each of 13 sections for approval: executive summary, strategic frame, current state, one per funnel stage, a 90-day roadmap, a 12-month outlook tied to funding milestones, the marketing skills and integrations that would carry out each move, an idea bank, and measurement with open decisions. The third phase compiles and checks the final file, and can offer to publish it to a GitHub repo. Throughout, it treats marketing as a portfolio of compounding assets, checks how big and frequent the problem is, sizes the market (total, serviceable and obtainable) when that's in doubt, sets budgets from revenue or from goals, and lists unknowns such as acquisition cost as open decisions rather than guessing. A finished plan is never overwritten without asking.",
          "permalink": "https://github.com/coreyhaines31/marketingskills/tree/96798cf38736ecdba015a1d2b0521b0c8f8f41dd/skills/marketing-plan"
        },
        "tags": [
          "category:marketing",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "marketing",
          "research"
        ],
        "note": "Saves research, progress and the finished plan under ~/marketing-plans/ in your home folder.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "coreyhaines31/marketingskills/skills/prospecting",
      "name": "prospecting",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/prospecting",
        "installs": 74961,
        "weeklyInstalls": [2435, 2280, 2639, 3052, 3109, 3268, 3937, 3568],
