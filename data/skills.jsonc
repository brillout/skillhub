          "effect:none",
          "needs:none",
          "by:community",
          "stack:react",
          "stack:zustand",
          "debugging",
          "code-review"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "affaan-m/ecc/skills/healthcare-phi-compliance",
      "name": "healthcare-phi-compliance",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/healthcare-phi-compliance",
        "installs": 5800,
        "weeklyInstalls": [260, 168, 148, 243, 417, 409, 475, 487],
        "firstSeen": "2026-05-19"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Applies patient-data protection patterns to healthcare apps: PHI classification, row-level security, insert-only audit logs, schema tagging and closing leaks through logs, URLs and storage.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your code touches patient or clinician data, or you're adding HIPAA- or GDPR-style access controls"
            },
            {
              "label": "It does",
              "text": "Sorts data into PHI and other sensitive PII, limits access by facility with row-level security, and logs every access to an insert-only audit table"
            },
            {
              "label": "You get",
              "text": "Code that keeps identifiers out of errors, logs, URLs and browser storage, plus a 10-item pre-deployment checklist"
            },
            {
              "label": "Covers",
              "text": "HIPAA in the US, DISHA in India and GDPR in the EU"
            },
            {
              "label": "Examples in",
              "text": "Postgres row-level security with Supabase's auth.uid() and keys, and TypeScript"
            }
          ],
          "text": "A compact pattern sheet for code that handles health data, contributed by Dr. Keyur Patel of Health1 Super Speciality Hospitals. It defines PHI as anything that identifies a patient and relates to their health, from names and national IDs to diagnoses, lab results and insurance claims, and separates it from other sensitive data such as clinician pay and bank details. Access is enforced in the database: SQL policies limit staff to their own facility's patients, and the audit log accepts inserts but no updates or deletes. Every access or change to PHI gets an audit entry with the user, patient, action, before and after values, IP address and session. It lists the usual leaks: patient details in error messages, console output, query strings, localStorage and stack traces sent to error trackers, and service-role keys in client code, with opaque UUIDs in place of record numbers. PHI and PII columns are marked with SQL comments. Its deployment checklist adds session timeouts, authenticated endpoints and verified isolation between facilities. It runs no scanner of its own.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/healthcare-phi-compliance"
        },
        "tags": [
