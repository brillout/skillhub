      "agentReview": {
        "description": "Audits a whole website for SEO with parallel subagents, then writes a scored report and a prioritized action plan.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a whole site checked, not one page or one area"
            },
            {
              "label": "It does",
