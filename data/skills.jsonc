    {
      "id": "rohitg00/agentmemory/plugin/skills/handoff",
      "name": "handoff",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/agentmemory/handoff",
        "installs": 14100,
        "weeklyInstalls": [375, 329, 291, 293, 304, 299, 285, 256],
        "firstSeen": "2026-05-18"
      },
      "skillMd": {
        "version": "f0f7378ac42849b863fcc5c8e753f120d5ec6f9d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Resumes the most recent agent session for the current project from agentmemory, leading with any question left unanswered.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A session starts without fresh context and you ask \"where were we\" or want to pick up where you left off"
            },
            {
              "label": "It does",
              "text": "Finds the latest session whose directory matches this project, then searches memory for its key files, decisions and errors"
            },
            {
              "label": "You get",
              "text": "A short resume: any unanswered question first, then the session's summary, key files and decisions, and one next step"
            },
            {
              "label": "Needs",
              "text": "agentmemory's memory server and MCP tools, plus its capture hooks recording your sessions: connecting the tools alone records no sessions"
            },
            {
              "label": "Unlike handoff documents",
              "text": "It writes nothing at the end of a session; it reads the sessions agentmemory recorded"
            }
          ],
          "text": "Part of agentmemory, a memory server that records coding agents' sessions. handoff resumes work in the current directory, or one you name. The agent fetches the project's sessions and picks the most recent whose working directory is this one, a folder inside it or a folder containing it, so a sibling such as /repo-a-staging is never taken for /repo-a, preferring completed sessions over abandoned ones. With no match it says so and stops, rather than resuming another project's session. If the session ended on a question for you, found in its summary or in recent conversation entries ending in a question mark, that comes first. Then it summarizes the title, key files and key decisions or errors from a memory search on the session's top concepts, keeping only results from that session or project, and ends with one concrete next step.",
          "permalink": "https://github.com/rohitg00/agentmemory/tree/f0f7378ac42849b863fcc5c8e753f120d5ec6f9d/plugin/skills/handoff"
