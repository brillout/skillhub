        "skew": 0
      },
      "agentReview": {
        "description": "Reviews a resume's layout for ATS-safe, scannable formatting: page length, margins, fonts, section order, dates and file type, with recommended changes.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "Your resume looks messy or hard to read, or you're unsure its layout will get through applicant tracking software"
            },
            {
              "label": "It does",
              "text": "Applies layout rules that work for parsers and recruiters alike: one column, standard fonts at 10-12pt, 0.5-1 inch margins, standard section headers"
            },
            {
              "label": "You get",
              "text": "A formatting review: current issues, recommended setup, section order, visual and ATS fixes, and a before-and-after preview"
            },
            {
              "label": "Unlike resume-ats-optimizer",
              "text": "That one also scores keywords against a posting; this one covers layout only"
            }
          ],
          "text": "Formatting rules for a resume that has to pass two readers: applicant tracking systems (ATS) that parse the text, and recruiters who scan it. Length goes by experience: one page up to five years, one or two up to fifteen, two beyond that and at most three for executives. It sets margins, fonts and sizes for the name, headers and body, line spacing and a standard section order. The don'ts are what breaks parsing: tables, text boxes, multiple columns, important details in headers or footers, images, skill bars, emojis and color that carries meaning. It gives formats for contact details (city and state, no photo, birth date or marital status), experience entries with consistent dates and three to six bullets per role, skills and education, plus visual hierarchy and white space. Files go out as .docx or text-based PDF, named like FirstName_LastName_Resume.pdf. For a designed resume for creative roles, the repo has creative-portfolio-resume.",
          "permalink": "https://github.com/paramchoudhary/resumeskills/tree/74ae19e7c62b0516d1c298328e5544976c12da5d/skills/resume-formatter"
        },
