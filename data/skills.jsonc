    {
      "id": "wondelai/skills/blue-ocean-strategy",
      "name": "blue-ocean-strategy",
      "skills.sh": {
        "url": "https://skills.sh/wondelai/skills/blue-ocean-strategy",
        "installs": 5700,
        "weeklyInstalls": [141, 142, 134, 138, 264, 198, 133, 134],
        "firstSeen": "2026-02-10"
