          "refactoring",
          "code-review"
        ],
        "note": "Needs CodeScene's MCP server and an access token; its standalone mode, which the skill sticks to, needs no paid CodeScene plan.",
        "model": "Claude Opus 5.5",
        "effort": null
      }
