      }
    },
    {
      "id": "ComposioHQ/awesome-claude-skills/tailored-resume-generator",
      "name": "tailored-resume-generator",
      "skills.sh": {
        "url": "https://skills.sh/composiohq/awesome-claude-skills/tailored-resume-generator",
        "installs": 10500,
        "weeklyInstalls": [139, 128, 177, 156, 128, 147, 137, 157],
        "firstSeen": "2026-01-20"
      },
      "skillMd": {
        "version": "be2a406907dbc61b73e6827ded415c96139d13a2",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Rewrites your resume for a specific job description, matching its keywords for applicant tracking systems without inventing experience.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're applying for a specific job, or changing careers, and want your resume rewritten for it"
            },
            {
              "label": "It does",
              "text": "Ranks the job's requirements, maps your experience to each, then reorders and rewords it with the posting's own keywords"
            },
            {
              "label": "You get",
              "text": "A tailored resume in Markdown or plain text, plus strengths, gaps, interview talking points and cover letter openers"
            },
            {
              "label": "Rule",
              "text": "Never fabricate: it only lists skills you can back up with experience"
            },
            {
              "label": "Watch for",
              "text": "Its own worked example adds figures and skills the background never gave, such as a 60% time saving, so check every claim before you send it"
            }
          ],
          "text": "You paste a job description and either your current resume or a summary of your background, and the agent asks for anything missing. It sorts the posting's requirements into deal-breakers, strongly desired and nice to have, picks out repeated keywords and signs of company culture, and finds where your experience matches, where transferable skills cover a gap and where you fall short. The resume it writes leads with a three-to-four-line summary built from the top required skills, groups skills the way the job does, and rewrites each role's bullets as action, what, how and result, quantified with numbers, percentages and scale. It keeps the layout safe for applicant tracking systems, the software that filters resumes by keyword: standard headings, no tables or graphics, both acronyms and full terms. It holds to one page under ten years of experience and two above, adapts for career changers, recent graduates, executives, and technical or creative roles, and offers to iterate or make versions for other jobs.",
          "permalink": "https://github.com/ComposioHQ/awesome-claude-skills/tree/be2a406907dbc61b73e6827ded415c96139d13a2/tailored-resume-generator"
        },
