      },
      "skillMd": {
        "version": "30971f1c50c6412a0c414e8c7b15032a32b21939",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Finds AI writing patterns in text and rewrites them, flags them only, or edits a prose file in place, keeping your voice and facts.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "A draft, post or doc sounds machine-written, or you want to see which AI tells a text carries without changing it"
            },
            {
              "label": "It does",
              "text": "Checks the text against a catalog of words and patterns ranked P0 to P2, tuned to the context, such as LinkedIn, a blog, docs or an investor email"
            },
            {
              "label": "You get",
              "text": "One final rewrite with a short change list and a verification report; in detect mode, quoted findings marked as clear problems or judgment calls"
            },
            {
              "label": "Modes",
              "text": "Rewrite (default); detect, which changes nothing; edit, which makes minimal changes to a prose file and refuses code or config"
            },
            {
              "label": "Won't",
              "text": "Add facts, experiences, opinions or stock \"human\" flourishes the source lacks, or rewrite quotes, code, tables and URLs"
            }
          ],
          "text": "The rules live in a long pattern catalog the agent reads in full first. P0 tells, such as chatbot leftovers, cutoff disclaimers, vague attributions and inflated significance, come first; P1 covers stock words like delve and leverage, template phrases, stacked hedges and bold overuse; P2 covers polish such as em-dash rate, rule-of-three habits and uniform paragraphs. A match becomes a finding only after its context exceptions are read, and an edit only when your mode and scope allow it, so a clean text comes back unchanged. Rewrites keep meaning, numbers, attribution and certainty, and an optional voice (casual, professional, technical, warm or blunt) can bring out a stance the source has but never invent one. A run gets at most two editing passes; a bundled Node script matches quotes and apostrophes to the original's style, and in edit mode an optional validator catches mechanical preservation errors but doesn't vouch for meaning. An optional house-style config adds typography rules, checked by another script. The verification lists passes used, which checks ran or were model-only, findings left and why it stopped. It treats the patterns as signals, not proof that AI wrote a text, and its rules are calibrated for English.",
          "permalink": "https://github.com/conorbronsdon/avoid-ai-writing/tree/30971f1c50c6412a0c414e8c7b15032a32b21939/skills/avoid-ai-writing"
        },
        "tags": [
          "category:writing",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "anti-slop",
          "writing"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
