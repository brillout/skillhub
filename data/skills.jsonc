      "id": "emilkowalski/skills/skills/emil-design-eng",
      "name": "emil-design-eng",
      "skills.sh": {
        "url": "https://skills.sh/emilkowalski/skills/emil-design-eng",
        "installs": 443357,
        "weeklyInstalls": [17740, 18074, 19408, 21612, 21425, 23021, 21061, 20798],
        "firstSeen": "2026-03-16"
      },
      "skillMd": {
        "version": "f1090bec277140d02ed202440185ad9d02ac1490",
