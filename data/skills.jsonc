      "id": "coreyhaines31/marketingskills/skills/conversion-tracking",
      "name": "conversion-tracking",
      "skills.sh": {
        "url": "https://skills.sh/coreyhaines31/marketingskills/conversion-tracking",
        "installs": 12400,
        "weeklyInstalls": [0, 0, 0, 0, 0, 2777, 3725, 3541],
