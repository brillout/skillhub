      },
      "skillMd": {
        "version": "4bde3168b43c0655c4d00ea2726e631719908a6d",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Organizes work into Conductor tracks: a spec.md and phased plan.md per feature, bug, chore or refactor, tracked with status markers and commit SHAs.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're starting a feature, bug fix, chore or refactor in a project run with Conductor, or writing or updating its spec.md and plan.md"
            },
            {
              "label": "It does",
              "text": "Defines a track, one unit of work with its own folder, an ID such as user-auth_20250115, a spec, a phased plan and metadata, and its lifecycle from creation to archive"
            },
            {
              "label": "You get",
              "text": "Templates for spec.md, plan.md, metadata.json and the tracks.md registry, plus quality checklists for specs and plans"
            },
            {
              "label": "Markers",
              "text": "[ ] pending, [~] in progress, [x] done with its commit SHA, [-] skipped, [!] blocked"
            },
            {
              "label": "Commands",
              "text": "Creating and reverting a track run /conductor:new-track and /conductor:revert, which come with the Conductor plugin, not with this skill"
            }
          ],
          "text": "Conductor, a plugin in the same repo, keeps a project's context in a conductor/ folder and splits work into tracks; this skill is its guide to tracks. Creating one means gathering requirements by Q&A, writing spec.md (functional and non-functional requirements, testable acceptance criteria, what's in and out of scope, dependencies, risks and open questions) and plan.md (phases of tasks, each ending in verification tasks, with a checkpoint table), then registering it in tracks.md with a metadata.json and an index. During implementation, tasks are marked as they go and completed ones record their commit SHA; each phase needs its verification and an approved checkpoint before the next. On completion, the track is marked done, product.md and tech-stack.md are updated if features or dependencies changed, and the track is archived rather than deleted. Tracks should take one to five days, with two to four phases and 8–20 tasks; it lists signs of tracks too large or too small, how to record hard, soft and external dependencies, and phase patterns for features, bug fixes (start with a failing test) and refactors (start with characterization tests). The SKILL.md holds only ten best practices; the rest is in a reference file.",
          "permalink": "https://github.com/wshobson/agents/tree/4bde3168b43c0655c4d00ea2726e631719908a6d/plugins/conductor/skills/track-management"
        },
        "tags": [
          "category:planning",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:community",
          "planning",
          "requirements"
        ],
        "note": "Written for wshobson's Conductor plugin: creating and reverting a track go through its /conductor:new-track and /conductor:revert commands, which installing the skill alone doesn't add.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
