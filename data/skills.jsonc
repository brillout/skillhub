      "agentReview": {
        "description": "Rebuilds slide images, screenshots, scanned PDFs or image-only PPTX files as PowerPoint decks with editable shapes, text and arrows, checked by rendered QA.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have slides only as images, screenshots, a scanned PDF or an image-only PPTX and need a deck you can edit"
            },
            {
              "label": "It does",
              "text": "Plans each structured page as 3-5 regions, rebuilds measurable boxes, text, connectors and arrows as native PowerPoint objects, and keeps only complex parts as images"
            },
            {
              "label": "You get",
              "text": "A final PPTX with the source's speaker notes preserved, a QA report, and a list of visuals still left as replaceable bitmaps"
            },
            {
              "label": "Unlike nature-paper2ppt",
              "text": "That one authors a new deck from a paper; this one reconstructs one you already have"
