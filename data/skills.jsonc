      "agentReview": {
        "description": "Generates a design system from your codebase's styles, or scores your UI on ten visual dimensions and flags generic AI-looking design.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're starting a design system, checking visual consistency before a redesign, or reviewing a PR that touches styling"
            },
            {
              "label": "It does",
              "text": "In one of three modes: pulls tokens from your CSS, Tailwind or styled-components, scores the UI, or checks it for AI-slop patterns"
