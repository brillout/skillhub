      "agentReview": {
        "description": "Reviews a printed CLI's sampled command output for implausible results that rule-based checks miss, such as irrelevant matches or silently dropped sources.",
        "tldr": {
          "glance": [
            {
              "label": "It does",
              "text": "Samples the printed CLI's commands through the scorecard's live check, then has a subagent judge the passing outputs as a person would"
            },
            {
              "label": "Catches",
              "text": "Results that match the query only as a substring, implausible top rankings, silently dropped sources, mojibake, and links to index pages instead of permalinks"
            },
            {
              "label": "You get",
              "text": "A PASS, WARN or SKIP block for the calling skill; findings are only warnings and never block shipping"
