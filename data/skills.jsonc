    {
      "id": "manaflow-ai/cmux/skills/cmux-browser",
      "name": "cmux-browser",
      "skills.sh": {
        "url": "https://skills.sh/manaflow-ai/cmux/cmux-browser",
        "installs": 9000,
        "weeklyInstalls": [306, 254, 249, 192, 174, 150, 124, 99],
        "firstSeen": "2026-02-20"
      },
      "skillMd": {
        "version": "be5e24339c6eabb8e929a7029c4e6f834e257c97",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Drives the browser built into the cmux terminal: opens sites, waits for pages, clicks, fills forms and extracts text, without moving your focus.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You work in cmux and want the agent to open, read or operate a website in a browser pane beside your terminal"
            },
            {
              "label": "It does",
              "text": "Runs cmux browser commands to open a page, wait for it, snapshot its elements, click, fill, and read its text or HTML"
            },
            {
              "label": "Leaves alone",
              "text": "Your focus: it finds browser panes from cmux's tree and targets each by its handle, never by what's on screen"
            },
            {
              "label": "Needs",
              "text": "The cmux macOS app and its CLI"
            },
            {
              "label": "Can't do",
              "text": "Tracing, network mocking or raw input, which need Chrome's DevTools protocol; geolocation and offline mode work"
            },
            {
              "label": "Unlike agent-browser",
              "text": "It drives cmux's WebKit browser rather than Chrome; a reference maps its commands to agent-browser's"
            }
          ],
          "text": "cmux is a macOS terminal for coding agents with a browser you can split next to your terminals. This skill is cmux's guide to automating that browser. The agent first checks cmux browser --help, then keeps two kinds of command apart: open, open-split and new create a browser surface, while commands that act on an existing surface name its handle, preferably with --surface, and never guess from focus. To find a page you already have open, it filters cmux tree --all --json for browser surfaces, or matches a URL or title without printing it. The usual loop opens a page with --focus false, keeps the returned surface ref, waits for the page to load, takes an interactive snapshot that labels elements e1, e2 and so on, fills and clicks by those labels, and snapshots again after each navigation because the labels go stale. It can also set an exact viewport and list a surface's downloads. When a page rejects the snapshot script, it falls back to reading the page's text or HTML. References cover logins and saved state, several surfaces at once and proxies, and three template scripts cover form filling, an authenticated session and capturing screenshots.",
          "permalink": "https://github.com/manaflow-ai/cmux/tree/be5e24339c6eabb8e929a7029c4e6f834e257c97/skills/cmux-browser"
        },
        "tags": [
          "category:browser",
          "type:tool",
          "effect:remote",
          "needs:cli",
          "by:official",
          "stack:cmux",
          "browser-automation",
          "scraping"
        ],
        "note": "Works only inside cmux, a macOS terminal app: it drives cmux's built-in WebKit browser, not Chrome.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
