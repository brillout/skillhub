        "skew": 0
      },
      "agentReview": {
        "description": "Researches why the TypeScript team typed a built-in the way it did, from their issues, PRs and comments.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to know why TypeScript types a built-in the way it does, as ts-reset's maintainers do before overriding one"
            },
            {
              "label": "It does",
              "text": "Searches microsoft/TypeScript's issues and PRs with gh for what the TypeScript team said, including changes that were tried and reverted"
            },
            {
              "label": "You get",
              "text": "A report in the conversation: a timeline, quotes linked to the exact comments, the reasoning, past attempts, and whether ts-reset should override the type"
            },
            {
              "label": "Needs",
              "text": "The gh CLI; it falls back to web search when GitHub's search falls short"
            }
          ],
          "text": "ts-reset is Matt Pocock's library that replaces some of TypeScript's built-in types with stricter ones. Before overriding one, its maintainers want to know why TypeScript typed it that way, and this skill researches that. The agent searches the microsoft/TypeScript repo's issues and PRs with gh, from narrow queries to broader ones, and keeps the comments of the TypeScript team: Ryan Cavanaugh, the project lead whose word usually settles it, then Daniel Rosenwasser, Anders Hejlsberg and Nathan Shively-Sanders. It checks for PRs that changed the type and were reverted, looks for principles stated on related issues, and falls back to web search. It knows the team's recurring arguments, such as \"any can never be wrong, just less right\" and caution about breaking changes. It only reads. Its report gives a timeline with links, direct quotes linked to the specific comments, the reasoning, earlier attempts to change the type, and whether the change fits ts-reset or the current typing is a deliberate trade-off.",
          "permalink": "https://github.com/mattpocock/ts-reset/tree/81b3b2614a32e47948cd4b8d5468879c07c2b361/.claude/skills/research-ts-decisions"
        },
