        "skew": 0
      },
      "agentReview": {
        "description": "Writes App Store release notes from your commits or notes, localizes them and uploads them with asc once you approve.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're shipping an app update and need its App Store \"What's New\" text in every language your listing has"
            },
            {
              "label": "It does",
              "text": "Turns git commits since your last tag, rough bullets or a description into New, Improved and Fixed sections, then translates the approved draft"
            },
            {
              "label": "You get",
              "text": "Release notes for each locale, optionally with 170-character promotional text, uploaded through asc once you approve them"
            },
            {
              "label": "Leads with",
              "text": "The single biggest change, in the first ~170 characters, the only part shown before \"more\""
            },
            {
              "label": "Needs",
              "text": "The asc CLI signed in to App Store Connect; keywords come from metadata pulled into ./metadata, or from you"
            }
          ],
          "text": "The agent drafts the primary locale first, en-US unless you say otherwise. From a git log it drops merges, dependency bumps, CI and formatting commits, and keeps what users would notice. The copy is benefit-focused and addressed to \"you\", with specific improvements rather than \"Bug fixes and improvements\". It weaves in words from the listing's keyword field where they fit the changes: What's New isn't indexed for search, so this is for conversion, not ranking. It aims for 500 to 1,500 characters, leaving room for languages that run longer, and shows you the draft with its character count. Once you approve, it translates into every locale already in the metadata, in a formal register (Sie, vous, usted), adapting idioms and echoing each locale's own keywords, within 4,000 characters and shortening rather than cutting mid-sentence. It shows a table of every locale with character counts, waits for your OK, then uploads per locale or with asc metadata push, and reports any locales that failed, offering to retry them.",
          "permalink": "https://github.com/rorkai/app-store-connect-cli-skills/tree/7de1ef7cc831f62d205dfa589063f3831f66391b/skills/asc-whats-new-writer"
        },
