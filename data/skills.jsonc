    {
      "id": "github/awesome-copilot/skills/conventional-commit",
      "name": "conventional-commit",
      "skills.sh": {
        "url": "https://skills.sh/github/awesome-copilot/conventional-commit",
        "installs": 17400,
        "weeklyInstalls": [307, 142, 132, 113, 124, 109, 91, 106],
        "firstSeen": "2026-02-25"
      },
      "skillMd": {
        "version": "797337f33f73e35d08d82f840e21c4b8c4932d88",
