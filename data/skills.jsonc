          "design-system"
        ],
        "note": "Needs the Figma MCP server and a Figma file whose design system is published. Before every Figma script it loads the repo's figma-use skill, which SkillHub doesn't list: install it alongside.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "bmad-code-org/bmad-method/skills/bmad-eval",
      "name": "bmad-eval",
      "skills.sh": {
        "url": "https://skills.sh/bmad-code-org/bmad-method/bmad-eval",
        "installs": 8100,
        "weeklyInstalls": [0, 0, 0, 1732, 1307, 1526, 1319, 1423],
