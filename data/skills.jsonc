      "skillMd": {
        "version": "d7b5633f91591ee3bf55c8d80831b515498cc0e6",
        "updated": "2026-11-07",
        "skew": 0
      },
      "agentReview": {
        "description": "Onboards you to the AI Engineering from Scratch course with three questions and a placement quiz, then saves a LEARNING.md study plan.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want to start the free AI Engineering from Scratch course with your coding agent as tutor"
            },
            {
              "label": "It does",
              "text": "Asks why you're learning, how many hours a week you have and what you want to build, then runs find-your-level's placement quiz"
            },
            {
              "label": "You get",
              "text": "LEARNING.md: your mission, placement score, entry phase, all 20 phases marked Skip, Review or Do with hours, a progress log and a review queue"
            },
            {
              "label": "Skips the quiz",
              "text": "When you name your starting phase yourself, marking every earlier phase Skip"
            },
            {
              "label": "Never overwrites",
              "text": "An existing LEARNING.md: it offers to resume, redo placement or start over, archiving the old file first"
            },
            {
              "label": "Routes",
              "text": "Resume requests for its MCP, Agent Skills, reverse engineering, certification and interview tracks, and requests for just one of the first three, to that track's own tutor"
            }
          ],
          "text": "The course is 542 lessons in 20 phases, from linear algebra to autonomous agents, and this skill is its front door. It asks only three questions, since the quiz measures knowledge and the interview only captures intent, then runs the placement quiz from find-your-level, keeping that skill's rule against reading answers early. Phase hours come from the course's ROADMAP.md, read from your clone or fetched from GitHub. Before onboarding, it looks for the state files of the course's other tracks and hands a resume request to the skill that owns that track, and a learner who wants only MCP, Agent Skills or reverse engineering goes straight to that track's tutor, with no quiz and no LEARNING.md; those skills aren't listed here. It ends with three lines: your entry point and total hours, how to call learn, which starts the first lesson and picks up from LEARNING.md every time, and how to call course-guide to jump to a topic. Commands are written in the form your agent uses, Codex, Claude Code or another.",
          "permalink": "https://github.com/rohitg00/ai-engineering-from-scratch/tree/d7b5633f91591ee3bf55c8d80831b515498cc0e6/skills/start-learning"
        },
        "tags": [
          "category:personal",
          "type:workflow",
          "effect:local",
          "needs:none",
          "by:official",
          "learning"
        ],
        "note": "Runs the find-your-level skill's placement quiz, so install both; the plan it writes is meant for the repo's learn skill, which isn't listed.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "rohitg00/ai-engineering-from-scratch/skills/check-understanding",
      "name": "check-understanding",
      "skills.sh": {
        "url": "https://skills.sh/rohitg00/ai-engineering-from-scratch/check-understanding",
        "installs": 5300,
        "weeklyInstalls": [195, 276, 451, 387, 302, 325, 356, 313],
        "firstSeen": "2026-05-23"
