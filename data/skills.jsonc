      "agentReview": {
        "description": "Outlines \"X vs Y\", \"alternatives to X\" and roundup pages: structure, feature table, schema markup and target keywords.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want pages that rank for \"[competitor] alternatives\", \"A vs B\" or \"best [category] tools\""
            },
            {
              "label": "It does",
              "text": "Picks one of four page types and lays out the feature matrix, title and H1 patterns, calls to action and social proof"
