      },
      "skillMd": {
        "version": "c1c8a8c1471069fb0e188eeaff69b8e8db6564a8",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Audits a codebase for vulnerabilities that cross a real trust boundary, with independent verification and a report of evidence, severity and fixes.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You have a security question, want a focused review, or explicitly ask for a full audit or pen test of a codebase"
            },
            {
              "label": "It does",
              "text": "In a full audit, maps trust boundaries, sends subagents hunting by attack class, has fresh agents verify each candidate, and validates the findings"
            },
            {
              "label": "You get",
              "text": "REPORT.md, FINDINGS-DETAIL.md and NEEDS-VALIDATION.md in a new run folder outside your repo, with severity only for confirmed findings and the smallest source fix for each"
            },
            {
              "label": "Runs",
              "text": "As guidance by default; the six-phase audit only when you explicitly ask, and it asks first when unclear"
            },
            {
              "label": "Never",
              "text": "Probes live services, edits your source, or runs your code outside a sandbox with no network"
            }
          ],
          "text": "Cloudflare's defensive, source-first audit method. A finding counts only if it names a lower-trust actor, the input they control, the control it defeats, the boundary crossed and a concrete result; missing best practices, guessed deployment behavior and self-inflicted effects don't qualify. Facts that live outside the repository, such as proxy or identity settings, become \"needs validation\" items with a safe plan instead of guesses. A full audit runs six phases: reconnaissance builds a coverage ledger, a list of the code areas and attack classes the run must cover; waves of isolated hunter subagents work through it, with critic passes looking for gaps; a fresh verifier checks each candidate; findings go to a JSON file checked against a schema; independent agents re-verify the final records; and the reports are written from them. Profiles trade breadth for cost: quick, standard or deep, optionally scoped to some paths or a diff, with an optional cap on agent calls. Severity runs from critical to informational and can't exceed the impact shown. Earlier runs are read:unchanged confirmed findings carry over after fresh verification, and changed code is rechecked. Target code runs only in an OS-enforced sandbox; without one, it doesn't run it.",
          "permalink": "https://github.com/cloudflare/security-audit-skill/tree/c1c8a8c1471069fb0e188eeaff69b8e8db6564a8/skills/security-audit"
        },
        "tags": [
          "category:security",
          "category:debugging",
          "type:workflow",
          "effect:local",
          "needs:subagents",
          "by:official",
          "security",
          "code-review"
        ],
        "note": "A full audit runs many subagents and writes its reports to ~/security-audit-skill/<repo>/run-N; it runs your code only inside a sandbox without network.",
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
