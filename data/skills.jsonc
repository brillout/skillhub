      "agentReview": {
        "description": "Fills in Weibo posts with images or video, and long Markdown headline articles, in your logged-in Chrome, leaving publishing to you.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want a post or a Markdown article on Weibo (微博) without composing it by hand"
            },
            {
              "label": "It does",
              "text": "Opens Weibo in Chrome through its debugging protocol and fills in the text, images and videos, or an article's title, summary, body and cover"
