    {
      "id": "trailofbits/skills/plugins/constant-time-analysis/skills/constant-time-analysis",
      "name": "constant-time-analysis",
      "skills.sh": {
        "url": "https://skills.sh/trailofbits/skills/constant-time-analysis",
