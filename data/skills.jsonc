    {
      "id": "affaan-m/ecc/skills/healthcare-emr-patterns",
      "name": "healthcare-emr-patterns",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/healthcare-emr-patterns",
        "installs": 5700,
        "weeklyInstalls": [260, 169, 143, 233, 414, 402, 474, 482],
        "firstSeen": "2026-05-19"
      },
      "skillMd": {
        "version": "d2ef2680594f9a17526a6e1a2e18b3d242c5d17b",
        "updated": "2026-11-06",
        "skew": 0
      },
      "agentReview": {
        "description": "Guides building EMR and EHR features around patient safety: single-page encounter flows, blocking drug-interaction checks, locked signed records and accessible clinical UIs.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You're building patient encounters, prescriptions, lab displays or clinical decision support into a medical records system"
            },
            {
              "label": "It does",
              "text": "Judges each design by \"could this harm a patient?\", from interaction checks that block prescribing to alerts that can't be dismissed"
            },
            {
              "label": "You get",
              "text": "Encounter, template and medication-check designs, plus UI rules for vitals, lab results and prescription PDFs"
            },
            {
              "label": "Unlike healthcare-phi-compliance",
              "text": "That one, from ECC, covers who may see patient data; this one covers how clinicians enter and act on it"
            }
          ],
          "text": "Patterns for electronic medical record systems, contributed by Dr. Keyur Patel of Health1 Super Speciality Hospitals. An encounter flows down one page, not across tabs, under a sticky header with the patient's allergies and active medications: complaint, history, exam, vitals with automatic scoring such as NEWS2 and qSOFA, diagnosis by ICD-10 or SNOMED search, medications, investigations, plan, then sign. Complaint templates carry symptom chips, required fields and red flags that raise a non-dismissable alert rather than a toast. Choosing a drug checks current and encounter medications, allergies, and dose against weight, age and kidney function; a critical interaction blocks prescribing until the clinician records an override reason, which goes to the audit trail. Signed encounters lock, and later changes become linked addenda. Clinical UIs need 4.5:1 contrast, 44px touch targets, keyboard entry, color always paired with text or an icon, and screen-reader labels. Worked examples cover a chest-pain encounter, a warfarin and aspirin override, and an addendum.",
          "permalink": "https://github.com/affaan-m/ecc/tree/d2ef2680594f9a17526a6e1a2e18b3d242c5d17b/skills/healthcare-emr-patterns"
        },
        "tags": [
          "category:engineering",
          "category:design",
          "type:guidelines",
          "effect:none",
          "needs:none",
          "by:community",
          "architecture",
          "accessibility",
          "design"
        ],
        "model": "Claude Opus 5.5",
        "effort": "xhigh"
      }
    },
    {
      "id": "affaan-m/ecc/skills/safety-guard",
      "name": "safety-guard",
      "skills.sh": {
        "url": "https://skills.sh/affaan-m/ecc/safety-guard",
        "installs": 5700,
        "weeklyInstalls": [258, 160, 145, 241, 415, 404, 479, 451],
        "firstSeen": "2026-05-19"
