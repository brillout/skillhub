      "agentReview": {
        "description": "Turns an article, notes or data into one AI-generated infographic, picking from 21 layouts and 22 visual styles.",
        "tldr": {
          "glance": [
            {
              "label": "Use it when",
              "text": "You want an article, notes or a set of numbers turned into one visual summary image"
